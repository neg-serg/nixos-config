+    /// `readFileAlloc` under the cache's size cap, naming the offending path
+    /// when the cap is what rejected the read: a bare `StreamTooLong` says
+    /// nothing about which file, and this cap is the one failure a caller
+    /// cannot diagnose from the error alone.
+    fn readCapped(self: *FileCache, io: std.Io, path: []const u8) ![]u8 {
+        return std.Io.Dir.cwd().readFileAlloc(io, path, self.allocator, .limited(max_read_bytes)) catch |err| {
+            if (err == error.StreamTooLong) {
+                std.debug.print("fix: file-read cap ({d} MiB) exceeded by {s}\n", .{ max_read_bytes / (1024 * 1024), path });
+            }
+            return err;
+        };
+    }
