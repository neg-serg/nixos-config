+test "the git fallback runs the configured binary with the fetch refspec" {
+    const testing = std.testing;
+
+    var tmp = testing.tmpDir(.{});
+    defer tmp.cleanup();
+
+    const cwd = try std.process.currentPathAlloc(testing.io, testing.allocator);
+    defer testing.allocator.free(cwd);
+    const base = try std.fs.path.resolve(testing.allocator, &.{ cwd, ".zig-cache", "tmp", &tmp.sub_path });
+    defer testing.allocator.free(base);
+
+    const stub = try std.fs.path.join(testing.allocator, &.{ base, "stub-git" });
+    defer testing.allocator.free(stub);
+    const log = try std.fs.path.join(testing.allocator, &.{ base, "argv.log" });
+    defer testing.allocator.free(log);
+
+    const script = try std.fmt.allocPrint(testing.allocator, "#!/bin/sh\nprintf '%s\\n' \"$@\" >> '{s}'\n", .{log});
+    defer testing.allocator.free(script);
+    try tmp.dir.writeFile(testing.io, .{ .sub_path = "stub-git", .data = script });
+    switch (@import("builtin").os.tag) {
+        .windows => return error.SkipZigTest,
+        else => {
+            var stub_file = try tmp.dir.openFile(testing.io, "stub-git", .{});
+            defer stub_file.close(testing.io);
+            try stub_file.setPermissions(testing.io, std.Io.File.Permissions.fromMode(0o755));
+        },
+    }
+
+    const fetch_dir = try std.fs.path.join(testing.allocator, &.{ base, "cache" });
+    defer testing.allocator.free(fetch_dir);
+
+    // Nothing listens on port 1, so the built-in fetch fails on its own and the
+    // transport has to take the fallback path — no network, no real git.
+    const rev = "0123456789abcdef0123456789abcdef01234567";
+    _ = materialize(testing.allocator, testing.io, "http://127.0.0.1:1/repo.git", fetch_dir, rev, null, false, false, true, true, .{
+        .git_fallback_bin = stub,
+        .connect_timeout_seconds = 1,
+    }) catch {};
+
+    const argv = try std.Io.Dir.cwd().readFileAlloc(testing.io, log, testing.allocator, .limited(4096));
+    defer testing.allocator.free(argv);
+    try testing.expect(std.mem.indexOf(u8, argv, "fetch") != null);
+    try testing.expect(std.mem.indexOf(u8, argv, "--depth") != null);
+    try testing.expect(std.mem.indexOf(u8, argv, "+0123456789abcdef0123456789abcdef01234567:refs/remotes/origin/pinned") != null);
+}
+
+test "a failing system git leaves the cache repository usable" {
+    const testing = std.testing;
+
+    var tmp = testing.tmpDir(.{});
+    defer tmp.cleanup();
+
+    const cwd = try std.process.currentPathAlloc(testing.io, testing.allocator);
+    defer testing.allocator.free(cwd);
+    const base = try std.fs.path.resolve(testing.allocator, &.{ cwd, ".zig-cache", "tmp", &tmp.sub_path });
+    defer testing.allocator.free(base);
+
+    // A stub that fails, like a machine without `git` or a server it cannot reach.
+    // The fallback must report an error rather than deinit the repository twice:
+    // the error path used to leave `repo` deinited behind `materialize`'s
+    // deferred `repo.deinit()`, which segfaulted.
+    try tmp.dir.writeFile(testing.io, .{ .sub_path = "git-that-fails", .data = "#!/bin/sh\nexit 1\n" });
+    switch (@import("builtin").os.tag) {
+        .windows => return error.SkipZigTest,
+        else => {
+            var stub_file = try tmp.dir.openFile(testing.io, "git-that-fails", .{});
+            defer stub_file.close(testing.io);
+            try stub_file.setPermissions(testing.io, std.Io.File.Permissions.fromMode(0o755));
+        },
+    }
+    const stub = try std.fs.path.join(testing.allocator, &.{ base, "git-that-fails" });
+    defer testing.allocator.free(stub);
+
+    const fetch_dir = try std.fs.path.join(testing.allocator, &.{ base, "cache" });
+    defer testing.allocator.free(fetch_dir);
+
+    try testing.expectError(error.FetchGitFailed, materialize(
+        testing.allocator,
+        testing.io,
+        "http://127.0.0.1:1/repo.git",
+        fetch_dir,
+        "0123456789abcdef0123456789abcdef01234567",
+        null,
+        false,
+        false,
+        true,
+        true,
+        .{ .git_fallback_bin = stub, .connect_timeout_seconds = 1 },
+    ));
+
+    // And when the fallback binary is missing altogether (the spawn itself
+    // fails), which is the other shape of the same crash.
+    const missing = try std.fs.path.join(testing.allocator, &.{ base, "no-such-git" });
+    defer testing.allocator.free(missing);
+    try testing.expectError(error.FetchGitFailed, materialize(
+        testing.allocator,
+        testing.io,
+        "http://127.0.0.1:1/repo.git",
+        fetch_dir,
+        "0123456789abcdef0123456789abcdef01234567",
+        null,
+        false,
+        false,
+        true,
+        true,
+        .{ .git_fallback_bin = missing, .connect_timeout_seconds = 1 },
+    ));
+}
