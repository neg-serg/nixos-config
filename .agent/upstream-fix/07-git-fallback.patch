+/// `fetchTargeted`, with the system `git` as a last resort.
+///
+/// The built-in client speaks the modern forges, but some servers answer it in
+/// a dialect it refuses — git.kernel.org is the known case — and Nix itself has
+/// always shelled out to `git` for this step. Only a transport-level failure
+/// falls back; a bad revision stays an error. The cache repository is reopened
+/// afterwards: an external fetch added pack files the open handle has not
+/// indexed, so the resolve/checkout steps below must see a fresh repository.
+fn fetchTargetedOrSystemGit(
+    allocator: std.mem.Allocator,
+    io: std.Io,
+    repo: *ziggit.Repository,
+    work_dir: std.Io.Dir,
+    path: []const u8,
+    url: []const u8,
+    refspec_text: []const u8,
+    rev: ?[]const u8,
+    ref_name: ?[]const u8,
+    all_refs: bool,
+    shallow: bool,
+    fallback_bin: ?[]const u8,
+    transport_options: ziggit.TransportOptions,
+    ssh_options: ziggit.Ssh.SshOptions,
+    diag: ?*?ziggit.Diagnostic,
+) !void {
+    fetchTargeted(allocator, io, repo, url, refspec_text, rev, ref_name, all_refs, shallow, transport_options, ssh_options, diag) catch |err| switch (err) {
+        error.FetchGitFailed, error.FetchTransient => {
+            const bin = fallback_bin orelse return err;
+            // Fetch through the system `git` *before* dropping the open handle: if
+            // that fails too, the error propagates and `materialize`'s deferred
+            // `repo.deinit()` must still see a live repository (deiniting twice
+            // segfaults). Only a successful external fetch has to invalidate the
+            // handle — it added pack files this repository has not indexed — and
+            // the replacement is opened before the old handle goes away, so no
+            // path leaves `repo` dangling.
+            try fetchWithSystemGit(allocator, io, bin, path, url, rev, ref_name, all_refs, shallow);
+            const reopened = openRepositoryAt(allocator, io, work_dir, diag) catch |reopen_err| return mapError(reopen_err);
+            repo.deinit();
+            repo.* = reopened;
+        },
+        else => return err,
+    };
+}
+
+/// Last-resort fetch through the system `git`.
+///
+/// The refspecs mirror `fetchRefspec`, so the caller's resolve/checkout steps
+/// find exactly what a built-in fetch would have left behind. A missing `git`
+/// or a non-zero exit is reported as `FetchGitFailed`, like any other
+/// transport fault.
+fn fetchWithSystemGit(
+    allocator: std.mem.Allocator,
+    io: std.Io,
+    bin: []const u8,
+    path: []const u8,
+    url: []const u8,
+    rev: ?[]const u8,
+    ref_name: ?[]const u8,
+    all_refs: bool,
+    shallow: bool,
+) !void {
+    // `git` refuses to fetch into a directory it does not recognize, and the
+    // built-in client may have created only a bare skeleton before failing.
+    try runSystemGit(allocator, io, bin, &.{ "-C", path, "init", "-q" });
+
+    const refspec_text = try fetchRefspec(allocator, rev, ref_name, all_refs);
+    defer allocator.free(refspec_text);
+
+    try fetchWithSystemGitRefspec(allocator, io, bin, path, url, refspec_text, shallow);
+
+    // A plain `ref` may name a tag: retry with the tag refspec before giving
+    // up, mirroring the candidates `resolveObject` walks.
+    if (rev == null and ref_name != null and !all_refs and !std.mem.startsWith(u8, ref_name.?, "refs/")) {
+        const tag_spec = try std.fmt.allocPrint(allocator, "+refs/tags/{s}:refs/tags/{s}", .{ ref_name.?, ref_name.? });
+        defer allocator.free(tag_spec);
+        fetchWithSystemGitRefspec(allocator, io, bin, path, url, tag_spec, shallow) catch {};
+    }
+}
+
+fn fetchWithSystemGitRefspec(
+    allocator: std.mem.Allocator,
+    io: std.Io,
+    bin: []const u8,
+    path: []const u8,
+    url: []const u8,
+    refspec_text: []const u8,
+    shallow: bool,
+) !void {
+    var args: std.ArrayListUnmanaged([]const u8) = .empty;
+    defer args.deinit(allocator);
+    try args.appendSlice(allocator, &.{ "-C", path, "fetch" });
+    if (shallow) try args.appendSlice(allocator, &.{ "--depth", "1" });
+    try args.appendSlice(allocator, &.{ url, refspec_text });
+    try runSystemGit(allocator, io, bin, args.items);
+}
+
+/// Runs one `git` command (`bin`), resolving a bare name through the parent's
+/// PATH. Output is
+/// discarded: the caller only cares whether the fetch landed.
+fn runSystemGit(allocator: std.mem.Allocator, io: std.Io, bin: []const u8, args: []const []const u8) !void {
+    const argv = try allocator.alloc([]const u8, args.len + 1);
+    defer allocator.free(argv);
+    argv[0] = bin;
+    @memcpy(argv[1..], args);
+
+    var child = std.process.spawn(io, .{
+        .argv = argv,
+        .expand_arg0 = .expand,
+        .stdin = .ignore,
+        .stdout = .ignore,
+        .stderr = .ignore,
+    }) catch return error.FetchGitFailed;
+    const term = child.wait(io) catch return error.FetchGitFailed;
+    switch (term) {
+        .exited => |code| if (code != 0) return error.FetchGitFailed,
+        else => return error.FetchGitFailed,
+    }
+}
