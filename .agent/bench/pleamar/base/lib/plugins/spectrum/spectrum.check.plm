language 0.4

// spectrum.check.plm — the compile proof of the Spectrum plugin.
//
// A library is not opened by `pleamar --check`, and a component is only checked
// where it is used, so a plugin with no consumer is never compiled: this scene
// is that consumer. `scripts/dev/check-plm.sh` (just pleamar-check, just lint)
// picks every tracked scene up, so the plugin cannot rot silently.
//
// It is a scene and not a `part` (parts are not opened either) and it is not
// deployed: the module links `lib/` and `shells/` only, and no unit names it.
// Keep it to the surface and the two components: the numbers are labels, not a
// layout contract — the bar's media slice picks the real geometry.

import "../../palette.plm"
import "./spectrum.plm" as spec

scene spectrum_check {
    surface { size: 320, 140; anchor: top; level: overlay; agent: hidden }

    // The boundary the scene owns (facts), and both render modes at the sizes
    // the bar and the music popup will ask for.
    spec.Bars(width: 300, height: 24)
    spec.Bars(width: 300, height: 24, tone: accent, end: highlight, gap: 4)
    spec.Led(width: 300, height: 24)

    // The boundary is the library's own name (`Spectrum.`), not the import
    // surname, and a fact is set from a rule, never loose.
    on demo {
        Spectrum.mirror = false
        Spectrum.gradient = false
        Spectrum.peaks = false
        Spectrum.colorLowHz = 40
        Spectrum.colorHighHz = 12000
    }
}
