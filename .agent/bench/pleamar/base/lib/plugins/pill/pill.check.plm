language 0.4

// pill.check.plm — the compile proof of the pill tracker plugin (INTERFACES §10.2).

import "../../palette.plm"
import "./pill.plm" as pill

scene pill_check {
    surface { size: 160, 60; anchor: top; level: overlay; agent: hidden }

    pill.Mark()
    pill.Mark(scale: 1.4)

    on demo {
        Pill.deadlineHour = 9
        Pill.deadlineMinute = 30
        Pill.taken = true
        Pill.streak = 4
        emit Pill.toggle
    }
}
