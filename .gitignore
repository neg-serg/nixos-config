/result*
nixos.qcow2
# Accidental nix store dump (nix/store/*.drv, .patch) — never source
# ...repo-root only: modules/nix/ is real source and must stay trackable
/nix/
.direnv/
__pycache__/
.pi/
packages/target/
.omo/
# DSH web runtime uploads (voice recordings, images from chat)
.dsh-uploads/
nvim.log
# Accidental curl cookie jar (curl -c in repo root)
.cookie
files/shell/zsh/.zcompdump
viz/

# Binary/compressed blobs — don't let them sneak in accidentally
*.xz
*.gz
*.tgz
*.txz
*.bz2
*.tbz2
*.zst
*.lz4
*.zip
*.7z
*.rar
*.tar
*.iso
*.img
*.qcow2
*.dmg
*.deb
*.rpm
*.apk
*.whl
*.jar
*.exe
*.msi
*.dll
*.so
*.dylib
*.o
*.a
*.bin
# ...except deliberately vendored sources (packages/overlay.nix)
!files/sources/
!files/sources/**
# ...and the MediaTek MT6639 BT firmware blob (needed by backported btmtk driver)
!files/firmware/mediatek/mt7927/BT_RAM_CODE_MT6639_2_1_hdr.bin

# uv lockfile from ad-hoc `uv run` in the repo root — resolve deps on the fly
uv.lock

# GPU core dumps (ROCm aborts write ~1.6 GiB files into the CWD)
gpucore.*

# Agent rollout: the switch request names the toplevel the agent built and verified
# (modules/security/agent-switch.nix). Written per switch, removed on success — it
# must not show up as a tree change in the very diff the switch reports.
.agent/switch-request

# Agent build cache and scratch logs — regenerable byproducts of a build/reflect run
# (the nixie plan pins XDG_CACHE_HOME here because the sandbox cannot write HOME).
.agent/tmp-nix-cache/
.agent/tmp-nixcache/
.agent/tmp-runtime/
.agent/*.log
.agent/*.rc

# Generated theme artifact: Tools/build-theme.mjs writes it, and the running shell merges the
# live copy under $XDG_CONFIG_HOME/quickshell/Theme. A tracked copy only ever ships a stale
# snapshot (June 2026, pre-nixie keys) to the tools that read it by default.
files/quickshell/Theme/.theme.json
