#!/usr/bin/env python3
"""webstep - a local GUI agent loop: plan, act, verify.

One goal, one window, a loop of VLM decisions. Everything runs on the local
llama-swap fleet; nothing leaves the host.

    webstep run --goal "open Contacts, select Alex, add album Rumours" \
        --app-id vivaldi-stable --title Roster

Several files or a whole folder go in one run:

    webstep run --goal "send these tracks to Saved Messages" \
        --app-id org.telegram.desktop --allow-send \
        --dir "/home/neg/music/Paysage·d'Hiver-⟨1x9⟩-Schattengang"

Every picker the loop opens is filled from that queue in order; the actor only
clicks the attach control and, when the queue is empty, sends.

Roles and models (all overridable):

  planner   qwen3.8-27b-abliterated  text only: turns the goal into <=5 steps
  actor     gui-owl-4b             sees the screenshot, picks ONE action
  verifier  qwen3-vl-8b-abliterated  checks progress every --verify-every

The actor returns JSON: {thought, action, x, y, text, key, reason}, with
x/y normalized to 0-1000 over the screenshot for the Qwen3-VL/Qwen2-VL GUI
tier (gui-owl, holo2, ui-tars); holo1.5 is absolute pixels (`--coord-space
absolute`). The loop refuses destructive actions unless --allow-dangerous is
passed: a wrong click on "delete" is not recoverable.

The window is captured and driven through computer-use-linux (CUL): its
screenshot is downscaled by `scale`, the metadata carries the physical window
size, and clicks go in physical pixels. `activate_window` before every step
keeps the target focused when another window (or another agent) steals it.

Each run writes its artifacts to --log: shot-NN.png, step-NN.json and
run.json, so a failed trajectory can be replayed and the prompt improved.
"""

from __future__ import annotations

import argparse
import base64
import datetime
import json
import os
import re
import shutil
import subprocess
import sys
import time
import urllib.error
import urllib.request

BASE = os.environ.get("LLMCTL_URL", "http://127.0.0.1:9292")
CUL = os.environ.get("CUL_BIN") or shutil.which("computer-use-linux")
DANGEROUS = re.compile(r"(delete|remove|format|rm\s+-rf|удал|сотри|format\s+disk)", re.I)


class Cul:
    """Minimal MCP client for computer-use-linux."""

    def __init__(self) -> None:
        if not CUL:
            sys.exit("computer-use-linux not found in PATH")
        self.p = subprocess.Popen(
            [CUL, "mcp"],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            text=True,
        )
        self._id = 0
        self.rpc(
            "initialize",
            {
                "protocolVersion": "2024-11-05",
                "capabilities": {},
                "clientInfo": {"name": "webstep", "version": "0"},
            },
        )
        self._notify("notifications/initialized")

    def _notify(self, method: str) -> None:
        self.p.stdin.write(json.dumps({"jsonrpc": "2.0", "method": method}) + "\n")
        self.p.stdin.flush()

    def rpc(self, method: str, params: dict | None = None) -> dict:
        self._id += 1
        msg = {"jsonrpc": "2.0", "id": self._id, "method": method}
        if params is not None:
            msg["params"] = params
        self.p.stdin.write(json.dumps(msg) + "\n")
        self.p.stdin.flush()
        while True:
            line = self.p.stdout.readline()
            if not line:
                raise SystemExit("computer-use-linux mcp closed")
            try:
                reply = json.loads(line)
            except json.JSONDecodeError:
                continue
            if reply.get("id") == self._id:
                return reply

    def call(self, name: str, args: dict) -> dict:
        reply = self.rpc("tools/call", {"name": name, "arguments": args})
        content = reply.get("result", {}).get("content") or []
        text = content[-1].get("text") if content else None
        return json.loads(text) if text else reply

    def raw(self, name: str, args: dict) -> list:
        reply = self.rpc("tools/call", {"name": name, "arguments": args})
        return reply.get("result", {}).get("content") or []

    def close(self) -> None:
        try:
            self.p.stdin.close()
            self.p.wait(timeout=5)
        except Exception:  # noqa: BLE001
            self.p.kill()


# ---------------------------------------------------------------- llama-swap


def ask(model: str, messages: list, max_tokens: int = 400) -> dict:
    body = {
        "model": model,
        "messages": messages,
        "max_tokens": max_tokens,
        "temperature": 0,
    }
    req = urllib.request.Request(
        BASE + "/v1/chat/completions",
        data=json.dumps(body).encode(),
        headers={"Content-Type": "application/json"},
    )
    with urllib.request.urlopen(req, timeout=600) as resp:
        return json.loads(resp.read())


def ask_json(model: str, messages: list, max_tokens: int = 400) -> dict:
    """Ask and return the first JSON object in the reply (models wrap it)."""
    data = ask(model, messages, max_tokens)
    text = data["choices"][0]["message"]["content"] or ""
    for match in re.finditer(r"\{.*\}", text, re.S):
        try:
            obj = json.loads(match.group(0))
            if isinstance(obj, dict):
                return obj
        except json.JSONDecodeError:
            continue
    raise ValueError(f"no JSON in reply: {text[:200]}")


# ---------------------------------------------------------------- screen/meta


DIALOG_RE = re.compile(
    r"(choose files?|open file|select file|file picker|открыть файл|выберите файл|выбрать файл)",
    re.I,
)


def find_dialog(cul: "Cul", app_id: str) -> dict | None:
    """Return the first open file-picker window, if any.

    Telegram uses its own Qt dialog ("Choose Files"), browsers use the GTK
    portal, so the match is by title, not by app id.
    """
    for win in cul.call("list_windows", {}).get("windows", []):
        if DIALOG_RE.search(win.get("title") or ""):
            return win
    return None


def fill_file_dialog(cul: "Cul", dialog: dict, path: str) -> bool:
    """Drive a GTK file picker: location bar + clipboard paste + Enter.

    Typing the path is not an option: the music tree has Unicode names
    (·, ⟨⟩, ') that ydotool cannot map, so the path goes through the
    clipboard and ctrl+V. ctrl+L opens the chooser's location entry.
    """
    if not shutil.which("wl-copy"):
        return False
    subprocess.run(["wl-copy"], input=path.encode(), check=False)
    cul.call("activate_window", {"window_id": dialog["window_id"]})
    time.sleep(0.5)
    # Qt and GTK both put the keyboard in the name field of the chooser; ctrl+L
    # opens the location bar where the shell has it. Pasting the absolute path
    # and pressing Enter opens the file in either case.
    for key in ("ctrl+l", "ctrl+v", "Return"):
        cul.call("press_key", {"key": key})
        time.sleep(0.45)
    for _ in range(12):
        if not find_dialog(cul, ""):
            return True
        time.sleep(0.5)
    return False


def check_attachment(cul: "Cul", target: "Target", args, logdir: str, path: str) -> bool:
    """Read the staged attachment name back and compare it with --file.

    The picker can accept a preselected file instead of the pasted path (Qt
    dialogs preselect the last-used entry), so the name shown in the staging
    panel is the only proof of what would be sent. Tags usually mirror the file
    name, so a shared significant token is the check.
    """
    if not args.check_model or not path:
        return True
    try:
        image, _ = target.shot(cul)
    except SystemExit:
        return False
    with open(os.path.join(logdir, "attach-check.png"), "wb") as f:
        f.write(image)
    try:
        verdict = ask_json(
            args.check_model,
            [
                {"role": "system",
                 "content": ('What file name or track title is shown attached/staged '
                             'in the message input of this chat? Return ONLY JSON '
                             '{"name": "..."} or {"name": null}.')},
                {"role": "user",
                 "content": [
                     {"type": "text", "text": "Screenshot:"},
                     {"type": "image_url", "image_url": {
                         "url": "data:image/png;base64," + base64.b64encode(image).decode()}},
                 ]},
            ],
            150,
        )
    except Exception:  # noqa: BLE001
        return False
    shown = (verdict.get("name") or "").lower()
    stem = os.path.splitext(os.path.basename(path))[0].lower()
    tokens = [tok for tok in re.split(r"[^a-z0-9]+", stem) if len(tok) > 3]
    ok = bool(shown) and any(tok in shown for tok in tokens)
    print(json.dumps({"attachment": shown or None, "expected": stem, "match": ok},
                     ensure_ascii=False), flush=True)
    return ok


def num(value) -> float:
    """Tolerant number: models wrap coordinates in lists or strings."""
    if isinstance(value, (int, float)):
        return float(value)
    if isinstance(value, (list, tuple)) and value:
        return num(value[0])
    if isinstance(value, str):
        match = re.search(r"-?\d+(?:\.\d+)?", value)
        return float(match.group(0)) if match else 0.0
    return 0.0


def coords(action: dict) -> tuple[float, float]:
    """(x, y) from an action; some models put both in a single 2-item list."""
    x, y = action.get("x"), action.get("y")
    if (
        isinstance(x, (list, tuple))
        and isinstance(y, (list, tuple))
        and list(x) == list(y)
        and len(x) >= 2
    ):
        return num(x[0]), num(x[1])
    return num(x), num(y)


CLICK_DIVISOR = 2.0  # see Target.to_click; calibrated on the 2x screen


def monitor_scale() -> float:
    try:
        out = subprocess.run(
            ["hyprctl", "monitors", "-j"], capture_output=True, text=True, check=True
        ).stdout
        return float(json.loads(out)[0].get("scale", 1.0))
    except Exception:  # noqa: BLE001
        return 1.0


class Target:
    def __init__(self, cul: Cul, app_id: str | None, title: str | None) -> None:
        windows = cul.call("list_windows", {}).get("windows", [])
        found = None
        for win in windows:
            if app_id and win.get("app_id") != app_id:
                continue
            if title and title.lower() not in (win.get("title") or "").lower():
                continue
            found = win
            break
        if not found:
            names = ", ".join(
                f"{w.get('app_id')}:{w.get('title')}" for w in windows[:8]
            )
            sys.exit(f"window not found (app_id={app_id} title={title}); have: {names}")
        self.win = found
        self.id = found["window_id"]
        self.bounds = found["bounds"]
        self.scale = monitor_scale()

    def activate(self, cul: Cul) -> None:
        cul.call("activate_window", {"window_id": self.id})

    def shot(self, cul: Cul) -> tuple[bytes, dict]:
        last = None
        for _ in range(3):
            self.activate(cul)
            time.sleep(0.4)
            content = cul.raw("screenshot", {"window_id": self.id, "format": "png"})
            if content and content[0].get("data"):
                image = base64.b64decode(content[0]["data"])
                meta = json.loads(content[-1]["text"])
                return image, meta
            last = content
        raise SystemExit(f"screenshot failed for window {self.id}: {last}")

    def to_click(self, x: float, y: float, meta: dict, space: str) -> tuple[int, int]:
        """Model point -> the coordinate CUL's absolute pointer expects.

        CUL reports window bounds in physical pixels and screenshots at
        `scale` downsize, while its uinput click lands at `click_divisor`
        times the value handed to it (measured 2.0 on the 2x HiDPI screen:
        click(122,69) puts the cursor at logical 244,138). So the model point
        becomes physical via the bounds + metadata, then is divided by
        scale * click_divisor to land on the intended logical pixel.
        """
        if space == "normalized":
            px = x / 1000.0 * meta["coordinate_width"]
            py = y / 1000.0 * meta["coordinate_height"]
        else:
            px = x * meta["coordinate_width"] / meta["width"]
            py = y * meta["coordinate_height"] / meta["height"]
        div = self.scale * CLICK_DIVISOR
        return round((self.bounds["x"] + px) / div), round((self.bounds["y"] + py) / div)


# ---------------------------------------------------------------- prompts


def plan_prompt(goal: str) -> list:
    return [
        {
            "role": "system",
            "content": (
                "You are the planner of a local GUI agent. Return ONLY a JSON "
                "object {\"plan\": [\"step\", ...]} with at most 5 short steps. "
                "Each step must be one UI action described in words. "
                "Do not invent data; do not add destructive steps."
            ),
        },
        {"role": "user", "content": f"Goal: {goal}"},
    ]


ACTOR_SYSTEM = """You are the actor of a local GUI agent. You see a screenshot of one window ({w}x{h}).

Goal: {goal}
Plan: {plan}
Files to attach (in order): {files}
Files still waiting for the picker: {remaining}
Hint: {hint}
Actions so far:
{history}

Return ONLY a JSON object:
{{"thought": "one sentence", "action": "click|type|press|scroll|wait|send|done",
  "x": 0-1000, "y": 0-1000, "text": "literal text to type", "key": "Return",
  "reason": "why this is the next step"}}

Rules:
- click: x/y are normalized to 0-1000 over the screenshot, pointing at the CENTER of the target element.
- type: put the exact text in "text" (the field must already be focused).
- press: "key" is a key or combo, e.g. "Return", "Tab", "ctrl+a".
- scroll: x/y point at the area, direction given in "key" as up|down.
- send: submit the message already composed in the current chat (the harness presses Enter).
- action "done" only when the goal is visibly achieved (say what proves it in "reason").
- Before sending, check that the chat header shows the intended recipient.
- To attach a file, click the paperclip/attach control; a file picker opens and the
  harness fills one path from the queue — never type paths in the picker.
- With several files: attach them one by one (in Telegram the staging panel's "Add"
  opens the picker again); after the last picker is filled, send once.
- NEVER click a Send/Submit/Enter control and never press Enter to send. Stop at the
  staged state and use the send action; the harness performs the actual send.
- Never click a destructive control (delete, remove, format) unless the goal explicitly says so.
- One action per reply. No prose outside the JSON."""


def verify_prompt(goal: str) -> str:
    return (
        "You check a GUI agent. Goal: {goal}. Look at the screenshot. "
        'Return ONLY JSON: {"done": true/false, "progress": "one sentence", '
        '"stuck": true/false}. "stuck" means the screen shows an error dialog, '
        "a wrong page, or nothing relevant to the goal."
    ).replace("{goal}", goal)


# ---------------------------------------------------------------- run


def run(args: argparse.Namespace) -> int:
    cul = Cul()
    target = Target(cul, args.app_id, args.title)
    stamp = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
    logdir = os.path.join(args.log or "/tmp", f"webstep-{stamp}")
    os.makedirs(logdir, exist_ok=True)
    run_rec = {
        "goal": args.goal,
        "window": target.win,
        "actor": args.act_model,
        "planner": args.plan_model,
        "verifier": args.check_model,
        "steps": [],
        "logdir": logdir,
    }

    plan = []
    if args.plan_model:
        try:
            plan = ask_json(args.plan_model, plan_prompt(args.goal), 300).get("plan", [])
        except Exception as exc:  # noqa: BLE001
            plan = []
            print(f"planner failed: {exc}", file=sys.stderr)
    print(json.dumps({"plan": plan}, ensure_ascii=False), flush=True)

    files = collect_files(args) if (args.file or args.dir) else []
    pending = list(files)
    run_rec["files"] = files
    history: list[str] = []
    staged: str | None = None  # basename of the attachment the picker accepted
    done = False

    def fill_next_picker() -> str:
        """Fill an open picker with the next queued file; "" when none is open.

        Returns "ok", "stop" (the picker took a different file) or "" (nothing
        to do). A picker that opens with an empty queue is cancelled, so the
        actor can reach the staged panel and send.
        """
        dialog = find_dialog(cul, args.dialog_app)
        if not dialog:
            return ""
        if not pending:
            cul.call("activate_window", {"window_id": dialog["window_id"]})
            cul.call("press_key", {"key": "Escape"})
            return ""
        path = pending.pop(0)
        if not fill_file_dialog(cul, dialog, path):
            return ""
        nonlocal staged
        staged = os.path.basename(path)
        history.append(f"attached {staged} ({len(pending)} left)")
        print(json.dumps({"dialog": "filled", "file": path, "left": len(pending)},
                         ensure_ascii=False), flush=True)
        target.activate(cul)
        time.sleep(1.0)
        if len(files) == 1 and not check_attachment(cul, target, args, logdir, path):
            print("the picker accepted a different file; stopping", file=sys.stderr)
            return "stop"
        return "ok"
    for step in range(1, args.max_steps + 1):
        # A file picker may be opening right now: the portal cannot capture the
        # parent window while a modal dialog is up, so fill the picker first and
        # only then take the screenshot the model sees.
        image = meta = None
        stopped = False
        for _ in range(6):
            state = fill_next_picker()
            if state == "stop":
                stopped = True
                break
            target.activate(cul)
            try:
                image, meta = target.shot(cul)
                break
            except SystemExit:
                time.sleep(1.0)
        if stopped:
            break
        if image is None:
            print("cannot capture the target window; is a modal dialog stuck?", file=sys.stderr)
            break
        with open(os.path.join(logdir, f"shot-{step:02d}.png"), "wb") as f:
            f.write(image)
        b64 = base64.b64encode(image).decode()
        history_text = "\n".join(history[-6:]) or "(none)"
        system = ACTOR_SYSTEM.format(
            w=meta["width"], h=meta["height"], goal=args.goal,
            plan=json.dumps(plan, ensure_ascii=False), history=history_text,
            files=json.dumps([os.path.basename(f) for f in files], ensure_ascii=False),
            remaining=len(pending), hint=args.hint or "(none)",
        )
        act = None
        for attempt in (700, 1000):
            try:
                act = ask_json(
                    args.act_model,
                    [
                        {"role": "system", "content": system},
                        {
                            "role": "user",
                            "content": [
                                {"type": "text", "text": "Screenshot:"},
                                {
                                    "type": "image_url",
                                    "image_url": {"url": "data:image/png;base64," + b64},
                                },
                            ],
                        },
                    ],
                    attempt,
                )
                break
            except Exception as exc:  # noqa: BLE001
                last = exc
        if act is None:
            print(f"actor failed at step {step}: {last}", file=sys.stderr)
            break

        rec = {"step": step, "action": act}
        with open(os.path.join(logdir, f"step-{step:02d}.json"), "w") as f:
            json.dump(rec, f, ensure_ascii=False, indent=1)
        run_rec["steps"].append(rec)
        print(json.dumps(rec, ensure_ascii=False), flush=True)

        action = (act.get("action") or "").lower()
        if action == "done":
            done = True
            break
        if action == "wait":
            time.sleep(1.5)
            history.append(f"{step}. wait")
            continue
        if DANGEROUS.search(json.dumps(act, ensure_ascii=False)) and not args.allow_dangerous:
            print("refusing a destructive-looking action; pass --allow-dangerous", file=sys.stderr)
            break
        if action == "click" and staged and not args.allow_send:
            print("a file is staged: clicks need --allow-send (the Send button is a click)",
                  file=sys.stderr)
            break

        if action == "click" and args.deny_region and not args.allow_send:
            x1, y1, x2, y2 = args.deny_region
            mx, my = coords(act)
            if x1 <= mx <= x2 and y1 <= my <= y2:
                print("refusing a click in the guarded send region", file=sys.stderr)
                break

        if action == "send":
            if args.expect and args.check_model:
                try:
                    verdict = ask_json(
                        args.check_model,
                        [
                            {"role": "system",
                             "content": (
                                 f'Does the conversation header of this window show '
                                 f'"{args.expect}" as the recipient? Return ONLY JSON '
                                 '{"match": true/false, "seen": "what the header says"}.'
                             )},
                            {"role": "user",
                             "content": [
                                 {"type": "text", "text": "Screenshot:"},
                                 {"type": "image_url", "image_url": {
                                     "url": "data:image/png;base64," +
                                            base64.b64encode(image).decode()}},
                             ]},
                        ],
                        200,
                    )
                except Exception as exc:  # noqa: BLE001
                    verdict = {"match": False, "error": str(exc)[:200]}
                print(json.dumps({"expect": args.expect, "verdict": verdict},
                                 ensure_ascii=False), flush=True)
                if not verdict.get("match"):
                    print("recipient check failed; not sending", file=sys.stderr)
                    break
            if not args.allow_send:
                print("refusing to send without --allow-send (dry run stops here)",
                      file=sys.stderr)
                break


        try:
            if action == "click":
                mx, my = coords(act)
                ax, ay = target.to_click(mx, my, meta, args.coord_space)
                cul.call("click", {"x": ax, "y": ay})
                history.append(f"{step}. click ({act.get('x')},{act.get('y')}) -> {ax},{ay}")
            elif action == "type":
                text = str(act.get("text") or "")
                if not text:
                    history.append(f"{step}. type (empty text, retry)")
                    continue
                if args.type_mode == "paste" and shutil.which("wl-copy"):
                    # ydotool types keycodes, so a Russian layout turns ASCII
                    # into Cyrillic; the clipboard is layout-independent.
                    subprocess.run(["wl-copy"], input=text.encode(), check=False)
                    cul.call("press_key", {"key": "ctrl+v"})
                else:
                    cul.call("type_text", {"text": text})
                history.append(f"{step}. type {text!r}")
            elif action == "send":
                cul.call("press_key", {"key": "Return"})
                history.append(f"{step}. send (Enter pressed)")
            elif action == "press":
                cul.call("press_key", {"key": str(act.get("key") or "Return")})
                history.append(f"{step}. press {act.get('key')}")
            elif action == "scroll":
                mx, my = coords(act)
                ax, ay = target.to_click(mx, my, meta, args.coord_space)
                cul.call(
                    "scroll",
                    {
                        "x": ax, "y": ay,
                        "direction": str(act.get("key") or "down"),
                        "pages": 1,
                    },
                )
                history.append(f"{step}. scroll {act.get('key') or 'down'}")
            else:
                history.append(f"{step}. unknown action {action!r}")
                continue
        except (KeyError, ValueError, urllib.error.URLError) as exc:
            print(f"step {step} failed: {exc}", file=sys.stderr)
            break

        state = fill_next_picker()
        if state == "stop":
            break

        if args.verify_every and step % args.verify_every == 0 and args.check_model:
            target.activate(cul)
            image2, _ = target.shot(cul)
            with open(os.path.join(logdir, f"check-{step:02d}.png"), "wb") as f:
                f.write(image2)
            b64b = base64.b64encode(image2).decode()
            try:
                verdict = ask_json(
                    args.check_model,
                    [
                        {"role": "system", "content": verify_prompt(args.goal)},
                        {
                            "role": "user",
                            "content": [
                                {"type": "text", "text": "Screenshot:"},
                                {
                                    "type": "image_url",
                                    "image_url": {"url": "data:image/png;base64," + b64b},
                                },
                            ],
                        },
                    ],
                    250,
                )
            except Exception as exc:  # noqa: BLE001
                verdict = {"error": str(exc)[:200]}
            rec["verdict"] = verdict
            print(json.dumps({"verdict": verdict}, ensure_ascii=False), flush=True)
            if verdict.get("done"):
                done = True
                break
            if verdict.get("stuck") and args.replan:
                try:
                    plan = ask_json(args.plan_model, plan_prompt(args.goal), 300).get("plan", plan)
                except Exception:  # noqa: BLE001
                    pass

    run_rec["done"] = done
    with open(os.path.join(logdir, "run.json"), "w") as f:
        json.dump(run_rec, f, ensure_ascii=False, indent=1)
    print(json.dumps({"done": done, "log": logdir}, ensure_ascii=False))
    cul.close()
    return 0 if done else 1


AUDIO_EXT = (".flac", ".mp3", ".ogg", ".wav", ".m4a", ".opus", ".ape", ".wv")


def collect_files(args) -> list[str]:
    files: list[str] = list(getattr(args, "file", None) or [])
    for directory in getattr(args, "dir", None) or []:
        for name in sorted(os.listdir(directory)):
            if name.lower().endswith(AUDIO_EXT):
                files.append(os.path.join(directory, name))
    files = [f for f in files if os.path.isfile(f)]
    if not files:
        sys.exit("no attachable files found")
    return files


def batch(args: argparse.Namespace) -> int:
    """Attach and send files one by one, without the model in the loop.

    Telegram sends a staged attachment on Enter, and the paperclip keeps its
    place in the message bar, so the whole batch is two fixed controls and the
    file picker. The model is only used for the recipient check (--expect).
    """
    cul = Cul()
    target = Target(cul, args.app_id, args.title)
    files = collect_files(args)
    stamp = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
    logdir = os.path.join(args.log or "/tmp", f"webstep-batch-{stamp}")
    os.makedirs(logdir, exist_ok=True)
    if not args.allow_send:
        sys.exit("batch sends files: pass --allow-send")

    target.activate(cul)
    image, meta = target.shot(cul)
    if args.expect and args.check_model:
        with open(os.path.join(logdir, "header.png"), "wb") as f:
            f.write(image)
        verdict = ask_json(
            args.check_model,
            [
                {"role": "system",
                 "content": (f'Does the conversation header of this window show '
                             f'"{args.expect}"? Return ONLY JSON '
                             '{"match": true/false, "seen": "..."}.')},
                {"role": "user",
                 "content": [
                     {"type": "text", "text": "Screenshot:"},
                     {"type": "image_url", "image_url": {
                         "url": "data:image/png;base64," + base64.b64encode(image).decode()}},
                 ]},
            ],
            200,
        )
        print(json.dumps({"expect": args.expect, "verdict": verdict}, ensure_ascii=False),
              flush=True)
        if not verdict.get("match"):
            cul.close()
            sys.exit("recipient check failed; nothing sent")

    sent = []
    for idx, path in enumerate(files, 1):
        target.activate(cul)
        ax, ay = target.to_click(
            args.attach_xy[0], args.attach_xy[1], meta, "normalized"
        )
        cul.call("click", {"x": ax, "y": ay})
        dialog = None
        for _ in range(20):
            dialog = find_dialog(cul, args.dialog_app)
            if dialog:
                break
            time.sleep(0.4)
        if not dialog:
            print(f"no file picker for {os.path.basename(path)}", file=sys.stderr)
            break
        if not fill_file_dialog(cul, dialog, path):
            print(f"picker did not close for {os.path.basename(path)}", file=sys.stderr)
            break
        target.activate(cul)
        time.sleep(0.8)
        cul.call("press_key", {"key": "Return"})
        time.sleep(1.2)
        sent.append(path)
        print(json.dumps({"sent": path, "n": idx, "of": len(files)}, ensure_ascii=False),
              flush=True)
        with open(os.path.join(logdir, f"sent-{idx:02d}.json"), "w") as f:
            json.dump({"file": path}, f, ensure_ascii=False)

    cul.close()
    print(json.dumps({"sent_count": len(sent), "of": len(files), "log": logdir},
                     ensure_ascii=False))
    return 0 if len(sent) == len(files) else 1


def shot(args: argparse.Namespace) -> int:
    cul = Cul()
    target = Target(cul, args.app_id, args.title)
    target.activate(cul)
    image, meta = target.shot(cul)
    out = args.out or "/tmp/webstep-shot.png"
    with open(out, "wb") as f:
        f.write(image)
    print(json.dumps({"path": out, "meta": meta}, ensure_ascii=False))
    cul.close()
    return 0


def main() -> int:
    ap = argparse.ArgumentParser(description="Local GUI agent loop (plan/act/verify)")
    sub = ap.add_subparsers(dest="cmd", required=True)

    runp = sub.add_parser("run", help="run the loop towards a goal")
    runp.add_argument("--goal", required=True)
    runp.add_argument("--app-id", default="vivaldi-stable")
    runp.add_argument("--title", default=None)
    runp.add_argument("--max-steps", type=int, default=12)
    runp.add_argument("--act-model", default="gui-owl-4b")
    runp.add_argument("--plan-model", default="qwen3.8-27b-abliterated")
    runp.add_argument("--check-model", default="qwen3-vl-8b-abliterated")
    runp.add_argument("--coord-space", choices=["normalized", "absolute"], default="normalized")
    runp.add_argument("--verify-every", type=int, default=3)
    runp.add_argument("--replan", action="store_true")
    runp.add_argument("--allow-dangerous", action="store_true")
    runp.add_argument("--allow-send", action="store_true",
                      help="permit clicks that send messages (irreversible)")
    runp.add_argument("--file", action="append", default=None,
                      help="file to attach (repeatable); the harness fills the picker")
    runp.add_argument("--dir", action="append", default=None,
                      help="attach every audio file in this directory (repeatable)")
    runp.add_argument("--hint", default=None, help="extra instruction for the actor")
    runp.add_argument("--dialog-app", default="xdg-desktop-portal-gtk")
    runp.add_argument("--type-mode", choices=["paste", "keys"], default="paste",
                      help="paste через буфер (раскладконезависимо) или ydotool")
    runp.add_argument("--expect", default=None,
                      help="recipient name the verifier must see in the header before sending")
    runp.add_argument("--deny-region", default=None,
                      help="x1,y1,x2,y2 (0-1000): clicks there need --allow-send")
    runp.add_argument("--log", default=None)
    runp.set_defaults(func=run)

    batchp = sub.add_parser("batch", help="attach and send files one by one (no model in the loop)")
    batchp.add_argument("--app-id", default="org.telegram.desktop")
    batchp.add_argument("--title", default=None)
    batchp.add_argument("--file", action="append", default=None)
    batchp.add_argument("--dir", action="append", default=None)
    batchp.add_argument("--expect", default=None)
    batchp.add_argument("--check-model", default="qwen3-vl-8b-abliterated")
    batchp.add_argument("--dialog-app", default="xdg-desktop-portal-gtk")
    batchp.add_argument("--attach-xy", default="44,976",
                        help="normalized x,y of the attach control in the chat")
    batchp.add_argument("--allow-send", action="store_true")
    batchp.add_argument("--log", default=None)
    batchp.set_defaults(func=batch)

    shotp = sub.add_parser("shot", help="capture one window (debug)")
    shotp.add_argument("--app-id", default="vivaldi-stable")
    shotp.add_argument("--title", default=None)
    shotp.add_argument("--out", default=None)
    shotp.set_defaults(func=shot)

    args = ap.parse_args()
    if getattr(args, "attach_xy", None):
        try:
            args.attach_xy = tuple(float(v) for v in args.attach_xy.split(","))
            assert len(args.attach_xy) == 2
        except (ValueError, AssertionError):
            ap.error("--attach-xy must be x,y (0-1000)")
    if getattr(args, "deny_region", None):
        try:
            args.deny_region = tuple(float(v) for v in args.deny_region.split(","))
            assert len(args.deny_region) == 4
        except (ValueError, AssertionError):
            ap.error("--deny-region must be x1,y1,x2,y2")
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
