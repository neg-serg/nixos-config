#
# Linux kernel config OVERLAY — deliberate manual tweaks for this host.
# Merged over base.config by localmodconfig.nix (overlay wins).
# Source: H-series notes from the Jul-2026 kernel audit
#   H1  SCX scheduler class (BPF schedulers are gated by SCHED_CLASS_EXT;
#       the short-lived BPF_SCHED symbol does not exist in 7.x)
#   H4  SCHED_DEADLINE — unconditional since 7.3, no Kconfig symbol to set
#   H5  Zen 5 features: AMD PMC / uncore perf (the AMD_PREFERRED_CORE symbol
#       was folded into amd-pstate/PMC in 7.x)
#   H6  AMD PSTATE userspace tuning (CoreCtrl/undervolt)
#   H7  HYPERV guest drivers disabled (bare-metal host); HYPERV_TIMER is a
#       derived def_bool and HYPERV_IOMMU was removed in 7.x, so neither
#       needs a line here
#   H8  eBPF userspace tooling (oryx/aya traffic sniffer): CO-RE needs
#       DEBUG_INFO_BTF, TC classifier attach needs NET_CLS_BPF (and
#       NET_ACT_BPF for the bpf action). pahole is already in nixpkgs
#       kernel build deps, so vmlinux BTF is generated automatically.
#
CONFIG_SCHED_CLASS_EXT=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_NET_CLS_BPF=y
CONFIG_NET_ACT_BPF=y
CONFIG_PERF_EVENTS_AMD_UNCORE=y
CONFIG_X86_AMD_PSTATE_UT=y
# CONFIG_HYPERV is not set
# CONFIG_HYPERV_VTL_MODE is not set
# CONFIG_HYPERV_VMBUS is not set
CONFIG_AMD_PMC=y
# CONFIG_HYPERV_TESTING is not set
#   H9  Gamepads: xpad for XInput devices (8BitDo Ultimate 3mode Xbox,
#       USB 2dc8:2030 — vendor-specific class 255/71/208, needs xpad)
#
CONFIG_JOYSTICK_XPAD=y
#   H10 PlayStation gamepads: DualShock 4 / DualSense / DualSense Edge via
#       hid-playstation, Sixaxis (DS3) + PS Move via hid-sony. Built as
#       modules and pre-loaded at boot — lockKernelModules forbids hotplug.
#
CONFIG_HID_PLAYSTATION=m
CONFIG_PLAYSTATION_FF=y
CONFIG_HID_SONY=m
#   H11 Bluetooth HID: hidp (classic BR/EDR HID profile) + uhid (HID over
#       GATT via bluez) — needed for wireless gamepads/keyboards/mice.
#       BT core is =m, so both are modules pre-loaded at boot.
#
CONFIG_BT_HIDP=m
CONFIG_UHID=m
#   H12 WiFi: MAC80211 stack for the out-of-tree MT7927/MT6639 mt76 driver
#       (cmspam/mt7927-nixos); cfg80211 is already =m in base.
#
CONFIG_MAC80211=m
#   H14 Bluetooth pairing crypto: cmac (AES-CMAC — LE SMP key derivation)
#       and ecc/ecdh (LE Secure Connections). Built-in: lockKernelModules
#       forbids runtime module loading, so pairing fails with "Unable to
#       create CMAC crypto context" otherwise.
#
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_ECC=y
CONFIG_CRYPTO_ECDH=y
#   H13 USB mass storage (card readers / USB sticks / USB SSD enclosures).
#       lockKernelModules forbids hotplug, so these MUST be built-in (=y)
#       instead of modules: base.config has them =m and modules_disabled=1
#       would never load them. Needed to flash router SD cards from trantor.
#
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
#   H15 VFIO device passthrough: iGPU (1002:13c0) + its HDMI audio
#       (1002:1640) go to the dockur Windows VM via vfio-pci
#       (hosts/trantor/hardware.nix binds them in the initrd BEFORE amdgpu
#       using vfio-pci.ids). localmodconfig dropped VFIO entirely (nothing
#       used it when base.config was generated), so re-enable it: core and
#       type1 IOMMU built-in, vfio-pci as a module for initrd preloading.
#       AMD_IOMMU / INTEL_IOMMU / IOMMU_SUPPORT are already =y in base.
#
CONFIG_VFIO=y
CONFIG_VFIO_IOMMU_TYPE1=y
CONFIG_VFIO_PCI=m
CONFIG_VFIO_PCI_VGA=y
#   H16 USB webcam (UVC): uvcvideo driver. Media core (MEDIA_SUPPORT /
#       VIDEO_DEV) is modular in base.config, so the driver cannot be
#       built-in (=y would be demoted to =m by Kconfig). lockKernelModules
#       forbids runtime hotplug loading, so uvcvideo is pre-loaded at boot
#       (hosts/trantor/hardware.nix, boot.kernelModules) and stays resident to
#       bind cameras plugged in later.
#
CONFIG_USB_VIDEO_CLASS=m
#   H17 Bluetooth RFCOMM/SPP: GalaxyBudsClient talks to the Galaxy Buds over
#       the Serial Port Profile, which is RFCOMM-only - without it the app dies
#       with "BlueZ timed out while connecting to profile" (its Linux backend
#       opens an RFCOMM socket to the buds' SPP UUID). localmodconfig dropped
#       RFCOMM because nothing on this box had opened such a socket before, and
#       base.config carries "# CONFIG_BT_RFCOMM is not set", so it is overridden
#       here. Must be =m, not =y - CONFIG_BT is modular (m) and kbuild silently
#       drops the built-in RFCOMM object under a module parent: with "=y" the
#       built vmlinux contained zero rfcomm symbols and the socket stayed
#       EPROTONOSUPPORT. The module is pre-loaded before lockKernelModules
#       (hosts/trantor/hardware/kernel.nix, boot.kernelModules).
#       BT_RFCOMM_TTY additionally exposes /dev/rfcommN (not needed by the app,
#       kept for rfcomm(8)/pppd-style tooling); both only need CONFIG_BT.
#
CONFIG_BT_RFCOMM=m
CONFIG_BT_RFCOMM_TTY=y
#   H18 USB: AMD Promontory 21 (800-series chipset) xHCI. Since 7.2 xhci-pci
#       defers those controllers to xhci-pci-prom21 (PCI IDs 43fc/43fd), so the
#       module is required for this board's chipset USB ports - without it the
#       ports have no driver. nixpkgs' initrd module list names it for kernels
#       >= 7.2, and the initrd closure build fails when the module is missing
#       ("Module xhci_pci_prom21 not found"), so it must exist either way.
#       The hwmon companion is the PROM21 xHCI temperature sensor and is also
#       the Kconfig gate upstream uses (USB_XHCI_PCI_PROM21 defaults to
#       USB_XHCI_PCI only when SENSORS_PROM21_XHCI != n), so stock configs ship
#       both; enabled here to match that default instead of silently losing the
#       chipset sensor. Both are =m: CONFIG_USB_XHCI_PCI is modular.
#
CONFIG_SENSORS_PROM21_XHCI=m
CONFIG_USB_XHCI_PCI_PROM21=m
#   H19 Attack-surface trim (kernel audit follow-up): drop code for hardware
#       this host does not have. localmodconfig only removes *modules* that
#       were never loaded on this machine, and it keeps everything Kconfig
#       marks built-in, so the remaining dead weight is removed here.
#       Everything the host actually uses stays: ahci/ata_piix (chipset SATA),
#       xhci (all USB, incl. the ASM4242), btmtk/btusb (MT6639), hid-generic/
#       usbhid plus Logitech and gamepad drivers, snd-usb-audio (Osmose) and
#       snd-hdspe (RME), the amdgpu RDNA path, nvme/zfs, vfio, i2c-dev.
#
#   H19a Legacy SATA/PATA and non-x86 AHCI controllers (absent hardware; the
#        board's SATA is AHCI and its USB is xHCI-only).
# CONFIG_SATA_VIA is not set
# CONFIG_SATA_SIS is not set
# CONFIG_SATA_NV is not set
# CONFIG_SATA_ULI is not set
# CONFIG_SATA_ACARD_AHCI is not set
# CONFIG_PATA_SIS is not set
# CONFIG_PATA_MARVELL is not set
# CONFIG_SATA_AHCI_PLATFORM is not set
# CONFIG_AHCI_DWC is not set
# CONFIG_AHCI_CEVA is not set
#   H19b USB 1.1/2.0 host controllers: every USB controller on this board is
#        xHCI (AMD chipset, Raphael/Granite Ridge, ASMedia ASM4242).
# CONFIG_USB_OHCI_HCD is not set
# CONFIG_USB_OHCI_HCD_PCI is not set
# CONFIG_USB_UHCI_HCD is not set
# CONFIG_USB_EHCI_HCD is not set
# CONFIG_USB_EHCI_PCI is not set
#   H19c Bluetooth vendor helpers for chips that are not MT6639. BT_BCM and
#        BT_RTL are hidden tristates selected by the btusb sub-options
#        (BT_HCIBTUSB_BCM/RTL, both default y), so those are switched off.
#        BT_INTEL is selected unconditionally by BT_HCIBTUSB itself (btusb is
#        required for MT6639), so it cannot be dropped separately.
# CONFIG_BT_HCIBTUSB_BCM is not set
# CONFIG_BT_HCIBTUSB_RTL is not set
# CONFIG_BT_INTEL_PCIE is not set
#   H19d HID quirk drivers for devices the host does not own (Apple/Cherry/
#        Corsair/Lenovo/Microsoft/Roccat). hid-generic/usbhid and the Logitech
#        + gamepad drivers stay, so unknown HID still enumerates.
# CONFIG_HID_APPLE is not set
# CONFIG_HID_CHERRY is not set
# CONFIG_HID_CORSAIR is not set
# CONFIG_HID_LENOVO is not set
# CONFIG_HID_MICROSOFT is not set
# CONFIG_HID_ROCCAT is not set
#   H19e Legacy USB audio interfaces (UA-101, US-122L, US-X2Y).
# CONFIG_SND_USB_UA101 is not set
# CONFIG_SND_USB_US122L is not set
# CONFIG_SND_USB_USX2Y is not set
#   H19f Media: no TV/radio/SDR tuners and no IR remote; CEC (HDMI, via
#        amdgpu), UVC camera and the Media Controller API stay. The *_SUPPORT
#        switches only get a prompt when MEDIA_SUPPORT_FILTER is on — without
#        it they default to y and the lines below would be ignored, so the
#        filter is enabled first and the keepers are restated.
CONFIG_MEDIA_SUPPORT_FILTER=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_MEDIA_USB_SUPPORT=y
CONFIG_MEDIA_CONTROLLER=y
# CONFIG_MEDIA_TEST_SUPPORT is not set
# CONFIG_MEDIA_ANALOG_TV_SUPPORT is not set
# CONFIG_MEDIA_DIGITAL_TV_SUPPORT is not set
# CONFIG_MEDIA_RADIO_SUPPORT is not set
# CONFIG_MEDIA_SDR_SUPPORT is not set
# CONFIG_MEDIA_PLATFORM_SUPPORT is not set
# CONFIG_MEDIA_PCI_SUPPORT is not set
#   The tuner core (MEDIA_TUNER) and the tuner drivers (E4000/FC2580/MSI001)
#   are hidden symbols gated by the four switched-off *TV/radio/SDR* options
#   above, so they fall away with them.
# CONFIG_RC_CORE is not set
# CONFIG_RC_DEVICES is not set
#   H19g amdgpu: SI/CIK (pre-Polaris GCN) and the laptop ISP block are absent;
#        the RX 9070 XT (Navi 48) runs the standard RDNA path.
# CONFIG_DRM_AMDGPU_SI is not set
# CONFIG_DRM_AMDGPU_CIK is not set
# CONFIG_DRM_AMD_DC_SI is not set
# CONFIG_DRM_AMD_ISP is not set
#   H19h Intel platform glue built into an AMD-only kernel: Intel LPSS,
#        Cherry Trail PMIC and the Intel pinctrl drivers. PINCTRL is kept on
#        explicitly — PINCTRL_AMD (AMD GPIO) sits inside "if PINCTRL" and
#        would otherwise disappear with the LPSS select. IOSF_MBI is NOT
#        listed: INTEL_RAPL_CORE (RAPL power telemetry, in use on this host)
#        selects it, so an "is not set" line would be silently overridden.
# CONFIG_X86_INTEL_LPSS is not set
CONFIG_PINCTRL=y
# CONFIG_INTEL_SOC_PMIC is not set
# CONFIG_INTEL_SOC_PMIC_CHTWC is not set
# CONFIG_INTEL_SOC_PMIC_CHTDC_TI is not set
# CONFIG_PINCTRL_INTEL is not set
# CONFIG_PINCTRL_BAYTRAIL is not set
# CONFIG_PINCTRL_CHERRYVIEW is not set
#   H19i Misc unused code: netkit virtual devices, Moxa/RSA 8250 ports (8250
#        core stays), NVMe in-band authentication and the Intel KVM flavour.
#        INPUT_VIVALDIFMAP is NOT listed: KEYBOARD_ATKBD (in use) selects it,
#        which is also why vivaldi_fmap shows up in lsmod.
# CONFIG_NETKIT is not set
# CONFIG_SERIAL_8250_MOXA_PCIE is not set
# CONFIG_SERIAL_8250_RSA is not set
# CONFIG_NVME_AUTH is not set
# CONFIG_NVME_KEYRING is not set
# CONFIG_NVME_HOST_AUTH is not set
# CONFIG_KVM_INTEL is not set
#   H19j FTP connection-tracking helpers: passive FTP through the br0 NAT
#        needs no helper, and the helpers are a known attack surface.
#        hosts/trantor/networking.nix drops the staged nf_nat_ftp modprobe
#        request that nat.nix adds to every NAT-enabled host.
# CONFIG_NF_CONNTRACK_FTP is not set
# CONFIG_NF_NAT_FTP is not set
#   H20 Type fixes for three base.config lines that kconfig rejects (they are
#       corrected during olddefconfig and only produce warnings today):
#       NETFILTER_NETLINK is a bool (base says "=m"), and the two BOOTPARAM_*
#       panic switches are ints (base says "=n"). The values below match what
#       kconfig already resolves to, so behaviour is unchanged.
CONFIG_NETFILTER_NETLINK=y
CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC=0
CONFIG_BOOTPARAM_HUNG_TASK_PANIC=0
