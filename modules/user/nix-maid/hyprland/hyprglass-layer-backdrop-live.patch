+// The layer namespace filters are parsed from the config values at load and on
+// config.reloaded — but a session that pushes its settings into a running plugin
+// (the config keys only exist once the plugin registered them) never triggers
+// that event. The filters then stay at their empty default, which
+// shouldGlassLayer() reads as "glass every layer". Compare the raw strings on the
+// layer path and re-parse as soon as one of them changed.
+static void refreshLayerNamespaceFilters() {
+    static std::string seenNamespaces, seenExclude, seenPresets, seenThresholds, seenLive, seenModes;
+
+    auto raw = [](StringConfigPtr ptr) { return std::string(readStringConfig(ptr)); };
+
+    const auto& config = g_pGlobalState->config;
+
+    const std::string namespaces = raw(config.layersNamespaces);
+    const std::string exclude    = raw(config.layersExcludeNamespaces);
+    const std::string presets    = raw(config.layersNamespacePresets);
+    const std::string thresholds = raw(config.layersNamespaceMaskThresholds);
+    const std::string live       = raw(config.layersNamespaceLiveResample);
+    const std::string modes      = raw(config.layersNamespaceMaskModes);
+
+    if (namespaces == seenNamespaces && exclude == seenExclude && presets == seenPresets && thresholds == seenThresholds && live == seenLive &&
+        modes == seenModes)
+        return;
+
+    seenNamespaces = namespaces;
+    seenExclude    = exclude;
+    seenPresets    = presets;
+    seenThresholds = thresholds;
+    seenLive       = live;
+    seenModes      = modes;
+
+    parseLayerNamespaceFilters();
+}
