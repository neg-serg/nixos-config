+bool Hy3Node::detached_tree() {
+	for (auto& node: this->ancestors()) {
+		if (node.detached) return true;
+	}
+
+	return false;
+}
+
+Hy3GroupNode* Hy3Node::detached_group() {
+	for (auto& node: this->ancestors()) {
+		if (!node.detached) continue;
+		// A detached window owns its box itself; only a detached group has a float box
+		// for its tabs to share.
+		if (node.is_group()) return &node.as_group();
+		return nullptr;
+	}
+
+	return nullptr;
+}
+
+void Hy3Node::clear_detached() {
+	this->detached = false;
+	if (!this->is_group()) return;
+
+	for (auto& child: this->as_group().children) {
+		child->clear_detached();
+	}
+}
