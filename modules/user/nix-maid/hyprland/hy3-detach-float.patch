+static constexpr std::string_view DETACH_ACTION_HELP = "on/off/toggle";
+
+struct SDetachAction {
+	std::optional<bool> state; // unset = toggle
+	bool valid = true;
+};
+
+static SDetachAction parseDetachArg(std::string_view arg) {
+	if (arg.empty() || arg == "toggle") return {};
+	if (arg == "on" || arg == "true") return {.state = true};
+	if (arg == "off" || arg == "false") return {.state = false};
+	return {.valid = false};
+}
+
+// ion3-style detach: the focused node (a window, or the tab group it lives in)
+// floats above the layout while keeping its slot in it, and the same command
+// reattaches it exactly where it was.
+static SDispatchResult detach(std::optional<bool> state) {
+	auto* hy3 = hy3InstanceForAction();
+	if (!hy3) return SDispatchResult {};
+
+	hy3->detach(hy3->workspace().get(), state);
+	return SDispatchResult {};
+}
+
+static int luaDetach(lua_State* L) {
+	static constexpr const char* FN = "hl.plugin.hy3.detach";
+	luaCheckArgCount(L, FN, 0, 1);
+
+	std::optional<bool> state;
+	if (!lua_isnoneornil(L, 1)) {
+		std::string action;
+		if (lua_istable(L, 1)) {
+			if (auto opt = LuaInternal::tableOptStr(L, 1, "action"); opt) {
+				action = *opt;
+			} else if (auto on = LuaInternal::tableOptBool(L, 1, "on"); on) {
+				state = *on;
+			}
+		} else {
+			action = luaStringArg(L, 1, FN, "action");
+		}
+
+		if (!action.empty()) {
+			auto parsed = parseDetachArg(action);
+			if (!parsed.valid)
+				return luaL_error(
+				    L,
+				    "%s: invalid action '%s' (expected %s)",
+				    FN,
+				    action.c_str(),
+				    DETACH_ACTION_HELP.data()
+				);
+			state = parsed.state;
+		}
+	}
+
+	auto dspDetach = [](lua_State* L) -> int {
+		int mode = static_cast<int>(lua_tointeger(L, lua_upvalueindex(1)));
+		detach(mode < 0 ? std::optional<bool> {} : std::optional<bool> {mode != 0});
+		return 0;
+	};
+
+	lua_pushinteger(L, luaOptionalBoolMode(state));
+	lua_pushcclosure(L, dspDetach, 1);
+	return 1;
+}
+
+static SDispatchResult dispatch_detach(std::string arg) {
+	auto parsed = parseDetachArg(arg);
+	if (!parsed.valid) return SDispatchResult {};
+	return detach(parsed.state);
+}
