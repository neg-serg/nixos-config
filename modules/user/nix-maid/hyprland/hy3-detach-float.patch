+void Hy3Layout::detach(const CWorkspace* workspace, std::optional<bool> state) {
+	auto* node = this->getWorkspaceFocusedNode(workspace);
+	if (node == nullptr || node->is_root()) return;
+
+	// A window inside a tab group is not detached on its own: the frame is the group,
+	// so the whole group floats and its tabs keep behaving like tabs.
+	while (node->is_target() && node->parent != nullptr && node->parent->is_group()
+	       && !node->parent->is_root() && node->parent->as_group().isTab())
+	{
+		node = node->parent.get();
+	}
+
+	this->setNodeDetached(*node, state.value_or(!node->detached));
+}
+
+void Hy3Layout::moveDetachedGroupTab(Hy3GroupNode& group, Hy3Node& tab) {
+	// The visible tab is the frame while detached: remember where it is (the user may
+	// have dragged it) so the tab coming in takes over exactly that place.
+	for (auto& child: group.children) {
+		if (!child->is_target() || !child->valid()) continue;
+
+		auto window = child->as_window();
+		auto target = child->as_target();
+		if (!window || !target || window->isHidden() || !target->floating()) continue;
+
+		group.floatBox = CBox(target->position());
+		break;
+	}
+
+	auto target = tab.as_target();
+	if (!target) return;
+
+	if (!target->floating()) {
+		// The tab was hidden when the group detached, so it never floated: do it now,
+		// at the frame's box.
+		this->floatDetachedWindows(tab, group.floatBox);
+		return;
+	}
+
+	target->setPositionGlobal(group.floatBox);
+}
+
+void Hy3Layout::setNodeDetached(Hy3Node& node, bool detached) {
+	if (node.detached == detached) return;
+	node.assertNotRoot();
+
+	if (!detached) {
+		node.clear_detached();
+		this->tileDetachedWindows(node);
+		this->recalcGeometry();
+		this->updateGroupBorderColors();
+		return;
+	}
+
+	// Float exactly where the window already is: a detach that moved the window would
+	// be indistinguishable from a workspace shuffle.
+	CBox box = node.visualBox;
+	for (auto& window_ref: node.windows(true)) {
+		auto window = window_ref.m_self.lock();
+		if (!window) continue;
+
+		auto target = window->layoutTarget();
+		if (!target) continue;
+
+		box = CBox(target->position());
+		break;
+	}
+
+	// Set before floating: Hyprland calls removeTarget on the way out of the tiled
+	// layer, and that is what has to see the flag and keep the node.
+	node.detached = true;
+	node.floatBox = box;
+	this->floatDetachedWindows(node, box);
+	hy3_log(LOG, "detached node {:x}", (uintptr_t) &node);
+}
+
+void Hy3Layout::floatDetachedWindows(Hy3Node& node, const CBox& box) {
+	for (auto& window_ref: node.windows(true)) {
+		auto window = window_ref.m_self.lock();
+		if (!window) continue;
+
+		auto target = window->layoutTarget();
+		if (!target || target->floating()) continue;
+
+		// changeFloatingMode recentres a window around its remembered floating size, so
+		// that size is set to the detach box first and the position is forced back to it
+		// right after.
+		target->rememberFloatingSize(box.size());
+		g_layoutManager->changeFloatingMode(target);
+		target->setPositionGlobal(box);
+		Desktop::windowState()->raise(window);
+	}
+}
+
+void Hy3Layout::tileDetachedWindows(Hy3Node& node) {
+	for (auto& window_ref: node.windows()) {
+		auto window = window_ref.m_self.lock();
+		if (!window) continue;
+
+		auto target = window->layoutTarget();
+		if (!target || !target->floating()) continue;
+
+		g_layoutManager->changeFloatingMode(target);
+	}
+}
+
+bool Hy3Layout::detachedNodeAlive(Hy3Node& node) {
+	if (!node.valid()) return false;
+
+	auto workspace = this->workspace();
+	if (!workspace) return false;
+
+	for (auto& window_ref: node.windows()) {
+		auto window = window_ref.m_self.lock();
+		if (!window || !window->m_isMapped) continue;
+		if (window->m_workspace == workspace) return true;
+	}
+
+	return false;
+}
+
+Hy3Node* Hy3Layout::findDeadDetachedNode() {
+	if (!this->root) return nullptr;
+
+	std::vector<Hy3Node*> stack {this->root.get()};
+	while (!stack.empty()) {
+		auto* node = stack.back();
+		stack.pop_back();
+
+		if (!node->is_group()) continue;
+
+		for (auto& child: node->as_group().children) {
+			if (child->detached) {
+				if (!this->detachedNodeAlive(*child)) return child.get();
+				continue;
+			}
+
+			stack.push_back(child.get());
+		}
+	}
+
+	return nullptr;
+}
+
+bool Hy3Layout::pruneDetachedNodes() {
+	bool pruned = false;
+
+	// One at a time: dropping a node merges its parent away, which would invalidate
+	// every other candidate found in the same walk.
+	while (auto* dead = this->findDeadDetachedNode()) {
+		hy3_log(LOG, "pruning detached node {:x}: its windows are gone", (uintptr_t) dead);
+		dead->parent->extractAndMerge(*dead, nullptr, CollapsePolicy::InvalidOnly);
+		pruned = true;
+	}
+
+	return pruned;
+}
