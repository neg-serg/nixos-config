         if (event.state == WL_POINTER_BUTTON_STATE_PRESSED) {
+            // Packaged patch (hyprexpo-click-swallow.patch): remember that a press was
+            // seen while the overview was up. The click that *opened* the overview
+            // (panel capsule toggles on the press) leaves an orphan release behind:
+            // its press happened while the overview did not exist yet, so without this
+            // flag that release was read as "the user picked the tile under the panel"
+            // and the overview closed in the same gesture.
+            m_clickPressSeen = true;
+            if (CLICKDEBUG)
