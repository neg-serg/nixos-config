 #include "IOverviewSession.hpp"
 
+#include "HyprlandConfigCompat.hpp"
+
 #include "Overview.hpp"
 #include "ScrollingLayoutAdapter.hpp"
 #include "ScrollingOverview.hpp"
@@ -27,7 +29,21 @@
     static std::atomic<uint64_t> nextGeneration = 1;
     const uint64_t generation = nextGeneration.fetch_add(1, std::memory_order_relaxed);
 
-    const bool detectedScrolling = Hyprexpo::Scrolling::workspaceUsesScrollingLayout(startedOn);
+    // Packaged patch (modules/user/nix-maid/hyprland/hyprexpo-grid-overview.patch).
+    // Upstream routes workspaces that use Hyprland's native scrolling layout to its
+    // scrolling overview (a strip of columns) and everything else to the grid. With
+    // plugin:hyprexpo:grid_overview = 1 the grid is used for every workspace: the
+    // layout itself is untouched, only what the overview draws.
+    // The value has to be read through the fork's own accessor: this file does not
+    // alias HyprlandAPI to CompatHyprlandAPI (only Overview/OverviewRender/
+    // OverviewInteraction.cpp do), so HyprlandAPI::getConfigValue() here is the real
+    // Hyprlang one — and for the plugin's CIntValue registrations its
+    // getDataStaticPtr() returns a pointer to the *value*, not to a pointer. Reading
+    // it as (**ptr) took the compositor down with a SEGV in this very function
+    // (+0xc2) the moment the overview was opened; reproduced in a nested 0.56.2 with
+    // a scrolling-layout workspace and fixed by going through intValue() below.
+    const bool forceGrid         = CompatHyprlandAPI::intValue("plugin:hyprexpo:grid_overview") != 0;
+    const bool detectedScrolling = !forceGrid && Hyprexpo::Scrolling::workspaceUsesScrollingLayout(startedOn);
     if (detectedScrolling) {
         const auto snapshot = Hyprexpo::Scrolling::snapshotWorkspace(startedOn);
         const bool emptyScrolling = startedOn && startedOn->getWindowCount() <= 0 && snapshot.failure == Hyprexpo::Scrolling::ESnapshotFailure::MissingScrollingData;
