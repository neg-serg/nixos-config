+                        action.name(),
+                        built
+                            .chords_for(keymap::BindMode::Normal, action)
+                            .join(" / ")
+                    );
+                }
+            }
+            app.keymap = built;
+        }
+        Err(err) => config_errors.push(format!("keys: {err}")),
+    }
