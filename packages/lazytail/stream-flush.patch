+/// Move every complete line out of `pending` into `batch`; `flush_tail` also
+/// takes the trailing partial line (only correct at end of stream).
+fn drain_lines(pending: &mut Vec<u8>, batch: &mut Vec<String>, flush_tail: bool) {
+    while let Some(pos) = pending.iter().position(|&byte| byte == b'\n') {
+        let mut line: Vec<u8> = pending.drain(..=pos).collect();
+        line.pop(); // the newline itself
+        if line.last() == Some(&b'\r') {
+            line.pop();
+        }
+        batch.push(String::from_utf8_lossy(&line).into_owned());
+    }
+    if flush_tail && !pending.is_empty() {
+        let line = std::mem::take(pending);
+        batch.push(String::from_utf8_lossy(&line).into_owned());
+    }
+}
