From f1f1023dab20bde9ce54d33a5581b6863bcbcef4 Mon Sep 17 00:00:00 2001
From: agent <agent@local>
Date: Wed, 14 Oct 2026 12:02:57 +0300
Subject: [PATCH] cli: resolve bare git work-tree paths as git+file and hide
 pure-only builtins

---
 src/expr/eval/tests/io_fetch.zig   | 97 +++++++++++++++++++++++++++++-
 src/expr/evaluator.zig             | 10 ++-
 src/expr/vm/builtins/flake_ref.zig | 27 +++++++++
 src/runtime/builtins.zig           | 29 +++++----
 4 files changed, 147 insertions(+), 16 deletions(-)

diff --git a/src/expr/eval/tests/io_fetch.zig b/src/expr/eval/tests/io_fetch.zig
index 168475e..affae6f 100644
--- a/src/expr/eval/tests/io_fetch.zig
+++ b/src/expr/eval/tests/io_fetch.zig
@@ -587,6 +587,70 @@ test "parseFlakeRef handles github refs without a branch and bare absolute paths
     try std.testing.expectEqualStrings("\"{\\\"path\\\":\\\"/tmp/source\\\",\\\"type\\\":\\\"path\\\"}\"", bare_absolute_path);
 }
 
+/// `renderWithFlakes` plus a file-cache io handle, optionally with store writes
+/// enabled — the flag that makes a bare local path resolve like Nix's
+/// git-backed flake ref instead of a plain directory copy.
+fn renderWithFlakesAndFileIo(source: []const u8, store_writes: bool) ![]u8 {
+    var ev = try Engine.init(std.testing.allocator, .{ .worker_count = 0 });
+    defer ev.deinit();
+    ev.setFileIo(std.testing.io);
+    ev.policy.flakes_enabled = true;
+    if (store_writes) ev.enableStoreWrites();
+
+    const result = try ev.evaluate(source);
+
+    var out: std.Io.Writer.Allocating = .init(std.testing.allocator);
+    defer out.deinit();
+
+    try ev.writeValue(&out.writer, result);
+    return out.toOwnedSlice();
+}
+
+test "a bare path that is a git work-tree root resolves as a git ref" {
+    var tmp = std.testing.tmpDir(.{});
+    defer tmp.cleanup();
+    const cwd = try std.process.currentPathAlloc(std.testing.io, std.testing.allocator);
+    defer std.testing.allocator.free(cwd);
+    const dir = try std.fs.path.resolve(std.testing.allocator, &.{ cwd, ".zig-cache", "tmp", &tmp.sub_path });
+    defer std.testing.allocator.free(dir);
+
+    // A `.git` entry (a directory in a normal checkout, a file in a linked
+    // work tree or submodule) is what makes the directory a work-tree root.
+    try tmp.dir.writeFile(std.testing.io, .{ .sub_path = ".git", .data = "gitdir: /tmp/worktree\n" });
+
+    const bare = try std.fmt.allocPrint(std.testing.allocator, "builtins.toJSON (builtins.parseFlakeRef \"{s}\")", .{dir});
+    defer std.testing.allocator.free(bare);
+
+    // Store writes on: like Nix, the flake source is the git snapshot.
+    const with_writes = try renderWithFlakesAndFileIo(bare, true);
+    defer std.testing.allocator.free(with_writes);
+    try std.testing.expect(std.mem.indexOf(u8, with_writes, "\\\"type\\\":\\\"git\\\"") != null);
+    try std.testing.expect(std.mem.indexOf(u8, with_writes, "file://") != null);
+
+    // Plain eval (no store writes): the local directory is read in place.
+    const without_writes = try renderWithFlakesAndFileIo(bare, false);
+    defer std.testing.allocator.free(without_writes);
+    try std.testing.expect(std.mem.indexOf(u8, without_writes, "\\\"type\\\":\\\"path\\\"") != null);
+
+    // An explicit `path:` ref stays a directory copy in both modes (Nix copies
+    // those verbatim), and so does a directory that is not a work-tree root.
+    const explicit = try std.fmt.allocPrint(std.testing.allocator, "builtins.toJSON (builtins.parseFlakeRef \"path:{s}\")", .{dir});
+    defer std.testing.allocator.free(explicit);
+    const explicit_with_writes = try renderWithFlakesAndFileIo(explicit, true);
+    defer std.testing.allocator.free(explicit_with_writes);
+    try std.testing.expect(std.mem.indexOf(u8, explicit_with_writes, "\\\"type\\\":\\\"path\\\"") != null);
+
+    var plain_tmp = std.testing.tmpDir(.{});
+    defer plain_tmp.cleanup();
+    const plain_dir = try std.fs.path.resolve(std.testing.allocator, &.{ cwd, ".zig-cache", "tmp", &plain_tmp.sub_path });
+    defer std.testing.allocator.free(plain_dir);
+    const plain = try std.fmt.allocPrint(std.testing.allocator, "builtins.toJSON (builtins.parseFlakeRef \"{s}\")", .{plain_dir});
+    defer std.testing.allocator.free(plain);
+    const plain_with_writes = try renderWithFlakesAndFileIo(plain, true);
+    defer std.testing.allocator.free(plain_with_writes);
+    try std.testing.expect(std.mem.indexOf(u8, plain_with_writes, "\\\"type\\\":\\\"path\\\"") != null);
+}
+
 test "parseFlakeRef rejects malformed refs" {
     try std.testing.expectError(error.InvalidFlakeRef, renderWithFlakes("builtins.parseFlakeRef \"github:NixOS\""));
     try std.testing.expectError(error.InvalidFlakeRef, renderWithFlakes("builtins.parseFlakeRef \"relative/path\""));
@@ -1119,9 +1183,14 @@ test "pure evaluation sandboxes env, out-of-tree reads, search paths, and unlock
     try std.testing.expectEqualStrings("INSIDE", ev.intern.get(in_val.asInternId()));
     try std.testing.expectError(error.RestrictedInPureEval, ev.evaluate("builtins.readFile \"/etc/hostname\""));
 
-    // currentSystem / currentTime are unavailable in pure eval.
-    try std.testing.expectError(error.RestrictedInPureEval, ev.evaluate("builtins.currentSystem"));
-    try std.testing.expectError(error.RestrictedInPureEval, ev.evaluate("builtins.currentTime"));
+    // currentSystem / currentTime are absent from `builtins` in pure eval
+    // (Nix parity): the attrset probe is false — so flake-compat guards
+    // (`!builtins ? currentSystem || …`) take the explicit-`system` branch —
+    // and a direct access fails as a missing attribute.
+    const has_current = try ev.evaluate("builtins ? currentSystem");
+    try std.testing.expect(!has_current.asBool());
+    try std.testing.expectError(error.MissingAttribute, ev.evaluate("builtins.currentSystem"));
+    try std.testing.expectError(error.MissingAttribute, ev.evaluate("builtins.currentTime"));
 
     // Search-path lookups and unlocked fetches are forbidden — but the
     // synthetic corepkgs `<nix/fetchurl.nix>` stays importable (it resolves to
@@ -1142,6 +1211,28 @@ test "pure evaluation sandboxes env, out-of-tree reads, search paths, and unlock
     }
 }
 
+test "setPureEval rebuilds the builtins attrset" {
+    // The attrset can be built before the policy settles (the CLI resolves
+    // flake refs first), so flipping purity must rebuild it — otherwise the
+    // pure-only omission of currentSystem/currentTime never takes effect and
+    // `builtins ? currentSystem` stays true in pure eval.
+    var ev = try Engine.init(std.testing.allocator, .{ .worker_count = 0 });
+    defer ev.deinit();
+    ev.setFileIo(std.testing.io);
+
+    const impure_has = try ev.evaluate("builtins ? currentSystem");
+    try std.testing.expect(impure_has.asBool());
+
+    try ev.setPureEval(true, &.{});
+    const pure_has = try ev.evaluate("builtins ? currentSystem");
+    try std.testing.expect(!pure_has.asBool());
+    try std.testing.expectError(error.MissingAttribute, ev.evaluate("builtins.currentSystem"));
+
+    try ev.setPureEval(false, &.{});
+    const back = try ev.evaluate("builtins ? currentSystem");
+    try std.testing.expect(back.asBool());
+}
+
 test "flake builtins are gated on the flakes experimental feature" {
     // getFlake / parseFlakeRef / flakeRefToString are hard-gated (uncatchable
     // by tryEval), like Nix. Without the feature they error before doing work.
diff --git a/src/expr/evaluator.zig b/src/expr/evaluator.zig
index 1ac6f50..e66719b 100644
--- a/src/expr/evaluator.zig
+++ b/src/expr/evaluator.zig
@@ -848,6 +848,14 @@ pub const Engine = struct {
         self.pure_eval_roots = replacement;
         self.policy.pure_eval = pure;
         self.policy.allowed_path_roots = self.pure_eval_roots;
+        // `builtins` is purity-sensitive: pure eval omits `currentSystem` /
+        // `currentTime` (Nix parity, so `builtins ? currentSystem` is false).
+        // The attrset may already exist — the CLI resolves flake refs before
+        // it settles the policy — so drop the cache and let the next
+        // `ensureBuiltins` rebuild it against the final policy. Bootstrap
+        // objects stay pinned for the eval's lifetime, so the stale attrset
+        // cannot be collected while an old reference is still live.
+        self.builtins_value = null;
     }
 
     pub fn languagePolicy(self: *const Engine) LanguagePolicy {
@@ -3300,7 +3308,7 @@ pub const Engine = struct {
         try self.heap.ensureEmptySingletons();
         const nix_path = try self.sources.search_paths.toNixPath(self.allocator);
         defer self.allocator.free(nix_path);
-        const value = try builtins.buildAttrSet(&self.intern, &self.heap, nix_path, self.store.realization.store_dir);
+        const value = try builtins.buildAttrSet(&self.intern, &self.heap, nix_path, self.store.realization.store_dir, self.policy.pure_eval);
         self.builtins_value = value;
         return value;
     }
diff --git a/src/expr/vm/builtins/flake_ref.zig b/src/expr/vm/builtins/flake_ref.zig
index 9dc7021..6e1f089 100644
--- a/src/expr/vm/builtins/flake_ref.zig
+++ b/src/expr/vm/builtins/flake_ref.zig
@@ -14,6 +14,14 @@ const appendStringAttr = arguments.appendStringAttr;
 const optionalStringAttr = arguments.optionalStringAttr;
 const requiredStringAttr = arguments.requiredStringAttr;
 
+/// The root of a git work tree: a `.git` entry, either a directory in a
+/// normal checkout or a file in a linked work tree / submodule.
+fn isWorkTreeRoot(self: *VM, path: []const u8) bool {
+    const dot_git = std.fs.path.join(self.allocator, &.{ path, ".git" }) catch return false;
+    defer self.allocator.free(dot_git);
+    return self.files.pathExists(dot_git) catch false;
+}
+
 /// A 40-char lowercase-hex git revision (as opposed to a branch/tag `ref`).
 fn looksLikeGitRev(text: []const u8) bool {
     if (text.len != 40) return false;
@@ -90,6 +98,25 @@ pub fn parse(self: *VM, arg: Value) !Value {
         return Value.attrs(try self.heap.addAttrs(entries.items));
     }
     if (std.fs.path.isAbsolute(base)) {
+        // Nix resolves a bare path that is a git work tree as `git+file`, so
+        // the flake sees the work tree's tracked snapshot — uncommitted
+        // tracked edits included, `.git` and untracked files excluded — and
+        // not the raw directory. Mirror that whenever the tree is written to
+        // the store (`instantiate`/`build`/`switch`): a raw-directory copy
+        // pulls repository junk (build outputs, caches, `.git`) into the
+        // store and can trip the file-size guard on large untracked blobs.
+        // Plain `eval` keeps evaluating the local directory in place, where
+        // relative imports already resolve without a store round trip.
+        // Explicit `path:` refs stay `path` in both modes (Nix copies those
+        // verbatim), as does a path that is not a work-tree root.
+        if (self.realization.storeWritesEnabled() and isWorkTreeRoot(self, base)) {
+            const url = try std.fmt.allocPrint(self.allocator, "file://{s}", .{base});
+            defer self.allocator.free(url);
+            try appendStringAttr(self, &entries, "type", "git");
+            try appendStringAttr(self, &entries, "url", url);
+            try appendQueryAttrs(self, &entries, query);
+            return Value.attrs(try self.heap.addAttrs(entries.items));
+        }
         try appendStringAttr(self, &entries, "type", "path");
         try appendStringAttr(self, &entries, "path", base);
         try appendQueryAttrs(self, &entries, query);
