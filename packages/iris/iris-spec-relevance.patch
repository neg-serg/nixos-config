+
 // Register adds a new spec to the global Registry
 // example: Register(&Spec{Name: "git"})
 func Register(s *Spec) {
+	if onlyOS, restricted := platformOnlySpecs[s.Name]; restricted && runtime.GOOS != onlyOS {
+		return
+	}
