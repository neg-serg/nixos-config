--- a/spec/lookup_relevance_test.go
+++ b/spec/lookup_relevance_test.go
@@ -0,0 +1,62 @@
+package spec
+
+import (
+	"runtime"
+	"testing"
+)
+
+// The relevance filter in topLevelSuggestions hides specs whose binary is not
+// on PATH. Upstream tests register fake commands (git, nvim, cat), so pin them
+// here; scanExternalCommands merges into pathCmds instead of replacing it, so
+// these entries survive the real PATH scan.
+func init() {
+	for _, name := range []string{"git", "nvim", "cat"} {
+		pathCmds[name] = true
+	}
+}
+
+func TestRegisterSkipsOtherPlatforms(t *testing.T) {
+	old := Registry
+	ResetRegistry()
+	defer func() { Registry = old }()
+
+	Register(&Spec{Name: "dscl", Description: "macOS-only helper"})
+	Register(&Spec{Name: "git", Description: "cross-platform"})
+
+	if runtime.GOOS != "darwin" {
+		if _, ok := Registry["dscl"]; ok {
+			t.Fatalf("dscl must not be registered on %s", runtime.GOOS)
+		}
+	}
+	if _, ok := Registry["git"]; !ok {
+		t.Fatal("git must stay registered")
+	}
+}
+
+func TestTopLevelSuggestionsKeepOnlyRunnable(t *testing.T) {
+	old := Registry
+	ResetRegistry()
+	defer func() { Registry = old }()
+
+	Register(&Spec{Name: "git", Description: "installed command"})
+	Register(&Spec{Name: "chezmoi", Description: "not installed"})
+	Register(&Spec{Name: "cd", Description: "shell builtin"})
+	Register(&Spec{Name: "dscacheutil", Description: "macOS-only helper"})
+
+	got := make(map[string]bool)
+	for _, s := range topLevelSuggestions("", nil, nil) {
+		got[s.Cmd] = true
+	}
+	if !got["git"] {
+		t.Error("installed command must be suggested")
+	}
+	if !got["cd"] {
+		t.Error("shell builtin must be suggested")
+	}
+	if got["chezmoi"] {
+		t.Error("spec without a binary on PATH must be hidden")
+	}
+	if runtime.GOOS != "darwin" && got["dscacheutil"] {
+		t.Error("spec for another platform must not reach the menu")
+	}
+}
