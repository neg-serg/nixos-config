+/**
+ * lusty fuzzy matcher — C++ port of the lusty-fuzzy crate.
+ *
+ * Source of truth: the lusty repo, crates/lusty-fuzzy (scorer.rs, rank.rs,
+ * layout.rs). The launcher uses it instead of the fzf v2 scorer so that the
+ * pickers, the quickshell tray and vicinae rank with one algorithm; the numeric
+ * semantics are pinned by golden vectors from `lusty --fuzzy-vectors`
+ * (see the "golden vectors" test cases in tests/main.cpp).
+ *
+ * Differences from fzf's scorer, on purpose:
+ *   - fzy-style scoring with the crate's weights (leading penalty, inner gap,
+ *     consecutive bonus, boundary bonuses) instead of fzf's integer scheme;
+ *   - byte-based matching with ASCII-only lowering, exactly like the crate, so
+ *     spans are byte ranges and a Latin query never matches Cyrillic text by
+ *     accident of Unicode folding — except when folding is requested
+ *     (scoreWeightedFold), which mirrors the crate's RankOpts::fold_case;
+ *   - a query typed in the RU layout is also read as its EN characters and the
+ *     better reading wins (crate's Layout::RuToEnFallback);
+ *   - no first-letter anchor: a menu/launcher is searched by any word in it.
+ */
+#pragma once
+
+#include "fuzzy/normalize.hpp"
+
+#include <algorithm>
+#include <cmath>
+#include <cstddef>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace lusty {
+
+// Kept in sync with the crate: bump together with the golden vectors.
+constexpr int WEIGHTS_VERSION = 1;
+
+constexpr double LEADING_PENALTY = 0.012; // per skipped byte before the first match
+constexpr double INNER_GAP = 0.02;        // per skipped byte between two matches
+constexpr double CONSECUTIVE_BONUS = 0.05;
+
+struct Span {
+  std::size_t begin = 0;
+  std::size_t end = 0; // exclusive, byte offsets
+};
+
+struct MatchResult {
+  double score = 0.0;
+  std::vector<Span> spans;
+};
+
+namespace detail {
+
+inline bool isAsciiDigit(char c) { return c >= '0' && c <= '9'; }
+
+inline double bonusFor(std::string_view raw, std::size_t i) {
+  if (i == 0) return 0.9;
+  char const ch = raw[i];
+  if (ch == '/') return 0.9;
+  char const prev = raw[i - 1];
+  if (prev == '-' || prev == '_' || prev == ' ' || prev == '.') return 0.8;
+  if (prev == '/') return 0.9;
+  if (prev >= 'a' && prev <= 'z' && ch >= 'A' && ch <= 'Z') return 0.7; // camelCase
+  return 0.0;
+}
+
+inline std::vector<unsigned char> asciiLowered(std::string_view s) {
+  std::vector<unsigned char> out(s.size());
+  for (std::size_t i = 0; i < s.size(); ++i) {
+    auto const c = static_cast<unsigned char>(s[i]);
+    out[i] = (c >= 'A' && c <= 'Z') ? static_cast<unsigned char>(c + 32) : c;
+  }
+  return out;
+}
+
+inline bool hasMatch(const std::vector<unsigned char> &hay, const std::vector<unsigned char> &needle) {
+  std::size_t a = 0, b = 0;
+  while (a < needle.size() && b < hay.size()) {
+    if (needle[a] == hay[b]) ++a;
+    ++b;
+  }
+  return a == needle.size();
+}
+
+} // namespace detail
+
+/// Subsequence check with the crate's byte semantics (ASCII-case-insensitive).
+inline bool matches(std::string_view label, std::string_view query) {
+  if (query.empty()) return true;
+  if (query.size() > label.size()) return false;
+  return detail::hasMatch(detail::asciiLowered(label), detail::asciiLowered(query));
+}
+
+/// Score plus the coalesced byte spans of the winning alignment.
+inline MatchResult scoreWithSpans(std::string_view label, std::string_view query) {
+  if (query.empty()) return {.score = 0.75, .spans = {}}; // neutral score, like the crate
+
+  auto const hay = detail::asciiLowered(label);
+  auto const needle = detail::asciiLowered(query);
+  if (needle.size() > hay.size() || !detail::hasMatch(hay, needle)) return {};
+
+  std::size_t const m = hay.size();
+  std::size_t const n = needle.size();
+  double const neg = -std::numeric_limits<double>::infinity();
+  constexpr std::size_t CONSEC = static_cast<std::size_t>(-1);
+
+  std::vector<std::vector<double>> dp(n + 1, std::vector<double>(m + 1, neg));
+  std::vector<std::vector<std::size_t>> pred(n + 1, std::vector<std::size_t>(m + 1, CONSEC));
+
+  for (std::size_t i = 1; i <= n; ++i) {
+    double bestGap = neg;
+    std::size_t bestGapK = 0;
+    for (std::size_t j = 1; j <= m; ++j) {
+      double scoreJ = neg;
+      if (needle[i - 1] == hay[j - 1]) {
+        double const bon = detail::bonusFor(label, j - 1);
+        if (i == 1) {
+          scoreJ = bon - LEADING_PENALTY * static_cast<double>(j - 1);
+        } else {
+          double cand = neg;
+          bool fromGap = false;
+          if (std::isfinite(dp[i - 1][j - 1])) cand = dp[i - 1][j - 1] + CONSECUTIVE_BONUS;
+          if (std::isfinite(bestGap)) {
+            double const viaGap = bestGap - INNER_GAP * static_cast<double>(j - 1);
+            if (viaGap > cand) {
+              cand = viaGap;
+              fromGap = true;
+            }
+          }
+          if (std::isfinite(cand)) {
+            scoreJ = cand + bon;
+            pred[i][j] = fromGap ? bestGapK : CONSEC;
+          }
+        }
+      }
+      dp[i][j] = scoreJ;
+      if (std::isfinite(dp[i - 1][j])) {
+        double const withK = dp[i - 1][j] + INNER_GAP * static_cast<double>(j);
+        if (withK > bestGap) {
+          bestGap = withK;
+          bestGapK = j;
+        }
+      }
+    }
+  }
+
+  // First maximum in the last row, exactly like the crate.
+  double best = neg;
+  std::size_t bestJ = 0;
+  for (std::size_t j = 1; j <= m; ++j) {
+    if (std::isfinite(dp[n][j]) && dp[n][j] > best) {
+      best = dp[n][j];
+      bestJ = j;
+    }
+  }
+  if (!std::isfinite(best)) return {};
+
+  std::vector<std::size_t> matched;
+  matched.reserve(n);
+  std::size_t i = n, j = bestJ;
+  while (i >= 1) {
+    matched.push_back(j - 1);
+    if (i == 1) break;
+    if (pred[i][j] == CONSEC) {
+      --i;
+      --j;
+    } else {
+      j = pred[i][j];
+      --i;
+    }
+  }
+  std::reverse(matched.begin(), matched.end());
+
+  std::vector<Span> spans;
+  for (std::size_t const pos : matched) {
+    if (!spans.empty() && spans.back().end == pos) {
+      spans.back().end = pos + 1;
+    } else {
+      spans.push_back({.begin = pos, .end = pos + 1});
+    }
+  }
+  return {.score = best, .spans = std::move(spans)};
+}
+
+/// Hot path: score only, no backtracking (mirrors the crate's Scorer::score).
+inline double score(std::string_view label, std::string_view query) {
+  if (query.empty()) return 0.75;
+  auto const hay = detail::asciiLowered(label);
+  auto const needle = detail::asciiLowered(query);
+  if (needle.size() > hay.size() || !detail::hasMatch(hay, needle)) return 0.0;
+
+  std::size_t const m = hay.size();
+  std::size_t const n = needle.size();
+  double const neg = -std::numeric_limits<double>::infinity();
+  std::vector<double> prev(m + 1, neg), cur(m + 1, neg);
+  double best = neg;
+
+  for (std::size_t i = 1; i <= n; ++i) {
+    double bestGap = neg;
+    for (std::size_t j = 1; j <= m; ++j) {
+      double scoreJ = neg;
+      if (needle[i - 1] == hay[j - 1]) {
+        double const bon = detail::bonusFor(label, j - 1);
+        if (i == 1) {
+          scoreJ = bon - LEADING_PENALTY * static_cast<double>(j - 1);
+        } else {
+          double cand = neg;
+          if (std::isfinite(prev[j - 1])) cand = prev[j - 1] + CONSECUTIVE_BONUS;
+          if (std::isfinite(bestGap)) {
+            double const viaGap = bestGap - INNER_GAP * static_cast<double>(j - 1);
+            if (viaGap > cand) cand = viaGap;
+          }
+          if (std::isfinite(cand)) scoreJ = cand + bon;
+        }
+      }
+      cur[j] = scoreJ;
+      if (std::isfinite(scoreJ) && i == n && scoreJ > best) best = scoreJ;
+      if (std::isfinite(prev[j])) {
+        double const withK = prev[j] + INNER_GAP * static_cast<double>(j);
+        if (withK > bestGap) bestGap = withK;
+      }
+    }
+    std::swap(prev, cur);
+  }
+  return std::isfinite(best) ? best : 0.0;
+}
+
+// ── RU (йцукен) → EN, mirrored from layout.rs ────────────────────────────────
+
+/// The physical key a Cyrillic letter sits on, in EN: 'щ' → 'o' and so on.
+inline std::optional<char> ruToEn(char32_t c) {
+  switch (c) {
+  case U'й': return 'q';
+  case U'ц': return 'w';
+  case U'у': return 'e';
+  case U'к': return 'r';
+  case U'е': return 't';
+  case U'н': return 'y';
+  case U'г': return 'u';
+  case U'ш': return 'i';
+  case U'щ': return 'o';
+  case U'з': return 'p';
+  case U'х': return '[';
+  case U'ъ': return ']';
+  case U'ф': return 'a';
+  case U'ы': return 's';
+  case U'в': return 'd';
+  case U'а': return 'f';
+  case U'п': return 'g';
+  case U'р': return 'h';
+  case U'о': return 'j';
+  case U'л': return 'k';
+  case U'д': return 'l';
+  case U'ж': return ';';
+  case U'э': return '\'';
+  case U'я': return 'z';
+  case U'ч': return 'x';
+  case U'с': return 'c';
+  case U'м': return 'v';
+  case U'и': return 'b';
+  case U'т': return 'n';
+  case U'ь': return 'm';
+  case U'б': return ',';
+  case U'ю': return '.';
+  default: return std::nullopt;
+  }
+}
+
+/// One typed character → the EN character it stands for, or nullopt when the
+/// character is not a printable ASCII query character. Uppercase RU (Shift) maps
+/// to uppercase EN so case-insensitive matching still sees the letter.
+inline std::optional<char> normalizeQueryChar(char32_t c) {
+  char32_t lower = c;
+  if (c >= U'A' && c <= U'Z') {
+    lower = c + 0x20;
+  } else if (c >= U'А' && c <= U'Я') { // А-Я
+    lower = c + 0x20;
+  } else if (c == U'Ё') {
+    lower = U'ё';
+  }
+
+  char mapped = 0;
+  if (auto const en = ruToEn(lower)) {
+    mapped = *en;
+  } else if (lower <= 0x7f) {
+    mapped = static_cast<char>(lower);
+  } else {
+    return std::nullopt;
+  }
+
+  if (c != lower && mapped >= 'a' && mapped <= 'z') { mapped = static_cast<char>(mapped - 32); }
+  auto const uc = static_cast<unsigned char>(mapped);
+  if ((uc >= 33 && uc <= 126) || mapped == ' ') return mapped;
+  return std::nullopt;
+}
+
+inline std::string normalizeQuery(std::string_view query) {
+  std::string out;
+  out.reserve(query.size());
+  for (std::size_t i = 0; i < query.size();) {
+    auto const [cp, len] = fzf::decodeUtf8(query, i);
+    i += static_cast<std::size_t>(len);
+    if (auto const mapped = normalizeQueryChar(cp)) { out.push_back(*mapped); }
+  }
+  return out;
+}
+
+/// Field with a weight, mirroring the launcher's own title/subtitle/alias/keywords
+/// weighting (vicinae used the same shape for fzf's scorer).
+struct WeightedField {
+  std::string_view text;
+  double weight = 1.0;
+};
+
+namespace detail {
+
+inline double scoreBest(std::vector<WeightedField> const &fields, std::string_view query) {
+  bool const hasCyrillic = std::any_of(query.begin(), query.end(), [](char c) {
+    return static_cast<unsigned char>(c) >= 0x80;
+  });
+  std::string const mapped = hasCyrillic ? normalizeQuery(query) : std::string{};
+  bool const mappedIsAscii = !mapped.empty() && std::all_of(mapped.begin(), mapped.end(), [](char c) {
+    return static_cast<unsigned char>(c) < 0x80;
+  });
+
+  double best = 0.0;
+  for (auto const &field : fields) {
+    double fieldScore = score(field.text, query) * field.weight;
+    // A query typed in the RU layout is also read as its EN characters; the
+    // better reading wins (crate's Layout::RuToEnFallback merge).
+    if (mappedIsAscii && mapped != query) {
+      fieldScore = std::max(fieldScore, score(field.text, mapped) * field.weight);
+    }
+    best = std::max(best, fieldScore);
+  }
+  return best;
+}
+
+} // namespace detail
+
+/// Score several fields and keep the best weighted match, so a title hit always
+/// beats a subtitle hit (the launcher's fields: title/alias 1.0, subtitle 0.5,
+/// keywords 0.3 — same weights the fzf-based scorer used).
+inline double scoreWeighted(std::vector<WeightedField> const &fields, std::string_view query) {
+  return detail::scoreBest(fields, query);
+}
+
+} // namespace lusty
