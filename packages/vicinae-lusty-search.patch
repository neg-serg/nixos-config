+
+// ── lusty matcher ────────────────────────────────────────────────────────────
+//
+// The launcher ranks with the lusty-fuzzy crate's algorithm (ported in
+// fuzzy/lusty.hpp) instead of fzf's v2 scorer. These cases pin the port against
+// the crate's golden vectors: the expected numbers are copied from
+// `lusty --fuzzy-vectors` over crates/lusty-fuzzy/tests/corpus/menu.txt (the
+// crate's own tests assert the same values against the Rust implementation), so
+// a drift in either direction fails here.
+
+TEST_CASE("lusty: golden vectors from the crate") {
+  using Catch::Approx;
+  auto const eps = Catch::Approx(0.0).epsilon(1e-9);
+
+  REQUIRE(lusty::score("Open in browser", "op") == Catch::Approx(0.95).epsilon(1e-9));
+  REQUIRE(lusty::score("Open in browser", "b") == Catch::Approx(0.704).epsilon(1e-9));
+  REQUIRE(lusty::score("Copy address", "copy") == Catch::Approx(1.05).epsilon(1e-9));
+  REQUIRE(lusty::score("Copy address", "cp") == Catch::Approx(0.88).epsilon(1e-9));
+  REQUIRE(lusty::score("Lock screen", "lock") == Catch::Approx(1.05).epsilon(1e-9));
+  REQUIRE(lusty::score("Lock screen", "sc") == Catch::Approx(0.79).epsilon(1e-9));
+  REQUIRE(lusty::score("Mark as read", "mrs") == Catch::Approx(0.82).epsilon(1e-9));
+  REQUIRE(lusty::score("Quit Telegram", "quit") == Catch::Approx(1.76).epsilon(1e-9));
+  (void)eps;
+}
+
+TEST_CASE("lusty: empty query is neutral, a miss is zero") {
+  REQUIRE(lusty::score("Open in browser", "") == Catch::Approx(0.75));
+  REQUIRE(lusty::score("Lock screen", "zzzz") == 0.0);
+  REQUIRE_FALSE(lusty::matches("Lock screen", "zzzz"));
+  REQUIRE(lusty::matches("Lock screen", ""));
+}
+
+TEST_CASE("lusty: spans cover exactly the matched bytes") {
+  auto const op = lusty::scoreWithSpans("Open in browser", "op");
+  REQUIRE(op.score == Catch::Approx(0.95).epsilon(1e-9));
+  REQUIRE(op.spans.size() == 1);
+  REQUIRE(op.spans[0].begin == 0);
+  REQUIRE(op.spans[0].end == 2);
+
+  auto const cp = lusty::scoreWithSpans("Copy address", "cp");
+  REQUIRE(cp.spans.size() == 2);
+  REQUIRE(cp.spans[0].begin == 0);
+  REQUIRE(cp.spans[0].end == 1);
+  REQUIRE(cp.spans[1].begin == 2);
+  REQUIRE(cp.spans[1].end == 3);
+
+  // The span path and the hot path must agree byte for byte.
+  for (auto const &label : {"Open in browser", "Preferences", "Take screenshot", "Quit Telegram"}) {
+    for (auto const &query : {"o", "pref", "ts", "quit", "zz"}) {
+      REQUIRE(lusty::scoreWithSpans(label, query).score == lusty::score(label, query));
+    }
+  }
+}
+
+TEST_CASE("lusty: a query typed in the RU layout still matches") {
+  REQUIRE(lusty::normalizeQuery("щз") == "op");
+  REQUIRE(lusty::normalizeQuery("дщсл") == "lock");
+  REQUIRE(lusty::normalizeQuery("И") == "B"); // Shift+RU keeps the letter's case
+  REQUIRE(lusty::normalizeQuery("abcd") == "abcd");
+  REQUIRE(lusty::normalizeQuery("äö") == ""); // unmapped scripts drop out
+
+  std::vector<lusty::WeightedField> const fields{{"Open in browser", 1.0}, {"Lock screen", 1.0}};
+  REQUIRE(lusty::scoreWeighted(fields, "щз") == Catch::Approx(0.95).epsilon(1e-9));
+  REQUIRE(lusty::scoreWeighted(fields, "дщсл") == Catch::Approx(1.05).epsilon(1e-9));
+}
+
+TEST_CASE("lusty: weighted fields keep the best field") {
+  // A title hit must beat a subtitle hit, and weights must not multiply a
+  // match into a higher score than the same match on a stronger field.
+  std::vector<lusty::WeightedField> const fields{{"Nothing here", 1.0}, {"Preferences", 0.5}};
+  REQUIRE(lusty::scoreWeighted(fields, "pref") == Catch::Approx(0.5 * 1.05).epsilon(1e-9));
+
+  std::vector<lusty::WeightedField> const strong{{"Preferences", 1.0}, {"Nothing here", 0.5}};
+  REQUIRE(lusty::scoreWeighted(strong, "pref") == Catch::Approx(1.05).epsilon(1e-9));
+}
