+/// Expand the configured title template for one tab. `{index}` is the tab
+/// number, `{title}` the tab name (zoom suffix included) and `{marker}` the
+/// `tab_active_marker` on the focused tab (empty otherwise). An empty template
+/// (or one that leaves no text) keeps the plain label, so the default look is
+/// unchanged.
+fn tab_title(tab: &ClientShellTab, config: &ClientShellConfig) -> String {
+    let template = if tab.focused {
+        &config.active_tab_title_template
+    } else {
+        &config.tab_title_template
+    };
+    if template.trim().is_empty() {
+        return tab_label(tab);
+    }
+    let marker = if tab.focused {
+        config.tab_active_marker.as_str()
+    } else {
+        ""
+    };
+    let title = template
+        .replace("{index}", &tab.number.to_string())
+        .replace("{title}", &tab_label(tab))
+        .replace("{marker}", marker);
+    if title.trim().is_empty() {
+        return tab_label(tab);
+    }
+    title
+}
+
+/// Repaint the active marker where the template put it, in the accent colour,
+/// so `{marker}` reads like kitty's accent `❯>` prompt.
+fn paint_tab_marker(
+    buffer: &mut Buffer,
+    rect: Rect,
+    text: &str,
+    base: Style,
+    marker: &str,
+    marker_fg: ratatui::style::Color,
+) {
+    let Some(byte) = text.find(marker) else {
+        return;
+    };
+    let cell = text[..byte].chars().count() as u16;
+    let width = marker.chars().count() as u16;
+    if width == 0 || cell.saturating_add(width) > rect.width {
+        return;
+    }
+    put_text(
+        buffer,
+        rect.x.saturating_add(cell),
+        rect.y,
+        rect.width.saturating_sub(cell),
+        marker,
+        base.fg(marker_fg),
+    );
+}
