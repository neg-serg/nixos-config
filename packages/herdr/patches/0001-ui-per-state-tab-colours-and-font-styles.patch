+/// Map the configured tab font style onto a ratatui modifier mask.
+fn tab_font_modifier(style: crate::config::TabFontStyleConfig) -> Modifier {
+    use crate::config::TabFontStyleConfig;
+    match style {
+        TabFontStyleConfig::Normal => Modifier::empty(),
+        TabFontStyleConfig::Bold => Modifier::BOLD,
+        TabFontStyleConfig::Italic => Modifier::ITALIC,
+        TabFontStyleConfig::BoldItalic => Modifier::BOLD | Modifier::ITALIC,
+    }
+}
