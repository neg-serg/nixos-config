+/// Parse an optional tab-bar colour. An empty value means "keep the built-in
+/// colour", so an unset key cannot change the current look.
+fn tab_color(value: &str) -> Option<ratatui::style::Color> {
+    let value = value.trim();
+    if value.is_empty() {
+        return None;
+    }
+    Some(crate::config::parse_color(value))
+}
+
 impl ClientShellConfig {
     pub(crate) fn from_config(config: &Config) -> Self {
         let theme_runtime = crate::app::client_theme_runtime_from_config(config);
@@ -121,6 +131,12 @@ impl ClientShellConfig {
