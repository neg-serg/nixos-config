+            active_tab_fg: tab_color(&config.ui.active_tab_fg),
+            active_tab_bg: tab_color(&config.ui.active_tab_bg),
+            inactive_tab_fg: tab_color(&config.ui.inactive_tab_fg),
+            inactive_tab_bg: tab_color(&config.ui.inactive_tab_bg),
+            active_tab_style: config.ui.active_tab_style,
