+/// Drop a running transition without drawing it, freeing its GPU resources.
+///
+/// `TransitionState::new_texture` aliases the `output.wallpaper.texture`
+/// handles (established when the transition starts), so only `old_texture` is
+/// owned by the transition and only that one may be destroyed here. Callers use
+/// this before replacing the current wallpaper: otherwise the transition keeps
+/// its descriptor set pointing at the wallpaper texture that `set_wallpaper`
+/// frees, and the next frame samples freed GPU memory.
+///
+/// # Safety
+/// The GPU must be idle (all callers arrive via `handle_img`, which waits) and
+/// `device` must own the transition resources.
+unsafe fn cancel_transition(
+    device: &ash::Device,
+    transition_pipeline: Option<&TransitionPipeline>,
+    output: &mut Output,
+) {
+    let Some(t) = output.transition.take() else {
+        return;
+    };
+    // SAFETY: caller guarantees the GPU is idle; handles belong to `output`.
+    unsafe {
+        t.old_texture.destroy(device);
+        if let Some(ds) = t.descriptor_set
+            && let Some(tp) = transition_pipeline
+        {
+            tp.free_descriptor_set(device, ds);
+        }
+    }
+}
+
