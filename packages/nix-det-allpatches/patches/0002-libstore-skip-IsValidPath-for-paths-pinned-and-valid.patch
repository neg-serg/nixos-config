     std::chrono::time_point<std::chrono::steady_clock> startTime;
+
+    /**
+     * Paths that were added as temporary roots on this connection, so that
+     * `isValidPath()` need not ask the daemon about them again.
+     *
+     * A temp root keeps a path from being garbage-collected for as long as
+     * the evaluation lasts, and `isValidPath()` is only ever asked about
+     * paths that already exist, so a path that is pinned never becomes
+     * invalid. The value records whether the path has already been observed
+     * valid *after* being pinned: only then may the round-trip be skipped,
+     * since a path can legitimately be invalid at the moment it is pinned
+     * (it is about to be written). LRU eviction would cost a round-trip,
+     * nothing more.
+     */
+    LRUCache<StorePath, bool> tempRootsPinned{65536};
 };
 
