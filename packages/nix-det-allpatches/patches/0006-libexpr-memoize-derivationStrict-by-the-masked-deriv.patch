+struct EvalState::DerivationStrictMemo
+{
+    Sync<std::map<Hash, std::pair<StorePath, DerivationOutputs>>> entries;
+};
+
+/**
+ * Hash of the parts of a derivation that are already final before
+ * `fillInOutputPaths()` runs: the masked derivation plus the set of output
+ * names. Everything else a derivation is written from is covered here, so two
+ * derivations with the same key would be written to the same store path with
+ * the same output paths. Derivations whose key cannot be computed (floating
+ * content-addressed outputs, unresolved output paths in `inputDrvs`) are not
+ * memoised.
+ */
+static std::optional<Hash> derivationStrictMemoKey(const Derivation & drv)
+{
+    HashSink sink(HashAlgorithm::SHA256);
+    auto put = [&](std::string_view s) {
+        sink << s.size();
+        sink(s);
+    };
+    put(drv.name);
+    put(drv.platform);
+    put(drv.builder);
+    sink << drv.args.size();
+    for (auto & a : drv.args)
+        put(a);
+    sink << drv.env.size();
+    for (auto & [k, v] : drv.env) {
+        put(k);
+        put(v);
+    }
+    sink << drv.outputs.size();
+    for (auto & [k, o] : drv.outputs) {
+        if (!std::holds_alternative<DerivationOutput::Deferred>(o.raw))
+            return std::nullopt;
+        put(k);
+    }
+    sink << drv.inputSrcs.size();
+    for (auto & p : drv.inputSrcs)
+        put(p.to_string());
+    sink << drv.inputDrvs.map.size();
+    for (auto & [p, node] : drv.inputDrvs.map) {
+        if (!node.childMap.empty())
+            return std::nullopt;
+        put(p.to_string());
+        sink << node.value.size();
+        for (auto & o : node.value)
+            put(o);
+    }
+    if (drv.structuredAttrs) {
+        auto [jsonName, jsonValue] = drv.structuredAttrs->unparse();
+        put(jsonName);
+        put(jsonValue);
+    } else
+        put("");
+    return sink.finish().hash;
+}
