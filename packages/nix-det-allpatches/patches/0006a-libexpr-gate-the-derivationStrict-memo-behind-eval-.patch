+     * (`scripts/dev/nix-memo-diff.sh`), not for everyday use.
+     */
+    Setting<bool> evalMemo{
+        this,
+        true,
+        "eval-memo",
+        R"(
+            Whether `derivationStrict` memoises its result under the hash of the
+            masked derivation, so that a derivation built a second time during
+            the same evaluation reuses the store path and the output paths of
+            the first instead of being written to the store again.
+
+            This is a cache of the evaluator's own result only: disabling it
+            changes no outcome, only the work done. Defaults to `true`.
+        )"};
