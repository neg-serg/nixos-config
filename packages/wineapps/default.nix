##
# Package: wineapps
# Purpose: Declarative Wine app manager CLI. Reads the registry generated by
#   modules/system/wine-apps.nix (/etc/wineapps/apps.json) and manages per-app
#   Wine prefixes under $XDG_DATA_HOME/wineprefixes (on trantor bind-mounted to
#   /gamez/main/wineprefixes): list/install/uninstall/run/sync/prefix/status.
#
# Rust, no crates: the registry is a small JSON document and every Wine
# operation is a call to the binaries this wrapper pins — wine, wineboot,
# wineserver, winetricks — so the client carries no Wine knowledge itself. The
# prefix root keeps its old default (XDG data dir), so existing prefixes are
# found unchanged.
{
  lib,
  rustPlatform,
  makeWrapper,
  wineWow64Packages,
  winetricks,
}:

rustPlatform.buildRustPackage {
  pname = "wineapps";
  version = (lib.importTOML ./Cargo.toml).package.version;

  src = ./.;

  cargoLock.lockFile = ./Cargo.lock;

  nativeBuildInputs = [ makeWrapper ];

  # The four paths the CLI shells out to. WINEPREFIX_BASE is left alone: the
  # client derives $XDG_DATA_HOME/wineprefixes itself, which is the same default
  # the old wrapper set, so existing prefixes stay visible.
  postInstall = ''
    wrapProgram $out/bin/wineapps \
      --set-default WINE ${wineWow64Packages.stable}/bin/wine \
      --set-default WINEBOOT ${wineWow64Packages.stable}/bin/wineboot \
      --set-default WINESERVER ${wineWow64Packages.stable}/bin/wineserver \
      --set-default WINETRICKS ${winetricks}/bin/winetricks
  '';

  meta = lib.mkMeta {
    description = "Declarative Wine app manager (list/install/uninstall/run)";
    homepage = "https://github.com/neg-serg/nixos-config";
    license = lib.licenses.mit;
    mainProgram = "wineapps";
  };
}
