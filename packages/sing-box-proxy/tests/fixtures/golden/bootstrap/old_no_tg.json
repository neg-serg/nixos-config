{
  "log": {
    "level": "error"
  },
  "dns": {
    "servers": [
      {
        "tag": "remote",
        "type": "https",
        "server": "1.1.1.1",
        "server_port": 443
      }
    ],
    "strategy": "prefer_ipv4"
  },
  "inbounds": [
    {
      "type": "socks",
      "tag": "in",
      "listen": "127.0.0.1",
      "listen_port": 10808
    },
    {
      "type": "socks",
      "tag": "in-lan-vm",
      "listen": "0.0.0.0",
      "listen_port": 10811
    },
    {
      "type": "http",
      "tag": "in-lan-vm-http",
      "listen": "0.0.0.0",
      "listen_port": 10812
    },
    {
      "type": "socks",
      "tag": "in-lan",
      "listen": "0.0.0.0",
      "listen_port": 10810,
      "users": [
        {
          "username": "fixtureuser",
          "password": "fixturepass"
        }
      ]
    }
  ],
  "outbounds": [
    {
      "type": "vless",
      "tag": "vl-0",
      "server": "a.example.com",
      "server_port": 443,
      "uuid": "11111111-2222-3333-4444-555555555555",
      "packet_encoding": "xudp",
      "tls": {
        "enabled": true,
        "server_name": "cdn.example.com",
        "utls": {
          "enabled": true,
          "fingerprint": "chrome"
        },
        "reality": {
          "enabled": true,
          "public_key": "0123456789abcdefghijklmnopqrstuvwxyzABCDEFG",
          "short_id": "0123abcd"
        }
      }
    },
    {
      "type": "trojan",
      "tag": "tr-1",
      "server": "tj.example.com",
      "server_port": 443,
      "password": "p\u00e4ss",
      "tls": {
        "enabled": true,
        "server_name": "tjsni.example.com",
        "utls": {
          "enabled": true,
          "fingerprint": "chrome"
        }
      },
      "transport": {
        "type": "ws",
        "path": "/tj",
        "headers": {
          "Host": "tjws.example.com"
        }
      }
    },
    {
      "type": "urltest",
      "tag": "auto",
      "outbounds": [
        "vl-0",
        "tr-1"
      ],
      "interval": "15s",
      "tolerance": 50
    },
    {
      "type": "direct",
      "tag": "direct"
    },
    {
      "type": "urltest",
      "tag": "tg-auto",
      "outbounds": [
        "vl-0",
        "tr-1"
      ],
      "interval": "15s",
      "tolerance": 50
    }
  ],
  "route": {
    "rules": [
      {
        "ip_is_private": true,
        "outbound": "direct"
      },
      {
        "domain_suffix": [
          "telegram.org",
          "t.me",
          "telegram.me",
          "telegram.dog"
        ],
        "outbound": "tg-auto"
      },
      {
        "ip_cidr": [
          "91.108.4.0/22",
          "91.108.8.0/22",
          "91.108.12.0/22",
          "91.108.16.0/22",
          "91.108.56.0/22",
          "95.161.64.0/20",
          "149.154.160.0/20",
          "185.76.151.0/24"
        ],
        "outbound": "tg-auto"
      },
      {
        "domain_suffix": [
          "deepseek.com",
          "deepseek.cn"
        ],
        "action": "route",
        "outbound": "auto"
      },
      {
        "action": "resolve",
        "server": "remote",
        "strategy": "prefer_ipv4"
      }
    ],
    "final": "auto",
    "auto_detect_interface": true,
    "default_domain_resolver": "remote"
  }
}