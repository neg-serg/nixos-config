+
+    /// Build the command a clipboard file list asks for, or `None` when the
+    /// clipboard holds text, names nothing that exists, or is plain enough
+    /// that inserting it is the honest reaction.
+    #[cfg(feature = "clipboard")]
+    fn clipboard_jump(
+        &self,
+        sel_info: SelInfo<'_>,
+        tree_root: &Path,
+    ) -> Option<Command> {
+        let crate::clipboard::Content::Paths(paths) = crate::clipboard::read()? else {
+            return None;
+        };
+        // A relative path is resolved the way `:focus` would resolve it: from
+        // the selected line's closest directory.
+        let base = sel_info
+            .paths()
+            .first()
+            .map(|path| path.to_path_buf())
+            .unwrap_or_else(|| tree_root.to_path_buf());
+        let mut existing: Vec<PathBuf> = Vec::new();
+        for path in &paths {
+            let path = crate::path::path_from(
+                &base,
+                crate::path::PathAnchor::Directory,
+                &path.to_string_lossy(),
+            );
+            if path.exists() || std::fs::symlink_metadata(&path).is_ok() {
+                existing.push(path);
+            }
+        }
+        let invocation = match existing.len() {
+            0 => return None,
+            1 => {
+                let path = &existing[0];
+                let name = if path.is_dir() {
+                    "focus"
+                } else if path.starts_with(tree_root) {
+                    // A file already under the tree is revealed and selected.
+                    "show"
+                } else {
+                    // `:focus` opens the closest directory, so a file outside
+                    // the tree still gets its parent opened.
+                    "focus"
+                };
+                VerbInvocation {
+                    name: name.to_string(),
+                    args: Some(path.to_string_lossy().into_owned()),
+                    bang: false,
+                }
+            }
+            _ => {
+                // Several files: open the one tree that shows all of them.
+                let dir = common_dir(&existing)?;
+                VerbInvocation {
+                    name: "focus".to_string(),
+                    args: Some(dir.to_string_lossy().into_owned()),
+                    bang: false,
+                }
+            }
+        };
+        Some(Command::VerbInvocate(invocation))
+    }
+}
+
+/// The directory several clipboard paths have in common, so a multi-file paste
+/// opens the one tree that shows all of them rather than an arbitrary first.
+#[cfg(feature = "clipboard")]
+fn common_dir(paths: &[PathBuf]) -> Option<PathBuf> {
+    let (first, rest) = paths.split_first()?;
+    let mut common = containing_dir(first);
+    for path in rest {
+        let dir = containing_dir(path);
+        while !dir.starts_with(&common) {
+            common = common.parent()?.to_path_buf();
+        }
+    }
+    // The filesystem root is technically common to /tmp and /home, but opening
+    // it would show neither.
+    common.parent()?;
+    Some(common)
+}
+
+#[cfg(feature = "clipboard")]
+fn containing_dir(path: &Path) -> PathBuf {
+    if path.is_dir() {
+        path.to_path_buf()
+    } else {
+        path.parent()
+            .map(Path::to_path_buf)
+            .unwrap_or_else(|| path.to_path_buf())
+    }
 }
