@@ -0,0 +1,302 @@
+//! Reading the system clipboard, file lists included.
+//!
+//! `terminal-clipboard`, which the copy verbs use, asks for UTF-8 text. A file
+//! manager doesn't put that on the clipboard: it offers a `text/uri-list` and,
+//! on GNOME and KDE, an `x-special/gnome-copied-files` list of `file://` URIs.
+//! Reading only the text type either yields the raw URIs — which
+//! `:input_paste` turns into `file:///home/…`, a pattern that matches nothing —
+//! or yields nothing at all.
+//!
+//! This module asks for the file-list types first, decodes them into local
+//! paths, and falls back to the plain text, so pasting ordinary text keeps
+//! behaving like pasting ordinary text.
+
+use std::path::PathBuf;
+
+/// The MIME types that carry a list of copied files rather than text.
+const FILE_LIST_TYPES: [&str; 2] = ["text/uri-list", "x-special/gnome-copied-files"];
+
+/// What a clipboard read produced.
+pub enum Content {
+    /// Local files or directories, in the clipboard's order.
+    Paths(Vec<PathBuf>),
+    /// Plain text, to be inserted as text.
+    Text(String),
+}
+
+/// Read the clipboard, preferring a file list over its textual shadow.
+pub fn read() -> Option<Content> {
+    #[cfg(unix)]
+    if let Some(content) = read_unix() {
+        return Some(content);
+    }
+    // X11 through x11-clipboard, Win32 or macOS: the platforms where the
+    // cross-platform crate is the only reader (and the text fallback where it
+    // isn't).
+    let text = terminal_clipboard::get_string().ok()?;
+    Some(content_from_text(text))
+}
+
+fn content_from_text(text: String) -> Content {
+    match file_paths(&text) {
+        Some(paths) => Content::Paths(paths),
+        None => Content::Text(text),
+    }
+}
+
+#[cfg(unix)]
+fn read_unix() -> Option<Content> {
+    if std::env::var_os("WAYLAND_DISPLAY").is_some() {
+        if let Some(content) = read_wayland() {
+            return Some(content);
+        }
+    }
+    if std::env::var_os("DISPLAY").is_some() {
+        if let Some(content) = read_x11() {
+            return Some(content);
+        }
+    }
+    None
+}
+
+/// Wayland: ask for the file-list types by name before settling for the text.
+#[cfg(unix)]
+fn read_wayland() -> Option<Content> {
+    for mime in FILE_LIST_TYPES {
+        if let Some(payload) = run("wl-paste", &["--no-newline", "--type", mime]) {
+            if let Some(paths) = file_paths(&payload) {
+                return Some(Content::Paths(paths));
+            }
+        }
+    }
+    let text = run("wl-paste", &["--no-newline"])?;
+    Some(content_from_text(text))
+}
+
+/// X11: no file-list type is reachable through the text-only crate, so ask
+/// xclip for it when the user has it installed. Missing xclip is not an error:
+/// the plain-text fallback below still works.
+#[cfg(unix)]
+fn read_x11() -> Option<Content> {
+    for mime in FILE_LIST_TYPES {
+        if let Some(payload) = run("xclip", &["-selection", "clipboard", "-t", mime, "-o"]) {
+            if let Some(paths) = file_paths(&payload) {
+                return Some(Content::Paths(paths));
+            }
+        }
+    }
+    None
+}
+
+/// Run a clipboard reader and collect its output.
+///
+/// The command is killed after a short deadline: an owner that never answers
+/// the selection request must not freeze the interface on `ctrl-v`.
+#[cfg(unix)]
+fn run(
+    program: &str,
+    args: &[&str],
+) -> Option<String> {
+    use std::{
+        io::Read,
+        process::{
+            Command,
+            Stdio,
+        },
+        time::{
+            Duration,
+            Instant,
+        },
+    };
+    let mut child = Command::new(program)
+        .args(args)
+        .stdin(Stdio::null())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::null())
+        .spawn()
+        .ok()?;
+    let deadline = Instant::now() + Duration::from_millis(750);
+    loop {
+        match child.try_wait() {
+            Ok(Some(_)) => break,
+            Ok(None) if Instant::now() < deadline => std::thread::sleep(Duration::from_millis(5)),
+            _ => {
+                let _ = child.kill();
+                let _ = child.wait();
+                return None;
+            }
+        }
+    }
+    let mut output = String::new();
+    child.stdout.take()?.read_to_string(&mut output).ok()?;
+    if output.is_empty() { None } else { Some(output) }
+}
+
+/// Turn a clipboard payload into local paths, or `None` when the payload is
+/// ordinary text rather than a file list.
+///
+/// Every non-empty, non-comment line has to be a path: a single stray word
+/// means the user copied text, not files, and that text is what should be
+/// pasted.
+pub fn file_paths(payload: &str) -> Option<Vec<PathBuf>> {
+    let lines: Vec<&str> = payload
+        .lines()
+        .map(str::trim)
+        .filter(|line| !line.is_empty() && !line.starts_with('#'))
+        .collect();
+    let (first, rest) = lines.split_first()?;
+    // x-special/gnome-copied-files prefixes the list with the operation.
+    let lines = if *first == "copy" || *first == "cut" {
+        rest
+    } else {
+        &lines[..]
+    };
+    if lines.is_empty() {
+        return None;
+    }
+    lines
+        .iter()
+        .map(|line| line_path(line))
+        .collect::<Option<Vec<_>>>()
+}
+
+fn line_path(line: &str) -> Option<PathBuf> {
+    if let Some(rest) = line.strip_prefix("file://") {
+        return uri_path(rest);
+    }
+    let looks_like_path = line.starts_with('/')
+        || line == "~"
+        || line.starts_with("~/")
+        || line.starts_with("./")
+        || line.starts_with("../");
+    #[cfg(windows)]
+    let looks_like_path = looks_like_path || is_windows_path(line);
+    looks_like_path.then(|| PathBuf::from(line))
+}
+
+/// A `file://` URI's path, percent-decoded, or `None` when the URI doesn't name
+/// this machine.
+fn uri_path(rest: &str) -> Option<PathBuf> {
+    let (host, path) = rest.split_once('/')?;
+    if !host.is_empty() && !host.eq_ignore_ascii_case("localhost") {
+        return None;
+    }
+    #[allow(unused_mut)] // the Windows drive is un-slashed below
+    let mut path = percent_decode(&format!("/{path}"))?;
+    // `file:///C:/Program%20Files` names a Windows path, not a Unix one.
+    #[cfg(windows)]
+    if path.len() > 1 && is_windows_path(&path[1..]) {
+        path.remove(0);
+    }
+    Some(PathBuf::from(path))
+}
+
+fn percent_decode(input: &str) -> Option<String> {
+    if !input.contains('%') {
+        return Some(input.to_string());
+    }
+    let bytes = input.as_bytes();
+    let mut decoded = Vec::with_capacity(bytes.len());
+    let mut i = 0;
+    while i < bytes.len() {
+        if bytes[i] == b'%' {
+            let high = hex_digit(*bytes.get(i + 1)?)?;
+            let low = hex_digit(*bytes.get(i + 2)?)?;
+            decoded.push(high * 16 + low);
+            i += 3;
+        } else {
+            decoded.push(bytes[i]);
+            i += 1;
+        }
+    }
+    String::from_utf8(decoded).ok()
+}
+
+fn hex_digit(byte: u8) -> Option<u8> {
+    match byte {
+        b'0'..=b'9' => Some(byte - b'0'),
+        b'a'..=b'f' => Some(byte - b'a' + 10),
+        b'A'..=b'F' => Some(byte - b'A' + 10),
+        _ => None,
+    }
+}
+
+#[cfg(windows)]
+fn is_windows_path(line: &str) -> bool {
+    let mut chars = line.chars();
+    matches!(
+        (chars.next(), chars.next(), chars.next()),
+        (Some(drive), Some(':'), Some('/' | '\\')) if drive.is_ascii_alphabetic()
+    )
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn a_uri_list_decodes_to_local_paths() {
+        assert_eq!(
+            file_paths("file:///tmp/a%20b\nfile:///home/neg"),
+            Some(vec![
+                PathBuf::from("/tmp/a b"),
+                PathBuf::from("/home/neg")
+            ])
+        );
+    }
+
+    #[test]
+    fn the_gnome_header_is_not_a_path() {
+        assert_eq!(
+            file_paths("copy\nfile:///tmp/a\n"),
+            Some(vec![PathBuf::from("/tmp/a")])
+        );
+        assert_eq!(
+            file_paths("cut\nfile:///tmp"),
+            Some(vec![PathBuf::from("/tmp")])
+        );
+    }
+
+    #[test]
+    fn plain_absolute_paths_are_a_file_list() {
+        assert_eq!(
+            file_paths("/tmp/a\n~/src\n"),
+            Some(vec![PathBuf::from("/tmp/a"), PathBuf::from("~/src")])
+        );
+    }
+
+    #[test]
+    fn ordinary_text_is_not_a_file_list() {
+        assert_eq!(file_paths("hello world"), None);
+        assert_eq!(file_paths("https://example.com/x"), None);
+        assert_eq!(file_paths("file:///tmp\nhello"), None);
+        assert_eq!(file_paths(""), None);
+        assert_eq!(file_paths("copy\n"), None);
+    }
+
+    #[test]
+    fn remote_file_uris_are_not_local_paths() {
+        assert_eq!(file_paths("file://example.com/tmp"), None);
+        assert_eq!(
+            file_paths("file://localhost/tmp"),
+            Some(vec![PathBuf::from("/tmp")])
+        );
+    }
+
+    #[test]
+    fn comments_and_blank_lines_are_skipped() {
+        assert_eq!(
+            file_paths("# a comment\n\nfile:///tmp\n"),
+            Some(vec![PathBuf::from("/tmp")])
+        );
+    }
+
+    #[test]
+    fn a_bare_percent_is_text() {
+        assert_eq!(file_paths("file:///tmp/100%"), None);
+        assert_eq!(
+            file_paths("file:///tmp/100%25"),
+            Some(vec![PathBuf::from("/tmp/100%")])
+        );
+    }
+}
