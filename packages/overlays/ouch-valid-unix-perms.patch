+/// A zip mode without Unix file-type bits isn't a real Unix mode, so its
+/// permissions are ignored. Backported from ouch main (valid_unix_permissions).
+fn valid_unix_permissions(mode: u32) -> Option<u32> {
+    (mode & 0o170000 != 0).then(|| sanitize_archive_mode(mode))
