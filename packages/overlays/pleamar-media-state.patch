+/// The other half of `is_playing`: a player that holds a song where it was left. The three states
+/// of `PlaybackStatus` are `Playing`, `Paused` and `Stopped`, and a scene that keeps a capsule for
+/// `playing || paused` (the way a bar does) cannot tell the last two apart from `playing` alone.
+fn is_paused(p: &Proxy) -> bool {
+    p.get_property::<String>("PlaybackStatus").is_ok_and(|s| s == "Paused")
+}
