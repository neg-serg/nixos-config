+/// Whether a scene may ask the compositor for a cursor shape at all. It may not, unless
+/// `PLEAMAR_CURSOR_SHAPES=1` says so.
+///
+/// A compositor keeps ONE cursor for the whole session, not one per surface, and Hyprland drops
+/// a shape that arrives while another client holds the pointer (hyprwm/Hyprland#14906), so a layer
+/// surface that asks for a hand can leave it stuck, or leave the compositor with no image at all.
+/// The scene language still carries `cursor:` in zones and this runtime still computes it, but by
+/// default that number goes nowhere: the pointer belongs to the compositor, and the shell does not
+/// touch it. Setting the variable back to 1 is the old behaviour, for anyone who wants to measure
+/// against it.
+fn cursor_shapes_wanted() -> bool {
+    static WANTED: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *WANTED.get_or_init(|| {
+        std::env::var_os("PLEAMAR_CURSOR_SHAPES").is_some_and(|v| v != "0")
+    })
+}
