+    /// And out of the frame, not only the input: an empty buffer leaves the layer mapped, and a
+    /// mapped layer is composited —and blurred— on every damage even when it shows nothing.
+    /// No buffer at all unmaps it; the next presented frame attaches one and maps it again.
+    fn unmap(&self) {
+        // Only a layer: a popup's parent owns its configure, and the closed sheets are layers.
+        if self.layer.is_none() {
+            return;
+        }
+        self.wl.attach(None, 0, 0);
+        self.commit();
+        // And the bufferless commit that makes the compositor arrange it again: Hyprland clears
+        // its `configured` flag on the unmap (LayerShell.cpp), and a layer surface may only take
+        // a buffer back after it has been configured — and acked — once more. Without this the
+        // next frame's buffer is attached to an unconfigured surface and the compositor kills
+        // the client ("layerSurface was not configured, but a buffer was attached").
+        self.commit();
+    }
+
