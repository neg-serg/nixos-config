Local fixes on top of the pinned upstream rev. All three are about what a
start (or a failed start) reports, not about the app once it listens.

1. "No .env file found …" was printed on every start without a .env next to
   the cwd. That is the normal case for the packaged server (the unit gets its
   environment from systemd), so the lookup now stays quiet when it finds
   nothing and still reports the file it did load.

2. A taken port surfaced as a raw Node stack trace. The common case here is
   `camillaeq` started twice, or the default 3000 hitting AdGuard Home, so the
   error is reduced to one line naming the address and the variable to move.

3. "Serving static client build" was logged (and duplicated a shadowed
   `clientDistPath`) before the listen, which is the step that can fail — so a
   failed run still claimed to serve the client. The log moved after listen.

--- a/server/src/index.ts
+++ b/server/src/index.ts
@@ -30,9 +30,8 @@
     if (existsSync(rootEnv)) {
       dotenv.config({ path: rootEnv });
       console.log(`Loaded environment from: ${rootEnv}`);
-    } else {
-      console.log('No .env file found (server/.env or repo-root .env)');
     }
+    // No .env anywhere is the normal case for the packaged server; stay quiet.
   }
 }
 
@@ -40,6 +39,9 @@
 const __dirname = dirname(__filename);
 
 const start = async () => {
+  const port = Number(process.env.SERVER_PORT) || 3000;
+  const host = process.env.SERVER_HOST || '0.0.0.0';
+
   try {
     const app = buildApp();
     
@@ -81,10 +83,6 @@
     if (isProduction) {
       // Resolve client dist relative to compiled server/dist
       // Build process copies client/dist to server/dist/client
-      const clientDistPath = join(__dirname, 'client');
-      
-      app.log.info({ clientDistPath }, 'Serving static client build');
-      
       // Register static file serving
       await app.register(fastifyStatic, {
         root: clientDistPath,
@@ -111,13 +109,23 @@
       app.log.info('Development mode: client served by Vite dev server');
     }
     
-    const port = Number(process.env.SERVER_PORT) || 3000;
-    const host = process.env.SERVER_HOST || '0.0.0.0';
-    
     await app.listen({ port, host });
+
+    // Only now is the client actually served: the listen above is the step
+    // that fails when the address is taken.
+    if (isProduction) {
+      app.log.info({ clientDistPath }, 'Serving static client build');
+    }
+
     app.log.info(`Server listening on http://${host}:${port}`);
   } catch (err) {
-    console.error(err);
+    if ((err as NodeJS.ErrnoException).code === 'EADDRINUSE') {
+      console.error(
