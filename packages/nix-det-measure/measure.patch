+std::mutex & bmMutex() { static std::mutex m; return m; }
+FILE * bmFile()
+{
+    static FILE * f = [] {
+        auto * p = getenv("NIX_BYMOTIF_STATS");
+        return p ? fopen(p, "a") : nullptr;
+    }();
+    return f;
+}
+void bmLog(const char * fmt, ...)
+{
+    auto * f = bmFile();
