#!/usr/bin/env python3
"""Regenerate hosts/odin/unbound-hosts.nix from its sources.

Merges:
  * hosts/odin/unbound-local.txt   — hand-curated local entries (host A|AAAA value)
  * files/sources/malw-hosts.txt   — upstream snapshot in raw hosts format (ip host)

Usage:
  gen-unbound-hosts [REPO_ROOT]   (default: git rev-parse --show-toplevel)
"""

import subprocess
import sys
from pathlib import Path

HEADER = """\
# Generated by `gen-unbound-hosts` — do not edit by hand.
# Sources: hosts/odin/unbound-local.txt (local entries) +
#          files/sources/malw-hosts.txt (upstream snapshot).
# Regenerate with: just unbound-hosts
[
"""


def parse_local(line: str) -> str | None:
    parts = line.split()
    if len(parts) == 3 and parts[1] in ("A", "AAAA"):
        return f"{parts[0]}. {parts[1]} {parts[2]}"
    return None


def parse_upstream(line: str) -> list[str]:
    """Raw hosts line `ip host [host...]` -> unbound local-data entries."""
    parts = line.split()
    if len(parts) < 2 or parts[0].startswith("#"):
        return []
    ip = parts[0]
    typ = "AAAA" if ":" in ip else "A"
    return [f"{h}. {typ} {ip}" for h in parts[1:]]


def repo_root(arg: str | None) -> Path:
    if arg:
        return Path(arg).resolve()
    out = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"],
        capture_output=True,
        text=True,
        check=True,
    )
    return Path(out.stdout.strip()).resolve()


def main(argv: list[str]) -> int:
    root = repo_root(argv[1] if len(argv) > 1 else None)

    local: list[str] = []
    for line in (root / "hosts/odin/unbound-local.txt").read_text().splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        e = parse_local(line)
        if e:
            local.append(e)

    upstream: set[str] = set()
    for line in (root / "files/sources/malw-hosts.txt").read_text().splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        upstream.update(parse_upstream(line))

    entries = local + sorted(upstream)
    body = "\n".join(f'  "{e}"' for e in entries)
    out_path = root / "hosts/odin/unbound-hosts.nix"
    out_path.write_text(HEADER + body + "\n]\n", encoding="utf-8")
    print(f"gen-unbound-hosts: wrote {out_path} ({len(entries)} entries)")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
