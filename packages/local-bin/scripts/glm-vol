#!/usr/bin/env bash
# glm-vol — control Genelec GLM volume from the command line.
#
# Writes the target to the state file $XDG_RUNTIME_DIR/genlc-volume, which the
# quickshell widget's FileView watches; the widget sends the absolute CC20
# to GLM (midiMode: glm-midi -> relay :9004 -> VM bridge -> loopMIDI -> GLM)
# 400 ms after the change (self-heal). No relative C21/C22 steps — CC20 only.
#
# Usage:
#   glm-vol -43         absolute target, whole dB (optional 'dB' suffix)
#   glm-vol read         print the last known target (state file)
set -euo pipefail

# The state file is per-user session state, not a system-wide temporary: it used
# to be the fixed /tmp/genlc-volume, which is a symlink-attack and cross-user
# collision surface and survives the session it belongs to. XDG_RUNTIME_DIR is
# cleared on logout, is 0700, and is what every other per-session file here uses.
RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
STATE="$RUNTIME_DIR/genlc-volume"

usage() { echo "usage: glm-vol {<dB> | read}" >&2; exit 1; }
[ $# -ge 1 ] || usage

case "$1" in
  read|current)
    # An existing-but-empty state file (every fresh session: XDG_RUNTIME_DIR is
    # wiped on logout) used to answer with an empty line, which callers then read
    # as "no volume" or as -40 depending on their fallback. The widget keeps the
    # last committed value in its own cache, so use that before giving up.
    v="$(cat "$STATE" 2>/dev/null || true)"
    case "$v" in
      '' | *[!0-9-]*)
        cached="$(jq -r '.genelecVolume // empty' "${XDG_CACHE_HOME:-$HOME/.cache}/quickshell/state.json" 2>/dev/null || true)"
        if [ -n "$cached" ]; then v="$cached"; else v="-40"; fi
        ;;
    esac
    echo "$v"
    exit 0
    ;;
esac

t=$1; t=${t%dB}
# Validate, round to whole dB and clamp to the widget range ([-95, -20]).
clamped=$(awk -v t="$t" 'BEGIN { if (t < -95) t = -95; if (t > -20) t = -20; printf "%.0f", t }')
echo "$clamped" > "$STATE"   # the widget sends the absolute CC20 to GLM
echo "glm-vol: requested $clamped dB (widget sends CC20)" >&2
