#!/usr/bin/env bash
# glm-vol — control Genelec GLM volume from the command line.
#
# Sends the same MIDI sequence the quickshell widget would send in midiMode
# (glm-midi -> relay :9004 -> VM bridge -> loopMIDI -> GLM) AND syncs the
# quickshell widget display by writing the state file /tmp/genlc-volume,
# which the widget's FileView watches. Absolute values only — GLM has no
# readback, so relative steps would desync the widget display.
#
# Usage:
#   glm-vol -43.5        absolute target (dB, optional 'dB' suffix)
#   glm-vol read         print the last known target (state file)
set -euo pipefail

GLM=/home/neg/.local/bin/glm-midi
STATE=/tmp/genlc-volume

usage() { echo "usage: glm-vol {<dB> | read}" >&2; exit 1; }
[ $# -ge 1 ] || usage

case "$1" in
  read|current)
    cat "$STATE" 2>/dev/null || echo "-40"
    exit 0
    ;;
esac

t=$1; t=${t%dB}
# Validate and clamp to the same range the widget uses ([-95, -20]).
clamped=$(awk -v t="$t" 'BEGIN { if (t < -95) t = -95; if (t > -20) t = -20; printf "%.1f", t }')
# Relative control: send the delta as C21 (vol+) / C22 (vol-) steps from the
# previous state value. GLM's absolute re-anchor (CC20) is sent once by the
# quickshell widget on MIDI activation and 400 ms after the last change
# (self-heal); never periodically.
current=$(cat "$STATE" 2>/dev/null || echo "-40")
delta=$(awk -v t="$clamped" -v c="$current" 'BEGIN { printf "%.3f", t - c }')
steps=$(awk -v d="$delta" 'BEGIN { s = int(d / 0.5 + (d >= 0 ? 0.5 : -0.5)); print s }')

if [ "$steps" -gt 0 ]; then
  "$GLM" vol+ "$steps"       # C21 x steps (spaced 250 ms each)
elif [ "$steps" -lt 0 ]; then
  "$GLM" vol- "$((-steps))"  # C22 x steps
fi
echo "$clamped" > "$STATE"   # sync the quickshell widget display
echo "glm-vol: $clamped dB ($steps steps)" >&2
