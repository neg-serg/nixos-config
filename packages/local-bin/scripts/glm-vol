#!/usr/bin/env bash
# glm-vol — control Genelec GLM volume from the command line.
#
# Writes the target to the state file /tmp/genlc-volume, which the
# quickshell widget's FileView watches; the widget sends the absolute CC20
# to GLM (midiMode: glm-midi -> relay :9004 -> VM bridge -> loopMIDI -> GLM)
# 400 ms after the change (self-heal). No relative C21/C22 steps — CC20 only.
#
# Usage:
#   glm-vol -43         absolute target, whole dB (optional 'dB' suffix)
#   glm-vol read         print the last known target (state file)
set -euo pipefail

STATE=/tmp/genlc-volume

usage() { echo "usage: glm-vol {<dB> | read}" >&2; exit 1; }
[ $# -ge 1 ] || usage

case "$1" in
  read|current)
    cat "$STATE" 2>/dev/null || echo "-40"
    exit 0
    ;;
esac

t=$1; t=${t%dB}
# Validate, round to whole dB and clamp to the widget range ([-95, -20]).
clamped=$(awk -v t="$t" 'BEGIN { if (t < -95) t = -95; if (t > -20) t = -20; printf "%.0f", t }')
echo "$clamped" > "$STATE"   # the widget sends the absolute CC20 to GLM
echo "glm-vol: requested $clamped dB (widget sends CC20)" >&2
