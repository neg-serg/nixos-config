#!/usr/bin/env bash
# glm-vol — request a Genelec GLM volume target.
#
# Volume is set ONLY by the quickshell widget's periodic CC20 anchor
# (every 400 ms): this tool just writes the target to /tmp/genlc-volume;
# the widget's FileView applies it and the anchor sends it to GLM. No
# direct MIDI sends here.
#
# Usage:
#   glm-vol -43.5        request a target (dB, optional 'dB' suffix)
#   glm-vol read         print the last known target (state file)
set -euo pipefail

STATE=/tmp/genlc-volume

usage() { echo "usage: glm-vol {<dB> | read}" >&2; exit 1; }
[ $# -ge 1 ] || usage

case "$1" in
  read|current)
    cat "$STATE" 2>/dev/null || echo "-40"
    exit 0
    ;;
esac

t=$1; t=${t%dB}
# Validate and clamp to the same range the widget uses ([-95, -20]).
clamped=$(awk -v t="$t" 'BEGIN { if (t < -95) t = -95; if (t > -20) t = -20; printf "%.1f", t }')

echo "$clamped" > "$STATE"   # the widget's anchor will send it to GLM
echo "glm-vol: requested $clamped dB (sent by the widget anchor)" >&2
