#!/usr/bin/env python3
"""Fetch missing album covers using sacad.
Usage: fetch-covers [--dry-run]"""
import os
import re
import subprocess
import sys

MUSIC = os.path.expanduser("~/music")
SIZE = 500
DRY_RUN = "--dry-run" in sys.argv
PATTERN = re.compile(r'^(.+?)-⟨[^⟩]+⟩-(.+)$')

dirs = sorted(os.listdir(MUSIC))
missing = []

for name in dirs:
    d = os.path.join(MUSIC, name)
    if not os.path.isdir(d):
        continue
    try:
        files = os.listdir(d)
    except PermissionError:
        continue
    has_cover = any(
        f.lower().startswith(('cover', 'folder', 'front', 'artwork'))
        for f in files
    )
    if has_cover:
        continue

    m = PATTERN.match(name)
    if m:
        artist, album = m.group(1), m.group(2)
    else:
        parts = name.split('-', 1)
        artist = parts[0]
        album = parts[1] if len(parts) > 1 else name

    missing.append((name, artist.strip(), album.strip()))

print(f"Albums without covers: {len(missing)}/{len(dirs)}")
print()

success = 0
for i, (dirname, artist, album) in enumerate(missing):
    outpath = os.path.join(MUSIC, dirname, "cover.jpg")
    print(f"[{i+1}/{len(missing)}] {artist} — {album}")

    if DRY_RUN:
        continue

    try:
        result = subprocess.run(
            ["sacad", artist, album, str(SIZE), outpath],
            capture_output=True, text=True, timeout=30
        )
        if result.returncode == 0:
            print(f"  ✓ saved to {dirname}/cover.jpg")
            success += 1
        else:
            err = result.stderr.strip().split('\n')[-1] if result.stderr else "unknown"
            print(f"  ✗ {err}")
    except subprocess.TimeoutExpired:
        print("  ✗ timeout")
    except Exception as e:
        print(f"  ✗ {e}")

print(f"\nDone: {success}/{len(missing)} covers downloaded")
