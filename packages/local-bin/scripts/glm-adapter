#!/usr/bin/env bash
# glm-adapter — locate the Genelec GLM USB adapter (Gnet 1781:0e39), move it
# between the host and the dockur Windows VM, and verify the control chain.
#
# Why: the adapter is passed through to the VM via QEMU usb-host while the VM
# runs. QEMU opens a passed-through device only when the QEMU process starts —
# libusb hotplug events never reach the container (its own netns, no /run/udev) —
# so a device that is lost or replugged while the VM runs is never re-claimed:
# the only cure is a fresh QEMU, i.e. a VM restart. Without the adapter GLM in
# the VM shows the monitors as OFFLINE and volume control dies.
#
# Usage:
#   glm-adapter status             # where is the adapter + chain state
#   glm-adapter auto               # keep the adapter in the VM (timer entry point)
#   glm-adapter attach             # move the adapter into the VM (default)
#   glm-adapter host               # move the adapter back to the host (manual reserve)
#   glm-adapter verify             # check the control chain only
#   glm-adapter <cmd> --glm        # also OCR-check the GLM window inside the VM
#   glm-adapter health             # VM liveness only (guest RDP; `auto` heals it)
#
# Privileged unbind/bind calls use sudo — run `sudo -v` first to cache the
# credentials, or run interactively.
set -euo pipefail

VID=1781
PID=0e39
CT=windows
STATE=/tmp/genlc-volume
GENLC=/run/current-system/sw/bin/genlc
PRIV=/run/current-system/sw/bin/glm-adapter-priv
# pasta re-adds the host's 192.168.2.88 alias to the container's netns on every
# start; left there, the guest's packets to .88 are answered by the container
# instead of the host (see fix_vm_net below).
NETFIX="$HOME/.local/bin/glm-vm-netfix"
GREEN=$'\e[32m'; RED=$'\e[31m'; YELLOW=$'\e[33m'; NC=$'\e[0m'
DO_GLM=0
ARGS=()
for a in "$@"; do
  if [ "$a" = "--glm" ]; then DO_GLM=1; else ARGS+=("$a"); fi
done
set -- "${ARGS[@]}"

ok()   { echo -e "  ${GREEN}ok${NC}   $1"; }
warn() { echo -e "  ${YELLOW}!!${NC}  $1"; }
fail() { echo -e "  ${RED}xx${NC}   $1"; }

vm_running() { timeout 10 podman ps --format '{{.Names}} {{.Status}}' 2>/dev/null | awk '$1=="windows" && $2=="Up" {print 1; exit}'; }
# Adapter is in the VM when QEMU holds it via usbfs. Detect it in sysfs directly:
# the QEMU monitor 'info usb' query returns nothing in the dockur container (no nc),
# so qemu_usb() below used to return 0 and glm-adapter-auto ran + failed every 60 s.
qemu_usb() { local n=0; for d in /sys/bus/usb/devices/*/idVendor; do [ "$(cat "$d" 2>/dev/null)" = "$VID" ] || continue; dev=${d%/idVendor}; [ "$(cat "$dev/idProduct" 2>/dev/null)" = "$PID" ] || continue; for i in "$dev":1.*; do [ -e "$i" ] || continue; if [ -L "$i/driver" ] && readlink "$i/driver" | grep -q usbfs; then n=$((n+1)); fi; done; done; echo "$n"; [ "$n" -ge 1 ]; }
host_present(){ lsusb 2>/dev/null | grep -q "$VID:$PID"; }
host_genlc_ok(){ timeout 10 "$GENLC" discover >/dev/null 2>&1; }

# Container state, empty when the container is gone.
ct_state() { timeout 10 podman inspect -f '{{.State.Status}}' "$CT" 2>/dev/null || true; }

# Guest liveness on 127.0.0.1:3389 (pasta/passt hand the guest the host's own
# address). Two probes, because a bare TCP connect is not one: passt completes
# the handshake from its own stack, so the port stays "open" while the guest
# serves nothing at all — 2026-09-17: 14 h of `ok RDP answers` over a Windows
# stuck in WinRE (Automatic Repair). vm_rdp_port_open() is therefore only used to
# tell the two failure modes apart; vm_rdp_ok() is the liveness signal.
vm_rdp_port_open() { (exec 3<>/dev/tcp/127.0.0.1/3389) 2>/dev/null; }

# The real probe: an RDP server answers the X.224 Connection Request below with
# a Connection Confirm — a TPKT header (03 00 <len hi> <len lo>). It sends
# nothing on its own, so the request is required; a guest that is booting, stuck
# in WinRE or dead never answers, and a read timeout is what the liveness checks
# (and so the restarts) key on. RDP_STRIKES consecutive failures are still
# required (see vm_unhealthy) so a guest mid-reboot is not restarted.
RDP_READ_TIMEOUT=5
vm_rdp_ok() {
  local hdr
  exec 3<>/dev/tcp/127.0.0.1/3389 2>/dev/null || return 1
  # X.224 Connection Request without a cookie (0x13 bytes, neg RDP/SSL+hybrid).
  printf '\x03\x00\x00\x13\x0e\xe0\x00\x00\x00\x00\x00\x01\x00\x08\x00\x03\x00\x00\x00' >&3 2>/dev/null \
    || { exec 3<&- 3>&- 2>/dev/null; return 1; }
  hdr=$(timeout "$RDP_READ_TIMEOUT" head -c 4 <&3 2>/dev/null | od -An -tx1 | tr -d ' \n') || hdr=""
  exec 3<&- 3>&- 2>/dev/null || true
  case "$hdr" in 0300*) return 0 ;; esac
  return 1
}

# Seconds since the container was started, taken from the mtime of the netns file
# podman created for it: `.State.StartedAt` is Go-formatted ("… +0300 MSK") and
# `date -d` cannot be relied on to parse the timezone abbreviation in the minimal
# user-service environment. Fails (empty) when the netns file is gone.
vm_uptime() {
  local key started
  key=$(timeout 10 podman inspect -f '{{.NetworkSettings.SandboxKey}}' "$CT" 2>/dev/null) || return 1
  [ -n "$key" ] && [ -e "$key" ] || return 1
  started=$(stat -c %Y "$key" 2>/dev/null) || return 1
  echo $(( $(date +%s) - started ))
}

# `podman stop` returns as soon as the container is dead, but its rootfs is torn
# down after that (fuse-overlayfs unmount + conmon scope exit). A `start` landing
# inside that window loses the merged dir mid-boot — 2026-09-17 02:46:
#   power.sh: line 480: touch: command not found
#   server.sh: line 273: /usr/bin/rm: Transport endpoint is not connected
#   ❯ ERROR: QEMU exited unexpectedly!
# So wait for `exited`, for the overlay to be unmounted, and for conmon to be reaped.
wait_teardown() {
  local i st upper merged
  st=""
  for i in $(seq 1 60); do
    st=$(ct_state)
    if [ "$st" = "exited" ] || [ -z "$st" ]; then break; fi
    sleep 1
  done
  if [ -n "$st" ] && [ "$st" != "exited" ]; then
    warn "container '$CT' is still '$st' after 60 s"
    return 1
  fi
  upper=$(timeout 10 podman inspect -f '{{.GraphDriver.Data.UpperDir}}' "$CT" 2>/dev/null) || upper=""
  if [ -n "$upper" ]; then
    merged="${upper%/diff}/merged"
    for i in $(seq 1 30); do
      grep -qF "$merged" /proc/self/mountinfo 2>/dev/null || break
      sleep 1
    done
    if grep -qF "$merged" /proc/self/mountinfo 2>/dev/null; then
      warn "container rootfs is still mounted ($merged) — unmounting"
      fusermount3 -u "$merged" 2>/dev/null || warn "could not unmount $merged"
    fi
  fi
  sleep 2 # let conmon / the container scope finish exiting
}

# Screendump the guest through the QEMU monitor and OCR it; prints the path of the
# OCR text file. The monitor lives inside the container (/run/shm/monitor.sock),
# hence the exec + nc dance — and always `nc -N`: a plain `nc -U` never closes the
# connection, and the leftover clients make the monitor stop answering at all.
# Status 1 means "no picture": the tools are missing, the exec failed (dead
# plumbing) or the guest is not drawing.
vm_screen_text() {
  local base=${1:-/tmp/glm-vm-screen}
  command -v magick >/dev/null 2>&1 || return 1
  command -v tesseract >/dev/null 2>&1 || return 1
  timeout 20 podman exec "$CT" sh -c 'rm -f /dev/shm/glm-screen.ppm; printf "screendump /dev/shm/glm-screen.ppm\n" | timeout 5 nc -N -U /run/shm/monitor.sock' >/dev/null 2>&1 || return 1
  podman exec "$CT" sh -c 'cat /dev/shm/glm-screen.ppm' >"$base.ppm" 2>/dev/null || return 1
  podman exec "$CT" sh -c 'rm -f /dev/shm/glm-screen.ppm' >/dev/null 2>&1 || true
  [ -s "$base.ppm" ] || return 1
  magick "$base.ppm" -resize 1600x\> "$base.png" 2>/dev/null || return 1
  tesseract "$base.png" "$base" -l eng >/dev/null 2>&1 || true
  [ -s "$base.txt" ] || return 1
  echo "$base.txt"
}

# A guest sitting in Windows Recovery ("Automatic Repair — Your PC did not start
# correctly", Startup Repair, WinRE) answers no RDP, and a restart is no cure: it
# boots back into the same screen. On 2026-09-17 the VM spent 14 h there after an
# unclean shutdown (the host killed QEMU because dockur could not send ACPI) while
# the TCP-only probe kept reporting a healthy VM. Only a human can click through
# WinRE, so cmd_auto pages instead of restarting when the screen shows this.
vm_recovery_screen() {
  local txt
  txt=$(vm_screen_text /tmp/glm-vm-recovery) || return 1
  grep -qiE 'automatic repair|did not start correctly|startup repair|recovery|winre' "$txt" 2>/dev/null
}

# One stop → teardown → start cycle; 0 when the container is back up with the
# adapter attached. Split out of vm_restart so a cycle killed by a straggler
# podman operation can be retried once.
vm_cycle() {
  timeout 180 podman stop "$CT" >/dev/null 2>&1 || warn "podman stop '$CT' failed — starting anyway"
  wait_teardown || warn "teardown did not finish cleanly — starting anyway"
  timeout 120 podman start "$CT" >/dev/null 2>&1 || {
    fail "podman start '$CT' failed"
    return 1
  }
  # A start that a straggler podman operation kills dies within seconds (on
  # 2026-09-17 02:46:39 the fresh container was dead 0.3 s after start), so wait
  # before believing it — and before touching the netns of a dead container.
  sleep 5
  [ "$(vm_running)" = 1 ] || return 1
  fix_vm_net
  # qemu_usb alone lies here: the dying QEMU still holds the adapter for a few
  # seconds, so on 02:46 the restart reported "ok adapter attached" while the
  # container was already dead. Require a running container as well.
  for i in $(seq 1 28); do
    if [ "$(vm_running)" = 1 ] && [ "$(qemu_usb)" -ge 1 ]; then return 0; fi
    sleep 2
  done
  return 1
}


# A fresh QEMU is the only thing that opens a passed-through device again (see
# the header), so a lost adapter is healed by restarting the VM. Rate-limited
# with a leaky bucket: a flapping adapter must not turn into a reboot loop, but
# a second flap minutes later should still recover instead of locking the VM out
# until a cooldown expires.
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/glm-adapter"
RESTART_LOG="$STATE_DIR/restart.log"
NOTIFY_STATE="$STATE_DIR/notify-state"
RESTART_MAX_PER_HOUR=3

# RDP liveness probe — see vm_unhealthy(): the guest's RDP port, two consecutive
# strikes (a Windows Update reboot closes it too), never a fresh container.
RDP_GRACE=300
RDP_STRIKES=2
RDP_STRIKES_FILE="$STATE_DIR/rdp.strikes"

# Telegram goes through the root-side webhook bridge that already serves
# Alertmanager (telegram-alert-bridge on 127.0.0.1:9094): it owns the SOPS
# secrets, while this script runs as the login user and cannot read them.
# Override the endpoint with GLM_NOTIFY_BRIDGE, set it empty to stay silent.
GLM_NOTIFY_BRIDGE=${GLM_NOTIFY_BRIDGE-http://127.0.0.1:9094}
notify() {
  local status=$1 msg=$2 payload
  [ -n "$GLM_NOTIFY_BRIDGE" ] || return 0
  payload=$(jq -nc --arg s "$status" --arg m "$msg"     '{alerts:[{status:$s,labels:{alertname:"GLM adapter",severity:"info"},annotations:{summary:$m}}]}') || return 0
  curl -s -m 10 -X POST -H 'Content-Type: application/json' --data "$payload" "$GLM_NOTIFY_BRIDGE" >/dev/null 2>&1 \
    || warn "telegram notification failed (bridge $GLM_NOTIFY_BRIDGE)"
}

# Edge-triggered: the auto timer runs every 60 s, a flapping adapter must not
# turn into a message storm. notify_reset re-arms the next notification.
notify_once() {
  mkdir -p "$STATE_DIR"
  if [ -f "$NOTIFY_STATE" ] && [ "$(cat "$NOTIFY_STATE" 2>/dev/null)" = "$1" ]; then
    return 0
  fi
  echo "$1" > "$NOTIFY_STATE"
  notify "$2" "$3"
}

notify_reset() {
  mkdir -p "$STATE_DIR"
  echo "ok" > "$NOTIFY_STATE"
}

# pasta copies the host uplink's whole address list into the container ('--config-net'),
# including the 192.168.2.88 alias the VM must reach the host on: while it is in the
# container, the guest's packets to .88 are answered by the container itself
# ("Connection refused") and the MIDI bridge holds a dead connection while still
# printing "connected to host relay". The normal start path is covered by ExecStartPost
# of windows-vm.service; this covers the restarts glm-adapter performs itself.
fix_vm_net() {
  local out
  if [ ! -x "$NETFIX" ]; then
    warn "glm-vm-netfix not found ($NETFIX) — the VM may lose the route to :9003"
    return 0
  fi
  if out=$(timeout 90 "$NETFIX" "$CT" 2>&1); then
    [ -z "$out" ] || printf '%s\n' "$out" | sed 's/^/       /'
  else
    warn "glm-vm-netfix failed: $out"
  fi
}

# The dockur container can be `Up` with its host-side plumbing already dead: qemu
# keeps running, so `podman ps` stays green while the pasta helper that owns the
# published ports is gone — nothing listens on 127.0.0.1:3389/8006, every
# `podman exec` fails with `crun: open …: Transport endpoint is not connected`,
# and the MIDI bridge/proxy lose the guest (2026-09-17 03:00 → 04:25: a `start`
# landing next to a straggler stop left the VM unreachable for 1.5 h while
# glm-adapter-auto kept reporting a healthy VM). Only a fresh stop+start brings
# the plumbing back, so the RDP port is the liveness probe for the container as a
# whole: a Windows Update reboot also closes :3389, hence RDP_STRIKES consecutive
# failures, and a container younger than RDP_GRACE is never touched, so a booting
# guest cannot be restarted mid-flight.
#
# 0 = the VM looks dead (cmd_auto restarts it); 1 = alive, too young to judge, or
# strikes not reached yet. A manual `glm-adapter health` only reports.
vm_unhealthy() {
  local now count up
  [ "$(vm_running)" = 1 ] || return 1
  if vm_rdp_ok; then
    rm -f "$RDP_STRIKES_FILE"
    return 1
  fi
  # An unreadable uptime (netns file gone) must not look like a young container —
  # that is exactly the broken-plumbing case this check exists for.
  up=$(vm_uptime) || up=""
  if [ -n "$up" ] && [ "$up" -lt "$RDP_GRACE" ]; then
    rm -f "$RDP_STRIKES_FILE"
    return 1
  fi
  mkdir -p "$STATE_DIR"
  now=$(date +%s)
  count=0
  if [ -f "$RDP_STRIKES_FILE" ]; then
    count=$(cat "$RDP_STRIKES_FILE" 2>/dev/null) || count=0
    case $count in '' | *[!0-9]*) count=0 ;; esac
    # A gap longer than 10 min (timer stopped, machine suspended) re-arms the count.
    if [ $((now - $(stat -c %Y "$RDP_STRIKES_FILE" 2>/dev/null || echo "$now"))) -ge 600 ]; then
      count=0
    fi
  fi
  count=$((count + 1))
  printf '%s\n' "$count" > "$RDP_STRIKES_FILE"
  [ "$count" -ge "$RDP_STRIKES" ]
}

vm_restart() {
  local now recent i why okmsg
  why="${1:-адаптер не в VM}"
  okmsg="${2:-ok, адаптер в VM}"
  mkdir -p "$STATE_DIR"
  # One restart at a time: the 60 s timer and a manual `glm-adapter attach` can
  # otherwise run two stop/start sequences on the same container — the very race
  # wait_teardown() exists for.
  exec 8>"$STATE_DIR/restart.lock"
  if ! flock -n 8; then
    warn "another restart is already in progress — skipping"
    return 1
  fi
  now=$(date +%s)
  recent=0
  if [ -f "$RESTART_LOG" ]; then
    recent=$(awk -v now="$now" '$1 > now - 3600' "$RESTART_LOG" | wc -l)
    if awk -v now="$now" '$1 > now - 3600' "$RESTART_LOG" > "$RESTART_LOG.new"; then
      mv "$RESTART_LOG.new" "$RESTART_LOG"
    fi
  fi
  if [ "$recent" -ge "$RESTART_MAX_PER_HOUR" ]; then
    warn "VM restart suppressed: $recent restarts within the last hour"
    notify_once "suppressed" firing "$recent рестарта за час → не трогаю ($why)"
    return 1
  fi
  warn "restarting VM '$CT' ($why)"
  notify firing "рестарт: $why"
  echo "$now" >> "$RESTART_LOG"
  # stop + start, not `podman restart`: an automatic restart was followed by a
  # container with only `lo` inside and an empty route table (no pasta tap, no
  # copied host addresses), so nothing the guest sent could reach the host
  # (:9003 relay, 10811/10812 proxy) and the MIDI bridge kept a dead connection.
  # An explicit stop + start is the sequence that was verified to bring the
  # pasta interface (net1) and its addresses back. The stop must also be
  # *finished* (rootfs unmounted, conmon reaped) before the start — wait_teardown().
  if ! vm_cycle; then
    warn "VM did not come back up — retrying the restart once"
    if ! vm_cycle; then
      fail "container '$CT' is not up with the adapter attached after two restarts (podman logs windows)"
      notify_once "failed" firing "рестарт не помог: $why"
      return 1
    fi
  fi
  notify resolved "$okmsg"
  notify_reset
  return 0
}

adapter_dev() {
  for d in /sys/bus/usb/devices/*/idVendor; do
    [ "$(cat "$d" 2>/dev/null)" = "$VID" ] || continue
    dev=${d%/idVendor}
    [ "$(cat "$dev/idProduct" 2>/dev/null)" = "$PID" ] || continue
    echo "$dev"; return 0
  done
  return 1
}

check_glm_vm() {
  # Best-effort: screendump the VM and OCR the GLM window for OFFLINE.
  local txt
  [ "$(vm_running)" = 1 ] || { warn "VM not running — skipping GLM screen check"; return; }
  if ! txt=$(vm_screen_text /tmp/glm-adapter-shot); then
    warn "could not OCR the VM screen (magick/tesseract missing, plumbing dead or the guest is not drawing)"
    return
  fi
  if grep -q -i 'offline' "$txt" 2>/dev/null; then
    fail "GLM in the VM shows OFFLINE — click Reconnect in GLM (or replug the adapter)"
  else
    ok "no OFFLINE detected on the VM screen (GLM online?)"
    grep -o -E '\-?[0-9]+(\.[0-9]+)? ?dB' "$txt" 2>/dev/null | head -3 | sed 's/^/       GLM dB: /' || true
  fi
}






verify_chain() {
  echo "--- control chain ---"
  if ss -tln 2>/dev/null | grep -q ':9003 '; then ok "relay listening :9003 (glm-midi-relay)"; else warn "relay not listening on :9003"; fi
  if ss -tln 2>/dev/null | grep -q ':9004 '; then ok "relay listening :9004 (glm-midi)"; else warn "relay not listening on :9004"; fi
  if [ "$(vm_running)" = 1 ] && ! vm_rdp_port_open; then warn "VM is Up but nothing accepts on :3389 — the host-side plumbing is gone (see glm-adapter health)"; fi
  if ss -tn 2>/dev/null | grep -q ':9003 '; then ok "VM bridge connected to :9003"; else warn "VM bridge NOT connected (check Windows autostart)"; fi
  if [ -f "$STATE" ]; then echo "       state: $(cat "$STATE") dB (quickshell display)"; else warn "no state file $STATE"; fi
  if [ "$DO_GLM" = 1 ]; then check_glm_vm; fi
}

cmd_status() {
  echo "=== GLM adapter location ==="
  if host_present; then echo "  host: adapter present on host USB"; else echo "  host: no adapter on host USB"; fi
  if host_genlc_ok; then ok "host genlc: adapter usable"; else fail "host genlc: adapter NOT usable"; fi
  if [ "$(vm_running)" = 1 ]; then
    n=$(qemu_usb) || true
    if [ "$n" -ge 1 ]; then ok "VM: adapter attached ($n)"; else fail "VM: adapter NOT attached"; fi
  else
    echo "  VM: not running (adapter should be on the host)"
  fi
  echo ""
  verify_chain
  echo ""
  # genlc-diagnose only makes sense when the adapter is physically on the host
  # (a genlc failure with the adapter inside the VM is expected, not a bug).
  if host_present && ! host_genlc_ok && { [ "$(vm_running)" != 1 ] || [ "$(qemu_usb)" -lt 1 ]; }; then
    echo "--- host genlc diagnostics (adapter on host but genlc fails) ---"
    if [ -x /etc/nixos/packages/local-bin/scripts/genlc-diagnose ]; then
      /etc/nixos/packages/local-bin/scripts/genlc-diagnose 2>/dev/null | tail -15 || true
    else
      echo "  (genlc-diagnose not found)"
    fi
  elif host_present && host_genlc_ok; then
    ok "host genlc works — no diagnostics needed"
  fi
}

cmd_attach() {
  if [ "$(vm_running)" != 1 ]; then
    fail "VM '$CT' is not running — start it first: docker start windows"
    return 1
  fi
  echo "=== attaching adapter to the VM ==="
  if [ "$(qemu_usb)" -ge 1 ] && ! host_genlc_ok; then
    ok "adapter already inside the VM"
    verify_chain
    return 0
  fi
  dev=$(adapter_dev || true)
  if [ -z "$dev" ]; then
    fail "adapter not found on the host USB — is it plugged in?"
    return 1
  fi
  # Unbind usbhid so QEMU could claim the device via usbfs (NOPASSWD helper).
  # QEMU does not re-claim a device it has lost (no libusb hotplug inside the
  # container), so fall back to the one action that does work: a fresh VM.
  warn "unbinding usbhid from the adapter"
  sudo "$PRIV" to-vm 2>/dev/null || true
  sleep 4
  if [ "$(qemu_usb)" -ge 1 ]; then
    ok "adapter attached to the VM"
  elif vm_restart; then
    ok "adapter attached to the VM (after restarting $CT)"
  else
    fail "adapter still not attached — check the USB cable/port, then retry"
    return 1
  fi
  if host_genlc_ok; then
    warn "host genlc still sees the adapter (dual claim?)"
  else
    ok "host genlc no longer sees the adapter (expected)"
  fi
  verify_chain
}

cmd_auto() {
  # VM-primary policy: the VM is the everyday GLM control path, so the adapter
  # belongs to the VM whenever the VM runs and never moves back to the host on
  # its own (host control stays available manually: `glm-adapter host`).
  # Idempotent — this is the entry point of the glm-adapter-auto timer.
  # Liveness first: with dead pasta/netns plumbing the container is Up while
  # nothing can reach the guest, and that has to be fixed before an adapter check
  # is meaningful (see vm_unhealthy).
  if vm_unhealthy; then
    # Two failure modes hide behind a dead RDP probe. Either nothing accepts on
    # the port — the host-side plumbing died and a restart is the cure — or passt
    # still accepts while the guest serves nothing: Windows is stuck in WinRE
    # (Automatic Repair after an unclean shutdown, see vm_recovery_screen).
    # Restarting that guest is useless (it boots back into the same screen) and
    # would only burn the hourly restart budget, so page the user instead. The
    # screen is OCRed only once the strikes are in, i.e. at most once a minute.
    if vm_rdp_port_open && vm_recovery_screen; then
      rm -f "$RDP_STRIKES_FILE"
      warn "guest is on a recovery screen (WinRE/Automatic Repair) — a VM restart cannot fix it"
      notify_once "recovery" firing "Windows застряла в WinRE (Automatic Repair) — нужен ручной восстановительный запуск: http://127.0.0.1:8006"
      return 0
    fi
    warn "VM '$CT' is Up but 127.0.0.1:3389 does not answer — the host-side plumbing is gone"
    if vm_restart "RDP мёртв → обвязка pasta умерла" "ok, pasta поднят, Windows грузится"; then
      rm -f "$RDP_STRIKES_FILE"
      ok "VM restarted — the guest is booting, RDP answers within ~1-2 min"
    fi
    return 0






  fi
  if [ "$(vm_running)" != 1 ]; then
    notify_reset
    return 0
  fi
  if [ "$(qemu_usb)" -ge 1 ]; then
    notify_reset
    return 0
  fi
  if ! host_present; then
    warn "adapter is not on the host USB — restarting the VM would not help"
    notify_once "missing" firing "адаптера нет на USB"
    return 0
  fi
  if vm_restart; then
    ok "adapter attached to the VM (after restarting $CT)"
    verify_chain
  else
    fail "adapter still not attached — check the USB cable/port"
    return 1
  fi
}

cmd_host() {
  echo "=== moving adapter to the host ==="
  if host_present || [ "$(qemu_usb)" -ge 1 ]; then
    # Release from QEMU (usbfs), then bind usbhid for host genlc control.
    warn "releasing from QEMU and binding usbhid"
    sudo "$PRIV" to-host 2>/dev/null || true
  else
    warn "adapter not found on the host USB"
  fi
  sleep 3
  if host_genlc_ok; then ok "host genlc: adapter usable"; else fail "host genlc: adapter NOT usable"; fi
}

cmd_verify() { verify_chain; }

# Liveness only: `auto` heals (restarts), this reports — the manual counterpart of
# vm_unhealthy(), plus the published port of the web viewer.
cmd_health() {
  echo "=== VM liveness ==="
  if [ "$(vm_running)" != 1 ]; then
    echo "  VM: not running"
    return 0
  fi
  echo "  VM: Up for $(vm_uptime || echo '?') s"
  if vm_rdp_ok; then
    ok "RDP 127.0.0.1:3389 answers (guest is serving RDP)"
  elif vm_rdp_port_open; then
    # passt accepts from its own stack, so this happens while the guest is dead
    # or still booting — it is exactly the state the TCP-only probe used to call
    # healthy (see vm_rdp_ok).
    fail "RDP port accepts but the guest sends nothing — Windows is not up (booting, or a recovery screen)"
    if vm_recovery_screen; then
      fail "VM screen shows WinRE (Automatic Repair) — click Restart/Startup Repair at http://127.0.0.1:8006, a VM restart will not help"
    fi
  else
    fail "RDP 127.0.0.1:3389 does not accept — host-side plumbing gone ('glm-adapter auto' restarts the VM)"
  fi
  if ss -tln 2>/dev/null | grep -q ':8006 '; then ok "web viewer listening on :8006"; else warn "web viewer not listening on :8006"; fi
  if [ -f "$RDP_STRIKES_FILE" ]; then
    echo "       consecutive RDP failures: $(cat "$RDP_STRIKES_FILE") (restart at $RDP_STRIKES)"
  fi
}

case "${1:-attach}" in
  status) cmd_status ;;
  auto) cmd_auto ;;
  attach) cmd_attach ;;
  host|detach) cmd_host ;;
  verify) cmd_verify ;;
  health) cmd_health ;;
  *) echo "usage: $0 {status|auto|attach|host|verify|health} [--glm]" >&2; exit 1 ;;
esac
