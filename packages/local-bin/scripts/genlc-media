#!/usr/bin/env bash
# Genelec SAM volume control — keyboard wheel (hyprland/sway media keys).
# Host path: genlc via the GLM USB adapter (dockur VM off).
# VM path:   glm-midi CC over the TCP relay when the adapter is inside the VM.
# Writes state file instantly for QML sync. Batches genlc calls via debounce.
set -euo pipefail

STATE=/tmp/genlc-volume
STEP_DB=0.5
DEBOUNCE_PID=/tmp/genlc-media.debounce.pid
DEBOUNCE_MS=60

# Adapter placement probe: genlc discover exits 0 only when the adapter is on
# the host (dockur VM off). It is cheap (~10ms), so probe on every call.
if genlc discover >/dev/null 2>&1; then
  MODE=host
else
  MODE=vm
fi

case "${1:-}" in
  up|down)
    current=-40.0
    [ -f "$STATE" ] && current=$(cat "$STATE" 2>/dev/null || echo -40.0) || true

    # Snap to the nearest 0.5 dB, then hard-clamp to the safe range [-95,-20].
    # The clamp is applied to BOTH the current state and the target so a stale
    # state (e.g. GLM session restore above -20, or drift while the relay was
    # down) can never push the monitors louder than -20 dB.
    current=$(awk "BEGIN { c=$current; printf \"%.1f\", int(c * 2 + (c < 0 ? -0.5 : 0.5)) / 2 }")
    current=$(awk "BEGIN { c=$current; if (c > -20.0) c=-20.0; if (c < -95.0) c=-95.0; printf \"%.1f\", c }")
    if [ "$1" = "up" ]; then
      target=$(awk "BEGIN { printf \"%.1f\", $current + $STEP_DB }")
    else
      target=$(awk "BEGIN { printf \"%.1f\", $current - $STEP_DB }")
    fi
    capped=$(awk "BEGIN { c=$target; if (c > -20.0) c=-20.0; if (c < -95.0) c=-95.0; printf \"%.1f\", c }")

    if [ "$MODE" = "vm" ]; then
      # VM path: only write the target — the quickshell widget's FileView
      # picks it up and sends via the SAME relative C21/C22 path as the wheel
      # (_commitAndSend), so keyboard and wheel share one code path.
      echo "$capped" > "$STATE"
    else
      # Host path: genlc set-volume (0.5 dB), batched by debounce.
      # Write state first — QML picks up via stateReader, display updates.
      echo "$capped" > "$STATE"
      [ -f "$DEBOUNCE_PID" ] && kill "$(cat "$DEBOUNCE_PID")" 2>/dev/null || true
      (
        sleep 0.06
        genlc set-volume --volume "$(cat "$STATE")dB" 2>/dev/null
      ) &
      echo $! > "$DEBOUNCE_PID"
    fi
    ;;
  mute)
    if [ "$MODE" = "vm" ]; then
      /home/neg/.local/bin/glm-midi mute >/dev/null 2>&1 || true
    else
      genlc set-volume --volume -95dB 2>/dev/null &
    fi
    ;;
  *) exit 1 ;;
esac
