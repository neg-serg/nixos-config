#!/usr/bin/env bash
# Genelec SAM volume control — keyboard wheel (Hyprland media keys via swayosd).
# Host path: genlc via the GLM USB adapter (dockur VM off).
# VM path:   glm-midi CC over the TCP relay when the adapter is inside the VM.
# Writes state file instantly for QML sync. Batches genlc calls via debounce.
set -euo pipefail

# The state file is per-user session state, not a system-wide temporary: it used
# to be the fixed /tmp/genlc-volume, which is a symlink-attack and cross-user
# collision surface and survives the session it belongs to. XDG_RUNTIME_DIR is
# cleared on logout, is 0700, and is what every other per-session file here uses.
RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
STATE="$RUNTIME_DIR/genlc-volume"
STEP_DB=1   # whole dB only (GLM CC20 is integer)
DEBOUNCE_PID="$RUNTIME_DIR/genlc-media.debounce.pid"
DEBOUNCE_MS=60

# Adapter placement probe: genlc discover exits 0 only when the adapter is on
# the host (dockur VM off). It is cheap (~10ms), so probe on every call.
if genlc discover >/dev/null 2>&1; then
  MODE=host
else
  MODE=vm
fi

case "${1:-}" in
  up|down)
    # Seed from the state file, and on a fresh session (XDG_RUNTIME_DIR is wiped on logout, so the
    # file is not there yet) from `glm-vol read`, which falls back to the last shell's cache. The
    # bare -40 used to be the answer, and the first notch of a session then pushed the monitors
    # from wherever they stood — -54 here — fifteen dB louder.
    current=$(glm-vol read 2>/dev/null || echo -40)

    # Snap to whole dB, then hard-clamp to the safe range [-95,-20].
    # The clamp is applied to BOTH the current state and the target so a stale
    # state (e.g. GLM session restore above -20, or drift while the relay was
    # down) can never push the monitors louder than -20 dB.
    current=$(awk "BEGIN { c=$current; printf \"%.0f\", c }")
    current=$(awk "BEGIN { c=$current; if (c > -20.0) c=-20.0; if (c < -95.0) c=-95.0; printf \"%.0f\", c }")
    if [ "$1" = "up" ]; then
      target=$(awk "BEGIN { printf \"%.0f\", $current + $STEP_DB }")
    else
      target=$(awk "BEGIN { printf \"%.0f\", $current - $STEP_DB }")
    fi
    capped=$(awk "BEGIN { c=$target; if (c > -20.0) c=-20.0; if (c < -95.0) c=-95.0; printf \"%.0f\", c }")

    if [ "$MODE" = "vm" ]; then
      # VM path: the state file is the shared target — the pleamar plugin polls it every 2 s —
      # but nothing *sends* it any more. The Quickshell FileView this leaned on left with the
      # tree, and the plugin adopts a polled value without committing it on purpose (the wheel is
      # what decides), so the knob moved the number and the monitors stayed put. Send the
      # absolute CC20 here, coalesced the way the host branch batches `genlc`, because GLM drops
      # messages that arrive in a burst.
      echo "$capped" > "$STATE"
      [ -f "$DEBOUNCE_PID" ] && kill "$(cat "$DEBOUNCE_PID")" 2>/dev/null || true
      (
        sleep 0.06
        /home/neg/.local/bin/glm-midi volume "$(cat "$STATE")dB" >/dev/null 2>&1 || true
      ) &
      echo $! > "$DEBOUNCE_PID"
    else
      # Host path: genlc set-volume (whole dB), batched by debounce.
      # Write state first — QML picks up via stateReader, display updates.
      echo "$capped" > "$STATE"
      [ -f "$DEBOUNCE_PID" ] && kill "$(cat "$DEBOUNCE_PID")" 2>/dev/null || true
      (
        sleep 0.06
        genlc set-volume --volume "$(cat "$STATE")dB" 2>/dev/null
      ) &
      echo $! > "$DEBOUNCE_PID"
    fi
    ;;
  mute)
    if [ "$MODE" = "vm" ]; then
      /home/neg/.local/bin/glm-midi mute >/dev/null 2>&1 || true
    else
      genlc set-volume --volume -95dB 2>/dev/null &
    fi
    ;;
  *) exit 1 ;;
esac
