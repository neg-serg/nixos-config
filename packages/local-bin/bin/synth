#!/usr/bin/env bash
# synth — run-or-raise / start for a carla-hosted synth (Hyprland-friendly).
#
# If the synth's engine is running (events-in port present): focus its window
# if there is one, otherwise report it as running (headless).
# If not running: start it headless via carlactl play (wires Osmose/RME MIDI
# + audio + Tidal slot). Headless = stable (the Qt UI variant segfaults).
#
# Usage: synth <plugin>        e.g.  synth Surge_XT | synth LegendHZ
set -euo pipefail

name="${1:?usage: synth <plugin>}"
plain=$(printf '%s' "$name" | sed 's/^vst[23]://; s/  */_/g')
# the events-in port name uses spaces: "Surge XT:events-in"
port_name="${plain//_/ }:events-in"

engine_up() {
  pw-cli ls Port 2>/dev/null | rg -qi "${port_name}"
}

find_win() {
  hyprctl clients -j 2>/dev/null | jq -r --arg t "$plain"     '.[] | select(.class=="carla" and (.title|contains($t))) | .address' | head -1
}

if engine_up; then
  win=$(find_win)
  if [ -n "$win" ]; then
    hyprctl dispatch focuswindow "address:$win" >/dev/null 2>&1 || true
    echo "synth: $name raised"
  else
    echo "synth: $name already running (headless)"
  fi
  exit 0
fi

echo "synth: starting $name (headless) ..."
carlactl play "vst3:$name"

for _ in $(seq 1 60); do
  engine_up && break
  sleep 1
done
engine_up && echo "synth: $name ready (headless, wired)"   || echo "synth: FAILED to start $name" >&2
