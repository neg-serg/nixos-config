#!/bin/sh
# pic-notify: screenshot notification bridge to quickshell ScreenshotToast.
# Usage: pic-notify IMAGE
#   Extracts dimensions, size, depth from PNG header (identify -ping, fast).
#   Copies path to clipboard and writes a JSON event for quickshell.
#   quickshell ScreenshotToast watches the event file and shows the card UI.


IFS=' 	
'
img="${1:-}"
if [ -z "${img}" ] || [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  sed -n '2,7p' "$0" | sed 's/^# \{0,1\}//'
  exit 1
fi

# ── Clipboard ──────────────────────────────────────────────────────────────
echo "$img" | sed -e "s/.bmp$/.png/" | wl-copy

# ── Metadata (fast: header-only) ───────────────────────────────────────────
w=0; h=0; depth=""; chan_raw=0; chan=-1
if command -v identify >/dev/null 2>&1; then
  read -r w h depth chan_raw _ 2>/dev/null <<-EOF
	$(identify -ping -format '%w %h %z %[channels]' "$img" 2>/dev/null)
	EOF
  [ -z "$w" ] && { w=0; h=0; depth=""; chan_raw=0; }
  chan=$(echo "$chan_raw" | awk '{print $NF}')  # %[channels] includes colorspace prefix
  [ -z "$chan" ] && chan=-1
fi

# ── File size (human-readable) ─────────────────────────────────────────────
size_bytes=$(stat -c %s "$img" 2>/dev/null || echo 0)
if   [ "$size_bytes" -ge 1073741824 ]; then
  size_hr=$(awk "BEGIN { printf \"%.1f GB\", $size_bytes / 1073741824 }")
elif [ "$size_bytes" -ge 1048576 ]; then
  size_hr=$(awk "BEGIN { printf \"%.2f MB\", $size_bytes / 1048576 }")
else
  size_hr=$(awk "BEGIN { printf \"%.0f KB\", $size_bytes / 1024 }")
fi

# ── Depth description ──────────────────────────────────────────────────────
depth_str=""
if [ -n "$depth" ] && [ "$chan" -ge 1 ] 2>/dev/null; then
  case "$chan" in
    1) cn="Gray";;
    2) cn="Gray+Alpha";;
    3) cn="RGB";;
    4) cn="RGBA";;
    *) cn="${chan}ch";;
  esac
  depth_str="${depth}-bit ${cn}"
elif [ -n "$depth" ]; then
  depth_str="${depth}-bit"
fi

# ── Timestamp from filename or stat ────────────────────────────────────────
ts=""
base=$(basename "$img")
if echo "$base" | grep -qE '[0-9]{8}-[0-9]{2}\.[0-9]{2}\.[0-9]{2}'; then
  raw=$(echo "$base" | grep -oE '[0-9]{8}-[0-9]{2}\.[0-9]{2}\.[0-9]{2}')
  ts=$(echo "$raw" | sed 's/\(....\)\(..\)\(..\)-\(..\)\.\(..\)\.\(..\)/\1-\2-\3 \4:\5:\6/')
fi
[ -z "$ts" ] && ts=$(date -d "@$(stat -c %Y "$img" 2>/dev/null)" '+%F %T' 2>/dev/null || echo "")

# ── Write JSON event for quickshell ScreenshotToast ────────────────────────
event_dir="${HOME}/.cache/quickshell"
mkdir -p "$event_dir"

# Escape path for JSON (only backslash and double-quote need escaping for the path field)
escaped_path=$(printf '%s' "$img" | sed 's/\\/\\\\/g; s/"/\\"/g')

# Write JSON atomically via temp + mv so FileView sees a single change
tmp="${event_dir}/.screenshot-event.json.tmp"
cat > "$tmp" <<JSON
{
  "path": "${escaped_path}",
  "w": ${w:-0},
  "h": ${h:-0},
  "sizeHr": "${size_hr}",
  "depth": "${depth_str}",
  "ts": "${ts}"
}
JSON
mv "$tmp" "${event_dir}/screenshot-event.json"

# ── Fallback: also send via dunst if quickshell not running ───────────────
if ! pgrep -f "quickshell" >/dev/null 2>&1; then
  if command -v notify-send >/dev/null 2>&1; then
    short=$(echo "$img" | sed "s|$HOME|~|")
    notify-send -h "string:fgcolor:#6C7E96" -a "screenshot" -i "$img" \
      "📸 Screenshot" \
      "${w}×${h}  ·  ${size_hr}${depth_str:+  ·  ${depth_str}}\n${short}"
  fi
fi
