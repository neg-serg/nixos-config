#!/bin/sh
# pic-notify: screenshot notification bridge to quickshell ScreenshotToast.
# Usage: pic-notify IMAGE
#   Extracts dimensions, size, depth from PNG header (identify -ping, fast).
#   Copies path to clipboard, writes JSON data + touches semaphore for quickshell.
#   Falls back to notify-send when quickshell does not answer its IPC.


IFS=' 	
'
img="${1:-}"
if [ -z "${img}" ] || [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'
  exit 1
fi

# ── Clipboard ──────────────────────────────────────────────────────────────
echo "$img" | sed -e "s/.bmp$/.png/" | wl-copy

# ── Metadata (fast: header-only) ───────────────────────────────────────────
# %[channels] is a bare count on ImageMagick 6 and a channel-set name plus a
# count on 7 ("srgba 4.0"). Take the trailing number when it is one, and fall
# back to the name so the label survives both spellings.
channel_label() {
  n=""
  for tok in $1; do
    case $tok in
      *.*) tok=${tok%%.*} ;;
    esac
    case $tok in
      ""|*[!0-9]*) ;;
      *) n=$tok ;;
    esac
  done
  case ${n:-} in
    1) printf 'Gray' ;;
    2) printf 'Gray+Alpha' ;;
    3) printf 'RGB' ;;
    4) printf 'RGBA' ;;
    "") case $1 in
          srgba*|rgba*) printf 'RGBA' ;;
          graya*|greya*) printf 'Gray+Alpha' ;;
          gray*|grey*) printf 'Gray' ;;
          srgb*|rgb*) printf 'RGB' ;;
        esac ;;
    *) printf '%sch' "$n" ;;
  esac
}

w=0; h=0; depth=""; chan_raw=""; cn=""
if command -v identify >/dev/null 2>&1; then
  read -r w h depth chan_raw 2>/dev/null <<-EOF
	$(identify -ping -format '%w %h %z %[channels]' "$img" 2>/dev/null)
	EOF
  [ -z "$w" ] && { w=0; h=0; depth=""; chan_raw=""; }
  cn=$(channel_label "$chan_raw")
fi

# ── File size (human-readable) ─────────────────────────────────────────────
size_bytes=$(stat -c %s "$img" 2>/dev/null || echo 0)
if   [ "$size_bytes" -ge 1073741824 ]; then
  size_hr=$(awk "BEGIN { printf \"%.1f GB\", $size_bytes / 1073741824 }")
elif [ "$size_bytes" -ge 1048576 ]; then
  size_hr=$(awk "BEGIN { printf \"%.2f MB\", $size_bytes / 1048576 }")
else
  size_hr=$(awk "BEGIN { printf \"%.0f KB\", $size_bytes / 1024 }")
fi

# ── Depth description ──────────────────────────────────────────────────────
depth_str=""
if [ -n "$depth" ]; then
  depth_str="${depth}-bit${cn:+ $cn}"
fi

# ── Timestamp from filename or stat ────────────────────────────────────────
ts=""
base=$(basename "$img")
if echo "$base" | grep -qE '[0-9]{8}-[0-9]{2}\.[0-9]{2}\.[0-9]{2}'; then
  raw=$(echo "$base" | grep -oE '[0-9]{8}-[0-9]{2}\.[0-9]{2}\.[0-9]{2}')
  ts=$(echo "$raw" | sed 's/\(....\)\(..\)\(..\)-\(..\)\.\(..\)\.\(..\)/\1-\2-\3 \4:\5:\6/')
fi
[ -z "$ts" ] && ts=$(date -d "@$(stat -c %Y "$img" 2>/dev/null)" '+%F %T' 2>/dev/null || echo "")

# ── Write JSON event + semaphore for quickshell ScreenshotToast ────────────
event_dir="${HOME}/.cache/quickshell"
mkdir -p "$event_dir"

escaped_path=$(printf '%s' "$img" | sed 's/\\/\\\\/g; s/"/\\"/g')

tmp="${event_dir}/.screenshot-event.json.tmp"
cat > "$tmp" <<JSON
{
  "path": "${escaped_path}",
  "w": ${w:-0},
  "h": ${h:-0},
  "sizeHr": "${size_hr}",
  "depth": "${depth_str}",
  "ts": "${ts}"
}
JSON
mv "$tmp" "${event_dir}/screenshot-event.json"
touch "${event_dir}/screenshot-event"   # semaphore for FileView

# ── Fallback: notify-send when quickshell cannot serve the toast ───────────
# A running process is not a serving shell: `pgrep -f quickshell` also passed for
# the wedged instance of 2026-10-13, and the toast then never appeared at all.
# One IPC round-trip is the real liveness test; `timeout` keeps a hung socket
# from stalling the screenshot pipeline.
if ! timeout 2 quickshell ipc show >/dev/null 2>&1; then
  if command -v notify-send >/dev/null 2>&1; then
    short=$(echo "$img" | sed "s|$HOME|~|")
    body="${w}×${h}  ·  ${size_hr}"
    [ -n "$depth_str" ] && body="${body}  ·  ${depth_str}"
    body="${body}\n${short}"
    [ -n "$ts" ] && body="${body}\n${ts}"
    notify-send -h "string:fgcolor:#6C7E96" -a "screenshot" -i "$img" \
      "📸 Screenshot" "$body"
  fi
fi
