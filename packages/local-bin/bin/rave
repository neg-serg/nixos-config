#!/bin/sh
# rave: neural audio VAE (acids-ircam RAVE v2) — encode/decode audio through a
# trained model. Models in /zero/ai/music/rave (guitar_iil 48k, VCTK speech,
# crozzoli ensemble).
# Usage: rave <model.ts> <input.wav> <output.wav>
set -eu

BASE="/zero/ai/music-ai"
TORCHLIB="$BASE/venv-rave311/lib/python3.12/site-packages/torch/lib"
export LD_LIBRARY_PATH="@ZSTD_LIB_DIR@:@ZLIB_LIB_DIR@:@GCC_LIB_DIR@:$TORCHLIB:${LD_LIBRARY_PATH:-}"

MODEL="${1:?usage: rave model.ts input.wav output.wav}"
SRC="${2:?}"
OUT="${3:?}"
SR="${4:-48000}"   # model sample rate (guitar_iil/VCTK/crozzoli = 48000)

"$BASE/venv-rave311/bin/python" -c "
import sys, torch, librosa, soundfile as sf
m = torch.jit.load('$MODEL')
dev = 'cuda' if torch.cuda.is_available() else 'cpu'
if dev == 'cuda':
    m = m.to(dev)  # move TorchScript buffers (e.g. padding) to GPU
x, sr = librosa.load('$SRC', sr=int('$SR'), mono=True)
x = torch.tensor(x).unsqueeze(0).unsqueeze(0).to(dev)
with torch.no_grad():
    z = m.encode(x)
    y = m.decode(z)
sf.write('$OUT', y[0,0].cpu().numpy(), int('$SR'))
print(f'device: {dev}')
print(f'encoded z: {tuple(z.shape)} | wrote $OUT')
"
