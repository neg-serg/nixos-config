#!/bin/sh
# music-embed: music embeddings for audio files (MERT by default).
#
#   music-embed [--model ID] [--layer N] [--windows N] [--out F.npy] FILE...
#
# Runs the payload from packages/local-bin/lib/music_embed.py inside the
# music-AI venv: the interpreter comes from nix (GC-rooted), the packages from
# the venv's site-packages via PYTHONPATH, so a nix-collect-garbage run that
# removes the venv's own bin/python does not break this tool.
set -eu

# Shared interpreter/venv preamble (sets BASE, LIB, PY, SP and exports).
MUSIC_AI_SELF=$0 . "$(dirname "$0")/_music_ai_env.sh"

exec "$PY" "$LIB/music_embed.py" "$@"
