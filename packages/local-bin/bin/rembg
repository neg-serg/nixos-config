#!/bin/sh
# rembg: AI background removal with models kept on the ZFS pool (/zero/ai),
# per the "all AI assets in /zero/ai/*" convention. Uses the pip venv at
# ~/src/music-ai/venv-rembg (nixpkgs rembg fails to build: onnxruntime/libhwy
# OOM-killed; see modules/media/ai-upscale-packages.nix).
#
# Models are downloaded on first use to $U2NET_HOME (/zero/ai/imgproc):
#   - default: u2net (rembg i image.png)
#   - better quality: birefnet-general (rembg i -m birefnet-general image.png)
#
# Usage: rembg i|p|s [options] <input> [output]
set -eu

export U2NET_HOME="${U2NET_HOME:-/zero/ai/imgproc}"
if ! mkdir -p "$U2NET_HOME" 2>/dev/null; then
  # /zero/ai is root-owned until the next rebuild creates /zero/ai/imgproc;
  # fall back to a user-writable dir so the tool still works.
  export U2NET_HOME="$HOME/.local/share/rembg"
  mkdir -p "$U2NET_HOME"
fi

# pip onnxruntime wheel needs system libstdc++/zlib on NixOS (same as music-ai tools)
export LD_LIBRARY_PATH="/nix/store/7vafhlh0lmcvi75jfyy09qwr4m3x1ks3-gcc-15.2.0-lib/lib:/nix/store/483x61iy35irm4wr2b7dwzihljhp6da2-zlib-1.3.2/lib:${LD_LIBRARY_PATH:-}"

exec "$HOME/src/music-ai/venv-rembg/bin/rembg" "$@"
