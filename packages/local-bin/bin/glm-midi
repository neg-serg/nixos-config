#!/usr/bin/env bash
# glm-midi — send Genelec GLM MIDI control messages (GLM 5 MIDI interface) to
# the dockur Windows VM: raw 3-byte CC packets (B0 cc val) -> local relay
# (127.0.0.1:9004, glm-midi-relay) -> VM bridge (glm-midi-bridge.ps1, TCP
# :9003) -> rtpMIDI out port -> GLM software.
# CC map per VOL20toGenelecGLM/CONSTANTS.md:
#   CC20 = absolute volume 0..127 (dB = value - 127)
#   CC21/22 = volume +/- ; CC23 = mute ; CC24 = dim ; CC28 = power
# GLM 5: Settings -> MIDI -> enable interface; Mute/Dim/Power act as toggles.
set -euo pipefail

usage() {
  echo "usage: glm-midi {volume <0-127 | dB> | step <dB> | vol+ [n] | vol- [n] | mute | dim | power}" >&2
  exit 1
}
[ $# -ge 1 ] || usage

send_cc() {
  local cc=$1 val=$2
  if ! exec 3<>/dev/tcp/127.0.0.1/9004 2>/dev/null; then
    echo "glm-midi: relay not reachable on 127.0.0.1:9004 — is glm-midi-relay running?" >&2
    echo "glm-midi: 'systemctl --user status glm-midi-relay'" >&2
    exit 1
  fi
  printf '\260' >&3          # 0xB0 = Control Change on channel 1
  printf "\\$(printf '%03o' "$cc")" >&3
  printf "\\$(printf '%03o' "$val")" >&3
  exec 3>&-
  echo "glm-midi: CC$cc=$val -> relay :9004"
}

case "$1" in
  volume)
    [ $# -ge 2 ] || usage
    if [[ "$2" == *dB* ]] || [ "$2" -lt 0 ] 2>/dev/null; then
      # dB input: -127..0 dB -> 0..127 (value = 127 + dB)
      db=$2; db=${db%dB}
      val=$((127 + db))
      [ "$val" -lt 0 ] && val=0
      [ "$val" -gt 127 ] && val=127
      # Safety cap: never louder than -20 dB (CC20 <= 107). Guards against a
      # stale/corrupt host state file pushing the monitors near maximum.
      [ "$val" -gt 107 ] && val=107
    else
      val=$2
      [ "$val" -gt 107 ] && val=107
    fi
    send_cc 20 "$val" ;;
  step)
    # Base dB (CC20, whole) then one vol+ (0.5) after a short delay so GLM
    # applies the absolute value first — lands exactly on base+0.5 dB.
    [ $# -ge 2 ] || usage
    db=$2; db=${db%dB}
    val=$((127 + db))
    [ "$val" -lt 0 ] && val=0
    [ "$val" -gt 107 ] && val=107
    send_cc 20 "$val"
    sleep 0.15
    send_cc 21 127
    ;;
  vol+) n=${2:-1}; for _ in $(seq 1 "$n"); do send_cc 21 127; done ;;
  vol-) n=${2:-1}; for _ in $(seq 1 "$n"); do send_cc 22 127; done ;;
  mute)  send_cc 23 127 ;;  # toggle
  dim)   send_cc 24 127 ;;  # toggle
  power) send_cc 28 127 ;;  # toggle
  *) usage ;;
esac
