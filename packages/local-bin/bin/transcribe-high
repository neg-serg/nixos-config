#!/bin/bash
# transcribe-high: точная транскрипция трека в MIDI (цена — время).
# Конвейер: [деноиз DeepFilterNet] → Demucs (4 стема) → basic-pitch по каждому
# стему (ONNX) → слияние MIDI → темп (madmom) → [опц. midi2tidal].
#
# Идея: транскрипция по разделённым стемам даёт заметно чище ноты, чем по
# полному миксу (нет наложений инструментов).
#
# Usage: transcribe-high input.mp3 [-o out.mid] [--tidal] [--no-denoise]
set -euo pipefail

BASE="$HOME/src/music-ai"
GCCLIB=/nix/store/7vafhlh0lmcvi75jfyy09qwr4m3x1ks3-gcc-15.2.0-lib/lib
ZLIB=/nix/store/483x61iy35irm4wr2b7dwzihljhp6da2-zlib-1.3.2/lib
export LD_LIBRARY_PATH="$GCCLIB:$ZLIB:${LD_LIBRARY_PATH:-}"

SRC="${1:?usage: transcribe-high input.mp3 [-o out.mid] [--tidal] [--no-denoise]}"; shift
OUT=""; TIDAL=0; DENOISE=1
while [ $# -gt 0 ]; do
  case "$1" in
    -o) OUT="$2"; shift 2;;
    --tidal) TIDAL=1; shift;;
    --no-denoise) DENOISE=0; shift;;
    *) echo "unknown arg: $1" >&2; exit 1;;
  esac
done
OUT="${OUT:-${SRC%.*}_high.mid}"
WORK="$(mktemp -d)"; trap 'rm -rf "$WORK"' EXIT
AUDIO="$SRC"

echo "[transcribe-high] 1/5 подготовка аудио (44.1k mono)"
ffmpeg -y -loglevel error -i "$SRC" -ar 44100 -ac 1 "$WORK/input.wav"
AUDIO="$WORK/input.wav"

if [ "$DENOISE" = "1" ] && [ -x "$BASE/venv-denoise/bin/python" ]; then
  echo "[transcribe-high] 2/5 деноиз (DeepFilterNet)"
  "$BASE/venv-denoise/bin/python" -m df.enhance --input "$WORK/input.wav" --output "$WORK/denoised.wav" >/dev/null 2>&1 && AUDIO="$WORK/denoised.wav" || echo "  (деноиз пропущен — сбой)"
else
  echo "[transcribe-high] 2/5 деноиз — пропущен (venv-denoise нет или --no-denoise)"
fi

echo "[transcribe-high] 3/5 стемы (Demucs htdemucs_ft)"
"$BASE/venv-demucs/bin/python" -m demucs --two-stems=vocals -o "$WORK/stems" "$AUDIO" >/dev/null 2>&1 || \
"$BASE/venv-demucs/bin/python" -m demucs -o "$WORK/stems" "$AUDIO" >/dev/null 2>&1
STEMS_DIR="$(find "$WORK/stems" -maxdepth 2 -type d -name 'htdemucs*' | head -1)"
echo "  стемы: $STEMS_DIR"

echo "[transcribe-high] 4/5 транскрипция стемов (basic-pitch ONNX)"
mkdir -p "$WORK/bp"
i=0
for stem in "$STEMS_DIR"/*.wav; do
  name="$(basename "$stem" .wav)"
  "$BASE/venv-bp/bin/basic-pitch" --save-midi --model-serialization onnx "$WORK/bp" "$stem" >/dev/null 2>&1 || continue
  mid="$(find "$WORK/bp" -name "*${name}*_basic_pitch.mid" | head -1)"
  [ -n "$mid" ] && echo "  ✓ $name → $(basename "$mid")"
done

echo "[transcribe-high] слияние стемов в один MIDI"
"$BASE/venv-midi2tidal/bin/python" - "$WORK/bp" "$OUT" <<'EOF'
import sys, glob, os
from midi import FileIO, Pattern, Track
bpdir, out = sys.argv[1], sys.argv[2]
mids = sorted(glob.glob(os.path.join(bpdir, "*_basic_pitch.mid")))
if not mids:
    print("  нет MIDI-выхода — стоп"); sys.exit(1)
merged = Pattern()
for m in mids:
    try:
        p = FileIO(m).read()
        for tr in p:
            merged.append(tr)
    except Exception as e:
        print(f"  пропуск {m}: {e}")
FileIO(out, save_track_events=True).write(merged)
print(f"  объединено {len(mids)} MIDI → {out}")
EOF

echo "[transcribe-high] 5/5 темп (madmom)"
BPM="$("$BASE/venv-bp/bin/python" -c "
from madmom_infer.features.downbeats import RNNDownBeatProcessor, DBNDownBeatTrackingProcessor
from madmom_infer import models
import sys
try:
    proc = RNNDownBeatProcessor(model=models.downbeats_blstm())
    dbn = DBNDownBeatTrackingProcessor(beats_per_bar=[3,4], fps=100)
    beats = list(dbn(proc('$AUDIO')))
    if len(beats) > 2:
        ivals = [beats[i+1][0]-beats[i][0] for i in range(len(beats)-1)]
        print(round(60/__import__('statistics').median(ivals),1))
except Exception as e:
    print('?')
" 2>/dev/null || echo "?")"
echo "  темп: ~$BPM BPM (для midi2tidal --tempo)"

if [ "$TIDAL" = "1" ]; then
  echo "[transcribe-high] конвертация в Tidal (midi2tidal)"
  "$BASE/venv-midi2tidal/bin/python" "$BASE/midi_to_tidalcycles/midi2tidal.py" -H "$OUT" 2>/dev/null || \
  midi2tidal "$OUT" || true
fi

echo "[transcribe-high] готово: $OUT (темп ~$BPM BPM)"
