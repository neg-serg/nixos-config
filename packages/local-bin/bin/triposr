#!/bin/sh
# triposr: image → 3D mesh (VAST-AI TripoSR, MIT). Uses the pip venv at
# ~/src/music-ai/venv-triposr (torch CPU + torchmcubes/xatlas/moderngl).
# Model weights (VAST-AI/TripoSR, ~700MB) live in /zero/ai/3d (HF_HOME);
# falls back to ~/.cache/huggingface until /zero/ai/3d exists (next rebuild).
#
# Usage: triposr image.png [--no-remove-bg] [--output-dir out/] [--model-size small|large]
set -eu

export LD_LIBRARY_PATH="/nix/store/7vafhlh0lmcvi75jfyy09qwr4m3x1ks3-gcc-15.2.0-lib/lib:/nix/store/483x61iy35irm4wr2b7dwzihljhp6da2-zlib-1.3.2/lib:${LD_LIBRARY_PATH:-}"

if mkdir -p /zero/ai/3d 2>/dev/null; then
  export HF_HOME="${HF_HOME:-/zero/ai/3d}"
else
  export HF_HOME="${HF_HOME:-$HOME/.cache/huggingface}"
fi

exec "$HOME/src/music-ai/venv-triposr/bin/python" "$HOME/src/music-ai/triposr-repo/run.py" "$@"
