#!/bin/sh
# nix-updates: show diffs between booted/current system profiles
# Usage: nix-updates

LOCALBIN_SELF=$0 . "$(dirname "$0")/_localbin.sh"

IFS=' 	
'
help_from_header 2 3 "$@"
need nix

nix profile diff-closures --profile /nix/var/nix/profiles/system || true
if command -v dix >/dev/null 2>&1; then
  dix /run/booted-system /run/current-system || true
fi
