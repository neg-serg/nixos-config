#!/bin/sh
# music-tags: zero-shot music tags (genre/mood/instrument) for one audio file.
#
#   music-tags [--labels a,b,c] [--top N] [--json] FILE
#
# CLAP (laion/clap-htsat-unfused, apache-2.0) matches free-text labels against
# the audio embedding; the model is fetched into $MUSIC_AI_HF_HOME on first
# use. Payload: packages/local-bin/lib/music_tags.py.
set -eu

BASE="@MUSIC_AI_BASE@"
LIB="@MUSIC_AI_LIB@"
PY="${MUSIC_AI_PY:-@MUSIC_AI_PY@}"
[ -x "$PY" ] || PY="$HOME/.local/bin/python3.12"
SP="$BASE/venv-analysis/lib/python3.12/site-packages"

export PYTHONPATH="$SP${PYTHONPATH:+:$PYTHONPATH}"
export LD_LIBRARY_PATH="@ZSTD_LIB_DIR@:@ZLIB_LIB_DIR@:@GCC_LIB_DIR@:$SP/torch/lib:${LD_LIBRARY_PATH:-}"
export HF_HOME="${MUSIC_AI_HF_HOME:-@MUSIC_AI_HF_HOME@}"

exec "$PY" "$LIB/music_tags.py" "$@"
