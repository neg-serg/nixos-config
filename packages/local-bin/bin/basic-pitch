#!/bin/sh
# basic-pitch: polyphonic note transcription (MIDI) via basic-pitch.
# The bundled TensorFlow saved-model is broken with TF 2.21 (incompatible
# format); the ONNX backend works — force it by default.
# Usage: basic-pitch OUT_DIR AUDIO... [options]
set -e
[ -n "$1" ] && [ -f "$2" ] || { echo "usage: basic-pitch OUT_DIR AUDIO... [--save-midi]" >&2; exit 2; }
export LD_LIBRARY_PATH="@GCC_LIB_DIR@:@ZLIB_LIB_DIR@:@ZSTD_LIB_DIR@:${LD_LIBRARY_PATH:-}"
exec @MUSIC_AI_BASE@/venv-bp/bin/basic-pitch "$@" --model-serialization onnx
