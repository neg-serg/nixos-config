#!/bin/sh
# basic-pitch: polyphonic note transcription (MIDI) via basic-pitch.
# The bundled TensorFlow saved-model is broken with TF 2.21 (incompatible
# format); the ONNX backend works — force it by default.
# Usage: basic-pitch OUT_DIR AUDIO... [options]
set -e
[ -n "$1" ] && [ -f "$2" ] || { echo "usage: basic-pitch OUT_DIR AUDIO... [--save-midi]" >&2; exit 2; }
export LD_LIBRARY_PATH="/nix/store/7vafhlh0lmcvi75jfyy09qwr4m3x1ks3-gcc-15.2.0-lib/lib:/nix/store/483x61iy35irm4wr2b7dwzihljhp6da2-zlib-1.3.2/lib:/nix/store/13id30w3rvgj24nnz34f7qrncz48zd7l-zstd-1.5.7/lib:${LD_LIBRARY_PATH:-}"
exec ~/src/music-ai/venv-bp/bin/basic-pitch "$@" --model-serialization onnx
