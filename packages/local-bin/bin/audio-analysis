#!/bin/sh
# audio-analysis: Essentia key/beat analysis + CLAP zero-shot tagging + matchering mastering.
# Subcommands:
#   audio-analysis keybeat  input.wav        → key, tempo, beats
#   audio-analysis tag      input.wav "txt1" "txt2"...  → CLAP zero-shot similarities
#   audio-analysis master   input.wav ref.wav out.wav   → reference-based mastering
#
# The interpreter is a nix python (GC-rooted) and the packages come from the
# venv over PYTHONPATH: the venv's own bin/python symlink dies whenever the
# store path it points at is collected, which took this tool down once.
set -eu

# Shared interpreter/venv preamble (sets BASE, LIB, PY, SP and exports).
MUSIC_AI_SELF=$0 . "$(dirname "$0")/_music_ai_env.sh"

CMD="${1:?usage: audio-analysis keybeat|tag|master ...}"
shift
case "$CMD" in
  keybeat)
    SRC="${1:?}"
    "$PY" -c "
import essentia.standard as es, statistics
audio = es.MonoLoader(filename='$SRC')()
key = es.KeyExtractor()(audio)
beats, _ = es.BeatTrackerMultiFeature()(audio)
if len(beats) > 2:
    ivals = [beats[i+1]-beats[i] for i in range(len(beats)-1)]
    bpm = round(60/statistics.median(ivals), 1)
else:
    bpm = 0.0
print(f'key: {key[0]} {key[1]} (conf {key[2]:.2f}) | ~{bpm} BPM | {len(beats)} beats')
"
    ;;
  tag)
    SRC="${1:?}"; shift
    [ $# -ge 1 ] || { echo "usage: audio-analysis tag input.wav 'label'..."; exit 1; }
    # CLAP via the shared music-tags payload (transformers, model from
    # $MUSIC_AI_HF_HOME): the laion_clap package wanted a Zenodo checkpoint
    # that is not on disk, and the venv has transformers anyway.
    LABELS=$(IFS=,; echo "$*")
    exec "$PY" "$LIB/music_tags.py" "$SRC" --labels "$LABELS" --top "$#"
    ;;
  master)
    SRC="${1:?}"; REF="${2:?}"; OUT="${3:?}"
    "$PY" -c "
import sys, matchering as mg
mg.process(target=sys.argv[1], reference=sys.argv[2], results=[mg.pcm16(sys.argv[3])])
print('mastered:', sys.argv[3])
" "$SRC" "$REF" "$OUT"
    ;;
  *)
    echo "unknown subcommand: $CMD (keybeat|tag|master)"; exit 1
    ;;
esac
