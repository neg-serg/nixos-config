#!/bin/sh
# whisperx: STT + speaker diarization (faster-whisper/CTranslate2 CPU backend,
# pyannote-community diarization). Uses the pip venv at @MUSIC_AI_BASE@/venv-whisperx.
# Coexists with whisper.cpp (:8002) from the speech stack — different backend.
#
# Usage: whisperx audio.wav --model large-v3 --language ru --diarize
#        whisperx audio.wav --model small --language ru --diarize --output_dir out/
set -eu

export LD_LIBRARY_PATH="@GCC_LIB_DIR@:@ZLIB_LIB_DIR@:@ZSTD_LIB_DIR@:${LD_LIBRARY_PATH:-}"

if mkdir -p /zero/ai/whisperx 2>/dev/null; then
  export HF_HOME="${HF_HOME:-/zero/ai/whisperx}"
else
  export HF_HOME="${HF_HOME:-$HOME/.cache/huggingface}"
fi

exec "@MUSIC_AI_BASE@/venv-whisperx/bin/whisperx" "$@"
