#!/bin/sh
# whisperx: STT + speaker diarization (faster-whisper/CTranslate2 CPU backend,
# pyannote-community diarization). Uses the pip venv at ~/src/music-ai/venv-whisperx.
# Coexists with whisper.cpp (:8002) from the speech stack — different backend.
#
# Usage: whisperx audio.wav --model large-v3 --language ru --diarize
#        whisperx audio.wav --model small --language ru --diarize --output_dir out/
set -eu

export LD_LIBRARY_PATH="/nix/store/7vafhlh0lmcvi75jfyy09qwr4m3x1ks3-gcc-15.2.0-lib/lib:/nix/store/483x61iy35irm4wr2b7dwzihljhp6da2-zlib-1.3.2/lib:${LD_LIBRARY_PATH:-}"

if mkdir -p /zero/ai/whisperx 2>/dev/null; then
  export HF_HOME="${HF_HOME:-/zero/ai/whisperx}"
else
  export HF_HOME="${HF_HOME:-$HOME/.cache/huggingface}"
fi

exec "$HOME/src/music-ai/venv-whisperx/bin/whisperx" "$@"
