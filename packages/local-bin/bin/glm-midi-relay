#!/usr/bin/env python3
"""glm-midi-relay — one-way MIDI relay to the dockur Windows VM.

Topology constraint: the VM shares the host IP (192.168.2.87 via pasta), so
bidirectional UDP (RTP-MIDI) handshakes die on the host->VM reply path. The
only reliable host->VM channel is a connection the VM *initiates* (outbound
TCP through passt works, replies flow back — same as the .88:10812 proxy).

Design:
  - the VM-side bridge (oem/glm-midi-bridge.ps1) connects OUT to :9003
  - local glm-midi connects to 127.0.0.1:9004 and writes one raw MIDI packet
  - this relay forwards each local packet into the current VM connection
"""
import socket
import sys
import threading

VM_PORT = 9003    # VM bridge connects here (0.0.0.0, inbound from LAN)
LOCAL_PORT = 9004  # glm-midi sends here (loopback only)

vm = None
lock = threading.Lock()


def vm_loop(vs):
    global vm
    while True:
        c, _ = vs.accept()
        with lock:
            vm = c  # a new VM connection replaces the previous one


def main():
    global vm  # main() assigns vm = None below; without this Python treats vm as a local -> UnboundLocalError on read
    vs = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    vs.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    # Bind both sockets before starting any thread: a failed bind then exits
    # cleanly instead of triggering Python's stderr-lock fatal error at
    # interpreter shutdown (daemon thread printing a traceback -> SIGABRT).
    try:
        vs.bind(("0.0.0.0", VM_PORT))
        s.bind(("127.0.0.1", LOCAL_PORT))
    except OSError as e:
        print(f"glm-midi-relay: bind failed: {e}", file=sys.stderr)
        sys.exit(1)
    vs.listen(1)
    s.listen(1)
    threading.Thread(target=vm_loop, args=(vs,), daemon=True).start()
    while True:
        c, _ = s.accept()
        try:
            # Protocol is one 3-byte CC message per connection (status CC val).
            # recv(64) can return after the first byte when the sender writes
            # the bytes separately (bash printf per byte), so loop until a
            # full message is read — otherwise the bridge gets a truncated CC.
            data = b""
            while len(data) < 3:
                chunk = c.recv(3 - len(data))
                if not chunk:
                    break
                data += chunk
            c.close()
            with lock:
                t = vm
            if t is None:
                continue  # no VM bridge connected yet — drop the packet
            try:
                t.sendall(data)
            except OSError:
                with lock:
                    if vm is t:
                        vm = None
        except OSError:
            pass


if __name__ == "__main__":
    main()
