#!/bin/sh
# dsh-url: print the URL the dsh web UI is serving right now.
# Usage: dsh-url [--lan|--open|--copy]
#   The ?token= value is a per-process launch token, so it changes on every dsh
#   restart. A browser that has exchanged it holds a signed cookie that does
#   survive restarts, so this is only needed for a fresh browser/profile, a
#   cleared cookie jar, or a different authority than the one that minted the
#   cookie.
if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'; exit 0
fi

# Match the URL line, not the sibling "dsh web: opening the default browser"
# notice that shares the prefix.
line="$(journalctl --user -u dsh.service --no-pager 2>/dev/null | grep 'dsh web: http' | tail -n 1)"
if [ -z "$line" ]; then
  echo "dsh-url: no 'dsh web:' line in the dsh.service journal — is the service running?" >&2
  exit 1
fi

loopback="$(printf '%s\n' "$line" | grep -o 'https\?://[^ ]*' | head -n 1)"
lan="$(printf '%s\n' "$line" | sed -n 's/.*(LAN: \([^)]*\)).*/\1/p')"

case "${1:-}" in
  "")
    url="$loopback"
    ;;
  --lan)
    if [ -z "$lan" ]; then
      echo "dsh-url: the log carries no LAN URL (loopback-only bind)" >&2
      exit 1
    fi
    url="$lan"
    ;;
  --open | --copy)
    url="$loopback"
    ;;
  *)
    echo "dsh-url: unknown option '$1' (use --lan, --open, --copy, --help)" >&2
    exit 2
    ;;
esac

printf '%s\n' "$url"

case "${1:-}" in
  --open)
    exec xdg-open "$url"
    ;;
  --copy)
    if command -v wl-copy >/dev/null 2>&1; then
      printf '%s' "$url" | wl-copy
    elif command -v xclip >/dev/null 2>&1; then
      printf '%s' "$url" | xclip -selection clipboard
    else
      echo "dsh-url: neither wl-copy nor xclip is available" >&2
      exit 1
    fi
    ;;
esac
