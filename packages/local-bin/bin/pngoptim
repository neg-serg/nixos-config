#!/bin/sh
# pngoptim: losslessly shrink a PNG with oxipng (max trials + Zopfli)
# Usage: pngoptim FILE.png

LOCALBIN_SELF=$0 . "$(dirname "$0")/_localbin.sh"

IFS=' 	
'

usage() { printf "Usage: pngoptim FILE.png\n" >&2; exit 1; }

help_dispatch "$@"
[ -n "${1:-}" ] || usage
[ -f "$1" ] || { printf 'pngoptim: no such file: %s\n' "$1" >&2; exit 1; }

file="$1"
case "$file" in
  *.png|*.PNG) :;;
  *) printf 'pngoptim: not a PNG: %s\n' "$file" >&2; exit 1;;
esac

# -o max: перебрать все фильтры (вплоть до bruteforce), -z: Zopfli — то, что
# раньше давали optipng -o7 + advpng/advdef -z4, но одним многопоточным
# проходом (на 2.4 МБ PNG: 3.7 с против 21.9 с, файл при этом меньше).
need oxipng
oxipng -o max -z --strip safe -- "$file"
