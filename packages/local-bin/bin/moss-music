#!/bin/sh
# moss-music: MOSS-Music-8B music understanding — key, tempo, timestamped
# chords, song structure, instruments, vocals.
#
#   moss-music FILE                     # the full analysis (preset: analyze)
#   moss-music --preset chords FILE     # one job; --list-presets shows all
#   moss-music -p "what carries the melody?" FILE
#   moss-music --thinking FILE          # chain-of-thought weights (Instruct by default)
#   moss-music --json FILE...           # one JSON object per file
#
# Weights: 18.1 GB bf16 per variant under $MOSS_MUSIC_BASE (Instruct and
# Thinking), fetched by `just music-moss-models`. They are too big for the
# 16 GB card, so inference is CPU by default (~2-4 tok/s, a few minutes per
# track) and --device cuda would only pay off with a partial offload.
#
# MOSS is not a llama.cpp/audio.cpp model — no ggml port exists (2026-11-07) —
# so this is the reference PyTorch implementation over its own venv.
# Payload: packages/local-bin/lib/moss_music.py.
set -eu

# Shared interpreter/venv preamble (sets BASE, LIB, PY, SP and exports).
MUSIC_AI_SELF=$0 . "$(dirname "$0")/_music_ai_env.sh"

# The custom modeling code imports Qwen3Model and WhisperEncoderLayer from
# transformers 4.57.1, the version the checkpoint was exported with, and the
# shared venv-analysis carries a newer one (the MERT/CLAP/MTG stack wants it).
# Replace PYTHONPATH rather than extending it, so venv-moss's torch and
# transformers win.
MOSS_SP="$BASE/venv-moss/lib/python3.12/site-packages"
if [ ! -d "$MOSS_SP" ]; then
  echo "moss-music: venv-moss is missing ($MOSS_SP) — run: just music-moss-venv" >&2
  exit 1
fi
PYTHONPATH="$MOSS_SP:$LIB"
export PYTHONPATH
export LD_LIBRARY_PATH="$MOSS_SP/torch/lib:${LD_LIBRARY_PATH:-}"
export MOSS_MUSIC_BASE="${MOSS_MUSIC_BASE:-$BASE/moss-music}"

exec "$PY" "$LIB/moss_music.py" "$@"
