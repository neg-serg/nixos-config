#!/bin/sh
# stems: vocal/instrumental separation via BS-RoFormer (viperx ep_317, SOTA vocals).
# Better than demucs for isolating a voice; demucs still better for 4-stem (drums/bass).
# Usage: stems input.wav [-o outdir] [--two-stems vocals|instrumental]
set -e
[ -n "$1" ] && [ -f "$1" ] || { echo "usage: stems input.wav [-o outdir] [--two-stems vocals|instrumental]" >&2; exit 2; }
IN="$1"; shift
OUT=/tmp/stems
TWO="vocals"
while [ "$#" -gt 0 ]; do
  case "$1" in
    -o) OUT="$2"; shift 2 ;;
    --two-stems) TWO="$2"; shift 2 ;;
    *) echo "stems: unknown option $1" >&2; exit 2 ;;
  esac
done
export LD_LIBRARY_PATH="/nix/store/7vafhlh0lmcvi75jfyy09qwr4m3x1ks3-gcc-15.2.0-lib/lib:/nix/store/483x61iy35irm4wr2b7dwzihljhp6da2-zlib-1.3.2/lib:/nix/store/13id30w3rvgj24nnz34f7qrncz48zd7l-zstd-1.5.7/lib:${LD_LIBRARY_PATH:-}"
mkdir -p "$OUT"
exec ~/src/music-ai/venv-demucs/bin/audio-separator   --model_filename model_bs_roformer_ep_317_sdr_12.9755.ckpt   --output_dir "$OUT" --two_stems "$TWO" "$IN"
