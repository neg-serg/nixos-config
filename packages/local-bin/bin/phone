#!/usr/bin/env bash
# phone — connect an Android phone via adb (USB or WiFi) and mirror it with scrcpy.
# Usage:
#   phone               auto: USB device, else WiFi from PHONE_IP or ~/.config/phone-ip
#   phone <ip>          WiFi: adb connect <ip>:5555, remember it, then scrcpy
#   phone usb           USB only (fails if no device)
#   phone connect [ip]  connect only, print device serial on stdout (usb = USB-only)
#   phone status        show adb device list
#   phone -h|--help     this help
set -euo pipefail

state_file="${HOME}/.config/phone-ip"

need() {
  command -v "$1" >/dev/null 2>&1 || {
    echo "phone: missing '$1' (adb/scrcpy are system packages on odin)" >&2
    exit 1
  }
}
need adb

usage() { sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; }

# First USB serial in "device" state, or empty
usb_serial() {
  adb devices | awk -F'\t' 'NR > 1 && $2 == "device" { print $1; exit }'
}

wifi_connect() {
  local ip="$1" out
  out="$(adb connect "${ip}:5555" 2>&1 || true)"
  echo "phone: $out" >&2
  if ! adb devices | awk -F'\t' -v s="${ip}:5555" 'NR > 1 && $1 == s && $2 == "device" { found = 1 } END { exit !found }'; then
    echo "phone: ${ip}:5555 not in 'device' state (enable wireless debugging / adb over WiFi, check the IP)" >&2
    return 1
  fi
  mkdir -p "${state_file%/*}"
  printf '%s\n' "$ip" > "$state_file"
  echo "phone: saved $ip to $state_file" >&2
}

# Resolve a device serial: explicit IP → USB → PHONE_IP/saved IP.
# Prints the serial on stdout, diagnostics on stderr. Exit 1 if nothing found.
resolve_serial() {
  local ip="${1:-}" serial
  # Explicit IP wins over everything
  if [ -n "$ip" ]; then
    wifi_connect "$ip" || return 1
    printf '%s:5555\n' "$ip"
    return 0
  fi
  # USB device next
  serial="$(usb_serial || true)"
  if [ -n "$serial" ]; then
    printf '%s\n' "$serial"
    return 0
  fi
  # WiFi from env / saved IP
  ip="${PHONE_IP:-}"
  if [ -z "$ip" ] && [ -f "$state_file" ]; then
    ip="$(cat "$state_file")"
  fi
  if [ -n "$ip" ]; then
    wifi_connect "$ip" || return 1
    printf '%s:5555\n' "$ip"
    return 0
  fi
  echo "phone: no USB device and no WiFi IP (pass <ip>, set PHONE_IP, or save the IP to $state_file)" >&2
  return 1
}

mirror() {
  local serial="$1"
  need scrcpy
  echo "phone: starting scrcpy on $serial"
  exec scrcpy -s "$serial"
}

case "${1:-}" in
  -h|--help)
    usage
    ;;
  status)
    adb devices
    ;;
  usb)
    serial="$(usb_serial || true)"
    if [ -z "$serial" ]; then
      echo "phone: no USB device — plug the phone in and allow USB debugging" >&2
      exit 1
    fi
    mirror "$serial"
    ;;
  connect)
    if [ "${2:-}" = "usb" ]; then
      serial="$(usb_serial || true)"
      if [ -z "$serial" ]; then
        echo "phone: no USB device — plug the phone in and allow USB debugging" >&2
        exit 1
      fi
      printf '%s\n' "$serial"
      exit 0
    fi
    serial="$(resolve_serial "${2:-}")" || exit $?
    printf '%s\n' "$serial"
    ;;
  *)
    serial="$(resolve_serial "${1:-}")" || exit $?
    mirror "$serial"
    ;;
esac
