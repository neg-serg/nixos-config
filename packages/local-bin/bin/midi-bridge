#!/usr/bin/env bash
# midi-bridge — connect SuperCollider MIDI out to the active synth/host.
#  1) REAPER (yabridge Windows VSTs): SC -> REAPER ALSA MIDI in
#  2) legacy Vital standalone: SC -> Midi Through (Vital auto-subscribes).
set -euo pipefail

sc=$(aconnect -l | awk '/^client [0-9]+: .SuperCollider./ {c=$2; sub(":","",c); print c; exit}')
[ -z "$sc" ] && { echo "no SuperCollider MIDI client" >&2; exit 1; }

# --- 1) REAPER (if running) ---
rpr=$(aconnect -l | awk '/^client [0-9]+: .REAPER./ {c=$2; sub(":","",c); print c; exit}')
if [ -n "$rpr" ]; then
  scp=$(aconnect -l | awk -v c="$sc" '$0 ~ "client " c ":" {inside=1} inside && /out0/ {print $1; exit}')
  rprp=$(aconnect -l | awk -v c="$rpr" '$0 ~ "client " c ":" {inside=1} inside && /midi in|Midi In|in0/ {print $1; exit}')
  if [ -n "$scp" ] && [ -n "$rprp" ]; then
    aconnect "$sc:$scp" "$rpr:$rprp" 2>/dev/null && echo "connected SC MIDI -> REAPER" || true
  fi
fi

# --- 2) Vital standalone via Midi Through (legacy) ---
mt=$(aconnect -l | awk '/^client [0-9]+: .Midi Through./ {c=$2; sub(":","",c); print c; exit}')
if [ -n "$mt" ]; then
  scp=$(aconnect -l | awk -v c="$sc" '$0 ~ "client " c ":" {inside=1} inside && /out0/ {print $1; exit}')
  mtp=$(aconnect -l | awk -v c="$mt" '$0 ~ "client " c ":" {inside=1} inside && /Midi Through Port-0/ {print $1; exit}')
  if [ -n "$scp" ] && [ -n "$mtp" ]; then
    aconnect "$sc:$scp" "$mt:$mtp" 2>/dev/null || true
  fi
fi
