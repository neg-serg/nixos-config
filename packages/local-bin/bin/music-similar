#!/bin/sh
# music-similar: nearest neighbours of a track from a music-index directory.
#
#   music-similar [--index DIR] [-k N] [--json] [FILE]
#
# Without FILE the current MPRIS track (playerctl) is used, which makes the
# command a one-liner for a key binding. Payload:
# packages/local-bin/lib/music_similar.py.
set -eu

BASE="@MUSIC_AI_BASE@"
LIB="@MUSIC_AI_LIB@"
PY="${MUSIC_AI_PY:-@MUSIC_AI_PY@}"
[ -x "$PY" ] || PY="$HOME/.local/bin/python3.12"
SP="$BASE/venv-analysis/lib/python3.12/site-packages"

export PYTHONPATH="$SP${PYTHONPATH:+:$PYTHONPATH}"
export LD_LIBRARY_PATH="@ZSTD_LIB_DIR@:@ZLIB_LIB_DIR@:@GCC_LIB_DIR@:$SP/torch/lib:${LD_LIBRARY_PATH:-}"
export HF_HOME="${MUSIC_AI_HF_HOME:-@MUSIC_AI_HF_HOME@}"

exec "$PY" "$LIB/music_similar.py" "$@"
