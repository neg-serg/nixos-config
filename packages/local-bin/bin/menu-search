#!/usr/bin/env python3
"""menu-search — search the tray apps' menus in a vicinae mini window.

Every StatusNotifierItem publishes its context menu over DBusMenu; that tree is
exactly what you get by right-clicking a tray icon, submenus included. The local
helper actions of `main-menu` (music/clipboard/network helpers) are listed next to
them, so one search window covers both. This script walks the menus, renders flattened entries as "App > Path > Item" into
`vicinae dmenu` (a compact always-focused window with vicinae's own search, which
ranks with lusty's matcher) and triggers the chosen entry on the bus, so a menu
entry is a hotkey plus a few letters instead of a mouse hunt through the tray.

A Qt app cannot raise its own window on Wayland: Qt's Wayland client implements
no xdg-activation, so the "Open Telegram"-style item switches nothing when the
window sits on a hidden special workspace. Those entries are therefore backed up
by a focus request (see raise_window_for): after a menu item whose label reads
like "open/show" fires, the matching window is focused via `window-activate`,
which can bring up even a special workspace. Nothing happens for entries whose
label means the opposite ("minimize", "hide", "quit"), and nothing happens when
there is no window for the entry at all.

The entry list is cached (see --refresh): the window is fed from the cache so it
opens without waiting for the DBus walk (~0.75 s on the current session — 15+
busctl round-trips), and a detached refresh updates the cache for the next
invocation. A stale entry is retried from a fresh walk before giving up.

Usage:
  menu-search                       open the mini window (default, from cache)
  menu-search --refresh             rebuild the cache and exit
  menu-search --list                print every entry (menus + local actions)
  menu-search --list --json         machine-readable dump (for other UIs)
  menu-search --query Q             pre-fill the query
  menu-search --width W --height H  window size
  menu-search --no-window           only enumerate (same as --list)

Exit status: 0 on success (also when the user dismisses the window), 1 on error.
"""

from __future__ import annotations

import argparse
import fcntl
import json
import os
import pathlib
import shutil
import subprocess
import sys
import time

BUSCTL = shutil.which("busctl")
VICINAE = shutil.which("vicinae")
WATCHER = "org.kde.StatusNotifierWatcher"
WATCHER_PATH = "/StatusNotifierWatcher"
SNI_IFACE = "org.kde.StatusNotifierItem"
MENU_IFACE = "com.canonical.dbusmenu"


def busctl(*args: str, json_out: bool = True) -> str:
    cmd = [BUSCTL, "--user"]
    if json_out:
        cmd.append("--json=short")
    cmd += args
    proc = subprocess.run(cmd, capture_output=True, text=True)
    if proc.returncode != 0:
        raise RuntimeError(proc.stderr.strip() or f"busctl {' '.join(args)} failed")
    return proc.stdout


def busctl_json(*args: str) -> object:
    return json.loads(busctl(*args))


def property_of(service: str, path: str, iface: str, name: str):
    try:
        value = busctl_json("get-property", service, path, iface, name)
    except RuntimeError:
        return None
    return value.get("data") if isinstance(value, dict) else value


def tray_items() -> list[tuple[str, str]]:
    """Every registered item as (service, object path)."""
    registered = property_of(WATCHER, WATCHER_PATH, WATCHER, "RegisteredStatusNotifierItems") or []
    items: list[tuple[str, str]] = []
    for entry in registered:
        service, _, path = str(entry).partition("/")
        items.append((service, "/" + path if path else "/StatusNotifierItem"))
    return items


def item_title(service: str, path: str) -> str:
    for prop in ("Title", "Id"):
        value = property_of(service, path, SNI_IFACE, prop)
        if value:
            text = str(value).split(".")[-1] if prop == "Id" else str(value)
            if text:
                return text
    return service


def menu_path(service: str, path: str) -> str | None:
    value = property_of(service, path, SNI_IFACE, "Menu")
    if value:
        return str(value)
    for guess in ("/MenuBar", "/StatusNotifierItem/menu"):
        try:
            busctl_json("call", "--", service, guess, MENU_IFACE, "GetLayout", "iias", "0", "-1", "0")
            return guess
        except RuntimeError:
            continue
    return None


def walk(children: list, prefix: list[str], out: list[dict]) -> None:
    for child in children:
        entry = child.get("data") if isinstance(child, dict) else child
        if not isinstance(entry, list) or len(entry) != 3:
            continue
        item_id, props, sub = entry
        props = props or {}
        if str(props.get("type", {}).get("data", "")) == "separator":
            continue
        if props.get("visible", {}).get("data", True) is False:
            continue
        label = str(props.get("label", {}).get("data", "")).replace("_", "").replace("&", "").strip()
        is_submenu = "children-display" in props or bool(sub)
        if is_submenu:
            walk(sub, prefix + ([label] if label else []), out)
            continue
        if not label:
            continue
        out.append(
            {
                "id": item_id,
                "label": label,
                "path": prefix,
                "enabled": props.get("enabled", {}).get("data", True) is not False,
            }
        )


def item_id(service: str, path: str) -> str:
    """The StatusNotifierItem id — for Telegram `TelegramDesktop`, for Steam `steam`.

    It is what the tray registry uses as the app identity, and it usually shares
    the window class' tail (`org.nicotine_plus.Nicotine`), which is what
    raise_window_for matches on.
    """
    return str(property_of(service, path, SNI_IFACE, "Id") or "")


def collect(service: str, path: str) -> list[dict]:
    menu = menu_path(service, path)
    if not menu:
        return []
    app_id = item_id(service, path)
    try:
        layout = busctl_json("call", "--", service, menu, MENU_IFACE, "GetLayout", "iias", "0", "-1", "0")
    except RuntimeError:
        return []
    children = layout.get("data", [None, [None, None, []]])[1][2]
    entries: list[dict] = []
    walk(children, [], entries)
    for entry in entries:
        entry["service"] = service
        entry["menu"] = menu
        entry["app"] = item_title(service, path)
        entry["app_id"] = app_id
    return entries


def trigger(entry: dict, dry_run: bool = False) -> None:
    """Click a DBusMenu item the way a mouse would."""
    args = [
        "busctl",
        "--user",
        "call",
        "--",
        entry["service"],
        entry["menu"],
        MENU_IFACE,
        "Event",
        "isvu",
        str(entry["id"]),
        "clicked",
        "s",
        "",
        str(int(time.time())),
    ]
    if dry_run:
        print(" ".join(args))
        return True
    proc = subprocess.run(args, capture_output=True, text=True, check=False)
    return proc.returncode == 0


# --- the "app cannot focus itself" workaround -------------------------------

# Labels that mean "bring it up". Qt tray menus are translated, so the prefixes
# cover Russian and English; only the beginning of the label is looked at, so
# "Quit Telegram" / "Minimize to tray" never match.
OPEN_LABELS = ("open", "show", "открыть", "показать", "развернуть")

# Tray ids and window classes disagree sometimes (Telegram's tray id is
# `TelegramDesktop`, its window class `org.telegram.desktop`), and appidding
# "telegram" to the search would match a chat window titled "telegram" too. This
# is the explicit list of the disagreements that matter, in a file the user can
# extend: `~/.config/menu-search/window-class.tsv`, "id<TAB>window class".
WINDOW_CLASS_FILE = (
    pathlib.Path(os.environ.get("XDG_CONFIG_HOME", pathlib.Path.home() / ".config"))
    / "menu-search"
    / "window-class.tsv"
)
def window_activate_bin() -> str | None:
    found = shutil.which("window-activate")
    if found:
        return found
    fallback = pathlib.Path.home() / ".local/bin/window-activate"
    return str(fallback) if fallback.is_file() else None


def window_class_hints() -> dict[str, str]:
    """The id → window class overrides, from window-class.tsv (missing file = {})."""
    try:
        lines = WINDOW_CLASS_FILE.read_text().splitlines()
    except OSError:
        return {}
    hints = {}
    for line in lines:
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        fields = [f.strip() for f in line.split("\t") if f.strip()]
        if len(fields) >= 2:
            hints[fields[0]] = fields[1]
    return hints


def raise_window_for(entry: dict) -> str | None:
    """Focus the window behind a "Open ..." menu entry; None if nothing was raised.

    The tray item and the window rarely agree on their names, so the match is
    tried in both directions: the item id (`org.telegram.desktop` for the
    Telegram tray icon, `org.nicotine_plus.Nicotine` for Nicotine+) against the
    window class, then the app title against the window class and title.
    """
    label = str(entry.get("label", "")).strip().lower()
    if not label.startswith(OPEN_LABELS):
        return None
    binary = window_activate_bin()
    if not binary:
        return None

    item_id = str(entry.get("app_id", "") or "")
    app = str(entry.get("app", "") or "")
    hint = window_class_hints().get(item_id)
    if hint:
        proc = subprocess.run([binary, "--class", hint, "--substring"], capture_output=True, text=True)
        if proc.returncode == 0:
            return proc.stderr.strip() or hint
    for needle in (item_id, app):
        if not needle:
            continue
        proc = subprocess.run([binary, "--class", needle, "--substring"], capture_output=True, text=True)
        if proc.returncode == 0:
            return proc.stderr.strip() or needle
    for needle in (item_id, app):
        if needle:
            proc = subprocess.run([binary, "--title", needle], capture_output=True, text=True)
            if proc.returncode == 0:
                return proc.stderr.strip() or needle
    return None


def main_menu_bin() -> str | None:
    found = shutil.which("main-menu")
    if found:
        return found
    fallback = pathlib.Path.home() / ".local/bin/main-menu"
    return str(fallback) if fallback.is_file() else None


def action_entries() -> list[dict]:
    """The local helper actions (`main-menu --list`), searchable next to the menus.

    They keep living in main-menu; this only borrows the names, and triggers them
    with `main-menu --run` — so the Super+Shift+M binding can move to the search
    window without losing a single action.
    """
    binary = main_menu_bin()
    if not binary:
        return []
    proc = subprocess.run([binary, "--list"], capture_output=True, text=True)
    if proc.returncode != 0:
        return []
    entries = []
    for name in proc.stdout.split():
        entries.append(
            {
                "kind": "action",
                "id": name,
                "label": name,
                "path": [],
                "app": "Actions",
                "action": name,
                "enabled": True,
                "service": "",
                "menu": "",
            }
        )
    return entries


def run_action(entry: dict, dry_run: bool = False) -> None:
    binary = main_menu_bin()
    if not binary:
        return
    args = [binary, "--run", entry["action"]]
    if dry_run:
        print(" ".join(args))
        return True
    proc = subprocess.run(args, capture_output=True, text=True, check=False)
    return proc.returncode == 0


CACHE_DIR = pathlib.Path(os.environ.get("XDG_CACHE_HOME", pathlib.Path.home() / ".cache")) / "menu-search"
CACHE_FILE = CACHE_DIR / "entries.tsv"
LOCK_FILE = CACHE_DIR / "refresh.lock"
CACHE_VERSION = "2"


def cache_path() -> pathlib.Path:
    return CACHE_FILE


def load_cache() -> list[dict]:
    try:
        lines = cache_path().read_text().splitlines()
    except OSError:
        return []
    entries: list[dict] = []
    for line in lines:
        fields = line.split("\t")
        if len(fields) != 8 or fields[0] != CACHE_VERSION:
            continue
        _, kind, service, menu, entry_id, action, app_id, display = fields
        entries.append(
            {
                "kind": kind,
                "service": service,
                "menu": menu,
                "id": int(entry_id) if entry_id.lstrip("-").isdigit() else entry_id,
                "action": action,
                "app_id": app_id,
                "line": display,
            }
        )
    return entries


def save_cache(entries: list[dict]) -> None:
    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    tmp = cache_path().with_suffix(".tmp")
    with tmp.open("w") as fh:
        for entry in entries:
            fh.write(
                "\t".join(
                    [
                        CACHE_VERSION,
                        str(entry.get("kind", "menu")),
                        str(entry.get("service", "")),
                        str(entry.get("menu", "")),
                        str(entry.get("id", "")),
                        str(entry.get("action", "")),
                        str(entry.get("app_id", "")),
                        entry_line(entry),
                    ]
                )
                + "\n"
            )
    os.replace(tmp, cache_path())


def refresh_cache_background() -> None:
    """Rebuild the cache for the next invocation without delaying this one."""
    try:
        subprocess.Popen(
            [sys.executable, os.path.abspath(__file__), "--refresh"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            stdin=subprocess.DEVNULL,
            start_new_session=True,
        )
    except OSError:
        pass


def entry_line(entry: dict) -> str:
    """The line shown for an entry. Cached entries already carry it."""
    if "line" in entry:
        return entry["line"]
    return " › ".join([entry["app"], *entry["path"], entry["label"]])


def enumerate_entries() -> list[dict]:
    entries: list[dict] = []
    for service, path in tray_items():
        entries.extend(collect(service, path))
    entries.extend(action_entries())
    entries.sort(key=entry_line)
    return entries


def refresh_cache() -> int:
    """Walk the menus and store the result. Serialised: two refreshes never race."""
    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    with LOCK_FILE.open("w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            return 0  # someone else is already refreshing
        entries = enumerate_entries()
        if entries:
            save_cache(entries)
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description="fuzzy-search the tray apps' menus")
    parser.add_argument("--list", action="store_true", help="print entries instead of opening a window")
    parser.add_argument("--json", action="store_true", help="with --list: dump JSON")
    parser.add_argument("--query", default="", help="initial query")
    parser.add_argument("--width", type=int, default=560)
    parser.add_argument("--height", type=int, default=420)
    parser.add_argument("--placeholder", default="Menus: ❯")
    parser.add_argument("--refresh", action="store_true", help="rebuild the entry cache and exit")
    parser.add_argument("--no-cache", action="store_true", help="walk the menus now, ignore the cache")
    parser.add_argument("--print-trigger", action="store_true", help="do not click, print the busctl call")
    parser.add_argument("--verbose", action="store_true", help="report the windows raised for an entry")
    args = parser.parse_args()

    if args.refresh:
        if not BUSCTL:
            print("menu-search: busctl not found", file=sys.stderr)
            return 1
        return refresh_cache()

    if not BUSCTL:
        print("menu-search: busctl not found", file=sys.stderr)
        return 1

    if args.no_cache:
        entries = enumerate_entries()
    else:
        # Cache first, walk later: feeding the window from disk is what makes it
        # appear immediately (vicinae slurps stdin before it opens the window).
        entries = load_cache()
        if entries:
            refresh_cache_background()
        else:
            entries = enumerate_entries()
            if entries:
                save_cache(entries)

    if not entries:
        print("menu-search: no menu entries found", file=sys.stderr)
        return 1
    if args.json:
        json.dump([{**e, "line": entry_line(e)} for e in entries], sys.stdout, ensure_ascii=False, indent=1)
        print()
        return 0
    if args.list or not VICINAE:
        for entry in entries:
            print(entry_line(entry))
        if not VICINAE:
            print("menu-search: vicinae not found, printed the entries instead", file=sys.stderr)
        return 0

    lines = [entry_line(e) for e in entries]
    # `vicinae dmenu` renders the list in a compact window and returns the chosen
    # line; vicinae's own search ranks it (lusty's matcher, see the vicinae patch).
    cmd = [
        VICINAE,
        "dmenu",
        "-p",
        args.placeholder,
        "-q",
        args.query,
        "-W",
        str(args.width),
        "-H",
        str(args.height),
    ]
    if args.print_trigger:
        cmd.append("--no-quick-look")
    proc = subprocess.run(cmd, input="\n".join(lines) + "\n", capture_output=True, text=True)
    if proc.returncode != 0 or not proc.stdout.strip():
        return 0  # dismissed
    chosen = proc.stdout.strip().splitlines()[-1]

    def fire(entry: dict) -> bool:
        if args.print_trigger:
            print(f"chosen: {chosen}")
        if entry.get("kind") == "action":
            return run_action(entry, dry_run=args.print_trigger)
        fired = trigger(entry, dry_run=args.print_trigger)
        if fired and not args.print_trigger:
            # "Open Telegram" fires here and does nothing on its own: Qt never
            # asks the compositor to focus the window (no xdg-activation in
            # Qt's Wayland client), so the window stays where it was. Raising it
            # is what the entry promised.
            raised = raise_window_for(entry)
            if raised and args.verbose:
                print(f"menu-search: raised {raised}", file=sys.stderr)
        return fired

    def find(source: list[dict]) -> dict | None:
        for entry in source:
            if entry.get("line", entry_line(entry)) == chosen:
                return entry
        return None

    entry = find(entries)
    if entry and fire(entry):
        return 0
    # The cached item may be gone (the app rebuilt its menu): walk once more and
    # retry the same label before reporting failure.
    if entry:
        fresh = enumerate_entries()
        if fresh:
            save_cache(fresh)
        retry = find(fresh)
        if retry and fire(retry):
            return 0
        print(f"menu-search: {chosen!r} is no longer available", file=sys.stderr)
        return 1
    print(f"menu-search: {chosen!r} did not match an entry", file=sys.stderr)
    return 1


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(0)
