#!/usr/bin/env bash
# proxy — запуск/остановка/обновление прокси sing-box (vless/vmess/hysteria2/hysteria/tuic/ss/trojan/anytls)
# Usage: proxy [on|off|status|refresh|gen]
# Credentials: from /run/secrets/proxy-fallback (SOPS-encrypted)
# refresh validates candidates (TCP scan + e2e probe) before writing the config,
# so dead free-pool nodes never replace a working config.
set -euo pipefail

CONFIG="$HOME/.config/sing-box-trojan/config.json"
LOG="/tmp/sing-box-trojan.log"
SECRET="/run/secrets/proxy-fallback"
LAN_SECRET="/run/secrets/proxy-lan"

# ============================================================
# load_fallback — прочитать fallback-ноды из sops
# ============================================================
load_fallback() {
    if [ -f "$SECRET" ]; then
        cat "$SECRET"
        return
    fi
    # No hardcoded fallback: nodes come only from the SOPS secret
    # (/run/secrets/proxy-fallback), so no live credentials ever land in
    # the public repo. \`proxy refresh\` fetches subscription nodes even
    # without the secret.
    echo ""
}

# ============================================================
# load_lan_auth — LAN SOCKS5 credentials ("user:pass") from the
# SOPS secret (decrypted to /run/secrets/proxy-lan). Empty when the
# secret is absent → LAN inbound stays passwordless.
# ============================================================
load_lan_auth() {
    if [ -f "$LAN_SECRET" ]; then
        cat "$LAN_SECRET"
    fi
}

# ============================================================
# lan_msg — one-line LAN access hint (best-effort; needs \`ip\`)
# ============================================================
lan_msg() {
    local ip auth
    ip=$(ip -4 -o addr show scope global 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -1)
    if [ -n "$(load_lan_auth)" ]; then
        auth="user:pass auth"
    else
        auth="no auth"
    fi
    if [ -n "$ip" ]; then
        echo "  LAN proxy: socks5://$ip:10810 ($auth, firewall: LAN only)"
    else
        echo "  LAN proxy: 0.0.0.0:10810 ($auth, firewall: LAN only)"
    fi
}

# ============================================================
# gen_cfg — единый python-генератор: парсит ноды из NODES_TEXT,
# пишет конфиг (real-shape) в CFG_PATH. Поддерживает
# vless (tls/reality), vmess, hysteria2/hy2, hysteria (v1), tuic,
# shadowsocks, trojan, anytls.
# ============================================================
gen_cfg() {
    python3 << 'PYEOF'
import base64, json, os, re, sys, urllib.parse

def load_nodes():
    # Nodes come via NODES_FILE (path) when the list is big: exporting
    # 1000+ nodes as one env var exceeds MAX_ARG_STRLEN (128 KiB) and
    # breaks every exec with "Argument list too long".
    nf = os.environ.get("NODES_FILE")
    if nf:
        with open(nf, "r") as f:
            return f.read()
    return os.environ["NODES_TEXT"]

text = load_nodes()
cfg_path = os.environ["CFG_PATH"]
lan_auth = os.environ.get("LAN_AUTH", "")

def b64dec(s):
    try:
        s = s + "=" * (-len(s) % 4)
        return base64.urlsafe_b64decode(s).decode()
    except Exception:
        try:
            return base64.b64decode(s).decode()
        except Exception:
            return ""

def clean(s):
    """Parse a node URI query string without mangling '+' (parse_qs would
    turn it into a space and break base64 params like reality pbk)."""
    if not s: return {}
    s = s.replace('&amp;', '&')
    if '#' in s: s = s.split('#')[0]
    out = {}
    for kv in s.split('&'):
        if not kv: continue
        if '=' in kv:
            k, v = kv.split('=', 1)
            v = urllib.parse.unquote(v.split('#')[0])
        else:
            k, v = kv, ''
        if k not in out:
            out[k] = v
    return out

def hp_parse(hp):
    """Split 'host:port[/path...]' -> (host, port) or None."""
    m = re.match(r'^([^:?#/]+):([0-9]+)(?:[/?#].*)?$', hp)
    if not m:
        return None
    return (m.group(1), int(m.group(2)))

def parse_line(line):
    """Return an outbound dict or None."""
    if line.startswith('hysteria2://') or line.startswith('hy2://'):
        r = line.split('://', 1)[1]
        a = r.split('@', 1)[1] if '@' in r else r
        h = a.split('?')[0]; host = h.split(':')[0]
        ps = h.split(':')[1] if ':' in h else '443'
        port = int(ps.split('?')[0]) if ps.split('?')[0].isdigit() else 443
        pwd = r.split('@')[0] if '@' in r else r.split('?')[0]
        p = clean(a.split('?', 1)[1] if '?' in a else '')
        ob = {"type": "hysteria2", "tag": "node", "server": host,
              "server_port": port, "password": pwd,
              "tls": {"enabled": True, "insecure": True,
                      "server_name": p.get('sni', host)}}
        if 'obfs' in p:
            ob["obfs"] = {"type": p['obfs'], "password": p.get('obfs-password', '')}
        return ob
    if line.startswith('vless://'):
        r = line.split('vless://')[1]
        uuid = r.split('@')[0]
        a = r.split('@', 1)[1] if '@' in r else r
        hp = a.split('?')[0]
        sp = hp_parse(hp)
        if sp is None: return None
        host, port = sp
        p = clean(a.split('?', 1)[1] if '?' in a else '')
        ob = {"type": "vless", "tag": "node", "server": host,
              "server_port": port, "uuid": uuid, "packet_encoding": "xudp"}
        sec = p.get('security', '')
        if sec in ('tls', 'reality', 'xtls'):
            fp = p.get('fp', 'chrome')
            if fp not in ('chrome','firefox','ios','android','edge','safari','360','random','randomized'):
                fp = 'chrome'
            tls = {"enabled": True, "server_name": p.get('sni', host),
                   "utls": {"enabled": True, "fingerprint": fp}}
            if sec == 'reality' and len(p.get('pbk', '')) >= 32:
                tls["reality"] = {"enabled": True,
                                  "public_key": p.get('pbk', '').replace('+', '-').replace('/', '_').rstrip('='),
                                  "short_id": p.get('sid', '')}
            ob["tls"] = tls
        flow = p.get("flow", "")
        if flow == "xtls-rprx-vision":
            ob["flow"] = flow
        tp = p.get('type', '').lower()
        if tp in ('xhttp', 'splithttp'):
            return None
        if tp == 'ws':
            tr = {"type": "ws"}
            if p.get('path'): tr["path"] = p['path']
            if p.get('host'): tr["headers"] = {"Host": p['host']}
            ob["transport"] = tr
        elif tp == 'grpc':
            tr = {"type": "grpc"}
            if p.get('serviceName'): tr["service_name"] = p['serviceName']
            ob["transport"] = tr
        elif tp == 'httpupgrade':
            tr = {"type": "httpupgrade"}
            if p.get('host'): tr["host"] = p['host']
            if p.get('path'): tr["path"] = p['path']
            ob["transport"] = tr
        elif tp == 'http':
            tr = {"type": "http"}
            if p.get('host'): tr["host"] = [p['host']]
            if p.get('path'): tr["path"] = p['path']
            ob["transport"] = tr
        return ob
    if line.startswith('ss://'):
        r = line.split('ss://')[1]
        if '@' in r:
            ui, hp = r.split('@', 1)
            if ':' not in ui:
                dec = b64dec(ui)
                if ':' not in dec: return None
                method, password = dec.split(':', 1)
            else:
                method, password = ui.split(':', 1)
        else:
            dec = b64dec(r.split('#')[0])
            if ':' not in dec or '@' not in dec: return None
            method, rest = dec.split(':', 1)
            password, hp = rest.rsplit('@', 1)
        hp = hp.split('#')[0]
        sp = hp_parse(hp)
        if sp is None: return None
        host, port = sp
        p = clean(r.split('?', 1)[1] if '?' in r else '')
        if p.get('plugin'):
            return None
        return {"type": "shadowsocks", "tag": "node", "server": host,
                "server_port": port, "method": method, "password": password}
    if line.startswith('trojan://'):
        r = line.split('trojan://')[1]
        password = urllib.parse.unquote(r.split('@')[0])
        a = r.split('@', 1)[1] if '@' in r else r
        hp = a.split('?')[0]
        sp = hp_parse(hp)
        if sp is None: return None
        host, port = sp
        p = clean(a.split('?', 1)[1] if '?' in a else '')
        ob = {"type": "trojan", "tag": "node", "server": host,
              "server_port": port, "password": password}
        sec = p.get('security', 'tls')
        if sec in ('tls', 'reality'):
            fp = p.get('fp', 'chrome')
            if fp not in ('chrome','firefox','ios','android','edge','safari','360','random','randomized'):
                fp = 'chrome'
            tls = {"enabled": True, "server_name": p.get('sni', host),
                   "utls": {"enabled": True, "fingerprint": fp}}
            if sec == 'reality' and len(p.get('pbk', '')) >= 32:
                tls["reality"] = {"enabled": True,
                                  "public_key": p.get('pbk', '').replace('+', '-').replace('/', '_').rstrip('='),
                                  "short_id": p.get('sid', '')}
            ob["tls"] = tls
        tp = p.get('type', '').lower()
        if tp in ('xhttp', 'splithttp'):
            return None
        if tp == 'ws':
            tr = {"type": "ws"}
            if p.get('path'): tr["path"] = p['path']
            if p.get('host'): tr["headers"] = {"Host": p['host']}
            ob["transport"] = tr
        elif tp == 'grpc':
            tr = {"type": "grpc"}
            if p.get('serviceName'): tr["service_name"] = p['serviceName']
            ob["transport"] = tr
        elif tp == 'httpupgrade':
            tr = {"type": "httpupgrade"}
            if p.get('host'): tr["host"] = p['host']
            if p.get('path'): tr["path"] = p['path']
            ob["transport"] = tr
        elif tp == 'http':
            tr = {"type": "http"}
            if p.get('host'): tr["host"] = [p['host']]
            if p.get('path'): tr["path"] = p['path']
            ob["transport"] = tr
        return ob
    if line.startswith('vmess://'):
        try:
            j = json.loads(b64dec(line.split('vmess://')[1].split('#')[0]))
        except Exception:
            return None
        host = str(j.get('add', ''))
        if not host: return None
        try: port = int(j.get('port', 0))
        except Exception: return None
        if not port: return None
        ob = {"type": "vmess", "tag": "node", "server": host,
              "server_port": port, "uuid": str(j.get('id', '')),
              "security": str(j.get('scy', 'auto') or 'auto'),
              "alter_id": int(j.get('aid', 0) or 0)}
        if ob["security"] not in ("auto", "aes-128-gcm", "chacha20-poly1305",
                                  "none", "zero"):
            ob["security"] = "auto"
        sec = j.get('tls', '')
        if sec in ('tls', 'reality', 'xtls'):
            fp = j.get('fp', 'chrome')
            if fp not in ('chrome', 'firefox', 'ios', 'android', 'edge',
                          'safari', '360', 'random', 'randomized'):
                fp = 'chrome'
            tls = {"enabled": True, "server_name": j.get('sni', host),
                   "utls": {"enabled": True, "fingerprint": fp}}
            if sec == 'reality' and len(str(j.get('pbk', ''))) >= 32:
                tls["reality"] = {"enabled": True,
                                  "public_key": str(j.get('pbk', '')),
                                  "short_id": str(j.get('sid', ''))}
            alpn = j.get('alpn', '')
            if alpn:
                tls["alpn"] = [x for x in str(alpn).split(',') if x]
            ob["tls"] = tls
        net = j.get('net', 'tcp')
        host_h = j.get('host', '')
        path = j.get('path', '')
        if net == 'ws':
            tr = {"type": "ws"}
            if path: tr["path"] = path
            if host_h: tr["headers"] = {"Host": host_h}
            ob["transport"] = tr
        elif net == 'grpc':
            tr = {"type": "grpc"}
            sn = path.split('?')[0]
            if sn.startswith('/'): sn = sn[1:]
            if sn: tr["service_name"] = sn
            if host_h: tr["authority"] = host_h
            ob["transport"] = tr
        elif net == 'httpupgrade':
            tr = {"type": "httpupgrade"}
            if host_h: tr["host"] = host_h
            if path: tr["path"] = path
            ob["transport"] = tr
        elif net in ('h2', 'http'):
            tr = {"type": "http"}
            if host_h: tr["host"] = [host_h]
            if path: tr["path"] = path
            ob["transport"] = tr
        elif net in ('xhttp', 'splithttp'):
            return None
        elif net == 'tcp' and j.get('type') == 'http':
            tr = {"type": "http"}
            if host_h: tr["host"] = [host_h]
            if path: tr["path"] = path
            ob["transport"] = tr
        return ob
    if line.startswith('tuic://'):
        r = line.split('tuic://')[1]
        cred = r.split('@')[0]
        if ':' not in cred: return None
        uuid, password = cred.split(':', 1)
        a = r.split('@', 1)[1] if '@' in r else r
        sp = hp_parse(a.split('?')[0])
        if not sp: return None
        host, port = sp
        p = clean(a.split('?', 1)[1] if '?' in a else '')
        tls = {"enabled": True, "server_name": p.get('sni', host)}
        if p.get('allow_insecure', '0') in ('1', 'true', 'yes'):
            tls["insecure"] = True
        if p.get('alpn'):
            tls["alpn"] = [x for x in p['alpn'].split(',') if x]
        ob = {"type": "tuic", "tag": "node", "server": host,
              "server_port": port, "uuid": urllib.parse.unquote(uuid),
              "password": urllib.parse.unquote(password),
              "congestion_control": p.get('congestion_control', 'bbr'),
              "udp_relay_mode": p.get('udp_relay_mode', 'native'),
              "tls": tls}
        return ob
    if line.startswith('hysteria://'):
        r = line.split('hysteria://')[1]
        sp = hp_parse(r.split('?')[0])
        if not sp: return None
        host, port = sp
        p = clean(r.split('?', 1)[1] if '?' in r else '')
        ob = {"type": "hysteria", "tag": "node", "server": host,
              "server_port": port}
        if p.get('auth'):
            ob["auth_str"] = urllib.parse.unquote(p['auth'])
        if p.get('up'):
            try: ob["up_mbps"] = int(float(p['up']))
            except Exception: pass
        if p.get('down'):
            try: ob["down_mbps"] = int(float(p['down']))
            except Exception: pass
        if p.get('obfs'):
            ob["obfs"] = p['obfs']
        tls = {"enabled": True,
               "insecure": p.get('insecure', '1') not in ('0', 'false', 'no'),
               "server_name": p.get('sni', p.get('server_name', host))}
        if p.get('alpn'):
            tls["alpn"] = [x for x in p['alpn'].split(',') if x]
        ob["tls"] = tls
        return ob
    if line.startswith('anytls://'):
        r = line.split('anytls://')[1]
        password = urllib.parse.unquote(r.split('@')[0])
        a = r.split('@', 1)[1] if '@' in r else r
        sp = hp_parse(a.split('?')[0])
        if not sp: return None
        host, port = sp
        p = clean(a.split('?', 1)[1] if '?' in a else '')
        tls = {"enabled": True, "server_name": p.get('sni', host)}
        if p.get('insecure', '0') in ('1', 'true', 'yes'):
            tls["insecure"] = True
        ob = {"type": "anytls", "tag": "node", "server": host,
              "server_port": port, "password": password, "tls": tls}
        return ob
    return None

outbounds = []
seen = set()
for line in text.strip().split('\n'):
    line = line.strip()
    if not line: continue
    try:
        ob = parse_line(line)
        if ob is None: continue
        # Dedup by server:port + canonical line, so distinct nodes sharing
        # one host:port (common in free pools) are all kept.
        canon = line.split('#')[0].strip()
        key = (ob["server"].lower(), ob["server_port"], canon)
        if key in seen: continue
        seen.add(key)
        ob["tag"] = ob["type"][:2] + "-" + str(len(outbounds))
        outbounds.append(ob)
    except Exception:
        continue

if not outbounds:
    print("  ERROR: no parseable nodes in node list")
    sys.exit(1)

tags = [o["tag"] for o in outbounds]
outbounds.append({"type": "urltest", "tag": "auto",
                  "outbounds": tags, "interval": "5m", "tolerance": 50})
outbounds.append({"type": "direct", "tag": "direct"})

in_lan = {"type": "socks", "tag": "in-lan", "listen": "0.0.0.0", "listen_port": 10810}
if lan_auth:
    u, p = lan_auth.split(":", 1)
    in_lan["users"] = [{"username": u, "password": p}]
inbounds = [{"type": "socks", "tag": "in", "listen": "127.0.0.1", "listen_port": 10808},
            in_lan,
            # Auth-less LAN SOCKS for the dockur Windows VM (firewall: LAN
            # only, reachable at the 192.168.2.88 alias). Chromium cannot
            # authenticate SOCKS5, hence the unauthenticated inbound.
            {"type": "socks", "tag": "in-lan-vm", "listen": "0.0.0.0", "listen_port": 10811},
            # Auth-less LAN HTTP CONNECT for the Windows VM system proxy
            # (WinINET/Qt apps like GLM cannot use SOCKS5 directly).
            {"type": "http", "tag": "in-lan-vm-http", "listen": "0.0.0.0", "listen_port": 10812}]
# DNS + route: client-side resolve via direct DoH. No "detour" on the DoH
# server: detouring it via urltest deadlocks DNS at startup when no node is
# selected yet, so every lookup times out.
dns = {"servers": [{"tag": "remote", "type": "https", "server": "1.1.1.1",
                    "server_port": 443}],
       "strategy": "ipv4_only"}
route = {"rules": [{"ip_is_private": True, "outbound": "direct"},
                   {"action": "resolve", "server": "remote", "strategy": "ipv4_only"}],
         "final": "auto", "auto_detect_interface": True,
         "default_domain_resolver": "remote"}

cfg = {"log": {"level": "error"}, "dns": dns, "inbounds": inbounds,
       "outbounds": outbounds, "route": route}
os.makedirs(os.path.dirname(cfg_path), exist_ok=True)
with open(cfg_path, "w") as f:
    json.dump(cfg, f, indent=2)
print("  Config: " + str(len(tags)) + " outbounds + urltest")
PYEOF
}

# ============================================================
# bootstrap — создать конфиг с fallback-нодами если нет
# ============================================================
bootstrap() {
    if [ -f "$CONFIG" ]; then
        # Config already exists. Heal known gaps:
        #  1. DNS + route: old generator emitted "dns": {} → sing-box 1.13 fell
        #     back to dns.google DoT (IPv6) and every domain lookup failed on
        #     IPv6-less hosts (~3s per lookup, all domain traffic dead). The
        #     nodes also resolve domains server-side with a broken resolver, so
        #     we resolve client-side via direct DoH (route action "resolve")
        #     and send the node plain IPs. The DoH server must NOT be detoured
        #     through the urltest group (startup deadlock).
        #  2. LAN inbound (0.0.0.0:10810) with password auth when the LAN
        #     secret (/run/secrets/proxy-lan, "user:pass") is present; the
        #     users block is synced from it (and removed when it's absent).
        echo "  Config exists — checking for missing DNS/LAN sections..."
        python3 - "$CONFIG" "$(load_lan_auth)" << 'PYEOF'
import json, sys
cfg_path = sys.argv[1]
lan_auth = sys.argv[2] if len(sys.argv) > 2 else ""
cfg = json.load(open(cfg_path))
changed = False
FINAL_DNS = {"servers": [
              {"tag": "remote", "type": "https", "server": "1.1.1.1",
               "server_port": 443}],
             "strategy": "ipv4_only"}
FINAL_ROUTE = {"rules": [
                {"ip_is_private": True, "outbound": "direct"},
                {"action": "resolve", "server": "remote", "strategy": "ipv4_only"}],
               "final": "auto", "auto_detect_interface": True,
               "default_domain_resolver": "remote"}
if cfg.get("dns") != FINAL_DNS or cfg.get("route") != FINAL_ROUTE:
    cfg["dns"] = FINAL_DNS
    cfg["route"] = FINAL_ROUTE
    changed = True
    print("  Config: DNS/route reset to final shape (client-side resolve)")
want_users = None
if lan_auth:
    u, p = lan_auth.split(":", 1)
    want_users = [{"username": u, "password": p}]
lan_in = None
for ib in cfg.get("inbounds", []):
    if ib.get("tag") == "in-lan":
        lan_in = ib
        break
if lan_in is None:
    ib = {"type": "socks", "tag": "in-lan", "listen": "0.0.0.0",
          "listen_port": 10810}
    if want_users:
        ib["users"] = want_users
    cfg["inbounds"].append(ib)
    changed = True
    print("  Config: added LAN inbound (0.0.0.0:10810, "
          + ("password auth" if want_users else "no auth") + ")")
elif lan_in.get("users") != want_users:
    if want_users:
        lan_in["users"] = want_users
        changed = True
        print("  Config: LAN inbound credentials synced from secret")
    else:
        lan_in.pop("users", None)
        changed = True
        print("  Config: LAN inbound is passwordless (users removed)")
if changed:
    json.dump(cfg, open(cfg_path, "w"), indent=2)
    print("  Config: patched")
PYEOF
        return
    fi
    FALLBACK=$(load_fallback)
    if [ -z "$FALLBACK" ]; then
        echo "  No fallback nodes (run 'proxy refresh' or create SOPS secret)"
        return
    fi
    echo "  First run: creating config..."
    TMPD=$(mktemp -d /tmp/proxy-bootstrap.XXXXXX)
    trap 'rm -rf "$TMPD"' EXIT
    printf '%s\n' "$FALLBACK" > "$TMPD/nodes.txt"
    unset NODES_TEXT
    export NODES_FILE="$TMPD/nodes.txt"
    export CFG_PATH="$CONFIG"
    export LAN_AUTH="$(load_lan_auth)"
    gen_cfg
}

# ============================================================
# validate_nodes — python: TCP-scan + e2e-тест кандидатов,
# печатает рабочие строки в stdout. Env: NODES_FILE (path to node
# list; preferred for big lists) or NODES_TEXT, E2E_CAP, MIN_WORKING,
# VALIDATE_TMP (temp dir for throwaway configs).
# ============================================================
validate_nodes() {
    python3 << 'PYEOF'
import asyncio, base64, json, os, re, shutil, socket, subprocess, sys, time, urllib.parse

# Nodes come via NODES_FILE (path) when the list is big: exporting
# 1000+ nodes as one env var exceeds MAX_ARG_STRLEN (128 KiB) and
# breaks every exec with "Argument list too long".
def load_nodes():
    nf = os.environ.get("NODES_FILE")
    if nf:
        with open(nf, "r") as f:
            return f.read()
    return os.environ["NODES_TEXT"]

text = load_nodes()
e2e_cap = int(os.environ.get("E2E_CAP", "150"))
min_working = int(os.environ.get("MIN_WORKING", "3"))
tmp = os.environ.get("VALIDATE_TMP", "/tmp/proxy-validate")
os.makedirs(tmp, mode=0o700, exist_ok=True)

if shutil.which("sing-box") is None:
    print("  ERROR: sing-box not found in PATH"); sys.exit(1)

def b64dec(s):
    try:
        s = s + "=" * (-len(s) % 4)
        return base64.urlsafe_b64decode(s).decode()
    except Exception:
        try:
            return base64.b64decode(s).decode()
        except Exception:
            return ""

def clean(s):
    """Parse a node URI query string without mangling '+' (parse_qs would
    turn it into a space and break base64 params like reality pbk)."""
    if not s: return {}
    s = s.replace('&amp;', '&')
    if '#' in s: s = s.split('#')[0]
    out = {}
    for kv in s.split('&'):
        if not kv: continue
        if '=' in kv:
            k, v = kv.split('=', 1)
            v = urllib.parse.unquote(v.split('#')[0])
        else:
            k, v = kv, ''
        if k not in out:
            out[k] = v
    return out

def hp_parse(hp):
    """Split 'host:port[/path...]' -> (host, port) or None."""
    m = re.match(r'^([^:?#/]+):([0-9]+)(?:[/?#].*)?$', hp)
    if not m:
        return None
    return (m.group(1), int(m.group(2)))

# Full outbound parser for probe configs (same rules as gen_cfg).
def parse_outbound(line):
    try:
        if line.startswith('hysteria2://') or line.startswith('hy2://'):
            r = line.split('://', 1)[1]
            a = r.split('@', 1)[1] if '@' in r else r
            h = a.split('?')[0]
            sp = hp_parse(h)
            if not sp: return None
            host, port = sp
            pwd = r.split('@')[0] if '@' in r else r.split('?')[0]
            p = clean(a.split('?', 1)[1] if '?' in a else '')
            ob = {"type": "hysteria2", "tag": "node", "server": host,
                  "server_port": port, "password": pwd,
                  "tls": {"enabled": True, "insecure": True,
                          "server_name": p.get('sni', host)}}
            if 'obfs' in p:
                ob["obfs"] = {"type": p['obfs'], "password": p.get('obfs-password', '')}
            return ob
        if line.startswith('vless://'):
            r = line.split('vless://')[1]
            uuid = r.split('@')[0]
            a = r.split('@', 1)[1] if '@' in r else r
            hp = a.split('?')[0]
            sp = hp_parse(hp)
            if not sp: return None
            host, port = sp
            p = clean(a.split('?', 1)[1] if '?' in a else '')
            ob = {"type": "vless", "tag": "node", "server": host,
                  "server_port": port, "uuid": uuid, "packet_encoding": "xudp"}
            sec = p.get('security', '')
            if sec in ('tls', 'reality', 'xtls'):
                fp = p.get('fp', 'chrome')
                if fp not in ('chrome','firefox','ios','android','edge','safari','360','random','randomized'):
                    fp = 'chrome'
                tls = {"enabled": True, "server_name": p.get('sni', host),
                       "utls": {"enabled": True, "fingerprint": fp}}
                if sec == 'reality' and len(p.get('pbk', '')) >= 32:
                    tls["reality"] = {"enabled": True,
                                      "public_key": p.get('pbk', '').replace('+', '-').replace('/', '_').rstrip('='),
                                      "short_id": p.get('sid', '')}
                ob["tls"] = tls
            flow = p.get("flow", "")
            if flow == "xtls-rprx-vision":
                ob["flow"] = flow
            tp = p.get('type', '').lower()
            if tp in ('xhttp', 'splithttp'): return None
            if tp == 'ws':
                tr = {"type": "ws"}
                if p.get('path'): tr["path"] = p['path']
                if p.get('host'): tr["headers"] = {"Host": p['host']}
                ob["transport"] = tr
            elif tp == 'grpc':
                tr = {"type": "grpc"}
                if p.get('serviceName'): tr["service_name"] = p['serviceName']
                ob["transport"] = tr
            elif tp == 'httpupgrade':
                tr = {"type": "httpupgrade"}
                if p.get('host'): tr["host"] = p['host']
                if p.get('path'): tr["path"] = p['path']
                ob["transport"] = tr
            elif tp == 'http':
                tr = {"type": "http"}
                if p.get('host'): tr["host"] = [p['host']]
                if p.get('path'): tr["path"] = p['path']
                ob["transport"] = tr
            return ob
        if line.startswith('ss://'):
            r = line.split('ss://')[1]
            if '@' in r:
                ui, hp = r.split('@', 1)
                if ':' not in ui:
                    dec = b64dec(ui)
                    if ':' not in dec: return None
                    method, password = dec.split(':', 1)
                else:
                    method, password = ui.split(':', 1)
            else:
                dec = b64dec(r.split('#')[0])
                if ':' not in dec or '@' not in dec: return None
                method, rest = dec.split(':', 1)
                password, hp = rest.rsplit('@', 1)
            hp = hp.split('#')[0]
            sp = hp_parse(hp)
            if not sp: return None
            host, port = sp
            p = clean(r.split('?', 1)[1] if '?' in r else '')
            if p.get('plugin'): return None
            return {"type": "shadowsocks", "tag": "node", "server": host,
                    "server_port": port, "method": method, "password": password}
        if line.startswith('trojan://'):
            r = line.split('trojan://')[1]
            password = urllib.parse.unquote(r.split('@')[0])
            a = r.split('@', 1)[1] if '@' in r else r
            hp = a.split('?')[0]
            sp = hp_parse(hp)
            if not sp: return None
            host, port = sp
            p = clean(a.split('?', 1)[1] if '?' in a else '')
            ob = {"type": "trojan", "tag": "node", "server": host,
                  "server_port": port, "password": password}
            sec = p.get('security', 'tls')
            if sec in ('tls', 'reality'):
                fp = p.get('fp', 'chrome')
                if fp not in ('chrome','firefox','ios','android','edge','safari','360','random','randomized'):
                    fp = 'chrome'
                tls = {"enabled": True, "server_name": p.get('sni', host),
                       "utls": {"enabled": True, "fingerprint": fp}}
                if sec == 'reality' and len(p.get('pbk', '')) >= 32:
                    tls["reality"] = {"enabled": True,
                                      "public_key": p.get('pbk', '').replace('+', '-').replace('/', '_').rstrip('='),
                                      "short_id": p.get('sid', '')}
                ob["tls"] = tls
            tp = p.get('type', '').lower()
            if tp in ('xhttp', 'splithttp'): return None
            if tp == 'ws':
                tr = {"type": "ws"}
                if p.get('path'): tr["path"] = p['path']
                if p.get('host'): tr["headers"] = {"Host": p['host']}
                ob["transport"] = tr
            elif tp == 'grpc':
                tr = {"type": "grpc"}
                if p.get('serviceName'): tr["service_name"] = p['serviceName']
                ob["transport"] = tr
            elif tp == 'httpupgrade':
                tr = {"type": "httpupgrade"}
                if p.get('host'): tr["host"] = p['host']
                if p.get('path'): tr["path"] = p['path']
                ob["transport"] = tr
            elif tp == 'http':
                tr = {"type": "http"}
                if p.get('host'): tr["host"] = [p['host']]
                if p.get('path'): tr["path"] = p['path']
                ob["transport"] = tr
        if line.startswith('vmess://'):
            try:
                j = json.loads(b64dec(line.split('vmess://')[1].split('#')[0]))
            except Exception:
                return None
            host = str(j.get('add', ''))
            if not host: return None
            try: port = int(j.get('port', 0))
            except Exception: return None
            if not port: return None
            ob = {"type": "vmess", "tag": "node", "server": host,
                  "server_port": port, "uuid": str(j.get('id', '')),
                  "security": str(j.get('scy', 'auto') or 'auto'),
                  "alter_id": int(j.get('aid', 0) or 0)}
            if ob["security"] not in ("auto", "aes-128-gcm", "chacha20-poly1305",
                                      "none", "zero"):
                ob["security"] = "auto"
            sec = j.get('tls', '')
            if sec in ('tls', 'reality', 'xtls'):
                fp = j.get('fp', 'chrome')
                if fp not in ('chrome', 'firefox', 'ios', 'android', 'edge',
                              'safari', '360', 'random', 'randomized'):
                    fp = 'chrome'
                tls = {"enabled": True, "server_name": j.get('sni', host),
                       "utls": {"enabled": True, "fingerprint": fp}}
                if sec == 'reality' and len(str(j.get('pbk', ''))) >= 32:
                    tls["reality"] = {"enabled": True,
                                      "public_key": str(j.get('pbk', '')),
                                      "short_id": str(j.get('sid', ''))}
                alpn = j.get('alpn', '')
                if alpn:
                    tls["alpn"] = [x for x in str(alpn).split(',') if x]
                ob["tls"] = tls
            net = j.get('net', 'tcp')
            host_h = j.get('host', '')
            path = j.get('path', '')
            if net == 'ws':
                tr = {"type": "ws"}
                if path: tr["path"] = path
                if host_h: tr["headers"] = {"Host": host_h}
                ob["transport"] = tr
            elif net == 'grpc':
                tr = {"type": "grpc"}
                sn = path.split('?')[0]
                if sn.startswith('/'): sn = sn[1:]
                if sn: tr["service_name"] = sn
                if host_h: tr["authority"] = host_h
                ob["transport"] = tr
            elif net == 'httpupgrade':
                tr = {"type": "httpupgrade"}
                if host_h: tr["host"] = host_h
                if path: tr["path"] = path
                ob["transport"] = tr
            elif net in ('h2', 'http'):
                tr = {"type": "http"}
                if host_h: tr["host"] = [host_h]
                if path: tr["path"] = path
                ob["transport"] = tr
            elif net in ('xhttp', 'splithttp'):
                return None
            elif net == 'tcp' and j.get('type') == 'http':
                tr = {"type": "http"}
                if host_h: tr["host"] = [host_h]
                if path: tr["path"] = path
                ob["transport"] = tr
            return ob
        if line.startswith('tuic://'):
            r = line.split('tuic://')[1]
            cred = r.split('@')[0]
            if ':' not in cred: return None
            uuid, password = cred.split(':', 1)
            a = r.split('@', 1)[1] if '@' in r else r
            sp = hp_parse(a.split('?')[0])
            if not sp: return None
            host, port = sp
            p = clean(a.split('?', 1)[1] if '?' in a else '')
            tls = {"enabled": True, "server_name": p.get('sni', host)}
            if p.get('allow_insecure', '0') in ('1', 'true', 'yes'):
                tls["insecure"] = True
            if p.get('alpn'):
                tls["alpn"] = [x for x in p['alpn'].split(',') if x]
            ob = {"type": "tuic", "tag": "node", "server": host,
                  "server_port": port, "uuid": urllib.parse.unquote(uuid),
                  "password": urllib.parse.unquote(password),
                  "congestion_control": p.get('congestion_control', 'bbr'),
                  "udp_relay_mode": p.get('udp_relay_mode', 'native'),
                  "tls": tls}
            return ob
        if line.startswith('hysteria://'):
            r = line.split('hysteria://')[1]
            sp = hp_parse(r.split('?')[0])
            if not sp: return None
            host, port = sp
            p = clean(r.split('?', 1)[1] if '?' in r else '')
            ob = {"type": "hysteria", "tag": "node", "server": host,
                  "server_port": port}
            if p.get('auth'):
                ob["auth_str"] = urllib.parse.unquote(p['auth'])
            if p.get('up'):
                try: ob["up_mbps"] = int(float(p['up']))
                except Exception: pass
            if p.get('down'):
                try: ob["down_mbps"] = int(float(p['down']))
                except Exception: pass
            if p.get('obfs'):
                ob["obfs"] = p['obfs']
            tls = {"enabled": True,
                   "insecure": p.get('insecure', '1') not in ('0', 'false', 'no'),
                   "server_name": p.get('sni', p.get('server_name', host))}
            if p.get('alpn'):
                tls["alpn"] = [x for x in p['alpn'].split(',') if x]
            ob["tls"] = tls
            return ob
        if line.startswith('anytls://'):
            r = line.split('anytls://')[1]
            password = urllib.parse.unquote(r.split('@')[0])
            a = r.split('@', 1)[1] if '@' in r else r
            sp = hp_parse(a.split('?')[0])
            if not sp: return None
            host, port = sp
            p = clean(a.split('?', 1)[1] if '?' in a else '')
            tls = {"enabled": True, "server_name": p.get('sni', host)}
            if p.get('insecure', '0') in ('1', 'true', 'yes'):
                tls["insecure"] = True
            ob = {"type": "anytls", "tag": "node", "server": host,
                  "server_port": port, "password": password, "tls": tls}
            return ob
    except Exception:
        return None
    return None

# Lightweight parse: only need server/server_port for scan; full config
# generation reuses gen_cfg for the final config.
def parse_addr(line):
    """Return (host, port, proto) for the TCP/UDP scan, or None."""
    m = re.match(r"(vless|vmess|ss|trojan|anytls)://[^@]+@([^:?#/]+):([0-9]+)", line)
    if m: return (m.group(2), int(m.group(3)), m.group(1))
    m = re.match(r"(hysteria2|hy2|tuic)://[^@]+@([^:?#/]+):([0-9]+)", line)
    if m: return (m.group(2), int(m.group(3)), m.group(1))
    # hysteria v1 carries auth in the query string (no user@ part)
    m = re.match(r"hysteria://([^:?#/]+):([0-9]+)", line)
    if m: return (m.group(1), int(m.group(2)), "hysteria")
    return None

cands = {}
for line in text.strip().split('\n'):
    line = line.strip()
    if not line: continue
    try:
        a = parse_addr(line)
        if a: cands.setdefault((a[0], a[1], a[2]), (a[2], line))
    except Exception:
        continue

if not cands:
    print("  ERROR: no parseable candidates"); sys.exit(1)
keys = sorted(cands)
print("  Candidates: " + str(len(keys)))

# UDP-based protocols (hysteria/hysteria2/tuic) have no TCP listener on the
# proxy port: a TCP connect would mark every such node dead. Skip the scan
# for them and let the e2e probe decide.
UDP_PROTOCOLS = {"hysteria", "hysteria2", "hy2", "tuic"}
tcp_keys = [k for k in keys if cands[k][0] not in UDP_PROTOCOLS]
udp_keys = [k for k in keys if cands[k][0] in UDP_PROTOCOLS]
print("  TCP-scan: " + str(len(tcp_keys)) + " tcp, " + str(len(udp_keys))
      + " udp (skipped)")

# --- TCP scan
async def check(host, port, timeout=2.5):
    try:
        loop = asyncio.get_event_loop()
        infos = await loop.getaddrinfo(host, port, type=socket.SOCK_STREAM)
        if not infos: return False
        fam, typ, pro, _, sa = infos[0]
        s = socket.socket(fam, typ, pro)
        s.setblocking(False)
        try:
            await asyncio.wait_for(loop.sock_connect(s, sa), timeout)
            return True
        finally:
            s.close()
    except Exception:
        return False

async def scan():
    sem = asyncio.Semaphore(300)
    async def one(k):
        async with sem:
            return await check(k[0], k[1])
    return await asyncio.gather(*[one(k) for k in tcp_keys])

res = asyncio.run(scan())
open_keys = [tcp_keys[i] for i, ok in enumerate(res) if ok] + udp_keys
print("  TCP open: " + str(len(open_keys)) + "/" + str(len(keys))
      + " (udp auto-included)")
if not open_keys:
    print("  ERROR: no reachable nodes"); sys.exit(1)

# --- e2e probe: single-node sing-box per open candidate, curl gstatic == 204
candidates = [k for k in open_keys[:e2e_cap] if parse_outbound(cands[k][1]) is not None]
print("  E2E probing up to " + str(len(candidates)) + " open nodes...")

def probe_cfg(key, port, path):
    ob = parse_outbound(cands[key][1])
    if ob is None:
        return None
    cfg = {
        "log": {"level": "error"},
        "dns": {"servers": [{"tag": "remote", "type": "https",
                             "server": "1.1.1.1", "server_port": 443}],
                "strategy": "ipv4_only"},
        "inbounds": [{"type": "socks", "tag": "in", "listen": "127.0.0.1",
                      "listen_port": port}],
        "outbounds": [ob, {"type": "direct", "tag": "direct"}],
        "route": {"final": ob["tag"], "default_domain_resolver": "remote"},
    }
    with open(path, "w") as f:
        json.dump(cfg, f, indent=2)
    return True

import concurrent.futures
procs = {}
BASE = 11300
okmap = {}
try:
    for wave_start in range(0, len(candidates), 20):
        wave = candidates[wave_start:wave_start + 20]
        for j, key in enumerate(wave):
            port = BASE + wave_start + j
            path = tmp + "/probe-" + str(port) + ".json"
            probe_cfg(key, port, path)
            p = subprocess.Popen(["setsid", "sing-box", "run", "-c", path],
                                 stdout=subprocess.DEVNULL,
                                 stderr=subprocess.DEVNULL,
                                 start_new_session=True, close_fds=True)
            procs[port] = p
        time.sleep(8)
        def probe(port):
            # 1) relay-only check via an IP literal (no DNS in the path):
            #    http://1.1.1.1 answers 301 through a working tunnel.
            # 2) fallbacks: remote-DNS checks through the node (socks5h).
            #    A node counts as working if any probe succeeds, so nodes
            #    whose server-side DNS is broken still pass (global DNS in
            #    the final config does not depend on a single node).
            for args in (
                ["curl", "-sS", "-o", "/dev/null", "-w", "%{http_code}",
                 "--max-time", "6", "--socks5", "127.0.0.1:" + str(port),
                 "http://1.1.1.1"],
                ["curl", "-sS", "-o", "/dev/null", "-w", "%{http_code}",
                 "--max-time", "8", "--socks5-hostname",
                 "127.0.0.1:" + str(port),
                 "https://cp.cloudflare.com/generate_204"],
                ["curl", "-sS", "-o", "/dev/null", "-w", "%{http_code}",
                 "--max-time", "8", "--socks5-hostname",
                 "127.0.0.1:" + str(port),
                 "https://www.gstatic.com/generate_204"],
            ):
                try:
                    r = subprocess.run(args, capture_output=True, text=True,
                                       timeout=15)
                    if r.stdout.strip() in ("204", "301", "302", "200", "403"):
                        return True
                except Exception:
                    continue
            return False
        with concurrent.futures.ThreadPoolExecutor(max_workers=20) as ex:
            futs = {ex.submit(probe, BASE + wave_start + wave.index(k)): k for k in wave}
            for fut in concurrent.futures.as_completed(futs):
                okmap[futs[fut]] = fut.result()
        for port, p in procs.items():
            try: p.terminate()
            except Exception: pass
        time.sleep(1)
        for port, p in procs.items():
            try: p.kill()
            except Exception: pass
        procs.clear()
        time.sleep(1)
finally:
    for port, p in procs.items():
        try: p.kill()
        except Exception: pass
    subprocess.run(["pkill", "-f", "sing-box.*" + tmp], capture_output=True)

work = [k for k in candidates if okmap.get(k)]
print("  E2E working: " + str(len(work)))
if len(work) == 0:
    print("  ERROR: no working nodes; keeping existing config")
    sys.exit(1)
if len(work) < min_working:
    print("  Warning: only " + str(len(work)) + " working nodes (wanted >= "
          + str(min_working) + "); proceeding with verified subset")
for k in work:
    print(cands[k][1])
PYEOF
}

# ============================================================
# refresh — скачать свежие ноды, проверить их, обновить конфиг
# ============================================================
refresh() {
    echo "  Fetching fresh nodes..."
    FALLBACK=$(load_fallback)
    NEW_NODES=""
    for url in \
      "https://cdn.jsdelivr.net/gh/rtwo2/FastNodes@main/sub/protocols/vless.txt" \
      "https://cdn.jsdelivr.net/gh/rtwo2/FastNodes@main/sub/everything.txt" \
      "https://raw.githubusercontent.com/mahdibland/V2RayAggregator/master/sub/sub_merge.txt" \
      "https://raw.githubusercontent.com/mahdibland/ShadowsocksAggregator/master/Eternity.txt" \
      "https://raw.githubusercontent.com/Pawdroid/Free-servers/main/sub"; do
        data=$(curl --noproxy '*' -sL --connect-timeout 8 --max-time 20 "$url" 2>/dev/null | \
          grep -E '^(vless|vmess|hysteria2|hy2|hysteria|tuic|ss|trojan|anytls)://' | \
          grep -vE '[?&](type=xhttp|type=splithttp|plugin=)' | \
          shuf | head -"${NODE_SAMPLE:-400}" || true)
        # raw.githubusercontent.com and some CDNs are blocked for direct
        # connections in this region; retry through the running proxy (10808)
        # when the direct fetch comes back empty.
        if [ -z "$data" ] && pgrep -f 'sing-box.*config.json' > /dev/null 2>&1; then
            data=$(curl -sL --connect-timeout 8 --max-time 25 \
              --proxy socks5h://127.0.0.1:10808 "$url" 2>/dev/null | \
              grep -E '^(vless|vmess|hysteria2|hy2|hysteria|tuic|ss|trojan|anytls)://' | \
              grep -vE '[?&](type=xhttp|type=splithttp|plugin=)' | \
              shuf | head -"${NODE_SAMPLE:-400}" || true)
        fi
        if [ -n "$data" ]; then
            echo "    $(echo "$data" | wc -l) from $(basename "$url")"
            NEW_NODES="$NEW_NODES"$'\n'"$data"
        fi
    done

    ALL="$FALLBACK"
    [ -n "$NEW_NODES" ] && ALL="$FALLBACK"$'\n'"$NEW_NODES"
    if [ -z "$ALL" ]; then
        echo "  ERROR: no fallback nodes and no subscription nodes available"
        exit 1
    fi

    # Node lists (up to ~1200 lines) exceed the kernel's per-string exec
    # limit (MAX_ARG_STRLEN, 128 KiB): exporting them as one env var made
    # every exec fail with "Argument list too long". Pass them via file.
    TMPD=$(mktemp -d /tmp/proxy-refresh.XXXXXX)
    trap 'rm -rf "$TMPD"' EXIT
    printf '%s\n' "$ALL" > "$TMPD/nodes.txt"
    unset NODES_TEXT
    export NODES_FILE="$TMPD/nodes.txt"
    export VALIDATE_TMP="$TMPD/validate"
    WORKING=$(validate_nodes) || { rc=$?; echo "$WORKING" | tail -4; return $rc; }
    WORKING_LINES=$(echo "$WORKING" | grep -E '^(vless|vmess|hysteria2|hy2|hysteria|tuic|ss|trojan|anytls)://' || true)
    COUNT=$(echo "$WORKING_LINES" | grep -c '://' || true)

    if [ -z "$WORKING_LINES" ]; then
        echo "  ERROR: validation produced no working nodes; keeping existing config"
        return 1
    fi

    echo "  Regenerating config with $COUNT validated nodes..."
    printf '%s\n' "$WORKING_LINES" > "$TMPD/nodes.txt"
    export CFG_PATH="$CONFIG"
    export LAN_AUTH="$(load_lan_auth)"
    gen_cfg
    echo "  Config: $CONFIG regenerated (validated)"
    if systemctl --user is-active --quiet sing-box-proxy.service 2>/dev/null; then
        echo "  Restarting proxy service..."
        systemctl --user restart sing-box-proxy.service 2>/dev/null || start
    else
        start
    fi
}

# ============================================================
# start/stop
# ============================================================
start() {
    if systemctl is-active --quiet xray.service 2>/dev/null; then
        echo "  Stopping xray..."
        if ! sudo -n systemctl stop xray.service 2>/dev/null; then
            # xray runs as neg — pkill works without root; systemd then marks the unit inactive
            pkill -f 'xray.*config.json' 2>/dev/null || true
            echo "  (no passwordless sudo — xray stopped via pkill)"
        fi
    fi
    # Preferred: run under the systemd user service (autostarts at login, survives reboot).
    if systemctl --user start sing-box-proxy.service 2>/dev/null; then
        sleep 1
        if systemctl --user is-active --quiet sing-box-proxy.service 2>/dev/null; then
            echo "  Proxy on 127.0.0.1:10808 (systemd user service)"
            lan_msg
            echo "  Dashboard: http://127.0.0.1:9090 (secret: neg)"
            return 0
        fi
    fi
    # Fallback (user unit not installed): legacy direct launch
    pkill -f 'sing-box.*trojan' 2>/dev/null || true
    sleep 1
    nohup sing-box run -c "$CONFIG" > "$LOG" 2>&1 &
    sleep 2
    if pgrep -f 'sing-box.*trojan' > /dev/null 2>&1; then
        echo "  Proxy on 127.0.0.1:10808"
        lan_msg
        echo "  Dashboard: http://127.0.0.1:9090 (secret: neg)"
    else
        echo "  FAILED"
        tail -3 "$LOG" 2>/dev/null || true
        return 1
    fi
}

stop() {
    if ! systemctl --user stop sing-box-proxy.service 2>/dev/null; then
        # user unit not installed — legacy pkill
        pkill -f 'sing-box.*trojan' 2>/dev/null || true
    fi
    if ! systemctl is-active --quiet xray.service 2>/dev/null; then
        echo "  Restoring xray..."
        sudo -n systemctl start xray.service 2>/dev/null \
            || echo "  (no passwordless sudo — run: sudo systemctl start xray.service)"
    fi
    echo "  Proxy off"
}

# ============================================================
# main
# ============================================================
CMD="status"
[ $# -gt 0 ] && CMD="$1"
case "$CMD" in
    on|start)    bootstrap; start ;;
    off|stop)    stop ;;
    refresh)     refresh ;;
    gen|bootstrap) bootstrap ;;
    status)
        if systemctl --user is-failed --quiet sing-box-proxy.service 2>/dev/null; then
            echo "Proxy: FAILED (see: journalctl --user -u sing-box-proxy)"
            ss -tlnp 2>/dev/null | grep -E '10808|10810' || true
        elif systemctl --user is-active --quiet sing-box-proxy.service 2>/dev/null \
            || pgrep -f 'sing-box.*trojan' > /dev/null 2>&1; then
            echo "Proxy: RUNNING (vless/vmess/h2/hysteria/tuic/ss/trojan/anytls pool)"
            ss -tlnp 2>/dev/null | grep -E '10808|10810' || true
        else
            echo "Proxy: STOPPED"
        fi
        if systemctl is-active --quiet xray.service 2>/dev/null; then
            echo "Xray: RUNNING"
        else
            echo "Xray: STOPPED"
        fi
        ;;
    *) echo "Usage: $0 {on|off|status|refresh|gen}"; exit 1 ;;
esac
