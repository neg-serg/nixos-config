#!/usr/bin/env bash
# proxy — запуск/остановка/обновление Hysteria2 + VLESS Reality прокси
# Usage: proxy [on|off|status|refresh]
# Credentials: from /run/secrets/proxy-fallback (SOPS-encrypted)
set -euo pipefail

CONFIG="$HOME/.config/sing-box-trojan/config.json"
LOG="/tmp/sing-box-trojan.log"
SECRET="/run/secrets/proxy-fallback"
LAN_SECRET="/run/secrets/proxy-lan"

# ============================================================
# load_fallback — прочитать fallback-ноды из sops
# ============================================================
load_fallback() {
    if [ -f "$SECRET" ]; then
        cat "$SECRET"
        return
    fi
    # Hardcoded fallback before SOPS is deployed
    echo 'hysteria2://35415e5e-3666-4454-8c45-903af0fcddf4@85.120.228.208:47257?insecure=1&sni=www.bing.com'
}

# ============================================================
# lan_cfg — LAN SOCKS5 credentials "user:pass" from the SOPS
# secret (empty → no LAN inbound). Port 10810 mirrors the local
# 10808 proxy but requires password auth; the firewall allows it
# only from the local network.
# ============================================================
lan_cfg() {
    if [ -f "$LAN_SECRET" ]; then
        cat "$LAN_SECRET" 2>/dev/null || true
    fi
}

# ============================================================
# lan_msg — one-line LAN access hint (best-effort; needs `ip`)
# ============================================================
lan_msg() {
    local ip
    ip=$(ip -4 -o addr show scope global 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -1)
    if [ -n "$ip" ]; then
        echo "  LAN proxy: socks5://$ip:10810 (user: lan, pass: /run/secrets/proxy-lan, firewall: LAN only)"
    else
        echo "  LAN proxy: 0.0.0.0:10810 (password auth, firewall: LAN only)"
    fi
}

# ============================================================
# bootstrap — создать конфиг с fallback-нодами если нет
# ============================================================
bootstrap() {
    if [ -f "$CONFIG" ]; then
        # Config already exists. Heal: add the LAN inbound (0.0.0.0:10810 with
        # password auth) when the LAN secret is present and the inbound is missing.
        if [ -f "$LAN_SECRET" ] && ! grep -q '"in-lan"' "$CONFIG"; then
            echo "  Config exists but missing LAN inbound — patching..."
            python3 - "$CONFIG" "$(lan_cfg)" << 'PYEOF'
import json, sys
cfg_path, lan = sys.argv[1], sys.argv[2]
cfg = json.load(open(cfg_path))
for ib in cfg.get("inbounds", []):
    if ib.get("tag") == "in-lan":
        sys.exit(0)
lan = lan.strip()
if not lan or ":" not in lan:
    print("  Config: LAN secret empty/invalid — skipping LAN inbound")
    sys.exit(0)
u, p = lan.split(":", 1)
cfg["inbounds"].append({"type": "socks", "tag": "in-lan", "listen": "0.0.0.0",
                        "listen_port": 10810,
                        "users": [{"username": u, "password": p}]})
json.dump(cfg, open(cfg_path, "w"), indent=2)
print("  Config: added LAN inbound (0.0.0.0:10810)")
PYEOF
        fi
        return
    fi
    FALLBACK=$(load_fallback)
    if [ -z "$FALLBACK" ]; then
        echo "  No fallback nodes (run 'proxy refresh' or create SOPS secret)"
        return
    fi
    echo "  First run: creating config..."
    mkdir -p "$(dirname "$CONFIG")"
    export NODES_TEXT="$FALLBACK"
    export CFG_PATH="$CONFIG"
    LAN_CFG="$(lan_cfg)"
    export LAN_CFG
    python3 << 'PYEOF'
import json, os, urllib.parse
text = os.environ["NODES_TEXT"]
cfg_path = os.environ["CFG_PATH"]
outbounds = []
def clean(s):
    if not s: return {}
    s = s.replace('&amp;', '&')
    if '#' in s: s = s.split('#')[0]
    return {k: v[0].split('#')[0] for k, v in urllib.parse.parse_qs(s).items()}
for line in text.strip().split('\n'):
    line = line.strip()
    if not line: continue
    try:
        if line.startswith('hysteria2://'):
            r = line.split('hysteria2://')[1]
            pwd = r.split('@')[0] if '@' in r else r.split('?')[0]
            a = r.split('@', 1)[1] if '@' in r else r
            h = a.split('?')[0]; host = h.split(':')[0]
            ps = h.split(':')[1] if ':' in h else '443'
            port = int(ps.split('?')[0]) if ps.split('?')[0].isdigit() else 443
            p = clean(a.split('?', 1)[1] if '?' in a else '')
            ob = {"type": "hysteria2", "tag": f"h2-{len(outbounds)}",
                  "server": host, "server_port": port, "password": pwd,
                  "tls": {"enabled": True, "insecure": True,
                          "server_name": p.get('sni', host)}}
            if 'obfs' in p:
                ob["obfs"] = {"type": p['obfs'], "password": p.get('obfs-password', '')}
            outbounds.append(ob)
        elif line.startswith('vless://'):
            r = line.split('vless://')[1]
            uuid = r.split('@')[0]
            a = r.split('@', 1)[1] if '@' in r else r
            hp = a.split('?')[0]
            host = hp.rsplit(':', 1)[0]; port = int(hp.rsplit(':', 1)[1])
            p = clean(a.split('?', 1)[1] if '?' in a else '')
            ob = {"type": "vless", "tag": f"vl-{len(outbounds)}",
                  "server": host, "server_port": port, "uuid": uuid,
                  "packet_encoding": "xudp"}
            sec = p.get('security', '')
            if sec in ('tls', 'reality', 'xtls'):
                tls = {"enabled": True, "server_name": p.get('sni', host),
                       "utls": {"enabled": True, "fingerprint": p.get('fp', 'chrome') if p.get('fp', 'chrome') in ['chrome','firefox','ios','android','edge','safari','360','random','randomized'] else 'chrome'}}
                if sec == 'reality' and len(p.get('pbk', '')) >= 32:
                    tls["reality"] = {"enabled": True,
                                     "public_key": p.get('pbk', ''),
                                     "short_id": p.get('sid', '')}
                ob["tls"] = tls
            tp = p.get('type', '').lower()
            if tp in ('xhttp', 'splithttp'):
                continue  # sing-box 1.13 has no xhttp transport
            if tp == 'ws':
                tr = {"type": "ws"}
                if p.get('path'): tr["path"] = p['path']
                if p.get('host'): tr["headers"] = {"Host": p['host']}
                ob["transport"] = tr
            elif tp == 'grpc':
                tr = {"type": "grpc"}
                if p.get('serviceName'): tr["service_name"] = p['serviceName']
                ob["transport"] = tr
            elif tp == 'httpupgrade':
                tr = {"type": "httpupgrade"}
                if p.get('host'): tr["host"] = p['host']
                if p.get('path'): tr["path"] = p['path']
                ob["transport"] = tr
            elif tp == 'http':
                tr = {"type": "http"}
                if p.get('host'): tr["host"] = [p['host']]
                if p.get('path'): tr["path"] = p['path']
                ob["transport"] = tr
            # tcp/raw/none → no transport
            outbounds.append(ob)
    except: pass
tags = [o["tag"] for o in outbounds]
if tags:
    outbounds.append({"type": "urltest", "tag": "auto",
                      "outbounds": tags, "interval": "5m", "tolerance": 50})
outbounds.append({"type": "direct", "tag": "direct"})
inbounds = [{"type": "socks", "tag": "in", "listen": "127.0.0.1", "listen_port": 10808}]
lan = os.environ.get("LAN_CFG", "").strip()
if lan and ":" in lan:
    u, p = lan.split(":", 1)
    inbounds.append({"type": "socks", "tag": "in-lan", "listen": "0.0.0.0",
                     "listen_port": 10810,
                     "users": [{"username": u, "password": p}]})
cfg = {"log":{"level":"error"},"dns":{},
       "inbounds":inbounds,
       "outbounds":outbounds,
       "route":{"rules":[{"ip_is_private":True,"outbound":"direct"}],
                "final":"auto","auto_detect_interface":True}}
os.makedirs(os.path.dirname(cfg_path), exist_ok=True)
with open(cfg_path,"w") as f:
    json.dump(cfg, f, indent=2)
print(f"  Config: {len(outbounds)-2} outbounds + urltest")
PYEOF
}

# ============================================================
# refresh — скачать свежие ноды, обновить конфиг
# ============================================================
refresh() {
    echo "  Fetching fresh nodes..."
    FALLBACK=$(load_fallback)
    NEW_NODES=""
    for url in \
      "https://cdn.jsdelivr.net/gh/rtwo2/FastNodes@main/sub/protocols/vless.txt" \
      "https://cdn.jsdelivr.net/gh/rtwo2/FastNodes@main/sub/everything.txt"; do
        data=$(curl --noproxy '*' -sL --connect-timeout 5 --max-time 10 "$url" 2>/dev/null | \
          grep -E '^(vless|hysteria2)://' | shuf | head -30 || true)
        if [ -n "$data" ]; then
            echo "    $(echo "$data" | wc -l) from $(basename $url)"
            NEW_NODES="$NEW_NODES"$'\n'"$data"
        fi
    done

    ALL="$FALLBACK"
    [ -n "$NEW_NODES" ] && ALL="$FALLBACK"$'\n'"$NEW_NODES"
    if [ -z "$ALL" ]; then
        echo "  ERROR: no fallback nodes and no subscription nodes available"
        exit 1
    fi
    export NODES_TEXT="$ALL"
    export CFG_PATH="$CONFIG"
    LAN_CFG="$(lan_cfg)"
    export LAN_CFG
    python3 << 'PYEOF'
import json, os, urllib.parse
text = os.environ["NODES_TEXT"]
cfg_path = os.environ["CFG_PATH"]
outbounds = []
def clean(s):
    if not s: return {}
    s = s.replace('&amp;', '&')
    if '#' in s: s = s.split('#')[0]
    return {k: v[0].split('#')[0] for k, v in urllib.parse.parse_qs(s).items()}
for line in text.strip().split('\n'):
    line = line.strip()
    if not line: continue
    try:
        if line.startswith('hysteria2://'):
            r = line.split('hysteria2://')[1]
            pwd = r.split('@')[0] if '@' in r else r.split('?')[0]
            a = r.split('@', 1)[1] if '@' in r else r
            h = a.split('?')[0]; host = h.split(':')[0]
            ps = h.split(':')[1] if ':' in h else '443'
            port = int(ps.split('?')[0]) if ps.split('?')[0].isdigit() else 443
            p = clean(a.split('?', 1)[1] if '?' in a else '')
            ob = {"type": "hysteria2", "tag": f"h2-{len(outbounds)}",
                  "server": host, "server_port": port, "password": pwd,
                  "tls": {"enabled": True, "insecure": True,
                          "server_name": p.get('sni', host)}}
            if 'obfs' in p:
                ob["obfs"] = {"type": p['obfs'], "password": p.get('obfs-password', '')}
            outbounds.append(ob)
        elif line.startswith('vless://'):
            r = line.split('vless://')[1]
            uuid = r.split('@')[0]
            a = r.split('@', 1)[1] if '@' in r else r
            hp = a.split('?')[0]
            host = hp.rsplit(':', 1)[0]; port = int(hp.rsplit(':', 1)[1])
            p = clean(a.split('?', 1)[1] if '?' in a else '')
            ob = {"type": "vless", "tag": f"vl-{len(outbounds)}",
                  "server": host, "server_port": port, "uuid": uuid,
                  "packet_encoding": "xudp"}
            sec = p.get('security', '')
            if sec in ('tls', 'reality', 'xtls'):
                tls = {"enabled": True, "server_name": p.get('sni', host),
                       "utls": {"enabled": True, "fingerprint": p.get('fp', 'chrome') if p.get('fp', 'chrome') in ['chrome','firefox','ios','android','edge','safari','360','random','randomized'] else 'chrome'}}
                if sec == 'reality' and len(p.get('pbk', '')) >= 32:
                    tls["reality"] = {"enabled": True,
                                     "public_key": p.get('pbk', ''),
                                     "short_id": p.get('sid', '')}
                ob["tls"] = tls
            tp = p.get('type', '').lower()
            if tp in ('xhttp', 'splithttp'):
                continue  # sing-box 1.13 has no xhttp transport
            if tp == 'ws':
                tr = {"type": "ws"}
                if p.get('path'): tr["path"] = p['path']
                if p.get('host'): tr["headers"] = {"Host": p['host']}
                ob["transport"] = tr
            elif tp == 'grpc':
                tr = {"type": "grpc"}
                if p.get('serviceName'): tr["service_name"] = p['serviceName']
                ob["transport"] = tr
            elif tp == 'httpupgrade':
                tr = {"type": "httpupgrade"}
                if p.get('host'): tr["host"] = p['host']
                if p.get('path'): tr["path"] = p['path']
                ob["transport"] = tr
            elif tp == 'http':
                tr = {"type": "http"}
                if p.get('host'): tr["host"] = [p['host']]
                if p.get('path'): tr["path"] = p['path']
                ob["transport"] = tr
            # tcp/raw/none → no transport
            outbounds.append(ob)
    except: pass
tags = [o["tag"] for o in outbounds]
if tags:
    outbounds.append({"type": "urltest", "tag": "auto",
                      "outbounds": tags, "interval": "5m", "tolerance": 50})
outbounds.append({"type": "direct", "tag": "direct"})
inbounds = [{"type": "socks", "tag": "in", "listen": "127.0.0.1", "listen_port": 10808}]
lan = os.environ.get("LAN_CFG", "").strip()
if lan and ":" in lan:
    u, p = lan.split(":", 1)
    inbounds.append({"type": "socks", "tag": "in-lan", "listen": "0.0.0.0",
                     "listen_port": 10810,
                     "users": [{"username": u, "password": p}]})
cfg = {"log":{"level":"error"},"dns":{},
       "inbounds":inbounds,
       "outbounds":outbounds,
       "route":{"rules":[{"ip_is_private":True,"outbound":"direct"}],
                "final":"auto","auto_detect_interface":True}}
os.makedirs(os.path.dirname(cfg_path), exist_ok=True)
with open(cfg_path,"w") as f:
    json.dump(cfg, f, indent=2)
print(f"  Config: {len(outbounds)-2} outbounds + urltest")
PYEOF
    echo "  Config: $CONFIG regenerated"
    if systemctl --user is-active --quiet sing-box-proxy.service 2>/dev/null; then
        echo "  Restarting proxy service..."
        systemctl --user restart sing-box-proxy.service 2>/dev/null || start
    else
        start
    fi
}

# ============================================================
# start/stop
# ============================================================
start() {
    if systemctl is-active --quiet xray.service 2>/dev/null; then
        echo "  Stopping xray..."
        if ! sudo -n systemctl stop xray.service 2>/dev/null; then
            # xray runs as neg — pkill works without root; systemd then marks the unit inactive
            pkill -f 'xray.*config.json' 2>/dev/null || true
            echo "  (no passwordless sudo — xray stopped via pkill)"
        fi
    fi
    # Preferred: run under the systemd user service (autostarts at login, survives reboot).
    if systemctl --user start sing-box-proxy.service 2>/dev/null; then
        sleep 1
        if systemctl --user is-active --quiet sing-box-proxy.service 2>/dev/null; then
            echo "  Proxy on 127.0.0.1:10808 (systemd user service)"
            lan_msg
            echo "  Dashboard: http://127.0.0.1:9090 (secret: neg)"
            return 0
        fi
    fi
    # Fallback (user unit not installed): legacy direct launch
    pkill -f 'sing-box.*trojan' 2>/dev/null || true
    sleep 1
    export ENABLE_DEPRECATED_LEGACY_DNS_SERVERS=true
    nohup sing-box run -c "$CONFIG" > "$LOG" 2>&1 &
    sleep 2
    if pgrep -f 'sing-box.*trojan' > /dev/null 2>&1; then
        echo "  Proxy on 127.0.0.1:10808"
        lan_msg
        echo "  Dashboard: http://127.0.0.1:9090 (secret: neg)"
    else
        echo "  FAILED"
        tail -3 "$LOG" 2>/dev/null || true
        return 1
    fi
}

stop() {
    if ! systemctl --user stop sing-box-proxy.service 2>/dev/null; then
        # user unit not installed — legacy pkill
        pkill -f 'sing-box.*trojan' 2>/dev/null || true
    fi
    if ! systemctl is-active --quiet xray.service 2>/dev/null; then
        echo "  Restoring xray..."
        sudo -n systemctl start xray.service 2>/dev/null \
            || echo "  (no passwordless sudo — run: sudo systemctl start xray.service)"
    fi
    echo "  Proxy off"
}

# ============================================================
# main
# ============================================================
case "${1:-status}" in
    on|start)    bootstrap; start ;;
    off|stop)    stop ;;
    refresh)     refresh ;;
    gen|bootstrap) bootstrap ;;
    status)
        if systemctl --user is-failed --quiet sing-box-proxy.service 2>/dev/null; then
            echo "Proxy: FAILED (see: journalctl --user -u sing-box-proxy)"
            ss -tlnp 2>/dev/null | grep -E '10808|10810' || true
        elif systemctl --user is-active --quiet sing-box-proxy.service 2>/dev/null \
            || pgrep -f 'sing-box.*trojan' > /dev/null 2>&1; then
            echo "Proxy: RUNNING (Hysteria2 + VLESS Reality)"
            ss -tlnp 2>/dev/null | grep -E '10808|10810' || true
        else
            echo "Proxy: STOPPED"
        fi
        if systemctl is-active --quiet xray.service 2>/dev/null; then
            echo "Xray: RUNNING"
        else
            echo "Xray: STOPPED"
        fi
        ;;
    *) echo "Usage: $0 {on|off|status|refresh|gen}"; exit 1 ;;
esac
