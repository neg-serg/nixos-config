#!/bin/sh
# seed-vc: zero-shot voice conversion (ByteDance Seed-VC, SOTA 2025-2026).
# venv-seedvc (torch 2.13+rocm7.1); checkpoints cached offline in /zero/ai/music-ai/seed-vc/checkpoints.
# Usage: seed-vc SOURCE.wav TARGET_REF.wav [OUTDIR] [--steps N] [--svc]
#   SOURCE = твой голос/аудио, TARGET_REF = референс голоса (1-30s).
#   --svc = режим пения (f0-condition, нужен rmvpe — качается отдельно).
set -eu
export LD_LIBRARY_PATH="/nix/store/7vafhlh0lmcvi75jfyy09qwr4m3x1ks3-gcc-15.2.0-lib/lib:/nix/store/483x61iy35irm4wr2b7dwzihljhp6da2-zlib-1.3.2/lib:/nix/store/13id30w3rvgj24nnz34f7qrncz48zd7l-zstd-1.5.7/lib:${LD_LIBRARY_PATH:-}"
export HF_HUB_OFFLINE=1
SRC="${1:?usage: seed-vc SOURCE.wav TARGET_REF.wav [OUTDIR] [--steps N] [--svc]}"; REF="${2:?}"; OUT="${3:-/tmp/svc-out}"; STEPS=25; SVC=0
shift $(( $# >= 2 ? 2 : $# ))
while [ "$#" -gt 0 ]; do case "$1" in
  --steps) STEPS="$2"; shift 2;;
  --svc) SVC=1; shift;;
  *) OUT="$1"; shift;;
esac; done
OUT="$(readlink -f "$OUT")"
cd /zero/ai/music-ai/seed-vc
if [ "$SVC" = "1" ]; then
  exec /zero/ai/music-ai/venv-seedvc/bin/python inference.py --source "$SRC" --target "$REF" --output "$OUT" --diffusion-steps "$STEPS" --fp16 True --f0-condition True
else
  exec /zero/ai/music-ai/venv-seedvc/bin/python inference.py --source "$SRC" --target "$REF" --output "$OUT" --diffusion-steps "$STEPS" --fp16 True
fi
