#!/usr/bin/env bash
# Keep the force-installed SurfingKeys extension loading its config from the
# local server.
#
# Vivaldi updates extensions in place (1.19.3 replaced 1.18.0 while the session
# was already running) and the minifier renames identifiers between releases.
# Every step below therefore patches the newest version directory, is guarded
# by the marker it writes, and *fails loudly* when neither the marker nor the
# anchor is present: a silent skip is how a `403 Forbidden` response body once
# stayed registered as the settings userScript (2026-11-02).
set -euo pipefail

EXT_BASE="$HOME/.config/vivaldi/Default/Extensions/gfbliohnnapiefjpjlpjnehglfpaknnc"
URL="http://localhost:18888/surfingkeys.js"

# Patch the newest version directory only.
VER_DIR=$(ls -d "$EXT_BASE"/*/ 2>/dev/null | sort -V | tail -1)
[ -z "$VER_DIR" ] && exit 0

BG_JS="$VER_DIR/background.js"
MD_CSS="$VER_DIR/pages/markdown.css"

fail=0
note() { logger "surfingkeys-patch: $*"; }
missing() {
  logger -p user.err "surfingkeys-patch: $*"
  fail=1
}

# 1. Config URL injection at worker start. SurfingKeys reads the config URL
# from the 'localPath' storage key, NOT 'loadSettingsUrl' (dead key).
if ! grep -q 'NEG_SK_URL' "$BG_JS"; then
  if grep -q '^(()=>{"use strict"' "$BG_JS"; then
    cp "$BG_JS" "$BG_JS.orig"
    sed -i "s|^(()=>{\"use strict\"|const NEG_SK_URL=\"$URL\";\nchrome.storage.sync.set({localPath:NEG_SK_URL});\nchrome.storage.local.set({localPath:NEG_SK_URL});\n(()=>{\"use strict\"|" "$BG_JS"
    note "Patched $BG_JS (URL injection)"
  else
    missing "URL-injection anchor not found in $BG_JS"
  fi
fi

# 2. Re-registration helper. SurfingKeys registers its settings as the
# 'settingsSnippets' userScript; if the config fetch ever fails, whatever body
# was registered last keeps running on every page. The helper mirrors the
# extension's own registration wrapper and is called from the fetch callback
# (step 4), so a successful fetch always replaces the registered code. It reads
# the current registration first and leaves it alone when the code already
# matches: this runs on every page load, and an unconditional unregister+register
# would rewrite the extension's dynamic-script store for no reason.
if ! grep -q 'NEG_SK_REGISTER2' "$BG_JS"; then
  # Drop the first version of the helper (no equality guard) if a previous run
  # of this patcher left it behind.
  sed -i '/^const NEG_SK_REGISTER=function(s){var c=/d' "$BG_JS" || true
  tmp=$(mktemp)
  cat > "$tmp" <<'JS'
const NEG_SK_REGISTER2=function(s){var c="import(\"./api.js\").then(function(m){m.default(\""+chrome.runtime.getURL("/")+"\",function(api,settings){"+s+"\n})});";chrome.userScripts.getScripts({ids:["settingsSnippets"]},function(r){if(!chrome.runtime.lastError&&r&&r.length&&r[0].js&&r[0].js[0]&&r[0].js[0].code===c){return}chrome.userScripts.unregister({ids:["settingsSnippets"]},function(){chrome.userScripts.register([{allFrames:!0,id:"settingsSnippets",matches:["*://*/*","file:///*"],js:[{code:c}],runAt:"document_start"}])})})};
JS
  cat "$tmp" "$BG_JS" > "$BG_JS.tmp"
  mv "$BG_JS.tmp" "$BG_JS"
  rm -f "$tmp"
  note "Patched $BG_JS (config re-registration helper)"
fi

# 3. Force the local config URL at the read point. The options page can
# overwrite 'localPath' ('Load from URL'), which would make the browser fetch a
# stale external config; the comma expression sets it on every load.
if ! grep -qF "(e.localPath=\"$URL\",e.localPath)" "$BG_JS"; then
  if grep -qF 'e.localPath?B(e.localPath,' "$BG_JS"; then
    sed -i "s|e.localPath?B(e.localPath,|(e.localPath=\"$URL\",e.localPath)?B(e.localPath,|" "$BG_JS"
    note "Patched $BG_JS (hardcoded config URL)"
  else
    missing "config-URL read anchor not found in $BG_JS"
  fi
fi

# 4. Refresh the registered userScript after every successful fetch: Vivaldi
# otherwise keeps the previously registered 'settingsSnippets' code. The helper
# itself skips the write when the wrapped code already matches.
if ! grep -qF 'NEG_SK_REGISTER2(t)' "$BG_JS"; then
  if grep -qF 'B(e.localPath,function(t){e.snippets=t,o(e)},' "$BG_JS"; then
    sed -i 's|B(e.localPath,function(t){e.snippets=t,o(e)},|B(e.localPath,function(t){e.snippets=t,NEG_SK_REGISTER2(t),o(e)},|' "$BG_JS"
    note "Patched $BG_JS (refresh registration after fetch)"
  elif grep -qF 'NEG_SK_REGISTER(t)' "$BG_JS"; then
    sed -i 's|NEG_SK_REGISTER(t)|NEG_SK_REGISTER2(t)|g' "$BG_JS"
    note "Patched $BG_JS (refresh registration after fetch, upgraded)"
  else
    missing "fetch-callback anchor not found in $BG_JS"
  fi
fi

# 5. Remove zebra striping from the markdown preview tables (cosmetic).
if [ -f "$MD_CSS" ] && grep -qF 'background-color: #f8f8f8;' "$MD_CSS"; then
  sed -i 's|background-color: #f8f8f8;|background-color: transparent;|' "$MD_CSS"
  note "Patched $MD_CSS (no zebra)"
fi

# A critical patch that silently stopped matching means the minifier moved and
# the anchors need an update; fail the unit so the breakage is visible.
grep -qF 'NEG_SK_URL' "$BG_JS" || missing "critical patch missing: URL injection"
grep -qF 'NEG_SK_REGISTER2' "$BG_JS" || missing "critical patch missing: registration helper"
grep -qF 'NEG_SK_REGISTER2(t)' "$BG_JS" || missing "critical patch missing: registration refresh"
grep -qF "(e.localPath=\"$URL\",e.localPath)" "$BG_JS" || missing "critical patch missing: hardcoded config URL"

exit "$fail"
