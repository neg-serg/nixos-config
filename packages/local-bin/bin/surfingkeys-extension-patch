#!/usr/bin/env bash
# Ensure SurfingKeys extension loads the local config and runs it reliably
set -euo pipefail

EXT_BASE="$HOME/.config/vivaldi/Default/Extensions/gfbliohnnapiefjpjlpjnehglfpaknnc"
URL="http://localhost:18888/surfingkeys.js"

# Find the latest version directory
VER_DIR=$(ls -d "$EXT_BASE"/*/ 2>/dev/null | sort -V | tail -1)
[ -z "$VER_DIR" ] && exit 0

BG_JS="$VER_DIR/background.js"
OP_JS="$VER_DIR/pages/options.js"

# 1. Config URL injection at worker start. SurfingKeys 1.18 reads the config
# URL from the 'localPath' storage key, NOT 'loadSettingsUrl' (dead key).
if [ -f "$BG_JS" ] && ! grep -q 'NEG_SK_URL' "$BG_JS"; then
    cp "$BG_JS" "$BG_JS.orig"
    sed -i "s|^(()=>{\"use strict\"|const NEG_SK_URL=\"$URL\";\nchrome.storage.sync.set({localPath:NEG_SK_URL});\nchrome.storage.local.set({localPath:NEG_SK_URL});\n(()=>{\"use strict\"|" "$BG_JS"
    logger "surfingkeys-patch: Patched $BG_JS (URL injection)"
fi

# 2. Hardcode the config URL at the read point and persist it back to storage.
# The options page can overwrite 'localPath' (e.g. 'Load from URL'), making the
# browser fetch a stale external config; force the local URL on every load and
# write it back so storage/options show it too.
if [ -f "$BG_JS" ] && ! grep -qF '(e.localPath="http://localhost:18888/surfingkeys.js"),chrome.storage.local.set({localPath:e.localPath})' "$BG_JS"; then
    sed -i 's|e.localPath?g(q(e.localPath),(function(t){e.snippets=t,n(e)}),void 0,void 0,(function(t){e.error="Failed to read snippets from "+e.localPath,n(e)})):n(e)|(e.localPath="http://localhost:18888/surfingkeys.js"),chrome.storage.local.set({localPath:e.localPath}),g(q(e.localPath),(function(t){e.snippets=t,setTimeout(function(){F(t)},100),n(e)}),void 0,void 0,(function(t){e.error="Failed to read snippets from "+e.localPath,e.snippets="",n(e)}))|' "$BG_JS"
    logger "surfingkeys-patch: Patched $BG_JS (hardcoded config URL)"
fi

# 3. Auto-register the config userScript on every page load: the page-load
# getSettings flow never triggered F (Vivaldi kept a stale registration);
# call F from the fetch callback so the registered config is always current.
if [ -f "$BG_JS" ] && ! grep -qF '(function(t){e.snippets=t,setTimeout(function(){F(t)},100),n(e)})' "$BG_JS"; then
    sed -i 's|(function(t){e.snippets=t,n(e)})|(function(t){e.snippets=t,setTimeout(function(){F(t)},100),n(e)})|' "$BG_JS"
    logger "surfingkeys-patch: Patched $BG_JS (auto-register on load)"
fi

# 4. Force userScript re-registration. Vivaldi sometimes keeps the previously
# registered settingsSnippets userScript instead of updating it; always
# unregister+register so the latest fetched config is what runs.
if [ -f "$BG_JS" ] && ! grep -qF 'chrome.userScripts.unregister({ids:[n]},i)' "$BG_JS"; then
    sed -i 's|r.length>0?r\[0\].js\[0\].code!==s?chrome.userScripts.unregister({ids:\[n\]},i):t&&t():i()|chrome.userScripts.unregister({ids:[n]},i)|' "$BG_JS"
    logger "surfingkeys-patch: Patched $BG_JS (forced re-registration)"
fi

# 5. Options page: stop persisting the 'Load from URL' value into localPath.
if [ -f "$OP_JS" ] && grep -qF 'localPath:A(w.value)' "$OP_JS"; then
    sed -i 's|e("updateSettings",{settings:{snippets:t,localPath:A(w.value)}})|e("updateSettings",{settings:{snippets:t}})|' "$OP_JS"
    logger "surfingkeys-patch: Patched $OP_JS (localPath save dropped)"
fi

# 6. Worker 'Load from URL' handler: do not write localPath into storage.
if [ -f "$BG_JS" ] && grep -qF 'E({localPath:o,snippets:e})' "$BG_JS"; then
    sed -i 's|E({localPath:o,snippets:e})|E({snippets:e})|' "$BG_JS"
    logger "surfingkeys-patch: Patched $BG_JS (loadFromUrl localPath dropped)"
fi
