#!/usr/bin/env bash
# Ensure SurfingKeys extension loads the local config and runs it reliably
set -euo pipefail

EXT_BASE="$HOME/.config/vivaldi/Default/Extensions/gfbliohnnapiefjpjlpjnehglfpaknnc"
URL="http://localhost:18888/surfingkeys.js"

# Find the latest version directory
VER_DIR=$(ls -d "$EXT_BASE"/*/ 2>/dev/null | sort -V | tail -1)
[ -z "$VER_DIR" ] && exit 0

BG_JS="$VER_DIR/background.js"
CJ_JS="$VER_DIR/content.js"

# 1. Config URL injection at worker start. SurfingKeys 1.18 reads the config
# URL from the 'localPath' storage key, NOT 'loadSettingsUrl' (dead key).
if [ -f "$BG_JS" ] && ! grep -q 'NEG_SK_URL' "$BG_JS"; then
    cp "$BG_JS" "$BG_JS.orig"
    sed -i "s|^(()=>{\"use strict\"|const NEG_SK_URL=\"$URL\";\nchrome.storage.sync.set({localPath:NEG_SK_URL});\nchrome.storage.local.set({localPath:NEG_SK_URL});\n(()=>{\"use strict\"|" "$BG_JS"
    logger "surfingkeys-patch: Patched $BG_JS (URL injection)"
fi

# 2. Hardcode the config URL at the read point. The options page can overwrite
# the 'localPath' storage key (e.g. 'Load from URL'), making the browser fetch
# a stale external config; force the local URL regardless of storage.
if [ -f "$BG_JS" ] && ! grep -qF '(e.localPath="http://localhost:18888/surfingkeys.js")' "$BG_JS"; then
    sed -i 's|e.localPath?g(q(e.localPath),(function(t){e.snippets=t,n(e)}),void 0,void 0,(function(t){e.error="Failed to read snippets from "+e.localPath,n(e)})):n(e)|(e.localPath="http://localhost:18888/surfingkeys.js"),g(q(e.localPath),(function(t){e.snippets=t,n(e)}),void 0,void 0,(function(t){e.error="Failed to read snippets from "+e.localPath,e.snippets="",n(e)}))|' "$BG_JS"
    logger "surfingkeys-patch: Patched $BG_JS (hardcoded config URL)"
fi

# 3. Kill the settingsSnippets userScript. Vivaldi fails to update it when the
# config changes (stale rose-pine config stuck since 06:48), so the config is
# executed via the direct content.js path instead (see 4). Never register.
if [ -f "$BG_JS" ] && ! grep -qF 'if(true)return chrome.userScripts.unregister({ids:["settingsSnippets"]}' "$BG_JS"; then
    sed -i 's|function F(e,t){if(!B())return void(t&&t());|function F(e,t){if(true)return chrome.userScripts.unregister({ids:["settingsSnippets"]},()=>{}),void(t\&\&t());|' "$BG_JS"
    logger "surfingkeys-patch: Patched $BG_JS (userScript kill)"
fi

# 4. Run the config directly in the content script (MV2-style 'new Function'
# path), so the latest fetched config applies on every page load without
# depending on userScript registration. Skip silently on pages whose CSP
# blocks eval instead of showing the error banner.
if [ -f "$CJ_JS" ] && ! grep -qF 'if(n.snippets&&' "$CJ_JS"; then
    cp "$CJ_JS" "$CJ_JS.orig"
    sed -i 's|!n\.isMV3&&n\.snippets&&|n.snippets\&\&|' "$CJ_JS"
    sed -i 's|try{new Function("settings","api",n.snippets)(i,e)}catch(e){r=e.toString()}|try{new Function("settings","api",n.snippets)(i,e)}catch(e){if(e instanceof EvalError)return console.log("[SurfingKeys] config skipped: page CSP blocks eval");r=e.toString()}|' "$CJ_JS"
    logger "surfingkeys-patch: Patched $CJ_JS (direct config path)"
fi
