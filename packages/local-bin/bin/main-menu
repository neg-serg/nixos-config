#!/bin/sh
# main-menu: vicinae dmenu-driven helper actions for music/clipboard/network/etc
#
# Usage:
#   main-menu                 # the classic dmenu picker
#   main-menu --list          # print the action names (for other pickers)
#   main-menu --run NAME      # run one action non-interactively
#
# menu-search (the tray/app menu mini window) lists these actions too, so the
# actions stay searchable after the Super+Shift+M binding moved over to it.
# shellcheck shell=sh

IFS=' 	
'

main_menu='
title_copy
artist_copy
album_copy
path_copy
pipewire_output
alsa_output
translate
termbin
'

generate_menu() {
    for item in $main_menu; do
        printf '%s\n' "$item"
    done
}

# Helpers for JSON from rmpc-song
_song_json() { rmpc song 2>/dev/null; } # prints JSON for current song
jq_str()     { jq -r "$1 // empty"; }

title_copy(){
    # Emulate `mpc current`: "Artist - Title" when possible, else Title, else empty
    _song_json | jq -r 'if .metadata.artist and .metadata.title then "\(.metadata.artist) - \(.metadata.title)"
                        else (.metadata.title // .metadata.name // "") end' | wl-copy
}

album_copy(){  _song_json | jq_str '.metadata.album'  | wl-copy; }
artist_copy(){ _song_json | jq_str '.metadata.artist' | wl-copy; }

path_copy(){
    mpd_music_dir="${XDG_MUSIC_DIR:-$HOME/Music}"
    file=$(_song_json | jq_str '.file')
    [ -n "$file" ] && printf '%s/%s\n' "$mpd_music_dir" "$file" | wl-copy
}

pipewire_output(){
    rmpc-pause
    rmpc-enableoutput PipeWire
    rmpc-disableoutput "$dac_name"
    rmpc-play
}

alsa_output(){
    timeout="5s"
    rmpc-pause
    rmpc-enableoutput "$dac_name"
    rmpc-disableoutput PipeWire
    rmpc-play
    sleep "$timeout"
    rmpc-play
}

translate(){
    text="$(wl-paste)"
    translate="$(trans -brief :ru "$text")"
    notify-send -t $((${#text} * 150)) "$translate"
    play-sound "cyclist.ogg"
}

termbin(){
    url=$(wl-paste | nc termbin.com 9999)
    echo "$url" | wl-copy
    notify-send "$url copied to clipboard"
    play-sound "direct.ogg"
}

handler() {
    while IFS= read -r line; do
        if [ -n "$line" ]; then
            for t in $main_menu; do
                if [ "$line" = "$t" ]; then
                    "$t"
                    break
                fi
            done
        fi
    done
}

dac_name='RME HDSPe AIO'

case "${1:-}" in
--list)
    generate_menu
    exit 0
    ;;
--run)
    action="${2:-}"
    if [ -z "$action" ]; then
        printf 'main-menu: --run needs an action name\n' >&2
        exit 2
    fi
    for t in $main_menu; do
        if [ "$action" = "$t" ]; then
            "$t"
            exit 0
        fi
    done
    printf 'main-menu: unknown action: %s\n' "$action" >&2
    exit 2
    ;;
--help | -h)
    printf 'usage: main-menu [--list | --run NAME]\n'
    exit 0
    ;;
esac

generate_menu | vicinae dmenu -p '❯>' | handler
