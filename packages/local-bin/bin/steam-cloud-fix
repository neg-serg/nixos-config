#!/usr/bin/env bash
# Reset Steam Cloud bookkeeping for one app and (re)start the Steam client.
#
# Why this exists
# ---------------
# The Steam client keeps a per-app cloud cache (userdata/<id>/<appid>/remotecache.vdf
# plus the "ac" staging tree). When that cache disagrees with the server manifest,
# the client can sit in a "changesincloud" loop: it reports saves as needing a
# download even when the local file is byte-identical, and only the per-app cache
# is ever consulted — restarting the client or verifying game files does not
# refresh it. Deleting the two cache paths makes the client rebuild them from the
# server manifest at the next start, which is the only local way to break the loop.
#
# Deliberately NOT used: proxychains/LD_PRELOAD routing of Steam through the local
# SOCKS5 proxy (features.games.steamProxy). Measured: with the client behind SOCKS5
# it stops logging in at all ("Received logon failure response" in
# logs/steamui_login.txt), so cloud sync cannot work; keep Steam direct.
#
# Nothing here touches the cloud account or the save files themselves: only the
# cache is moved aside (backups are kept), never deleted.
#
# Usage:
#   steam-cloud-fix                 # repair RimWorld (294100) and start Steam
#   steam-cloud-fix --status        # report only, change nothing
#   steam-cloud-fix --app 294100 --wait 120
#   steam-cloud-fix --no-start      # repair without launching the client
#
# Env: STEAM_ROOT (default ~/.local/share/Steam), BACKUP_ROOT (default
# ~/.local/share/steam-cloud-fix).
set -euo pipefail

APPID=294100
STEAM_ROOT="${STEAM_ROOT:-$HOME/.local/share/Steam}"
BACKUP_ROOT="${BACKUP_ROOT:-$HOME/.local/share/steam-cloud-fix}"
STATUS_ONLY=0
START=1
WAIT=90

die() {
  printf 'ошибка: %s\n' "$*" >&2
  exit 1
}

while (($#)); do
  case "$1" in
    --app)
      APPID="${2:?--app требует appid}"
      shift 2
      ;;
    --status)
      STATUS_ONLY=1
      shift
      ;;
    --no-start)
      START=0
      shift
      ;;
    --wait)
      WAIT="${2:?--wait требует секунды}"
      shift 2
      ;;
    -h | --help)
      sed -n '2,32p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    *) die "неизвестный аргумент: $1" ;;
  esac
done

[[ -d $STEAM_ROOT ]] || die "нет каталога Steam: $STEAM_ROOT"

# Account directory: the numeric userdata entry with the largest id (the only one
# this host ever logs into; "0" is the anonymous dir and has no cloud state).
account_dir() {
  local d best=''
  for d in "$STEAM_ROOT"/userdata/*/; do
    [[ -d $d ]] || continue
    d="${d%/}"
    [[ $(basename "$d") =~ ^[0-9]+$ && $(basename "$d") != 0 ]] || continue
    if [[ -z $best || $(basename "$d") -gt $(basename "$best") ]]; then best="$d"; fi
  done
  printf '%s' "$best"
}

ACCOUNT="$(account_dir)"
[[ -n $ACCOUNT ]] || die "не найден профиль в $STEAM_ROOT/userdata"

CLOUD_LOG="$STEAM_ROOT/logs/cloud_log.txt"
APPDIR="$ACCOUNT/$APPID"

# last_sync_state for the app, as recorded by the client itself
sync_state() {
  local f="$ACCOUNT/config/localconfig.vdf"
  [[ -f $f ]] || return 0
  awk -v app="$APPID" '
    $0 ~ "\"" app "\"$" { inside = 1 }
    inside && /last_sync_state/ { gsub(/["\t ]/, "", $0); sub(/^last_sync_state/, "", $0); print; exit }
    inside && /^\t{5}\}/ { inside = 0 }
  ' "$f"
}

# Recent cloud_log lines for the app (the client logs there, one line per step)
recent_log() {
  local n="${1:-12}"
  [[ -f $CLOUD_LOG ]] || return 0
  grep -F "[AppID $APPID]" "$CLOUD_LOG" | grep -v '^[[:space:]]*$' | tail -n "$n" |
    sed -E 's/^\[[0-9-]+ ([0-9:]+)\] \[AppID [0-9]+\] /\1  /' | cut -c1-140
}

report() {
  local state files
  state="$(sync_state)"
  printf 'RimWorld (appid %s), профиль %s\n' "$APPID" "$(basename "$ACCOUNT")"
  case "$state" in
    synchronized) state_text='синхронизировано' ;;
    changesincloud) state_text='в облаке есть изменения, которых нет локально (ждёт загрузки)' ;;
    changeslocal) state_text='локальные изменения ждут выгрузки' ;;
    '') state_text='состояние не записано клиентом' ;;
    *) state_text="$state" ;;
  esac
  printf '  состояние облака: %s\n' "$state_text"

  if [[ -d $APPDIR ]]; then
    files="$(find "$APPDIR" -maxdepth 2 -type f 2>/dev/null | wc -l)"
    printf '  кэш облака: %s (%s файлов)\n' "${APPDIR#"$STEAM_ROOT"/}" "$files"
  else
    printf '  кэш облака: нет (клиент ещё не заводил его для этой игры)\n'
  fi

  if [[ -f $CLOUD_LOG ]]; then
    printf '  последние строки %s:\n' "${CLOUD_LOG#"$STEAM_ROOT"/}"
    recent_log 8 | sed 's/^/    /'
  fi
}

if ((STATUS_ONLY)); then
  report
  exit 0
fi

steam_running() { pgrep -f 'steamrt64/steam' >/dev/null 2>&1; }

# Stop the client cleanly so it cannot rewrite the cache we are about to move.
if steam_running; then
  printf 'останавливаю Steam...\n'
  if command -v steam >/dev/null 2>&1; then
    timeout 60 steam -shutdown >/dev/null 2>&1 || true
  fi
  for _ in $(seq 1 30); do steam_running || break; sleep 1; done
  if steam_running; then
    pkill -TERM -f 'steamrt64/steam' 2>/dev/null || true
    for _ in $(seq 1 20); do steam_running || break; sleep 1; done
  fi
  steam_running && die 'Steam не завершился — закрой его вручную и повтори'
fi

# Move the per-app cloud cache aside; the client rebuilds it from the server.
stamp="$(date +%Y%m%d-%H%M%S)"
dest="$BACKUP_ROOT/$APPID-$stamp"
if [[ -e $APPDIR/remotecache.vdf || -e $APPDIR/ac ]]; then
  mkdir -p "$dest"
  for path in remotecache.vdf ac; do
    [[ -e $APPDIR/$path ]] && mv "$APPDIR/$path" "$dest/"
  done
  printf 'кэш облака убран в %s\n' "$dest"
else
  printf 'кэш облака уже пуст — нечего убирать\n'
fi

if ((!START)); then
  printf 'Steam не запускаю (--no-start).\n'
  exit 0
fi

# Launch the client the way the desktop session does: detached, direct connection
# (no proxy env), inheriting DISPLAY/WAYLAND_DISPLAY/XDG_RUNTIME_DIR.
steam_bin="$(command -v steam || true)"
[[ -n $steam_bin ]] || steam_bin="$STEAM_ROOT/steam.sh"
[[ -x $steam_bin ]] || die "не нашёл steam ($steam_bin)"
env -u ALL_PROXY -u all_proxy -u http_proxy -u https_proxy -u HTTP_PROXY -u HTTPS_PROXY \
  setsid "$steam_bin" >/dev/null 2>&1 < /dev/null &
printf 'Steam запускается, жду %s с и смотрю облако...\n' "$WAIT"
sleep "$WAIT"

report
printf '\nЕсли по-прежнему "Download Timeout" с хоста steamcloud-*.s3.dualstack.*:\n'
printf '  это ответ на стороне CDN Valve, а не локальная поломка — повтори позже\n'
printf '  или запусти игру, чтобы клиент разрешил конфликт сохранений своей стороной.\n'
