#!/bin/sh
# mt3: multi-instrument audio→MIDI transcription (mt3-infer, MR-MT3 PyTorch).
# venv: /zero/ai/music-ai/venv-mt3; checkpoint auto-downloaded on first use.
# Usage: mt3 input.wav [output.mid]
set -eu

BASE="/zero/ai/music-ai"
TORCHLIB="$BASE/venv-mt3/lib/python3.12/site-packages/torch/lib"
export LD_LIBRARY_PATH="@ZSTD_LIB_DIR@:@ZLIB_LIB_DIR@:@GCC_LIB_DIR@:$TORCHLIB:${LD_LIBRARY_PATH:-}"

SRC="${1:?usage: mt3 input.wav [output.mid]}"
OUT="${2:-/tmp/mt3-out.mid}"

# Checkpoint cache on the ZFS pool (per /zero/ai convention); fallback to ~/.cache
export MT3_CHECKPOINT_DIR="${MT3_CHECKPOINT_DIR:-/zero/ai/music/mt3}"
if ! mkdir -p "$MT3_CHECKPOINT_DIR" 2>/dev/null; then
  export MT3_CHECKPOINT_DIR="$HOME/.cache/mt3"
  mkdir -p "$MT3_CHECKPOINT_DIR"
fi

"$BASE/venv-mt3/bin/python" -c "
import sys
from mt3_infer import transcribe
from mt3_infer.utils.audio import load_audio
from mt3_infer.utils.midi import count_notes
audio, sr = load_audio('$SRC')
import torch
_device = 'cuda' if torch.cuda.is_available() else 'cpu'
midi = transcribe(audio, sr=sr, model='fast', device=_device)
print(f'device: {_device}')
print(f'notes: {count_notes(midi)}')
midi.save('$OUT')
print(f'saved: $OUT')
"
