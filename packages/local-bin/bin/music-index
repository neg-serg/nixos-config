#!/bin/sh
# music-index: build the similarity index for a music library.
#
#   music-index [--out DIR] [--model ID] [-j N] [--limit N] [MUSIC_DIR]
#
# MERT embeddings (m-a-p/MERT-v1-95M by default) + numpy brute force: for a
# few thousand tracks the cosine search costs milliseconds, so there is no
# Annoy dependency and no separate "build" step beyond the embedding pass.
# Payload: packages/local-bin/lib/music_index.py.
set -eu

# Shared interpreter/venv preamble (sets BASE, LIB, PY, SP and exports).
MUSIC_AI_SELF=$0 . "$(dirname "$0")/_music_ai_env.sh"
export MUSIC_EMBED_MODEL="${MUSIC_EMBED_MODEL:-@MUSIC_EMBED_MODEL@}"

exec "$PY" "$LIB/music_index.py" "$@"
