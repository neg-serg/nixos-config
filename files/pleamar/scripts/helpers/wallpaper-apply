#!/usr/bin/env bash
# pleamar-wallpaper-apply FILE [COMMAND] — everything a new wallpaper sets besides the picture
# on screen, for the picker scene (shells/picker/picker.plm).
#
#     wallpaper-apply FILE [COMMAND]
#
#   ~/.cache/pleamar/wallpaper-path       -> the still, the producer path pleamar's theme
#                                            pipeline watches (scripts/theme/theme.sh reads it
#                                            first and falls back to the legacy one below)
#   ~/.cache/quickshell-wallpaper-path    -> the same still, for the legacy readers still alive
#                                            in the session: the bar accent and wl-greeter-sync,
#                                            which copies the file into the login screen's cache
#   ~/.cache/current_wallpaper_source     -> FILE, what is on screen
#   ~/.cache/current_wallpaper            -> the still, for the lock screens and the panels
#   ~/.local/state/wl/last-good           -> the still, wl-daemon's fallback when its own state
#                                            names a file that is gone
#   and the colour scheme, from matugen on that still (when matugen is installed).
#
# The still, never the source: the login screen runs k-means over it and the bar extracts
# colours, and neither can read a video.
#
# COMMAND is the tool that paints the desktop — settings.json's `command`, `wl img {}` on
# trantor, and `{}` is where the wallpaper's path goes (quoted; with no `{}` the path is
# appended). It runs detached: the tools that do this (swaybg, mpvpaper) do not return, and a
# wallpaper command that hangs must not hang the picker.
#
# Ported from the Quickshell picker's scripts/wallpaper-apply (GPL-3.0-or-later);
# the caches are the same, plus the pleamar producer path.
set -u

file=${1:-}
[ -n "$file" ] || { echo "wallpaper-apply: no FILE" >&2; exit 2; }
[ -f "$file" ] || { echo "wallpaper-apply: '$file' not found" >&2; exit 1; }
template=${2:-}

# The still comes from the helper beside this script (the links in ~/.local/bin point at both);
# without one, an image is its own still.
here=$(dirname "$0")
still=""
for cand in "$here/pleamar-wallpaper-still" "$here/wallpaper-still"; do
    if [ -x "$cand" ]; then
        still=$("$cand" "$file") || { echo "wallpaper-apply: no still image for '$file'" >&2; exit 1; }
        break
    fi
done
[ -n "$still" ] || still=$file

cache=${XDG_CACHE_HOME:-$HOME/.cache}
mkdir -p "$cache/pleamar" "$HOME/.local/state/wl"

ln -sfn "$file" "$cache/current_wallpaper_source"
ln -sfn "$still" "$cache/current_wallpaper"
printf '%s\n' "$still" > "$cache/pleamar/wallpaper-path"
printf '%s\n' "$still" > "$cache/quickshell-wallpaper-path"
printf '%s\n' "$still" > "$HOME/.local/state/wl/last-good"

# The painter. `setsid -f`: the command owns its own session, so it outlives this script and the
# scene that ran it (a swaybg that dies with the picker leaves no wallpaper at all).
if [ -n "$template" ]; then
    quoted=$(printf '%q' "$file")
    case $template in
        *'{}'*) cmd=${template//\{\}/$quoted} ;;
        *) cmd="$template $quoted" ;;
    esac
    setsid -f sh -c "$cmd" >/dev/null 2>&1 ||
        echo "wallpaper-apply: the wallpaper command failed: $template" >&2
fi

# The colour scheme, for those who use matugen. Niced: reading a big image takes most of a second
# on every core, which would cost the picker's own animations their frames.
command -v matugen >/dev/null || exit 0
nice -n 19 matugen image "$still" --source-color-index 0
