language 0.4

// widgets.plm — the desktop widgets: clock, now-playing, quote, system monitor
// and the CAVA analyser, laid on the wallpaper under every window (scene
// `widgets`).
//
// Ported from dhrruvsharma/shell (quickshell/modules/desktopwidgets — ClockWidget,
// MusicWidget, QuoteWidget, SysmonWidget — and the Cava widget of modules/cava),
// behaviour by behaviour, in this language's own terms. The widgets keep the
// reference's placement (clock top left, music top right, quote bottom left,
// system monitor bottom right), its content and its drag-to-arrange idea. What is
// NOT carried over is the reference's per-desktop-theme frame set: fifteen
// hand-drawn frames (WidgetFrame.qml, 749 lines) that belong to that rice's
// wallpaper themes. Here the plate is one shape drawn from the shell's live
// palette, so a theme change repaints the widgets with the rest of the shell
// instead of switching a second visual system on (lib/palette-live.plm).
//
// The surface
// -----------
// One layer-shell surface per monitor at `level: bottom`, full size, above the
// wallpaper and under every window: a widget is a desktop thing, not a panel.
// Only the zones take the mouse — the compositor passes a press through the empty
// part of the surface (the input region is the zones) — so clicking the wallpaper
// still reaches whatever is behind it. No reserve: windows keep the whole monitor.
//
// Arranging
// ---------
// A widget is dragged by pressing it and moving (`on drag`), and the position it
// is let go at is written into `~/.local/share/pleamar/widgets/widgets.json` by
// widgets.luau; the next start reads it back. Positions are stored normalised
// (0..1 of the monitor), so a monitor that is not the one it was arranged on still
// puts the widget in the same corner.
//
// The edit strip
// --------------
//   pleamar --say widgets "emit edit"                show or hide the strip
//   pleamar --say widgets "emit toggle_clock"        clock on/off (the strip's press)
//   pleamar --say widgets "emit toggle_music"        now-playing on/off
//   pleamar --say widgets "emit toggle_quote"        quote on/off
//   pleamar --say widgets "emit toggle_sysmon"       system monitor on/off
//   pleamar --say widgets "emit toggle_cava"         analyser on/off
//   pleamar --say widgets "emit reset_positions"     back to the reference's corners
// The strip is the discoverable way in: toggles along the bottom of the screen
// while `editing` is true, each saying what it switches (`checked:` for an agent).
// It is a widget of its own (`pages/edit.plm`), not a panel: the scene has no
// surface of its own to open and close.
//
// Where the data comes from
// -------------------------
//   clock   the `clock` service, declaratively (no logic involved)
//   music   the `media` service, watched by widgets.luau for the readouts the
//           language cannot compose (elapsed/total, progress); the Cover plugin for
//           the sleeve (the same resolver as the bar and the media drawer), and
//           `media.toggle/next/previous` for the transport
//   quote   a local list in widgets.luau, rotated every ten minutes; a press asks
//           for the next one. The reference fetches dad jokes from an API; a
//           desktop widget that draws on somebody else's network is not worth it,
//           and the port says so here instead of hiding it.
//   sysmon  the `pleamar-sysmon` worker (packages/pleamar-sysmon, the same one the
//           bar and the system drawer read), one sample every two seconds
//   cava    the CAVA analyser plugin (cava itself, driven by
//           lib/plugins/spectrum), with `Spectrum.active` following what plays
//
// Settings (`~/.local/share/pleamar/widgets/widgets.json`, read and watched by widgets.luau)
// -----------------------------------------------------------------------------------------
//   clock / music / quote / sysmon / cava   bool    which widgets are there
//   positions."<name>".x, .y                number  0..1 of the monitor, the plate's top left
// A missing key keeps the default here; the file holds only what the user changed.
// A file edited by hand — or by a provisioning script — is re-read while the scene
// runs (`files:` watch), so the widgets can be arranged with a text editor too.

import "../../lib/palette.plm"
import "../../lib/palette-live.plm"
import "../../lib/icons.plm"
import "../../lib/plugins/cover/cover.plm" as Cover
import "../../lib/plugins/spectrum/spectrum.plm" as Spectrum

scene widgets {

    // A desktop layer, not a panel: under the windows, over the wallpaper, on every
    // monitor. 30 frames while the analyser or a hover needs them, 10 at rest (the
    // clock changes once a minute); the engine paints at the surface's pace and
    // never idles on its own.
    surface {
        size: full, full
        anchor: top_left
        level: bottom
        screens: each
        rate: 30, 10 while not playing
    }

    permissions {
        run: "pleamar-sysmon"
        services: "clock", "media", "media.*", "files", "files.write"
    }

    // The live palette (lib/palette-live.plm): the theme handed over as facts, so a
    // new theme repaints the widgets without a reload. widgets.luau reads the
    // numbers out of the scene's own `palette.json` (`pleamar-themes push` writes
    // it); the defaults are the repository's theme.plm, so the first frame before
    // that read looks as it always did.
    fact pal_coal_r = 0.0000
    fact pal_coal_g = 0.0000
    fact pal_coal_b = 0.0000
    fact pal_surface_r = 0.1412
    fact pal_surface_g = 0.1647
    fact pal_surface_b = 0.2078
    fact pal_ink_r = 0.7961
    fact pal_ink_g = 0.8392
    fact pal_ink_b = 0.8980
    fact pal_ink_dim_r = 0.6824
    fact pal_ink_dim_g = 0.7255
    fact pal_ink_dim_b = 0.7843
    fact pal_accent_r = 0.0000
    fact pal_accent_g = 0.4353
    fact pal_accent_b = 0.8000
    fact pal_on_accent_r = 1.0000
    fact pal_on_accent_g = 1.0000
    fact pal_on_accent_b = 1.0000
    fact pal_light = 0

    // ------------------------------------------------------------ what is there
    // The interface a script or a bind talks to: one fact per widget, so
    // `--say widgets "fact has.clock false"` works as well as the events below.
    fact has.clock = true
    fact has.music = true
    fact has.quote = true
    fact has.sysmon = true
    fact has.cava = false
    fact editing = false

    // ------------------------------------------------------------- the clock
    // `clock` changes when the minute does, `clock.seconds` every second; neither
    // wakes the machine up to see whether it is time yet. `time` and `date` come
    // written out (`10:41`, `Sun 20 Sep`), and the plate puts the seconds after the
    // date as a number.
    service clock as now { time: text; date: text }
    service clock.seconds as tick { second: number }

    // -------------------------------------------------------------- the media
    // Declared for what the plate draws by itself (`playing` gates the transport
    // and the surface's pace); widgets.luau watches the same service for the
    // readouts the language cannot compose (elapsed/total, progress).
    fact playing = false
    fact media.progress = 0
    text track = ""
    text artist = ""
    text media.pos = "--:--"
    text media.len = "--:--"

    // ------------------------------------------------------------ the system
    // 0..1 for the bars, with the readouts as live texts (the language cannot
    // print a unit on a number it did not shape).
    fact cpu = 0
    fact ram = 0
    fact temp = 0
    fact disk = 0
    fact has.gpu = false
    fact gpu = 0
    text cpu.read = "--"
    text ram.read = "--"
    text temp.read = "--"
    text disk.read = "--"
    text gpu.read = "--"
    text ram.pair = ""
    model hist max 40 { v: number }

    // ------------------------------------------------------------- the quote
    text quote.body = "…"
    text quote.by = ""

    // ---------------------------------------------------------- where they sit
    // Normalised 0..1 of the monitor, the reference's own defaults: clock top
    // left, music top right, quote bottom left, system monitor bottom right, the
    // analyser low and centred. The plates are placed straight from these facts
    // (`move:` in each part), so a drag is the mouse's own motion and nothing
    // trails behind it.
    fact clock.nx = 0.03000
    fact clock.ny = 0.05556
    fact music.nx = 0.68750
    fact music.ny = 0.05556
    fact quote.nx = 0.03000
    fact quote.ny = 0.79630
    fact sysmon.nx = 0.68750
    fact sysmon.ny = 0.62963
    fact cava.nx = 0.39583
    fact cava.ny = 0.72222
    // Where the press started: a drag is measured from there, never added frame by
    // frame (which would double the distance travelled).
    fact clock.gx = 0.03000
    fact clock.gy = 0.05556
    fact music.gx = 0.68750
    fact music.gy = 0.05556
    fact quote.gx = 0.03000
    fact quote.gy = 0.79630
    fact sysmon.gx = 0.68750
    fact sysmon.gy = 0.62963
    fact cava.gx = 0.39583
    fact cava.gy = 0.72222

    // ---------------------------------------------------------------- events
    // What the strip and a bind say to widgets.luau (they persist the setting).
    event edit ->
    event toggle_clock ->
    event toggle_music ->
    event toggle_quote ->
    event toggle_sysmon ->
    event toggle_cava ->
    event reset_positions ->
    // A widget was let go: the logic reads its position facts and writes them.
    event clock_moved ->
    event music_moved ->
    event quote_moved ->
    event sysmon_moved ->
    event cava_moved ->
    // Transport and quote presses: the logic carries them to the service.
    event media_toggle ->
    event media_next ->
    event media_previous ->
    event next_quote ->

    // -------------------------------------------------------------- the plates
    // One frame for every widget: the shell's own tone, one accent hairline, a
    // quiet title, and the content in a slot. Every number is a design pixel; the
    // per-monitor fit is the caller's `scale` (palette.plm rule 2), so a widget
    // that has to be dragged stays a plain design box inside it.
    component Plate(w: number, h: number, title: text, scale: number = 1) {
        size: w * scale, h * scale
        group zoom {
            scale: scale
            body {
                color: live.coal
                opacity: 74%
                border: 1, mix(live.coal, live.ink, 10%)
                rim: 0.07
                shadow: 0, 10, 28, 42%
                box { from: 0, 0; size: w, h; corner: 12 }
            }
            // The accent mark the drawers carry at their top edge.
            box { from: 16, 0; size: 34, 1; color: live.accent; opacity: 70% }
            text "{title}" { at: 16, 16; anchor: left center; family: "Iosevka"; size: 9; weight: 700; color: live.ink.dim }
            group body_slot { move: 16, 30; size: w - 32, h - 44; children }
        }
    }

    // One row of the system monitor: the label on the left, the readout on the
    // right, and the bar under both. `value` is the 0..1 the bar fills, `read` the
    // words the logic wrote.
    component Stat(label: text, read: text, value: number, w: number, tone: color = live.accent) {
        size: w, 30
        text "{label}" { at: 0, 9; anchor: left center; family: "Iosevka"; size: 10; color: live.ink.dim }
        text "{read}" { at: w, 9; anchor: right center; family: "Iosevka"; size: 10; weight: 500; color: live.ink }
        box { from: 0, 20; size: w, 2; corner: 1; color: live.ink; opacity: 10% }
        box { from: 0, 20; size: w * clamp(value, 0, 1), 2; corner: 1; color: tone }
    }

    // ------------------------------------------------------------- the widgets
    include "pages/clock.plm"
    include "pages/music.plm"
    include "pages/quote.plm"
    include "pages/sysmon.plm"
    include "pages/cava.plm"
    include "pages/edit.plm"

    // The analyser follows the music: cava runs only while something plays, and
    // only while somebody switched the widget on.
    on change playing { Spectrum.active = playing and has.cava }
    on change has.cava { Spectrum.active = playing and has.cava }
}
