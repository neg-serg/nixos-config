// pages/quote.plm — the desktop saying (part `Quote`).
//
// Legacy: quickshell/modules/desktopwidgets/QuoteWidget.qml — a wrapped line of
// text in the frame, with a refresh arrow that asks for another one. The text and
// its attribution are live texts the logic owns (widgets.luau rotates the list
// every ten minutes); the arrow is a press, not a timer.
//
// The reference's quote is a dad joke fetched from an API. The port keeps the
// widget and drops the request: the list lives in the logic, so the widget draws
// with no network and no permission behind it.

part Quote {

    component QuotePlate(scale: number = clamp(min(screen.width / design.width, screen.height / design.height), fit.min, fit.max)) {
        size: 360 * scale, 150 * scale

        group place {
            move: min(quote.nx * screen.width, max(0, screen.width - 360 * scale)), min(quote.ny * screen.height, max(0, screen.height - 150 * scale))

            group zoom {
                scale: scale

                Plate(w: 360, h: 150, title: "quote") {
                    text quote.body { at: 0, 4; width: 300; lines: 4; line_height: 1.32
                        family: "Iosevka"; size: 12; color: live.ink }
                    text quote.by { at: 0, 88; family: "Iosevka"; size: 10; color: live.ink.dim }
                    text "refresh" { at: 320, 86; family: "Material Symbols Outlined"; size: 16; color: live.ink.dim }
                }

                zone box quote_grab {
                    from: 0, 0
                    size: 360, 150
                    corner: 12
                    cursor: move
                    label: "Quote"
                    role: region
                }
                on press quote_grab {
                    quote.gx = quote.nx
                    quote.gy = quote.ny
                    busy = true
                }
                on drag quote_grab {
                    quote.nx = clamp(quote.gx + drag.dx / screen.width, 0, max(0, 1 - 360 * scale / screen.width))
                    quote.ny = clamp(quote.gy + drag.dy / screen.height, 0, max(0, 1 - 150 * scale / screen.height))
                }
                on release quote_grab {
                    busy = false
                    emit quote_moved
                }

                // The refresh mark, above the plate's handle: 24 px of zone around a
                // 16 px glyph.
                zone box quote_next { from: 316, 82; size: 24, 24; corner: 12; cursor: pointer; label: "Another quote"; role: button }
                on press quote_next { emit next_quote }
            }
        }
    }

    QuotePlate() { show: has.quote }
}
