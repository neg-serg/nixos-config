language 0.4

import "../../lib/palette.plm"
import "../../lib/palette-live.plm"
import "../../lib/capsule.plm"

// headphones.plm — the headphone model drawer (scene `headphones`, task T14 of the aurora
// headphone-UI plan; the plan's §3.2, `docs/plan-headphone-ui.md` in the aurora repository).
//
// What it is
// ----------
// A viewer and applier for the headphone catalogue the companion CLI shares with the player:
// the models on the left, the selected one's parametric-EQ response on the right (bright), the
// measurement it was fitted to when the file has one (dim), and its name, vendor, kind, target,
// preamp and band count. `enter` applies the selection through `headphones apply` and what the
// CLI answers — applied, or why not — is shown in the drawer.
//
// Where the catalogue comes from
// ------------------------------
// The catalogue is a directory of model files, not something this scene can fetch: a scene
// reads only its own data folder (docs/INTERFACES.md §1.2), and for this scene that is
// $XDG_DATA_HOME/pleamar/headphones — `~/.local/share/pleamar/headphones` on this host. One
// step fills it (T12's verb; `headphones dirs` prints the CLI's own two directories):
//
//     headphones export --all --into "$XDG_DATA_HOME/pleamar/headphones"
//
// The drawer lists every `*.json` there that parses as a model (a numeric `schema` and a
// `name`), so the folder's other JSON — the `palette.json` the theme tool may leave in a
// scene's folder — is ignored. The folder is read-only for this scene: the export is its
// writer (docs/INTERFACES.md §1.2's one-writer rule), and `r` re-reads it after a new export.
// A model file that does not parse is skipped with a line in the journal, never hidden
// silently, and one bad file never empties the list.
//
// Applying
// --------
// `enter` runs `headphones apply <the file this drawer draws>` — a path into the folder above,
// not a bare slug. The CLI resolves a bare NAME only in its own model and catalog directories,
// and the drawer must apply exactly the file it shows (a catalogue model has no second copy
// there). The command is the scene's `run:` permission below; the CLI is installed into PATH by
// /etc/nixos/packages/aurora.nix (`aurora-tools`) and reaches the CamillaDSP facade at
// 127.0.0.1:1234. A missing daemon is an error line in the drawer, not a silent failure; the
// apply is reversible with `headphones restore`.
//
// Opening and closing
// -------------------
// The chord is the compositor's (the plan's §4.2 leaves it to this task):
//
//     M4+SHIFT+space   pleamar --say headphones "emit toggle_drawer"
//
// in files/gui/hypr/hyprland.lua's pleamar block. The whole M4+SHIFT letter row is taken by the
// session's keymap, and `space` was the free slot that reads as a toggle (M4+space dismisses the
// shell, so the pair is "close everything" / "open the drawer"). The drawer is a resident scene
// like the launcher: `pleamarScenes` in modules/user/nix-maid/gui/pleamar.nix starts it with the
// session and keeps it restarted, and `dismiss_shell()` also closes it on M4+space.
//   pleamar --say headphones "emit toggle_drawer"   open or close
//   pleamar --say headphones "emit close_drawer"    close (the dismissal bind)
//   pleamar --say headphones "fact open true"       open through the fact alone
// A press outside the card and Escape close it too.
//
// Keyboard
// --------
// j/k or Down/Up move the selection, `r` re-reads the folder, `enter` applies, `escape` closes.
// `keyboard: exclusive while open` is what makes those keys reach the scene without a click
// first; the phantom Escape the runtime delivers when the surface takes the keyboard is the
// reason for the `armed` latch (`launcher.plm`'s measured note, 2026-11-02, and launcher.luau's
// ARM_MS): the runtime sends one Escape of its own about 1.5 s after the hand-over, so the logic
// arms the latch after that and a real Escape — one key — is what closes the drawer.
//
// Cost
// ----
// Closed, the scene draws nothing and the keeper asks for 10 frames a second; open, it asks for
// the monitor's. The curve is 96 line segments recomputed only when the selection changes — not
// per frame — and there is no `time` anywhere in the file, so two frames with nothing moving are
// identical (the harness's two-run check).
//
// Settings and palette
// --------------------
// No user knobs: the drawer writes no settings.json (the catalogue folder is the CLI's). The
// palette is the shell's own (`lib/palette-live.plm`): `pleamar-themes push` would hand it over
// as facts if packages/pleamar-theme's PALETTE_SCENES ever names this scene; until then the
// repository theme's defaults below are what is drawn.

scene headphones {

    // The live palette (lib/palette-live.plm): the theme handed over as facts, so a new theme
    // repaints the drawer without a reload once the theme tool pushes to this scene too. The
    // defaults are the repository's theme.plm, so the first frame looks as it always did.
    fact pal_coal_r = 0.0000
    fact pal_coal_g = 0.0000
    fact pal_coal_b = 0.0000
    fact pal_surface_r = 0.1412
    fact pal_surface_g = 0.1647
    fact pal_surface_b = 0.2078
    fact pal_ink_r = 0.7961
    fact pal_ink_g = 0.8392
    fact pal_ink_b = 0.8980
    fact pal_ink_dim_r = 0.6824
    fact pal_ink_dim_g = 0.7255
    fact pal_ink_dim_b = 0.7843
    fact pal_accent_r = 0.0000
    fact pal_accent_g = 0.4353
    fact pal_accent_b = 0.8000
    fact pal_on_accent_r = 1.0000
    fact pal_on_accent_g = 1.0000
    fact pal_on_accent_b = 1.0000
    fact pal_light = 0

    // The interface facts. `open` and `armed` are the launcher's pair: the second says the
    // surface has held the keyboard long enough that the runtime's own Escape has already gone
    // by. `selected` is the index into the whole catalogue, `offset` the first row the 8-row
    // window shows (headphones.luau scrolls it), `total` how many models the folder holds.
    fact open = false
    fact armed = false
    fact selected = 0
    fact offset = 0
    fact total = 0

    // What the logic computes: the visible slice of the catalogue and the two curves as
    // pixel-space segments in the plot's own coordinates (368 x 196, +12 .. -18 dB). A segment
    // per pair of the 97-point log grid; the model cap is 256, the slice is at most 8.
    model rows max 8 {
        idx: number; title: text; sub: text
    }
    model curve max 96 {
        x1: number; y1: number; x2: number; y2: number
    }
    model measured max 96 {
        x1: number; y1: number; x2: number; y2: number
    }

    // The right-hand texts, filled by headphones.luau from the selected model; `status` carries
    // the apply's answer, `empty_hint` the export command when the folder holds no model.
    text model_name = ""
    text model_meta = ""
    text model_facts = ""
    text status = ""
    text counter = ""
    text empty_hint = ""

    // The scene's own logic: catalogue reader, biquad arithmetic, the apply spawn, the Escape
    // latch. The events with `->` reach it; `toggle_drawer`, `close_drawer` and `pick_row` stay
    // in the scene, where the rules below handle them.
    event toggle_drawer
    event close_drawer
    event pick_row
    event apply_model ->
    event reload_catalog ->

    // Listening and commanding: the catalogue is read from the scene's own folder (`files`),
    // the apply spawns the CLI by the name T13 installs into PATH. No `files.write`: the drawer
    // never writes into the folder the export owns.
    permissions { run: "headphones"; services: "files" }

    // The modal surface: one per monitor, full size, no reserve, and the keyboard only while the
    // drawer is up. Unnamed, so the scrim, the catcher and Panel() below — the scene's loose
    // drawing — have somewhere to go (docs/INTERFACES.md §2.3); with every surface named they
    // would be painted nowhere.
    surface {
        size: full, full
        anchor: center
        level: overlay
        reserve: 0
        screens: each
        keyboard: exclusive while open
        open: open
    }

    // The keeper: one pixel, no body, no input — the reason the scene stays loaded while `open`
    // is false. A closed surface drives no pace, so the pace lives here: the monitor's while the
    // drawer is up and 10 a second while it is not (the launcher's measured lesson: without it
    // the closed scene kept rounding at the monitor's 240 Hz to draw nothing).
    surface keeper { size: 1, 1; anchor: top_left; level: background; reserve: 0; screens: each
                     rate: 240, 10 while not open }

    // ----***---------------------------- opening, closing, keys

    // One rule with `toggle`, not an open and a close rule: both would look at the state the
    // frame began with and both would fire (picker.plm's note). The logic's `fact:open` watcher
    // arms/disarms the Escape latch on either route.
    on toggle_drawer { toggle open }
    on close_drawer { open = false }

    // Escape closes the drawer once it is armed. The runtime delivers one Escape of its own as
    // soon as this surface takes the keyboard (measured 2026-11-02, launcher.plm:141-150), and
    // the logic arms the fact after ARM_MS, so that phantom key finds this rule closed and a
    // real second press closes. Nothing else is bound to Escape, so the drawer cannot trap the
    // keyboard: closing it releases the exclusive grab with it.
    on key Escape while open and armed { open = false }

    // The selection. `total - 1` is the last index; with an empty catalogue both ends are 0.
    on key j while open { selected = min(selected + 1, max(total - 1, 0)) }
    on key k while open { selected = max(selected - 1, 0) }
    on key Down while open { selected = min(selected + 1, max(total - 1, 0)) }
    on key Up while open { selected = max(selected - 1, 0) }

    // Enter applies through the logic, `r` re-reads the folder (after an export), and a press on
    // a row selects it (the row's action is the keyboard's, so a stray click cannot apply).
    on key Return while open { emit apply_model }
    on key r while open { emit reload_catalog }
    on pick_row(v) { selected = v }

    // ----***------------------------------ the drawer

    // The scrim dims what is under the drawer; the catcher closes it on a press outside the
    // card. Declared before the card, so every card zone sits above it.
    box { from: 0, 0; size: screen.width, screen.height; color: live.coal; opacity: shadow.strong; show: open }

    zone box catcher { from: 0, 0; size: screen.width, screen.height
                       label: "Close the headphone drawer"; role: region }
    on press catcher while open { emit close_drawer }

    // The card. `screen.*` and the fit are read per monitor copy at the use site, so each copy
    // gets its own scale (INTERFACES §3.2); the design size is 780 x 520 at 1920 x 1080.
    component Panel(scale: number = ui * clamp(min(screen.width / design.width, screen.height / design.height), fit.min, fit.max)) {
        let w = 780
        let h = 520
        let cw = 368       // plot width, the x the logic maps frequency onto
        let ch = 196       // plot height, the y the logic maps dB onto
        let cx = (screen.width - w * scale) / 2
        let cy = (screen.height - h * scale) / 2

        group place {
            move: cx, cy
            group zoom {
                scale: scale

                Capsule(w, h, fill: live.coal, alpha: 96%, radius: overlay.corner, shadow: 45%, scale: 1) { }

                // The card swallows the presses that land on it, so they do not reach the
                // dismissal catcher underneath. Not pressable, so no label (INTERFACES §8.1).
                zone box body { from: 0, 0; size: w, h; corner: overlay.corner; role: region }

                text "Наушники" { at: 26, 38; anchor: left center; size: 17; weight: 600; color: live.ink }
                text counter { at: w - 26, 38; anchor: right center; width: 200; lines: 1; align: right
                               size: 11; family: "Iosevka"; color: live.ink.dim }
                box { from: 20, 70; size: w - 40, 1; color: live.ink; opacity: ink.subtle }

                // ----***----------------------- the list
                text "модели" { at: 20, 92; anchor: left center; size: 10; family: "Iosevka"; color: live.ink.off }

                column list ~ui.quick {
                    at: 18, 108
                    view: 316, 352
                    gap: 2
                    for r in rows { Row(r, selected, pick_row) }
                }

                // What a drawer with nothing to show says: the one step that fills the folder.
                text "каталог пуст" { at: 20, 128; size: 13; color: live.ink; show: total == 0 }
                text empty_hint { at: 20, 150; width: 300; lines: 3; size: 10.5; family: "Iosevka"
                                  color: live.ink.off; show: total == 0 }

                // The two halves of the drawer, divided the way the shell's cards divide a list
                // from its detail.
                box { from: 350, 90; size: 1, 374; color: live.ink; opacity: 8% }

                // ----***----------------------- the selected model
                text model_name { at: 384, 96; anchor: left center; width: 368; lines: 1
                                  size: 16; weight: 600; color: live.ink }
                text model_meta { at: 384, 120; anchor: left center; width: 368; lines: 1
                                  size: 11; family: "Iosevka"; color: live.ink.dim }
                text model_facts { at: 384, 140; anchor: left center; width: 368; lines: 1
                                   size: 10.5; family: "Iosevka"; color: live.ink.off }
                text "коррекция" { at: 384, 160; anchor: left center; size: 9; family: "Iosevka"
                                   weight: 700; color: live.accent }
                text "замер" { at: 452, 160; anchor: left center; size: 9; family: "Iosevka"
                               color: live.ink.off }

                // ----***----------------------- the curve
                // The window is fixed: +12 dB at the top, -18 at the bottom, the six grid lines
                // five dB bands apart (196 / 5). The logic maps every point into this box and
                // clamps; a curve that asks for more room runs along the edge instead of
                // rescaling under the reader's eyes while `j`/`k` walk the list.
                group plot {
                    move: 384, 176

                    box { from: 0, 0; size: cw, ch; color: live.ink; opacity: 3% }
                    // The six horizontal rules; the middle one is 0 dB and reads stronger.
                    repeat g in 0..5 {
                        box { from: 0, g * ch / 5; size: cw, 1; color: live.ink
                              opacity: if(g == 2, 20%, 8%) }
                    }
                    // The decade lines, on the log positions the logic uses (20 Hz at 0).
                    box { from: 85.7, 0; size: 1, ch; color: live.ink; opacity: 8% }
                    box { from: 208.4, 0; size: 1, ch; color: live.ink; opacity: 8% }
                    box { from: 331.1, 0; size: 1, ch; color: live.ink; opacity: 8% }

                    // One `line` per segment: the dim measurement first, the EQ correction over
                    // it. Both are recomputed only when the selection changes.
                    for s in measured {
                        line { from: s.x1, s.y1; to: s.x2, s.y2; width: 1.2
                               color: live.ink.off; opacity: 55% }
                    }
                    for s in curve {
                        line { from: s.x1, s.y1; to: s.x2, s.y2; width: 1.6; color: live.accent }
                    }

                    box { from: 0, 0; size: cw, ch; stroke: 1; color: live.ink; opacity: 10% }

                    // The axes: the decades under the box, the two ends and 0 dB on the left.
                    text "20" { at: 0, 210; anchor: left center; size: 9; family: "Iosevka"; color: live.ink.off }
                    text "100" { at: 85.7, 210; anchor: center; size: 9; family: "Iosevka"; color: live.ink.off }
                    text "1k" { at: 208.4, 210; anchor: center; size: 9; family: "Iosevka"; color: live.ink.off }
                    text "10k" { at: 331.1, 210; anchor: center; size: 9; family: "Iosevka"; color: live.ink.off }
                    text "+12" { at: -8, 0; anchor: right center; size: 9; family: "Iosevka"; color: live.ink.off }
                    text "0" { at: -8, 78.4; anchor: right center; size: 9; family: "Iosevka"; color: live.ink.off }
                    text "−18" { at: -8, ch; anchor: right center; size: 9; family: "Iosevka"; color: live.ink.off }
                }

                // The apply's answer, or why the list is empty; two lines are enough for the
                // CLI's first line and a half.
                text status { at: 384, 408; anchor: left center; width: 368; lines: 2; size: 10.5
                              family: "Iosevka"; color: live.ink.dim }

                text "j / k — выбор   ·   enter — применить   ·   r — обновить   ·   esc — закрыть" {
                    at: 20, h - 24; anchor: left center; size: 10; family: "Iosevka"; color: live.ink.off
                }
            }
        }
    }

    // One row of the list, the launcher-result shape at the drawer's own size. `lit` is the
    // keyboard selection's spring and `hit.hover` the pointer's, so the row under either reads.
    component Row(r: record, chosen: number, pick: event) {
        let w = 312
        let h = 42

        size: w, h

        prop lit = 0 ~ui.quick
        follow lit = if(chosen == r.idx, 1, 0)

        box wash {
            from: 0, 0; size: w, h; corner: 4
            color: mix(live.slate, live.accent, 0.18 + 0.22 * lit)
            opacity: max(0.10 + 0.55 * lit, hit.hover * 0.8)
        }
        box mark { from: 0, 0; size: 2, h; corner: 1; color: live.accent; opacity: lit }
        text r.title { at: 12, 13; anchor: left center; width: w - 24; lines: 1
                       size: 13; family: "Iosevka"; weight: 500; color: live.ink }
        text r.sub { at: 12, 29; anchor: left center; width: w - 24; lines: 1
                     size: 10; family: "Iosevka"; color: live.ink.dim }

        // The row zone: a name for the agent tree, `selected:` for the machine, and a press
        // that only moves the selection (the keyboard's enter is what applies).
        zone box hit { from: 0, 0; size: w, h; corner: 4; cursor: pointer
                       label: "{r.title}"; role: item; selected: chosen == r.idx }
        on press hit { emit pick(r.idx) }
    }

    // The card is drawn only while the drawer is up (the surface is closed when it is not, and
    // a closed surface is neither seen nor pressed — INTERFACES §2.3).
    Panel() { show: open }
}
