language 0.6

import "../../lib/palette.plm"
import "../../theme.plm"
import "../../lib/capsule.plm"

// picker.plm — the wallpaper deck (scene `picker`), the pleamar port of the swatch-deck picker
// Quickshell ran (files/qs-wallpaperpicker stays in the tree as the reference for parity).
//
// What it does
// ------------
// Every wallpaper of the settings folder (`folder`, ~/pic/wl on trantor) is a card in a grid:
// its own picture, the wallpaper's name, and the strip of colours matugen would dress the
// desktop in, read ahead of time by `pleamar-wallpaper-palettes`
// (files/pleamar/scripts/helpers). The arrows walk the deck, the wheel and a drag scroll it,
// Enter hands the chosen card to `pleamar-wallpaper-apply` — caches, the wallpaper command
// (`wl img {}` on trantor), matugen — and the deck closes.
//
// Commands (the Quickshell CLI's verbs, one shorthand per line under ~/.local/bin):
//   pleamar --say picker "emit open_picker"      open (the compositor bind starts the unit first)
//   pleamar --say picker "emit toggle_picker"    open/close
//   pleamar --say picker "emit close_picker"     close
//   pleamar --say picker "emit reload"           read the folder again
//   pleamar --say picker "emit choose 3"         set the fourth card (0 is the first)
//   pleamar --say picker "emit open_settings"    the settings screen (the g key)
//   pleamar --say picker "emit toggle_settings"  open/close the settings screen
//   pleamar --say picker "fact order newest"     sort: newest first, or `name`
//   pleamar --say picker "emit favourite 2"      favourite the third card (and unfavourite it)
//   pleamar --say picker "fact only_favourites true"   show the favourites and nothing else
//   pleamar --say picker "fact open true"        open through the fact alone
//   pleamar --say picker describe                what every card and zone says
//
// Settings (~/.local/share/pleamar/picker/settings.json; read and written by picker.luau)
//   folder    text    ~/pic/wl          the wallpapers to browse
//   command   text    wl img {}         the tool that paints the desktop; {} is the path
//   columns   —       —                 NOT a setting: the deck is laid out from `let cols` when the
//                                       scene loads (the model's `list cells max 4` and the row
//                                       arithmetic follow it), so the four a row is fixed here.
// `g` opens the screen that edits the first two — Enter in either field saves — and a key the
// logic does not know survives the write, because the table it read is what it writes back. The
// screen is not the only way in: the logic watches the file, and an edit by hand lands the same
// way, the folder it lists moving without a restart.
//
// What is not here yet: Wallhaven search and downloads, the live preview of a clip, the
// fan-and-preview choreography of the reference. Wallpapers are images: an animated GIF/WebP or a
// video cannot be painted by wl, and the Quickshell layer that drew them went with the shell. The
// settings screen saves what it is given: the reference's "create that folder" and "try the
// command on the wallpaper on screen" need the filesystem and the wallpaper on screen, neither of
// which a scene may reach — its own folder is all of it (INTERFACES §6).

scene picker {

    // The deck's own surface: unnamed, so it is the scene's — what is drawn loose below belongs to
    // it (a named surface carries only what its own block holds). One copy per monitor, full size,
    // no reserve: the deck is modal on every screen while `open` holds, and a closed surface is
    // neither seen nor pressed. The keyboard is held exclusively so the arrows and Enter reach the
    // rules without a click first.
    surface {
        size: full, full
        anchor: center
        level: overlay
        reserve: 0
        screens: each
        keyboard: exclusive while open
        open: open
    }

    // The keeper: one pixel, no body, no input — the reason the scene stays loaded while `open`
    // is false, exactly as panels.plm and launcher.plm do it. A closed surface drives no pace, so
    // the rate lives here: 30 while closed, which is also how long `open` waits to be drawn.
    surface keeper { size: 1, 1; anchor: top_left; level: background; reserve: 0; screens: each
                     rate: 240, 30 while not open }

    // Two user helpers (installed from files/pleamar/scripts/helpers into ~/.local/bin):
    // the colour schemes of the folder, and applying one. `files` is the scene's own folder,
    // where settings.json lives; `files.write` is what the settings screen saves through.
    // `ls` is the newest-first sort and nothing else: no service reports a file's modification
    // time, so the documented stopgap stands in for one (see picker.luau).
    permissions {
        run: "pleamar-wallpaper-palettes", "pleamar-wallpaper-apply", "ls"
        services: "env", "files", "files.write"
    }

    // Four cards a row, sixteen rows: one page of the folder (picker.luau). A `let` and not a
    // setting, because the deck's rows are laid out from it when the scene loads.
    let cols = 4

    // The mark a favourited card wears: Adwaita's `starred-symbolic`, the nearest thing the
    // deployment's icon themes have to the reference's `favorite` heart.
    image star = icon "starred-symbolic", 14, 14

    // The interface.
    fact open = false
    fact sel = 0                  // the card the keyboard is on, within the page
    fact page = 0                 // which page of cards is on screen (0 is the first)
    fact pages = 1
    fact shown = 0                // how many cards that page holds (picker.luau)
    fact settings = false         // the settings screen is over the deck
    // The deck's sort, the reference's `S` key: by name, or the newest wallpaper first. It is the
    // session's, as it was there (WallpaperSwatches.sort), and picker.luau does the sorting: a
    // model's records are laid down from what the logic hands it, so the order is decided there.
    fact order: name | newest = name
    // Favourites, the reference's `F` key and its Favourites source: `favourites` is how many the
    // file holds (picker.luau keeps it), and `only_favourites` is the deck showing nothing else —
    // the reference's source switch, which Tab turns over here.
    fact favourites = 0
    fact only_favourites = false
    text folder = ""              // what the deck is showing
    text status = ""              // a line about it, or why it is empty
    text command = ""             // the wallpaper tool, with {} where the path goes
    // The settings screen's two fields and its line about them. An `input` is bound to the live
    // text of its own name (as the launcher's `query` is): the logic fills them when the screen
    // opens and reads them when Enter is pressed.
    text field_folder = ""
    text field_command = ""
    text note = ""

    // The page on screen, a row of cards per record: a card is a component, and a component takes
    // its record from a `for` — never from a computed place — so the rows are what the model holds
    // and each row walks its own cells. `picture` is a path the scene paints.
    model walls max 16 {
        list cells max 4 {
            name: text
            picture: image 288, 180
            fav: bool
            list sw max 4 { r: number; g: number; b: number }
        }
    }

    // `->` also reaches picker.luau: opening reads the folder the first time, reloading reads it
    // again, a page turn reads that page's schemes, choosing applies one, saving the settings
    // writes them back. The rest the rules handle alone: the deck's own open and close, and the
    // settings screen, whose fact the logic watches instead (an edit by hand reaches it too).
    event open_picker ->
    event reload ->
    event flip ->
    event choose ->
    event save_settings ->
    event favourite ->
    event toggle_picker
    event close_picker
    event open_settings
    event close_settings
    event toggle_settings

    // ---***------------------------------ keys
    // The settings screen has the caret and the keys while it is up: Escape closes it, Enter in a
    // field saves (`on submit` below). Everything the deck does waits for it to be gone, because a
    // focused field keeps the letters and may keep the arrows too.
    on key Escape while settings { emit close_settings }
    on key g while open and not settings { emit open_settings }

    on key Escape while open and not settings { emit close_picker }
    on key Right while open and not settings { sel = min(sel + 1, shown - 1) }
    on key Left while open and not settings { sel = max(sel - 1, 0) }
    on key Down while open and not settings { sel = min(sel + cols, shown - 1) }
    on key Up while open and not settings { sel = max(sel - cols, 0) }
    on key Home while open and not settings { sel = 0 }
    on key End while open and not settings { sel = max(shown - 1, 0) }
    on key Return while open and not settings { emit choose(sel) }
    on key r while open and not settings { emit reload }
    // `s` turns the sort over; the logic hears the fact change and lays the page down again.
    on key s while open and not settings { order = if(order == name, newest, name) }
    // `f` favourites the card the keyboard is on (and unfavourites it), `tab` shows only the
    // favourites — the reference's source switch, on the key a deck of cards suggests.
    on key f while open and not settings { emit favourite(sel) }
    on key Tab while open and not settings { toggle only_favourites }
    // A page at a time: the deck holds a page of cards, not the folder (see picker.luau).
    on key Page_Down while open and not settings { emit flip(1) }
    on key Page_Up while open and not settings { emit flip(-1) }
    on key n while open and not settings { emit flip(1) }
    on key p while open and not settings { emit flip(-1) }

    // The settings screen's own verbs. Enter in either of its fields is not here: the fields live
    // inside the card (a component), so `submit field_folder` at the scene's level names the live
    // text and no rule fires — picker.luau hears `submit:field_folder` instead.
    on open_settings while open { settings = true }
    on close_settings { settings = false }
    // One rule and `toggle`, not two: two rules both look at the state the frame began with, so
    // a pair guarded by `settings` and by `not settings` would both fire and the last would win.
    on toggle_settings while open { toggle settings }

    // ---***------------------------------ the deck
    // One card: the wallpaper's picture, its name, and the colours it would give the desktop.
    // `chosen` is the scene's selection, so a card lights up as the keyboard reaches it.
    component Card(c: record, at: number, chosen: number, pick: event) {
        let CW = 288
        let CH = 180

        size: CW, CH

        prop lit = 0 ~ui.quick
        follow lit = if(chosen == at, 1, 0)

        // Everything is clipped to the card's own corner: the picture is a rectangle of pixels,
        // and the zone that catches the press follows the same shape.
        group frame {
            size: CW, CH
            clip box { from: 0, 0; size: CW, CH; corner: 16 }
            image c.picture { at: 0, 0; size: CW, CH; fit: cover }
            // The cards behind the front one sit a little darker, and the hover lifts them.
            box { from: 0, 0; size: CW, CH; corner: 16; color: skin.coal
                  opacity: (0.45 - 0.30 * lit) * (1 - hit.hover * 0.5) }
            // The wallpaper's palette: the scheme its card would give the desktop.
            row chips { at: 12, CH - 28; gap: 4
                for s in c.sw {
                    group { size: 30, 12
                        box { from: 0, 0; size: 30, 12; corner: 6; color: rgb(s.r, s.g, s.b)
                              opacity: 1 - hit.hover * 0.25 }
                    }
                }
            }
            // A favourited card wears a star, on a disc dark enough to read over any picture.
            group marked {
                show: c.fav
                box { from: CW - 30, 10; size: 22, 22; corner: 11; color: skin.coal; opacity: 55% }
                image star { at: CW - 26, 14; size: 14, 14; tint: skin.accent }
            }
            text c.name { at: 12, CH - 50; anchor: left center; width: CW - 24; lines: 1
                          size: 12.5; color: skin.ink }
            // The ring of the card the keyboard is on.
            box { from: 0, 0; size: CW, CH; corner: 16; stroke: 2; color: skin.accent; opacity: lit }
        }

        zone box hit { from: 0, 0; size: CW, CH; corner: 16; cursor: pointer
                       label: "{c.name}"; role: item; selected: chosen == at }
        on press hit { emit pick(at) }
    }

    // The panel: a title, what it is showing, and the deck itself.
    component Panel(scale: number = ui * clamp(min(screen.width / design.width, screen.height / design.height), fit.min, fit.max)) {
        let DW = 1400
        let DH = 880
        let cx = (screen.width - DW * scale) / 2
        let cy = (screen.height - DH * scale) / 2
        // What is seen of the deck; the card is 288 x 180 and the gap 16, so a row is 196.
        let view_w = DW - 64
        let view_h = DH - 168
        let row_step = 196

        group place {
            move: cx, cy
            group zoom {
                scale: scale

                Capsule(DW, DH, fill: skin.coal, alpha: 92%, radius: overlay.corner, shadow: 45%, scale: 1) { }

                // The card swallows the presses that land on it, so they do not reach the
                // dismissal catcher underneath. Not pressable, so no label.
                zone box body { from: 0, 0; size: DW, DH; corner: overlay.corner; role: region }

                text "Wallpapers" { at: 32, 42; anchor: left center; size: 17; weight: 600; color: skin.ink }
                text folder { at: 32, 70; anchor: left center; width: DW - 260; lines: 1
                              size: 11.5; color: skin.ink.dim }
                text status { at: DW - 32, 42; anchor: right center; width: 520; lines: 1; align: right
                              size: 11.5; color: skin.ink.dim }

                // The deck: rows of cards the wheel and a drag scroll (`view:`), with the front
                // card's row kept in sight by the rule below. A row is `cols` cards and as tall as
                // one, so the whole page is `rows` rows of `row_step`.
                column deck ~calm { at: 32, 96; view: view_w, view_h; gap: 16
                    for r in walls {
                        row { gap: 16
                            for cell in r.cells {
                                Card(cell, r.index * cols + cell.index, sel, choose)
                            }
                        }
                    }
                }

                text "No wallpapers in {folder}" { at: DW / 2, 96 + view_h / 2; anchor: center
                                                   size: 13; color: skin.ink.dim
                                                   show: walls.count == 0 and not only_favourites }
                text "No favourites yet: press f on a wallpaper you like"
                    { at: DW / 2, 96 + view_h / 2; anchor: center; size: 13; color: skin.ink.dim
                      show: walls.count == 0 and only_favourites }
                text "arrows choose · enter sets · f favourite · s sorts · tab all / favourites · n / p next page · r reads the folder · g settings · esc closes"
                    { at: DW / 2, DH - 30; anchor: center; size: 11; color: skin.ink.dim }

                // The keyboard's card is always in sight: the deck scrolls to the row it is on
                // when it changes hands, and when the deck opens.
                on change sel {
                    deck.scroll: clamp(floor(sel / cols) * row_step - view_h / 2 + row_step / 2,
                                       0, max(deck.content - view_h, 0)) ~calm
                }
                on change open while open {
                    deck.scroll: clamp(floor(sel / cols) * row_step - view_h / 2 + row_step / 2,
                                       0, max(deck.content - view_h, 0)) ~calm
                }
            }
        }
    }

    // The settings screen, the reference's gear: the folder the deck lists and the command that
    // paints the desktop, as two fields a press cannot reach past (`body`), Enter in either
    // saving through picker.luau, and the line under them saying what there is. The fields are
    // the scene's live texts, so the logic fills them as the screen opens and reads them as it
    // saves; the panel's own `show:` decides whether they are there at all.
    component Sheet(scale: number = ui * clamp(min(screen.width / design.width, screen.height / design.height), fit.min, fit.max)) {
        let SW = 520
        let SH = 300
        let cx = (screen.width - SW * scale) / 2
        let cy = (screen.height - SH * scale) / 2
        let pad = 24
        let fw = SW - 2 * pad

        group place {
            move: cx, cy
            group zoom {
                scale: scale

                Capsule(SW, SH, fill: skin.coal, alpha: 96%, radius: overlay.corner, shadow: 50%,
                        rim: 1, scale: 1) { }

                // The card swallows the presses that land on it, so the deck's cards underneath
                // keep out of the way. Not pressable, so no label.
                zone box body { from: 0, 0; size: SW, SH; corner: overlay.corner; role: region }

                text "Picker settings" { at: pad, 34; anchor: left center; size: 16; weight: 600
                                         color: skin.ink }

                text "WALLPAPER FOLDER" { at: pad, 72; anchor: left center; size: 10.5; weight: 600
                                          color: skin.ink.dim }
                input field_folder {
                    at: pad, 84; width: fw; size: 13; color: skin.ink; family: "Iosevka"
                    selection: skin.accent.deep; placeholder: "~/pic/wl"
                    label: "Wallpaper folder"
                }
                box { from: pad, 116; size: fw, 1; color: skin.ink; opacity: ink.subtle }

                text "WALLPAPER COMMAND" { at: pad, 142; anchor: left center; size: 10.5; weight: 600
                                           color: skin.ink.dim }
                input field_command {
                    at: pad, 154; width: fw; size: 13; color: skin.ink; family: "Iosevka"
                    selection: skin.accent.deep; placeholder: "wl img {}"
                    label: "Wallpaper command"
                }
                box { from: pad, 186; size: fw, 1; color: skin.ink; opacity: ink.subtle }

                text note { at: pad, 210; anchor: left center; width: fw; lines: 1; size: 11.5
                            color: skin.ink.dim }

                // A button is a painted box with a zone over it (the shape is the zone's; the
                // paint is the box's — §8: a zone brings the springs and takes the press).
                box { from: SW - 206, SH - 52; size: 84, 32; corner: 8; color: skin.accent
                      opacity: 88% }
                zone box save { from: SW - 206, SH - 52; size: 84, 32; corner: 8; cursor: pointer
                                role: button; label: "Save the settings" }
                text "Save" { at: SW - 164, SH - 36; anchor: center; size: 12; weight: 600
                              color: skin.on.accent }

                box { from: SW - 114, SH - 52; size: 84, 32; corner: 8; color: skin.ink
                      opacity: 8% }
                zone box close { from: SW - 114, SH - 52; size: 84, 32; corner: 8; cursor: pointer
                                 role: button; label: "Close the settings" }
                text "Close" { at: SW - 72, SH - 36; anchor: center; size: 12; weight: 600
                               color: skin.ink }

                text "Enter saves · Esc closes" { at: pad, SH - 36; anchor: left center; size: 11
                                                  color: skin.ink.dim }

                on press save { emit save_settings }
                on press close { emit close_settings }
            }
        }
    }


    // The scrim dims what is under the deck; the catcher closes it on a press outside the panel.
    // Declared before the panel, so every panel zone sits above it.
    box { from: 0, 0; size: screen.width, screen.height; color: skin.coal; opacity: shadow.strong; show: open }

    zone box catcher { from: 0, 0; size: screen.width, screen.height
                       label: "Close the wallpaper deck"; role: region }
    on press catcher while open and not settings { emit close_picker }

    // Opening and closing. The logic does the reading (and sets `open` too); the rule here is
    // what makes a press of the key show the deck in the same frame.
    on open_picker { open = true }
    on toggle_picker { toggle open }
    on close_picker { open = false; settings = false }

    Panel() { show: open }

    // The settings screen: declared after the panel, so it paints over the deck and its catcher
    // takes the presses before a card under it does. A press outside the card closes the screen,
    // not the deck, and the deck's own close takes the screen with it (the rule above).
    box { from: 0, 0; size: screen.width, screen.height; color: skin.coal
          opacity: shadow.strong * 2; show: settings }
    zone box sheet_catcher { from: 0, 0; size: screen.width, screen.height
                             label: "Close the picker settings"; role: region
                             show: settings }
    on press sheet_catcher while settings { emit close_settings }

    Sheet() { show: settings }
}
