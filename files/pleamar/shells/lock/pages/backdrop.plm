// pages/backdrop.plm — the wallpaper: posterised, dithered, run through the tube.
//
// Drawn inside the scene's surface, below everything else. One group shader
// carries both QML passes (shaders/paper.wgsl): the picture is pushed to four
// levels through an ordered Bayer dither, then the tube's barrel curve,
// chromatic aberration, bloom, scanlines and vignette are applied over it. The
// shader draws the legacy dot-grid fallback itself when no wallpaper path was
// published, so the scene needs no second shader for that case.
//
// No loose `let`: with `screens: each` the copies would share it, so the cover
// arithmetic is written inside the repeated drawing, where `screen.*` belongs
// to the copy (INTERFACES.md §3.2). The image cell is declared 16:9; a monitor
// of another shape gets a wider or taller crop, never a squash.

part Backdrop {

    group deck {
        // barrel, aberration, scanlines, grille, bloom, vignette, dither
        // amount, dither cell (paper.wgsl)
        shader: paper, 0.008, 0.6, 0.13, 0.05, 0.35, 0.35, 0.55, 2

        image wall {
            at: (screen.width - max(screen.width, screen.height * 1.7777778)) / 2, (screen.height - max(screen.width / 1.7777778, screen.height)) / 2
            size: max(screen.width, screen.height * 1.7777778), max(screen.width / 1.7777778, screen.height)
            show: wall_ok
        }
    }

    // The scrim of LockContent.qml: 18 % of the theme's darkest tone over the tube, so the eye
    // lands on the clock and the card. It is `skin.coal` — the wallpaper's colors.background
    // role, the same tone the drawers and the launcher lay under themselves — so a light wallpaper
    // veils with its own light tone instead of frozen black. The vignette lives in paper.wgsl.
    //
    // It covers three screens' worth, centred on the scene's origin, because a lock surface does
    // not own its own size: `size:` on a `kind: lock` surface is "the box that gets centred on
    // each monitor", and the runtime's own reference says to paint the backdrop large, "what lies
    // around it shows too" (pleamar --docs reference, the lock-screen section; its example draws
    // its backdrop from -4000). On a monitor whose box and size agree this is the same 18 % pane
    // as before; if they ever disagree — the boot-time face sized for a monitor that is not the
    // one on screen — the login screen is at least filled instead of three quarters black with
    // the card pushed into a corner.
    box scrim {
        from: -screen.width, -screen.height
        size: screen.width * 3, screen.height * 3
        color: skin.coal
        opacity: 18%
    }
}
