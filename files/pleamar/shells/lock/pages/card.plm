// pages/card.plm — the login card: glass, avatar, identity, field, status.
//
// The card of LockContent.qml, drawn with what the language has: a native glass
// slab (box { glass: 100% … }) in place of shaders/glass_card.frag, an image
// rounded by a clip, and the password `input` — declared here, inside the
// surface, because an input inside a component would be renamed by the copies
// (`password#Card1`) and the logic could not read `text.password`.
//
// Dropped from LockContent.qml, and why (README.md has the long form):
//   · the five power buttons (screen off, media pause, suspend, reboot, power
//     off) and the keyboard-layout chip: they need `run: "systemctl"` /
//     `run: "hyprctl"` and the two-step agent policy, so they belong to the
//     human-gated cutover, not to this scene;
//   · the Caps Lock warning (the kernel exposes it as an LED, and the scene has
//     no business reading /sys), the fingerprint hint, the hover tooltips and
//     the user/session selector (greeter mode only);
//   · the caret is the input's own.
//
// The failure is visible three times over: the tint warms, the nudge plays and
// the status line turns red — all through facts the logic sets, so a wrong
// password can never look like a slow one.
//
// Colours come from the wallpaper palette the scene imports (theme.plm): `skin.surface` for the
// card's plate, `skin.coal` for the field's well, `skin.ink`/`skin.ink.dim` for the ink and
// `skin.accent` for the prompt, the caret and the progress line. Three greeter tokens stay frozen
// because theme.plm carries no role for them: `lock.danger` (the refusal — the palette has no
// error role), the `lock.edge` rim (no outline role) and `lock.card.alpha`, the plate's own
// opacity, which is an alpha and not a colour.

part Card {

    group card_block {
        // Centre of the card; `shake` is the refusal nudge (logical px), the
        // entrance slides up 18 px. The `scale` is `scaleNow` for this copy.
        move: screen.width / 2 + shake, screen.height * 0.62 + (1 - appear) * 18
        scale: ui_scale * clamp(min(screen.width / design.width, screen.height / design.height), fit.min, fit.max)
        opacity: appear

        // ------------------------------------------------------- the glass
        // Legacy glassTint #c20a0e14 — greeter.cardColor at lock.card.alpha — with the plate
        // taken from the wallpaper: `skin.surface` is the theme's colors.surfaceVariant, the
        // role a raised surface carries, so a new wallpaper repaints the card. The refusal still
        // warms it with `lock.danger`, which theme.plm has no role for. No frame: the glass
        // paints its own rim; the drop shadow is a body's (`shadow:` is not a box property).
        body {
            color: mix(skin.surface, lock.danger, alarm * 0.25)
            opacity: lock.card.alpha
            glass: 100%
            refraction: lock.card.refraction
            dispersion: lock.card.dispersion
            frost: lock.glass.frost
            shine: pointer
            shadow: 0, 10, 28, 45%
            box { from: -240, -165; size: 480, 320; corner: 6 }
        }

        // ------------------------------------------------------- the avatar
        // Rounded square, photo clipped inside, ring over it; the monogram is
        // the fallback (LockContent.qml tries theme avatar → ~/.face →
        // monogram; the integration publishes one path, see README.md).
        group avatar_block {
            move: 0, -83

            group portrait {
                clip inset 0 box { from: -52, -52; size: 104, 104; corner: 16 }
                image face { at: -52, -52; size: 104, 104; show: avatar_ok }
            }
            box avatar_fallback {
                from: -52, -52; size: 104, 104; corner: 16
                color: skin.surface; opacity: 30%; show: not avatar_ok
            }
            text monogram {
                at: 0, 0; anchor: center; size: 46; weight: 500; color: skin.ink
                family: "Iosevka"; show: not avatar_ok
            }
            // The ring is the greeter's white rim (`lock.edge`): the wallpaper palette carries no
            // outline role, so the tone stays frozen and only the refusal recolours it.
            box avatar_ring {
                from: -52, -52; size: 104, 104; corner: 16
                stroke: 2; color: mix(lock.edge, lock.danger, alarm)
                opacity: if(failed, 80%, lock.edge.alpha)
            }
        }

        // --------------------------------------------------- user@host line
        row identity { at: 0, -2; anchor: center; gap: 0
            text user { size: 22; color: skin.ink; family: "Iosevka" }
            text host { size: 22; color: skin.ink.dim; opacity: 60%; family: "Iosevka" }
        }

        // ------------------------------------------------------- the field
        // A glass well; the prompt glyph and the input sit on it. `skin.coal` is the theme's
        // colors.background, so the well sits below the card's plate in either theme — dark on a
        // dark wallpaper, light on a light one. No frame: the well's own rim and the caret say
        // "type here".
        box field_bg {
            from: -192, 33; size: 384, 58; corner: 8
            color: skin.coal; opacity: 55%
            glass: 100%; refraction: lock.field.refraction; frost: lock.glass.frost
        }
        text ">" {
            at: -174, 62; anchor: left center; size: 20; color: skin.accent
            opacity: if(busy, 90%, 35%); family: "Iosevka"
        }
        // The password field: `secret: true` and `agent: no` are the policy
        // (INTERFACES.md §8.1, frozen label `Password`). The logic is the only
        // reader of `text.password`; drawing never shows it.
        input password {
            at: -150, 48; width: 330; size: 22; weight: 500; color: skin.ink
            family: "Iosevka"; selection: skin.accent
            secret: true; label: "Password"; agent: no
            placeholder: "type the password"
        }
        // PAM is running: one accent line filling along the bottom edge of the
        // field (the legacy sweeping bar, as a fill — a sweep needs a loop).
        box field_progress {
            from: -177, 86; size: 354 * busy_progress, 2; corner: 1
            color: skin.accent; show: busy
        }

        // ------------------------------------------- the keyboard-layout chip
        // The reference's `layoutChip` (`LockContent.qml:964-990`): a pill under the field, on the
        // left, saying which layout the next keystroke will type in — the one thing a lock screen
        // must not leave to be discovered after a failed password. A press asks for the next layout
        // (the compositor switches it; the worker reports the new one a moment later).
        group chip {
            show: kb_on
            box chip_bg {
                from: -192, 92; size: 78, 22; corner: 11
                color: skin.ink; opacity: 8%
            }
            // 78 design px: "layout: ru" is ten glyphs of Iosevka at 14 (≈6.5 each) plus the
            // pill's 12 px of padding on each side, rounded up for a three-letter code.
            text "layout: {kb_layout}" {
                at: -181, 103; anchor: left center; size: 14; family: "Iosevka"; color: skin.ink.dim
            }
            zone box chip_hit {
                from: -192, 92; size: 78, 22; corner: 11; cursor: pointer
                label: "Keyboard layout {kb_layout}"; role: button
            }
            on press chip_hit { emit toggle_layout }
        }

        // ---------------------------------------------------- the status line
        // Keeps its place whether or not it says something: the card never
        // grows a row on a typo and never moves the field. It is the reference's one line under
        // the field (`LockContent.qml:244-253`): the failure first, then Caps Lock, then a note —
        // and the first two are warnings, so the line wears the danger colour for both.
        text status {
            at: 0, 113; anchor: center; size: 16; family: "Iosevka"
            color: if(status_danger, lock.danger, skin.ink.dim)
        }
    }

    // The refusal nudge, played by the logic's `rejected` event.
    on rejected { play jolt }
}
