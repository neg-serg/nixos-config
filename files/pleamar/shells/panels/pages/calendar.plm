// pages/calendar.plm — the calendar drawer (`drawer == calendar`).
//
// A month grid (Sunday first, the khal default on this host: firstweekday 0)
// plus the selected day's entries. The grid itself is panels.luau's: it builds
// `cells` (42 records, ISO-accurate including the adjacent-month padding),
// `events` and `holidays` from the pleamar-calendar worker, and the month
// title. The khal date-format bug (M13: khal parses dates with its own
// `dateformat = %d.%m.%Y`) is fixed inside the worker, which retries the month
// range in that format and normalises every date back to ISO before printing;
// this scene therefore only ever sees ISO `date` fields.
//
// Navigation (cal_prev / cal_next) is handled by panels.luau: it recomputes
// the grid and restarts the worker for the new month. A missing worker keeps
// the grid and shows `cal.err` ("not available") instead of pretending there
// are events; the same text carries a worker error.
//
// Roles and labels follow INTERFACES.md §8.2; every repeated cell carries its
// own month-qualified label from the model so `--say press` is unambiguous.

part Calendar {
    component CalendarDrawer(scale: number = ui * clamp(min(screen.width / design.width, screen.height / design.height), fit.min, fit.max) * zoom) {
        size: 380 * scale, 480 * scale

        group {
            // Bottom-left, like the legacy calendar popup (calendar.popupMargin).
            // The bar's edge is bar.height + bar.gap design px above the bottom.
            move: calendar.popup * scale, screen.height - (480 + bar.height + bar.gap) * scale + (1 - lift) * (480 + bar.height + bar.gap) * scale

            // ----***----------------------------- the card
            Capsule(380, 480, fill: coal, alpha: 92%, rim: 0.06, shadow: 40%, radius: overlay.corner, scale: scale)

            // ----***------------------ header: month and arrows
            group { move: 14 * scale, 10 * scale
                Capsule(24, 20, fill: slate, alpha: 60%, radius: 10, scale: scale)
                text "‹" { at: 12 * scale, 10 * scale; anchor: center; size: 1 * type.body * text_scale * scale; color: ink }
                zone box prev { from: 0, 0; size: 24 * scale, 20 * scale; corner: 10 * scale
                    cursor: pointer; label: "Previous month"; role: button }
                on press prev { emit cal_prev }
            }
            group { move: 300 * scale, 10 * scale
                Capsule(24, 20, fill: slate, alpha: 60%, radius: 10, scale: scale)
                text "›" { at: 12 * scale, 10 * scale; anchor: center; size: 1 * type.body * text_scale * scale; color: ink }
                zone box next { from: 0, 0; size: 24 * scale, 20 * scale; corner: 10 * scale
                    cursor: pointer; label: "Next month"; role: button }
                on press next { emit cal_next }
            }
            group { move: 336 * scale, 10 * scale
                Capsule(30, 20, fill: slate, alpha: 60%, radius: 10, scale: scale)
                text "Close" { at: 15 * scale, 10 * scale; anchor: center; size: 1 * type.caption * text_scale * scale; color: ink }
                zone box close { from: 0, 0; size: 30 * scale, 20 * scale; corner: 10 * scale
                    cursor: pointer; label: "Close {drawer}"; role: button }
                on press close { drawer = none }
            }
            text cal.title { at: 168 * scale, 20 * scale; anchor: center; size: 1 * type.body * text_scale * scale; weight: 1 * weight.medium; color: accent }

            box { from: 12 * scale, 36 * scale; size: 356 * scale, 1 * scale; color: ink; opacity: ink.subtle }

            // ----***------------------------- weekday row
            repeat c in 0..6 {
                text pick(c, "Su", "Mo", "Tu", "We", "Th", "Fr", "Sa") { at: 22 * scale + c * 50 * scale, 48 * scale; anchor: center; size: 1 * type.caption * text_scale * scale; color: ink.dim }
            }

            // ----***--------------------------- month grid
            // wrap: 7 is the grid (7 per line); the 42 cells are always there,
            // so nothing moves when a month is short.
            row { at: 12 * scale, 58 * scale; wrap: 7; gap: 2 * scale
                for c in cells {
                    group {
                        size: 50 * scale, 40 * scale
                        box { from: 0, 0; size: 50 * scale, 40 * scale; corner: 3 * scale; color: accent; opacity: ink.active; show: c.this and c.day == sel_day }
                        box { from: 0.75 * scale, 0.75 * scale; size: 48.5 * scale, 38.5 * scale; corner: 3 * scale; stroke: 1.2 * scale; color: accent; show: c.today }
                        box { from: 0.75 * scale, 0.75 * scale; size: 48.5 * scale, 38.5 * scale; corner: 3 * scale; stroke: 1 * scale; color: warn; opacity: 55%; show: c.weekend and not c.today }
                        ellipse { at: 6 * scale, 6 * scale; radius: 2.5 * scale; color: accent; show: c.mark == 1 }
                        ellipse { at: 44 * scale, 6 * scale; radius: 2.5 * scale; color: warn; show: c.mark == 2 }
                        text number(c.day, 0) { at: 25 * scale, 21 * scale; anchor: center; size: 1 * type.caption * text_scale * scale; color: ink; show: c.this and not c.today }
                        text number(c.day, 0) { at: 25 * scale, 21 * scale; anchor: center; size: 1 * type.caption * text_scale * scale; weight: 1 * weight.medium; color: accent; show: c.today }
                        text number(c.day, 0) { at: 25 * scale, 21 * scale; anchor: center; size: 1 * type.caption * text_scale * scale; color: ink.off; show: not c.this }
                        zone box day { from: 0, 0; size: 50 * scale, 40 * scale; corner: 3 * scale; active: c.this
                            cursor: pointer; label: c.label; role: button; selected: c.this and c.day == sel_day }
                        on press day { sel_day = c.day }
                    }
                }
            }

            box { from: 12 * scale, 312 * scale; size: 356 * scale, 1 * scale; color: ink; opacity: ink.subtle }
            text cal.err { at: 190 * scale, 322 * scale; anchor: center; size: 1 * type.caption * text_scale * scale; color: warn }

            // ----***------------------- the selected day's entries
            text "Selected day" { at: 14 * scale, 334 * scale; anchor: left center; size: 1 * type.caption * text_scale * scale; color: ink.dim; show: sel_day > 0 }
            column daylist {
                at: 14 * scale, 346 * scale
                view: 352 * scale, 106 * scale
                gap: 2 * scale
                for h in holidays {
                    group {
                        show: h.day == sel_day and sel_day > 0
                        size: 352 * scale, 16 * scale
                        ellipse { at: 5 * scale, 8 * scale; radius: 3 * scale; color: warn }
                        text h.name { at: 16 * scale, 8 * scale; anchor: left center; width: 330 * scale; lines: 1; size: 1 * type.caption * text_scale * scale; color: ink.dim }
                    }
                }
                for e in events {
                    group {
                        show: e.day == sel_day and sel_day > 0
                        size: 352 * scale, 16 * scale
                        ellipse { at: 5 * scale, 8 * scale; radius: 3 * scale; color: accent }
                        text e.title { at: 16 * scale, 8 * scale; anchor: left center; width: 244 * scale; lines: 1; size: 1 * type.caption * text_scale * scale; color: ink.dim }
                        text e.time { at: 266 * scale, 8 * scale; anchor: left center; width: 44 * scale; size: 1 * type.caption * text_scale * scale; color: accent }
                        text e.cal { at: 314 * scale, 8 * scale; anchor: left center; width: 34 * scale; lines: 1; size: 1 * type.caption * text_scale * scale; color: ink.off }
                    }
                }
            }

            text cal.today { at: 190 * scale, 466 * scale; anchor: center; size: 1 * type.caption * text_scale * scale; color: ink.off }
        }
    }

    CalendarDrawer() { show: drawer == calendar }
}
