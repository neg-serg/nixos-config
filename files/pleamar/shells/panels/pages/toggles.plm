// pages/toggles.plm — the quick toggles and the way into the rest (`drawer == toggles`).
//
// Legacy: dhrruvsharma/shell's control/Toggles.qml (the switches at the top of the
// control centre) plus the control centre itself as a door: the pages this shell
// grew — key binds, notes, the timer, the contributions — are opened from here,
// which is what makes them reachable without a bind each. One bind of its own,
// `M4+SH+Y`, opens this drawer.
//
// The night light and the power profile of the reference are not here: the shell
// has no night-light daemon (wlsunset is not installed) and no power-profiles
// daemon on this host, so a switch for either would be a lie.

part Toggles {

    // The page's scale, read HERE, inside the named surface: a component's parameter default is
    // re-read inside the component in the scene's main-surface scope, and in this scene the main
    // surface is the full-monitor catcher — so the default came out 1.0 inside the card while the
    // card's `move:` used the surface's own fit, and every card was shifted on a monitor whose fit
    // is not 1. Passing the value from here keeps one scale for the move and the drawing.
    let toggles.scale = ui * clamp(min(screen.width / design.width, screen.height / fit.height), fit.min, fit.max) * zoom

    component TogglesDrawer(scale: number) {
        size: 400 * scale, 430 * scale

        let s = scale
        group {
            move: (screen.width - 400 * s) / 2, (screen.height - 430 * s) / 2 + (1 - lift) * 18 * s
            scale: s
            opacity: lift

            body {
                color: live.coal
                opacity: 92%
                border: 1, mix(live.coal, live.ink, 12%)
                rim: 0.07
                shadow: 0, 18, 44, 45%
                box { from: 0, 0; size: 400, 430; corner: 14 }
            }
            box { from: 16, 0; size: 34, 1; color: live.accent; opacity: 70% }
            text "toggles" { at: 16, 22; anchor: left center; family: "Iosevka"; size: 12; weight: 700; color: live.ink.dim }

            // ---- wifi
            text "Wi-Fi" { at: 16, 62; anchor: left center; family: "Iosevka"; size: 12; color: live.ink }
            text pick(net.wifi, "radio off", "no network") { at: 16, 78; anchor: left center; family: "Iosevka"; size: 9; color: live.ink.off; show: not (net.wifi and net.online) }
            text "{net.name}" { at: 16, 78; anchor: left center; width: 260; lines: 1; family: "Iosevka"; size: 9; color: live.ink.off; show: net.wifi and net.online }
            group { move: 340, 56
                Switch(toggle: toggle_wifi, on: net.wifi, label: "Wi-Fi", fill: live.slate, lit: live.accent, off: live.ink.off, on_tone: live.coal, scale: 1)
            }

            // ---- bluetooth
            text "Bluetooth" { at: 16, 116; anchor: left center; family: "Iosevka"; size: 12; color: live.ink }
            text pick(bt.powered, "radio off", "radio on") { at: 16, 132; anchor: left center; family: "Iosevka"; size: 9; color: live.ink.off }
            group { move: 340, 110
                Switch(toggle: toggle_bt, on: bt.powered, label: "Bluetooth", fill: live.slate, lit: live.accent, off: live.ink.off, on_tone: live.coal, scale: 1)
            }

            // ---- do not disturb
            text "Do not disturb" { at: 16, 170; anchor: left center; family: "Iosevka"; size: 12; color: live.ink }
            text "notifications stay in the centre" { at: 16, 186; anchor: left center; family: "Iosevka"; size: 9; color: live.ink.off }
            group { move: 340, 164
                Switch(toggle: toggle_dnd, on: dnd, label: "Do not disturb", fill: live.slate, lit: live.amber, off: live.ink.off, on_tone: live.coal, scale: 1)
            }

            box { from: 16, 212; size: 368, 1; color: live.ink; opacity: ink.subtle }
            text "shell pages" { at: 16, 228; anchor: left center; family: "Iosevka"; size: 9; color: live.ink.off }

            // ---- the door to the pages this shell grew
            text "key binds" { at: 16, 258; anchor: left center; family: "Iosevka"; size: 12; color: live.ink }
            text "every bind the compositor knows" { at: 16, 274; anchor: left center; family: "Iosevka"; size: 9; color: live.ink.off }
            text "notes" { at: 16, 302; anchor: left center; family: "Iosevka"; size: 12; color: live.ink }
            text "short notes, kept in the shell's folder" { at: 16, 318; anchor: left center; family: "Iosevka"; size: 9; color: live.ink.off }
            text "timer" { at: 16, 346; anchor: left center; family: "Iosevka"; size: 12; color: live.ink }
            text "a countdown that rings" { at: 16, 362; anchor: left center; family: "Iosevka"; size: 9; color: live.ink.off }
            text "contributions" { at: 16, 390; anchor: left center; family: "Iosevka"; size: 12; color: live.ink }

            text "›" { at: 384, 258; anchor: right center; family: "Iosevka"; size: 16; color: live.accent }
            text "›" { at: 384, 302; anchor: right center; family: "Iosevka"; size: 16; color: live.accent }
            text "›" { at: 384, 346; anchor: right center; family: "Iosevka"; size: 16; color: live.accent }
            text "›" { at: 384, 390; anchor: right center; family: "Iosevka"; size: 16; color: live.accent }

            zone box open_keys { from: 16, 244; size: 368, 44; corner: 8; cursor: pointer; label: "Key binds"; role: button }
            zone box open_notes { from: 16, 288; size: 368, 44; corner: 8; cursor: pointer; label: "Notes"; role: button }
            zone box open_timer { from: 16, 332; size: 368, 44; corner: 8; cursor: pointer; label: "Timer"; role: button }
            zone box open_github { from: 16, 376; size: 368, 26; corner: 8; cursor: pointer; label: "Contributions"; role: button }
            zone box open_power { from: 16, 398; size: 368, 26; corner: 8; cursor: pointer; label: "Session menu"; role: button }

            on press open_keys { drawer = keys }
            on press open_notes { drawer = notes }
            on press open_timer { drawer = timer }
            on press open_github { drawer = github }
            on press open_power { drawer = power }

            text "M4+SH+Y opens this page" { at: 384, 22; anchor: right center; family: "Iosevka"; size: 8; color: live.ink.off }

            // The session menu is the last door: one row, no description.
            text "session menu" { at: 16, 414; anchor: left center; family: "Iosevka"; size: 12; color: live.ink }
            text "›" { at: 384, 414; anchor: right center; family: "Iosevka"; size: 16; color: live.accent }
        }
    }

    TogglesDrawer(toggles.scale)
}
