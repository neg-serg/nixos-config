// pages/network.plm — the flow dashboard (`drawer == network`).
//
// Legacy: files/quickshell/Bar/Modules/NetFlowPopup.qml (470 x 338 dp). What
// that card actually draws, and this port follows it rather than an idea of a
// network graph:
//   `flow` at 17 bold, the interface in a pill at 11, LIVE/IDLE/OFF at 10;
//   two readouts — the arrow caption at 10 bold in the disabled tone, the value
//   at 20 bold, the peak at 10 — one per direction;
//   a plot with three horizontal grid rules, each labelled on the right with a
//   compact value (`1.2K`), and two series as a translucent area under a bright
//   line, upload first (1.4 wide) and download over it (2.0 wide);
//   a footer line, `flow — see your network breathe · ~10 Hz · N s window`.
// The earlier version of this file drew a three-dimensional waterfall of
// columns; the reference has no such thing.
//
// The data is the stream the reference reads — `flow -json-stream` at ~10 Hz,
// one JSON record a line — spawned by panels.luau while this drawer is open and
// killed when it closes. Colours: the reference chains blue to cyan for download
// and green to lime for upload; this palette has no green, so download is
// `highlight` and upload `amber`.
//
// Every length is a design-pixel literal inside `group zoom { scale }`: `size:`
// and `weight:` take ONE number and drop the rest (INTERFACES §9.2).
//
// The part is `NetPanel`, not `Network`: identifiers are case-insensitive here,
// so a part named after the drawer's enum value shadows it and `show: drawer ==
// network` never fires.
//
part NetPanel {
    component NetPanelDrawer(scale: number = ui * clamp(min(screen.width / design.width, screen.height / design.height), fit.min, fit.max) * zoom) {
        size: 470 * scale, 338 * scale

        // The plot: 14..414 across, 116..296 down, so the compact axis labels
        // have room on the right where the reference puts them.
        // flow's palette, which the reference hard-codes rather than taking
        // from the theme: download blue to cyan, upload green to lime.
        let down.a = #3B82F6
        let down.b = #00F5D4
        let up.a = #10B981
        let up.b = #A3E635

        let plot.x = 14
        let plot.w = 400
        let plot.y = 116
        let plot.h = 180
        // Stretched over what there is, like `xAt(i)` in the reference: eleven
        // samples span the plot, not a tenth of it.
        let pitch = plot.w / max(flow.total, 1)
        let column.w = plot.w / max(flow.total, 1)

        group {
            move: 4, 4 + (1 - lift) * (338 + 4) * scale

            group zoom {
                scale: scale

                // ----***------------------------- the card
                body {
                    color: coal
                    opacity: 92%
                        box { from: 0, 0; size: 470, 338; corner: 0 }
                }

                // ----***------------------------ header
                text "flow" { at: 14, 20; anchor: left center; family: "Iosevka"; size: 17; weight: 700; color: ink }

                group { move: 62, 9
                    Capsule(96, 22, fill: accent, alpha: 15%, edge: 1, edge_tone: accent, edge_alpha: 35%, radius: 9, scale: 1)
                    text "{net.iface}" { at: 48, 11; anchor: center; width: 88; lines: 1; align: center; family: "Iosevka"; size: 11; color: ink }
                }

                ellipse { at: 404, 20; radius: 3.5; color: pick(net_live, down.b, ink.off) }
                text pick(net_live, "IDLE", "LIVE") { at: 414, 20; anchor: left center; family: "Iosevka"; size: 10; color: ink.dim }

                // ----***----------------------- readouts
                text "↓ DOWN" { at: 14, 52; anchor: left center; family: "Iosevka"; size: 10; weight: 700; color: ink.off }
                text "{net.rx}" { at: 14, 78; anchor: left center; family: "Iosevka"; size: 20; weight: 700; color: down.b }
                text "peak {net.peak_rx}" { at: 14, 96; anchor: left center; family: "Iosevka"; size: 10; color: ink.off }

                text "↑ UP" { at: 240, 52; anchor: left center; family: "Iosevka"; size: 10; weight: 700; color: ink.off }
                text "{net.tx}" { at: 240, 78; anchor: left center; family: "Iosevka"; size: 20; weight: 700; color: up.b }
                text "peak {net.peak_tx}" { at: 240, 96; anchor: left center; family: "Iosevka"; size: 10; color: ink.off }

                // ----***--------------------------- plot
                // Three rules at the thirds, each labelled to the right.
                repeat g in 0..3 {
                    box { from: plot.x, plot.y + plot.h - g * plot.h / 3; size: plot.w, 1; color: ink; opacity: 18% }
                }
                text "{net.ax1}" { at: 422, plot.y + plot.h - plot.h / 3 + 3; anchor: left center; family: "Iosevka"; size: 9; color: ink.off }
                text "{net.ax2}" { at: 422, plot.y + plot.h - 2 * plot.h / 3 + 3; anchor: left center; family: "Iosevka"; size: 9; color: ink.off }
                text "{net.ax3}" { at: 422, plot.y + 3; anchor: left center; family: "Iosevka"; size: 9; color: ink.off }

                // Upload first, download over it, the way the reference stacks
                // the two series. The area is the column, the line its top edge.
                for v in flow {
                    let t.up = if(flow.total > 1, v.index / (flow.total - 1), 0)
                    box { from: plot.x + v.index * pitch, plot.y + plot.h - max(v.tx / max(net_max_tx, 1) * plot.h, 0)
                        size: column.w, max(v.tx / max(net_max_tx, 1) * plot.h, 0)
                        color: mix(up.a, up.b, t.up); opacity: 22%; show: v.tx > net_max_tx * 0.02 }
                    box { from: plot.x + v.index * pitch, plot.y + plot.h - max(v.tx / max(net_max_tx, 1) * plot.h, 0)
                        size: column.w, 1.4; color: mix(up.a, up.b, t.up); show: v.tx > net_max_tx * 0.02 }
                }
                for v in flow {
                    let t.down = if(flow.total > 1, v.index / (flow.total - 1), 0)
                    box { from: plot.x + v.index * pitch, plot.y + plot.h - max(v.rx / max(net_max_rx, 1) * plot.h, 0)
                        size: column.w, max(v.rx / max(net_max_rx, 1) * plot.h, 0)
                        color: mix(down.a, down.b, t.down); opacity: 28%; show: v.rx > net_max_rx * 0.02 }
                    box { from: plot.x + v.index * pitch, plot.y + plot.h - max(v.rx / max(net_max_rx, 1) * plot.h, 0)
                        size: column.w, 2; color: mix(down.a, down.b, t.down); show: v.rx > net_max_rx * 0.02 }
                }

                text "waiting for flow…" { at: 214, 206; anchor: center; family: "Iosevka"; size: 11; color: ink.off
                    show: flow.total == 0 }
                text "{net.err}" { at: 214, 214; anchor: center; family: "Iosevka"; size: 10; color: warn }

                // ----***------------------------- footer
                text "flow — see your network breathe   ·   ~10 Hz   ·   {flow.total} samples" { at: 14, 318; anchor: left center; family: "Iosevka"; size: 9; color: ink.off }
            }
        }
    }

    NetPanelDrawer() { show: drawer == network }
}
