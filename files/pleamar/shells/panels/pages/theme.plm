// pages/theme.plm — the theme drawer (`drawer == theme`).
//
// One row per theme file in `~/.config/pleamar/themes`, as `pleamar-themes list
// --plain` answers it (name, font, corners, path, and whether theme.plm was made
// from that file). A press runs `pleamar-themes apply`, which rewrites
// `theme.plm` — every scene imports it, so the shell re-themes on reload and
// this drawer closes with the panels scene, exactly as a wallpaper change does.
// The rows are the logic's (`model.themes`, panels.luau): this part invents
// nothing, and with no theme file the card says so instead of drawing an empty
// plate.

part Theme {

    component ThemeRow(t: record, pick: event, scale: number = ui) {
        let w = 332
        let h = 34

        size: w * scale, h * scale

        group zoom {
            scale: scale

            box wash { from: 0, 0; size: w, h; corner: menu.item.corner
                color: mix(live.slate, live.accent, 0.18)
                opacity: max(0.35, hit.hover * 0.65) }

            // The applied theme: an accent bar down the row's left edge.
            // Arithmetic, not `pick(t.selected, …)`: a model's bool arrives as 0/1,
            // and `pick` reads a number as an index — 0 is its first choice, so both
            // rows lit up (measured on 0.7.7).
            box mark { from: 0, 6; size: 2, h - 12; color: live.accent
                opacity: t.selected * 100% }

            text "{t.name}" { at: 12, 12; anchor: left center
                family: "Iosevka"; size: 12; weight: 500; color: live.ink }
            text "{t.detail}" { at: 12, 24; anchor: left center
                family: "Iosevka"; size: 9; color: live.ink.dim }

            // The theme's accent, as the file gives it (the logic passes the
            // channels `rgb()` takes, so the row shows its own colour).
            box swatch { from: w - 20, 13; size: 8, 8; corner: 4
                color: rgb(t.accent_r, t.accent_g, t.accent_b) }

            // The row zone: `role: item` and `selected:` so the machine tree says
            // which theme is the one in place (INTERFACES.md §8.1).
            zone box hit { from: 0, 0; size: w, h; corner: menu.item.corner
                cursor: pointer; label: "{t.name}"; role: item; selected: t.selected }
            on press hit { emit pick(t.idx) }
        }
    }

    component ThemeDrawer(scale: number = ui * clamp(min(screen.width / design.width, screen.height / fit.height), fit.min, fit.max) * zoom) {
        size: 360 * scale, 330 * scale

        group place {
            // The surface is the card grown by the shader's margin (6 px a side), so
            // the torn fringe of a light theme's sheet has room to be drawn.
            move: 6 * scale, 6 * scale + (1 - lift) * 330 * scale

            group zoom {
                scale: scale

                // ----***----------------------------- the card
                // A light theme is a sheet of paper: the card is its cream body and the
                // shader lays the grain, the rubbed edge and the torn fringe over it
                // (ported from Vitreus, see shaders/paper.wgsl). A dark theme keeps the
                // plate it always had.
                body {
                    color: pick(live.light, live.slate, live.coal)
                    opacity: pick(live.light, 100%, 85%)
                    box { from: 0, 0; size: 360, 330; corner: 0; opacity: 0% }
                }
                shader paper_sheet { at: -6, -6; size: 372, 342; show: live.light
                    values: 0.55, 7.0, 6.0, 0.0
                    colors: live.slate, live.accent_deep }
                box { from: 0, 0; size: 360, 1; color: live.accent; opacity: 25% }

                // ----***------------------------------ the title
                text "theme" { at: 14, 18; anchor: left center; family: "Iosevka"; size: 12; weight: 700; color: live.ink }
                text "~/.config/pleamar/themes" { at: 14, 32; anchor: left center; family: "Iosevka"; size: 9; color: live.ink.off }
                box { from: 14, 40; size: 332, 1; color: live.ink; opacity: ink.subtle }

                // ----***------------------------------- the list
                column list { at: 14, 46
                    for t in themes {
                        ThemeRow(t, theme_apply, scale: 1)
                    }
                }

                text "no themes yet — put a .toml in ~/.config/pleamar/themes" { at: 180, 170; anchor: center; family: "Iosevka"; size: 10; color: live.ink.off
                    show: themes.total == 0 }

                // ----***------------------------ the paper's warmth
                // A light theme's whites are one number: 2700 K is warm paper, 6500 K a
                // neutral sheet, and the tool rebuilds the palette from it while the
                // slider is dragged (`pleamar-themes warm`). A dark theme has no paper
                // to tint, so the block is hidden.
                box { from: 14, 262; size: 332, 1; color: live.ink; opacity: ink.subtle
                    show: live.light }
                text "paper warmth" { at: 14, 272; anchor: left center; family: "Iosevka"; size: 9; color: live.ink.dim
                    show: live.light }
                text "{theme.warm}" { at: 346, 272; anchor: right center; family: "Iosevka"; size: 9; color: live.ink.dim
                    show: live.light }
                group { move: 14, 280; show: live.light
                    Slider(change: theme_warm, value: warm, label: "Paper warmth",
                        tone: live.accent, track: live.ink, knob: live.ink, scale: 1)
                }
                // An empty text draws nothing, so the error line needs no `show:`
                // (a text fact cannot be compared inside a scene expression).
                text "{theme.err}" { at: 180, 190; anchor: center; family: "Iosevka"; size: 10; color: live.warn }
            }
        }
    }

    // The surface is the monitor (see `panels.plm`), so the card is placed against
    // its screen corner here: the `let` below is the component's own fit, times the user's zoom.
    let theme.s = ui * clamp(min(screen.width / design.width, screen.height / fit.height), fit.min, fit.max) * zoom
    group { move: screen.width - 372 * theme.s - 5, screen.height - 342 * theme.s - 1
        ThemeDrawer(scale: theme.s) { show: drawer == theme }
    }
}
