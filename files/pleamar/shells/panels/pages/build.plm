// pages/build.plm — the Nix build drawer (`drawer == build`).
//
// The legacy `BuildStatusPopup.qml`: one line per running build — the phase, what is
// being built and for how long — under a title. The rows are the build plugin's own
// model (`build.Rows`), which build.luau fills from the tool's `builds` array, so this
// part draws and invents nothing: with no build running the list is empty and the
// drawer is nothing but its title.
//
// QS anchored the popup under the bar's centre, aligned with the capsule that opened it
// (`BuildStatusPopup.qml`). The badge rides in the bar's left row here, so the card
// hangs from the left edge, 2 design px in — the calendar's corner, since both open from
// a left-row capsule.
//
// The plate is the weather card's: `Theme.surface` at 85%, no radius, one 1 px line of
// the live.accent along the top edge.

part Build {
    component BuildDrawer(scale: number = ui * clamp(min(screen.width / design.width, screen.height / fit.height), fit.min, fit.max) * zoom) {
        size: 384 * scale, 214 * scale

        group {
            move: 0, (1 - lift) * 214 * scale

            // ----***----------------------------- the card
            body {
                color: live.coal
                opacity: 85%
                box { from: 0, 0; size: 384 * scale, 214 * scale; corner: 0; opacity: 0% }
            }
            box { from: 0, 0; size: 384, 1; color: live.accent; opacity: 25% }

            // ----***------------------------------ the title
            text "nix build" { at: 14, 18; anchor: left center; family: "Iosevka"; size: 12; weight: 700; color: live.ink }
            box { from: 14, 32; size: 356, 1; color: live.ink; opacity: ink.subtle }

            // ----***------------------------------- the list
            group list { move: 14, 42
                build.Rows(width: 356, type_scale: text_scale)
            }
        }
    }

    // Every part prints its drawer at the end, and this one did not: the surface opened on
    // `drawer == build` and painted nothing — the empty window the scene's own header warns
    // about, and the only reason this card was ever blank.
    // The surface is the monitor (see `panels.plm`), so the card is placed against
    // its screen corner here: the `let` below is the component's own fit, times the user's zoom.
    let build.s = ui * clamp(min(screen.width / design.width, screen.height / fit.height), fit.min, fit.max) * zoom
    group { move: 2, screen.height - 214 * build.s - 2
        BuildDrawer(scale: build.s) { show: drawer == build }
    }
}
