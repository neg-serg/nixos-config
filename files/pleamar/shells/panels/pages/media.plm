// pages/media.plm — the now-playing card (`drawer == media`).
//
// Legacy: files/quickshell/Widgets/SidePanel/Music.qml. The card is the cover
// and the identity rows centred on it, and the transport stays where
// QS keeps it — in the bar capsule, not here (Music.qml:705: "Track title
// removed on request: the card carries the identity rows below and the bar
// keeps the title"). There is no close button either: the reference closes on
// Escape and on an outside press, and the drawer family does both.
//
// Layout, from the reference's own tokens — `musicPopupWidth` 420
// (Settings.json), `sidePanel.albumArtSize` 200 (Theme/sidePanel.jsonc), padding
// 12 — and the card is no taller than what it holds: 12 + 200 of cover, 12 of
// air, the 76 of timeline (62 of picture over a 14 ruler), and the 3 px seek
// rail flush on the bottom edge (303).
//
//     +--------------------------------------------------+
//     | [cover 200]  rows: icon + value, 18 apart        |
//     |              rows centred on the cover           |
//     |                                                  |
//     | the whole track's spectrogram, played part dim   |
//     | 0:00        1:00        2:00        3:00    4:03 | <- ruler
//     | ==== seek rail: 3 px, flush on the bottom ====== |
//     +--------------------------------------------------+
//
// Every element has its own coordinates and its own box: nothing is stacked by
// a layout that could change its mind. That is deliberate — a `column` sizes
// itself to what it holds, so the block moved a few pixels whenever a tag row
// appeared or a value grew, which reads as the card twitching around its centre.
// Rows sit at `rows_y + index * 18`, and the tag rows continue from the
// number of service rows (`media_rows.total`), so a row never lands on another.
//
// Icon and value are anchored by their **bottom** edge, on the same line: a
// Material glyph and a text centred at the same y do not share an optical
// baseline, and the icons looked like they were floating.
//
// Every length is a design-pixel literal inside `group zoom { scale }`: `size:`
// and `weight:` take ONE number and drop the rest of the expression
// (INTERFACES §9.2), so `size: 11 * scale` draws at 11 px while the card grows.
//
// The part is `NowPlaying`, not `Media`: an identifier is case-insensitive here,
// so a part named after the drawer's own enum value shadows it and
// `show: drawer == media` compares the fact with the part — the rule never
// fires, the surface never opens, and the scene exits a couple of seconds after
// the drawer is asked for.

part NowPlaying {
    component NowPlayingDrawer(scale: number = ui * clamp(min(screen.width / design.width, screen.height / fit.height), fit.min, fit.max) * zoom) {
        size: 420 * scale, 303 * scale

        // The identity block's top: its middle sits on the cover's own
        // (12 + 200 / 2), so the rows are centred on the art however many the
        // service reports, instead of hanging under the card's top edge.
        let rows_y = 112 - (media_rows.total + Meta.rows.total) * 9

        group {
            move: 0, (1 - lift) * 303 * scale

            group zoom {
                scale: scale


                // ----***------------------------- the card
                body {
                    color: live.coal
                    opacity: 75%
                        box { from: 0, 0; size: 420, 303; corner: 0; opacity: 0% }
                }

                // ----***--------------------- album art
                // The cover plugin resolves the real album-directory file behind
                // the player's URL; with nothing resolvable it draws its own
                // quiet plate, which is the reference's fallback.
                group { move: 12, 12
                    Cover.Art(w: 200, h: 200)
                }

                // ----***------------------ identity rows
                // Row n sits at `rows_y + n * 18`; the tag rows continue after
                // the service's own.
                for r in media_rows {
                    text r.glyph { at: 216, rows_y + r.index * 18 + 13; anchor: left bottom
                        family: "Material Symbols Outlined"; size: 11; color: live.ink.dim }
                    text r.value { at: 234, rows_y + r.index * 18 + 13; anchor: left bottom; width: 174; lines: 1
                        family: "Iosevka"; weight: 700; size: 11; color: live.ink }
                }
                for r in Meta.rows {
                    text r.glyph { at: 216, rows_y + (media_rows.total + r.index) * 18 + 13; anchor: left bottom
                        family: "Material Symbols Outlined"; size: 11; color: live.ink.dim }
                    text r.value { at: 234, rows_y + (media_rows.total + r.index) * 18 + 13; anchor: left bottom; width: 174; lines: 1
                        family: "Iosevka"; weight: 700; size: 11; color: live.ink }
                }

                // ----***----------------- the track, whole
                // Aurora's timeline (its `plugins/statusbar`) in the card's lower band: the
                // whole-track spectrogram, the played part shaded to the ground, a ruler with its
                // times, and the playhead. It is a picture of the track and not of the moment,
                // which is what a seek bar needs — the cava band this replaced drew only "now".
                // `panels.luau` decodes it once per track (`ffmpeg showspectrumpic`) and writes
                // `spectre_path`; the ticks are its too, since a clock is arithmetic and the step
                // the ruler can afford depends on the length.
                let share = clamp(media.pos / max(media.length, 1), 0, 1)
                group { show: spectre_on and media.length > 0
                    // The picture is `ffmpeg`'s own grey levels, not `tint:`ed: an image tint in
                    // this language paints the picture one flat colour, so the hue comes from a
                    // wash over it instead, and the levels stay readable through it.
                    image spectre { at: 0, 224; size: 420, 62; fit: fill }
                    box { from: 0, 224; size: 420, 62; color: cover_accent; opacity: 28% }
                    // The played part: the ground's own colour over the picture at a weight that
                    // leaves its structure visible but reads as "behind us" at a glance.
                    box { from: 0, 224; size: 420 * share, 62; color: live.coal; opacity: 70% }
                    // A grid line through the picture at every labelled step: the ruler says when
                    // a mark is, the grid puts that mark next to the music it names.
                    for t in ticks {
                        box { from: 420 * t.x, 224; size: 1, 62; color: live.ink; opacity: 12% }
                    }
                    // The playhead: the frame's ink, not the accent — the picture is painted in
                    // the accent, and an accent line on a loud band is invisible.
                    box { from: clamp(420 * share - 1, 0, 418), 224; size: 2, 62
                        color: live.ink; opacity: 55% }
                }
                // The ruler: a hairline whose played part is the accent, the tick under each label,
                // and the times. Drawn with or without the picture, so the first frame of a track
                // already reads as a timeline.
                box { from: 0, 286; size: 420, 1; color: live.ink; opacity: 22%
                      show: media.length > 0 }
                box { from: 0, 286; size: 420 * share, 1; color: cover_accent
                      show: media.length > 0 }
                for t in ticks {
                    box { from: 420 * t.x, 286; size: 1, 4; color: live.ink; opacity: 55% }
                    text t.label { at: clamp(420 * t.x, 26, 394), 290; anchor: center top
                        family: "Iosevka"; size: 8; color: live.ink.dim }
                }

                // ----***----------------------- the seek rail
                // Aurora's rail (plugins/statusbar: a 3 px bed along the frame's foot, the played
                // share filled over it, a rounded head on the column the hand names and a plate
                // above it carrying that column's clock) on the card's own bottom edge.
                // The fill keeps a hairline's width even at the track's very start, the way
                // aurora's `max(track * share, progress_h)` does: a track a second in has begun.
                box { from: 0, 300; size: 420, 3; corner: 1.5; color: live.ink; opacity: 22%
                      show: media.length > 0 }
                box { from: 0, 300; size: max(420 * share, 3), 3; corner: 1.5; color: cover_accent
                      show: media.length > 0 }
                // The head marks the hand, not the playhead: the rail already says what is playing,
                // and a rule can read `pointer.x` only while the mouse is doing something, so a
                // hover head would freeze where it last was. It waits for a press — which is also
                // the only moment the plate above it has a second to show.
                box { from: clamp(420 * seek_frac - 3, 0, 414), 296; size: 6, 7; corner: 3
                      color: cover_accent
                      show: media.can_seek and media.length > 0 and scrub.pressed > 0.05 }
                // The hand's column through the picture, and the clock it names. `panels.luau`
                // writes both values — the hand's share and the second — because a clock is
                // arithmetic a text cannot do, and it has the length when the press arrives.
                group { show: media.can_seek and media.length > 0 and scrub.pressed > 0.05
                    box { from: clamp(420 * seek_frac - 0.5, 0, 419), 224; size: 1, 62
                          color: live.ink; opacity: 90% }
                    let tip.x = clamp(420 * seek_frac - 24, 4, 372)
                    body { color: live.coal; opacity: 96%; border: 1, cover_accent
                        box { from: tip.x, 260; size: 48, 18; corner: 4; opacity: 0% }
                    }
                    text seek_time { at: tip.x + 24, 269; anchor: center
                        family: "Iosevka"; weight: 700; size: 10; color: cover_accent }
                }

                // ----***----------------- the seek band
                // The rail is the hit box: the hand lands anywhere on the card's last 22 px, and
                // its x over the card's 420 is the share. A press seeks at once and `drag` keeps
                // seeking while the button is held, as `Music.qml`'s `seekFromX` does. The cursor
                // already says `default` when the player cannot seek, and the press is gated too,
                // so the band does not do what the pointer promised it would not.
                zone box scrub { from: 0, 281; size: 420, 22; cursor: pick(media.can_seek, not_allowed, pointer)
                                 label: pick(media.can_seek, "Seek (this player cannot seek)", "Seek")
                                 role: slider; value: "{media.pos, 0} s" }
                on press scrub while media.can_seek { emit seek(clamp(local.x / 420, 0, 1)) }
                on drag scrub { emit seek(clamp(local.x / 420, 0, 1)) }

                // ----***---------------- nothing playing
                group { show: media_rows.total == 0
                    text "music_note" { at: 210, 104; anchor: center
                        family: "Material Symbols Outlined"; size: 28; color: live.ink.dim }
                    text "No music player detected" { at: 210, 136; anchor: center
                        family: "Iosevka"; size: 11; color: live.ink.off }
                }
            }
        }
    }

    // The surface is the monitor (see `panels.plm`), so the card is placed against
    // its screen corner here: the `let` below is the component's own fit, times the user's zoom.
    let media.s = ui * clamp(min(screen.width / design.width, screen.height / fit.height), fit.min, fit.max) * zoom
    group { move: screen.width - 420 * media.s - 131, screen.height - 303 * media.s
        NowPlayingDrawer(scale: media.s) { show: drawer == media }
    }
}
