// pages/system.plm — the system monitor drawer (`drawer == system`).
//
// pleamar has no system-monitor service, so this drawer is fed by the
// pleamar-sysmon worker (procfs/sysfs; scripts/helpers/README.md) while it is
// open: one sample per second with cpu_percent, mem/swap, disk rates, gpu and
// a cpu temperature. panels.luau turns each sample into one `tiles` record —
// label, formatted value, a 0..1 level and a tone 0 accent / 1 amber / 2 warn —
// so the scene stays a pure drawing of whatever the worker last said. A worker
// that is absent or died leaves the tiles at their last sample and writes
// `sysmon.err`; `sysmon_online` is 0 and the header says offline.
//
// The legacy SystemMonitorPopup was a journal/TTY dashboard fed by journalctl
// and log files, which this slice does not port: the worker is the metrics
// source the port froze (INTERFACES.md §7), the journal dashboard is deferred.

part System {
    component SystemDrawer(scale: number = ui * clamp(min(screen.width / design.width, screen.height / design.height), fit.min, fit.max) * zoom) {
        size: 1040 * scale, 348 * scale

        group {
            move: (screen.width - min(1040 * scale, screen.width - 48 * scale)) / 2, screen.height - (384 + bar.height + bar.gap) * scale + (1 - lift) * (384 + bar.height + bar.gap) * scale

            // ----***----------------------------- the card
            Capsule(1040, 384, fill: coal, alpha: 75%, edge: 1, edge_tone: ink, edge_alpha: 10%, radius: 0, scale: scale)

            // ----***---------------------------- samples
            text "Sampling…" { at: 520 * scale, 204 * scale; anchor: center; family: "Iosevka"; size: 16; color: ink.off; show: tiles.total == 0 }

            column rows { at: 16 * scale, 28 * scale; gap: 6 * scale
                for t in tiles {
                    group {
                        size: 1008 * scale, 12 * scale
                        box { from: 0, 0; size: 1008 * scale, 12 * scale; corner: 4 * scale; color: ink; opacity: ink.hover }
                        text t.label { at: 14 * scale, 24 * scale; anchor: left center; family: "Iosevka"; size: 12; color: ink.dim }
                        text t.value { at: 994 * scale, 15 * scale; anchor: right center; family: "Iosevka"; size: 16; weight: 700; color: ink }
                        box { from: 14 * scale, 4 * scale; size: 980 * scale, 5 * scale; corner: 2.5 * scale; color: ink; opacity: ink.active }
                        box { from: 14 * scale, 4 * scale; size: 980 * t.level * scale, 5 * scale; corner: 2.5 * scale; color: pick(t.tone, accent, amber, warn) }
                    }
                }
            }
        }
    }

    SystemDrawer() { show: drawer == system }
}
