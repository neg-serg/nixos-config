// pages/system.plm — the system monitor drawer (`drawer == system`).
//
// pleamar has no system-monitor service, so this drawer is fed by the
// pleamar-sysmon worker (procfs/sysfs; scripts/helpers/README.md) while it is
// open: one sample per second with cpu_percent, mem/swap, disk rates, gpu and
// a cpu temperature. panels.luau turns each sample into one `tiles` record —
// label, formatted value, a 0..1 level and a tone 0 live.accent / 1 live.amber / 2 live.warn —
// so the scene stays a pure drawing of whatever the worker last said. A worker
// that is absent or died leaves the tiles at their last sample and writes
// `sysmon.err`; `sysmon_online` is 0 and the header says offline.
//
// The legacy SystemMonitorPopup was a journal/TTY dashboard fed by journalctl
// and log files, which this slice does not port: the worker is the metrics
// source the port froze (INTERFACES.md §7), the journal dashboard is deferred.

part SysPanel {
    component SystemDrawer(scale: number = ui * clamp(min(screen.width / design.width, screen.height / fit.height), fit.min, fit.max) * zoom) {
        // Bar/Modules/SystemMonitorPopup.qml: `Color.withAlpha(Theme.surface,
        // 0.85)`, `borderWidth: 0`, radius 0 — a dashboard of the journal, not
        // of the CPU: the title, the journal's state beside it, three figures
        // (log lines, errors, services) and the last few entries with a time, a
        // unit and a message.
        size: 1040 * scale, 610 * scale

        group {
            move: 0, (1 - lift) * 610 * scale

            body {
                color: live.coal
                opacity: 85%

                box { from: 0, 0; size: 1040 * scale, 610 * scale; corner: 0; opacity: 0% }
            }

            // ----***---------------------------- header
            text "System Dashboard" { at: 14, 20; anchor: left center; family: "Iosevka"; size: 17; weight: 700; color: live.ink }
            ellipse { at: 930, 20; radius: 5; color: pick(journal_ok, #00F5D4, live.ink.off) }
            text "Journal" { at: 942, 20; anchor: left center; family: "Iosevka"; size: 13; color: live.ink.dim }

            box { from: 14, 36; size: 1012, 1; color: live.ink; opacity: ink.subtle }

            // ----***-------------------------- figures
            // Three cards of equal width, the value above the label, as the
            // reference lays them out (value at medium, label at small).
            group { move: 14, 46
                body {
                    color: live.slate
                    opacity: 40%
                    box { from: 0, 0; size: 330, 56; corner: 6 }
                }
                text sys.logs { at: 16, 22; anchor: left center; family: "Iosevka"; size: 19; weight: 700; color: live.ink }
                text "Log Lines" { at: 16, 42; anchor: left center; family: "Iosevka"; size: 13; color: live.ink.dim }
            }
            group { move: 356, 46
                body {
                    color: live.slate
                    opacity: 40%
                    box { from: 0, 0; size: 330, 56; corner: 6 }
                }
                text sys.errors { at: 16, 22; anchor: left center; family: "Iosevka"; size: 19; weight: 700; color: live.warn }
                text "Errors" { at: 16, 42; anchor: left center; family: "Iosevka"; size: 13; color: live.ink.dim }
            }
            group { move: 698, 46
                body {
                    color: live.slate
                    opacity: 40%
                    box { from: 0, 0; size: 330, 56; corner: 6 }
                }
                text sys.services { at: 16, 22; anchor: left center; family: "Iosevka"; size: 19; weight: 700; color: live.ink }
                text "Services" { at: 16, 42; anchor: left center; family: "Iosevka"; size: 13; color: live.ink.dim }
            }

            // ----***----------------------- recent logs
            text "Recent Logs" { at: 14, 128; anchor: left center; family: "Iosevka"; size: 17; weight: 700; color: live.ink }

            // The table's head, then a row per entry: time, unit, message.
            text "Time" { at: 20, 150; anchor: left center; family: "Iosevka"; size: 12; color: live.ink.off }
            text "Service" { at: 90, 150; anchor: left center; family: "Iosevka"; size: 12; color: live.ink.off }
            text "Message" { at: 250, 150; anchor: left center; family: "Iosevka"; size: 12; color: live.ink.off }

            for e in journal {
                text e.time { at: 20, 168 + e.index * 20; anchor: left center; family: "Iosevka"; size: 13; color: live.ink.dim }
                text e.service { at: 90, 168 + e.index * 20; anchor: left center; width: 152; lines: 1; family: "Iosevka"; size: 13; color: live.ink.dim }
                text e.msg { at: 250, 168 + e.index * 20; anchor: left center; width: 770; lines: 1; family: "Iosevka"; size: 13; color: live.ink }
            }

            // Two states, not one: the worker answers a second or two after the drawer opens, and
            // "no entries" is a claim about the world, not a loading label — `sys.have` is what
            // tells them apart.
            text "reading the journal…" { at: 380, 200; anchor: center; family: "Iosevka"; size: 11; color: live.ink.off
                show: journal.total == 0 and not sys.have }
            text "no journal entries in the last day" { at: 380, 200; anchor: center; family: "Iosevka"; size: 11; color: live.ink.off
                show: journal.total == 0 and sys.have }

            // ----***--------------------------- history
            // sysmon samples all the time (panels.luau `wanted`), so the last 60 records are the
            // minute before the drawer opened, not the minute after. Three series share one
            // 0..100 % scale, so the chart is a comparison, not three sparklines; each series is a
            // polyline of one `line` per pair of samples, the flow card's shape. The temperature is
            // broken where the worker had no reading, never drawn to zero; the GPU series is gone —
            // its reading cannot be trusted on this card.
            let hist.x = 14
            let hist.y = 386
            let hist.w = 840
            let hist.h = 166
            text "History" { at: 14, 350; anchor: left center; family: "Iosevka"; size: 17; weight: 700; color: live.ink }
            // The legend: a dot in the series colour and its name, one row under the title.
            box { from: 14, 367; size: 8, 8; corner: 4; color: live.accent }
            text "CPU" { at: 28, 371; anchor: left center; family: "Iosevka"; size: 12; color: live.ink.dim }
            box { from: 76, 367; size: 8, 8; corner: 4; color: live.amber }
            text "RAM" { at: 90, 371; anchor: left center; family: "Iosevka"; size: 12; color: live.ink.dim }
            box { from: 138, 367; size: 8, 8; corner: 4; color: live.warn; show: sysmon_temp == 1 }
            text "TEMP" { at: 152, 371; anchor: left center; family: "Iosevka"; size: 12; color: live.ink.off; show: sysmon_temp == 1 }

            // Five rules at the quarters, round numbers every one, and every one labelled: the ONS
            // chart guidance says gridlines always carry the value they stand for and the count
            // stays between three and six on a chart this size. Only the value axis gets them —
            // a time axis gets tick marks, not gridlines — and the zero line is the emphasised one
            // (ONS "Axes and gridlines": the zero line carries more weight than a standard rule).
            repeat g in 0..4 {
                box { from: hist.x, hist.y + hist.h - g * hist.h / 4; size: hist.w, 1; color: live.ink; opacity: 8% }
            }
            box { from: hist.x, hist.y + hist.h; size: hist.w, 1; color: live.ink; opacity: 22% }
            text "100 %" { at: hist.x + hist.w + 8, hist.y; anchor: left center; family: "Iosevka"; size: 10; color: live.ink.off }
            text "75 %" { at: hist.x + hist.w + 8, hist.y + hist.h / 4; anchor: left center; family: "Iosevka"; size: 10; color: live.ink.off }
            text "50 %" { at: hist.x + hist.w + 8, hist.y + hist.h / 2; anchor: left center; family: "Iosevka"; size: 10; color: live.ink.off }
            text "25 %" { at: hist.x + hist.w + 8, hist.y + 3 * hist.h / 4; anchor: left center; family: "Iosevka"; size: 10; color: live.ink.off }
            text "0 %" { at: hist.x + hist.w + 8, hist.y + hist.h; anchor: left center; family: "Iosevka"; size: 10; color: live.ink.off }
            // The time axis: ticks at the window's ends and its middle, with the spans under them.
            repeat t in 0..2 {
                box { from: hist.x + t * hist.w / 2, hist.y + hist.h + 2; size: 1, 3; color: live.ink; opacity: 30% }
            }
            text "−60 s" { at: hist.x, hist.y + hist.h + 12; anchor: left center; family: "Iosevka"; size: 10; color: live.ink.off }
            text "−30 s" { at: hist.x + hist.w / 2, hist.y + hist.h + 12; anchor: center; family: "Iosevka"; size: 10; color: live.ink.off }
            text "now" { at: hist.x + hist.w, hist.y + hist.h + 12; anchor: right center; family: "Iosevka"; size: 10; color: live.ink.off }

            // One `line` per segment and series, round caps closing the joins. CPU is the primary
            // reading and is drawn last (over the others) and wider; the rest sit behind it.
            for h in sys_hist {
                line { from: hist.x + h.t0 * hist.w, hist.y + hist.h - h.ram0 * hist.h
                    to: hist.x + h.t1 * hist.w, hist.y + hist.h - h.ram1 * hist.h
                    width: 1.3; color: live.amber; opacity: 85% }
                line { from: hist.x + h.t0 * hist.w, hist.y + hist.h - h.temp0 * hist.h
                    to: hist.x + h.t1 * hist.w, hist.y + hist.h - h.temp1 * hist.h
                    width: 1.2; color: live.warn; opacity: 80%; show: h.temp_ok }
                line { from: hist.x + h.t0 * hist.w, hist.y + hist.h - h.cpu0 * hist.h
                    to: hist.x + h.t1 * hist.w, hist.y + hist.h - h.cpu1 * hist.h
                    width: 1.8; color: live.accent; opacity: 95% }
            }
            text "waiting for samples…" { at: hist.x + hist.w / 2, hist.y + hist.h / 2; anchor: center
                family: "Iosevka"; size: 11; color: live.ink.off; show: sys_hist.total == 0 }
            text "1 sample / s · 60 s window" { at: 14, 584; anchor: left center; family: "Iosevka"; size: 10; color: live.ink.off }
        }
    }

    SystemDrawer() { show: drawer == system }
}
