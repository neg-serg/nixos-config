// pages/system.plm — the system monitor drawer (`drawer == system`).
//
// pleamar has no system-monitor service, so this drawer is fed by the
// pleamar-sysmon worker (procfs/sysfs; scripts/helpers/README.md) while it is
// open: one sample per second with cpu_percent, mem/swap, disk rates, gpu and
// a cpu temperature. panels.luau turns each sample into one `tiles` record —
// label, formatted value, a 0..1 level and a tone 0 accent / 1 amber / 2 warn —
// so the scene stays a pure drawing of whatever the worker last said. A worker
// that is absent or died leaves the tiles at their last sample and writes
// `sysmon.err`; `sysmon_online` is 0 and the header says offline.
//
// The legacy SystemMonitorPopup was a journal/TTY dashboard fed by journalctl
// and log files, which this slice does not port: the worker is the metrics
// source the port froze (INTERFACES.md §7), the journal dashboard is deferred.

part SysPanel {
    component SystemDrawer(scale: number = ui * clamp(min(screen.width / design.width, screen.height / fit.height), fit.min, fit.max) * zoom) {
        // Bar/Modules/SystemMonitorPopup.qml: `Color.withAlpha(Theme.surface,
        // 0.85)`, `borderWidth: 0`, radius 0 — a dashboard of the journal, not
        // of the CPU: the title, the journal's state beside it, three figures
        // (log lines, errors, services) and the last few entries with a time, a
        // unit and a message.
        size: 1040 * scale, 610 * scale

        group {
            move: 0, (1 - lift) * 610 * scale

            body {
                color: coal
                opacity: 85%

                box { from: 0, 0; size: 1040 * scale, 610 * scale; corner: 0; opacity: 0% }
            }

            // ----***---------------------------- header
            text "System Dashboard" { at: 14, 20; anchor: left center; family: "Iosevka"; size: 17; weight: 700; color: skin.ink }
            ellipse { at: 930, 20; radius: 5; color: pick(journal_ok, #00F5D4, ink.off) }
            text "Journal" { at: 942, 20; anchor: left center; family: "Iosevka"; size: 13; color: skin.ink.dim }

            box { from: 14, 36; size: 1012, 1; color: skin.ink; opacity: ink.subtle }

            // ----***-------------------------- figures
            // Three cards of equal width, the value above the label, as the
            // reference lays them out (value at medium, label at small).
            group { move: 14, 46
                body {
                    color: skin.surface
                    opacity: 40%
                    box { from: 0, 0; size: 330, 56; corner: 6 }
                }
                text sys.logs { at: 16, 22; anchor: left center; family: "Iosevka"; size: 19; weight: 700; color: skin.ink }
                text "Log Lines" { at: 16, 42; anchor: left center; family: "Iosevka"; size: 13; color: skin.ink.dim }
            }
            group { move: 356, 46
                body {
                    color: skin.surface
                    opacity: 40%
                    box { from: 0, 0; size: 330, 56; corner: 6 }
                }
                text sys.errors { at: 16, 22; anchor: left center; family: "Iosevka"; size: 19; weight: 700; color: warn }
                text "Errors" { at: 16, 42; anchor: left center; family: "Iosevka"; size: 13; color: skin.ink.dim }
            }
            group { move: 698, 46
                body {
                    color: skin.surface
                    opacity: 40%
                    box { from: 0, 0; size: 330, 56; corner: 6 }
                }
                text sys.services { at: 16, 22; anchor: left center; family: "Iosevka"; size: 19; weight: 700; color: skin.ink }
                text "Services" { at: 16, 42; anchor: left center; family: "Iosevka"; size: 13; color: skin.ink.dim }
            }

            // ----***----------------------- recent logs
            text "Recent Logs" { at: 14, 128; anchor: left center; family: "Iosevka"; size: 17; weight: 700; color: skin.ink }

            // The table's head, then a row per entry: time, unit, message.
            text "Time" { at: 20, 150; anchor: left center; family: "Iosevka"; size: 12; color: ink.off }
            text "Service" { at: 90, 150; anchor: left center; family: "Iosevka"; size: 12; color: ink.off }
            text "Message" { at: 250, 150; anchor: left center; family: "Iosevka"; size: 12; color: ink.off }

            for e in journal {
                text e.time { at: 20, 168 + e.index * 20; anchor: left center; family: "Iosevka"; size: 13; color: skin.ink.dim }
                text e.service { at: 90, 168 + e.index * 20; anchor: left center; width: 152; lines: 1; family: "Iosevka"; size: 13; color: skin.ink.dim }
                text e.msg { at: 250, 168 + e.index * 20; anchor: left center; width: 770; lines: 1; family: "Iosevka"; size: 13; color: skin.ink }
            }

            // Two states, not one: the worker answers a second or two after the drawer opens, and
            // "no entries" is a claim about the world, not a loading label — `sys.have` is what
            // tells them apart.
            text "reading the journal…" { at: 380, 200; anchor: center; family: "Iosevka"; size: 11; color: ink.off
                show: journal.total == 0 and not sys.have }
            text "no journal entries in the last day" { at: 380, 200; anchor: center; family: "Iosevka"; size: 11; color: ink.off
                show: journal.total == 0 and sys.have }

            // ----***--------------------------- history
            // The worker samples while the drawer is open; panels.luau keeps the last 60
            // records. Four series share the same 0..100 % scale, so the chart is a
            // comparison, not four separate sparklines. GPU and temperature appear only
            // when the worker has a real reading for them.
            let hist.x = 14
            let hist.y = 388
            let hist.w = 876
            let hist.h = 176
            let hist.pitch = hist.w / max(sys_hist.total, 1)
            text "History" { at: 14, 350; anchor: left center; family: "Iosevka"; size: 17; weight: 700; color: skin.ink }
            text "last 60 s" { at: 92, 350; anchor: left center; family: "Iosevka"; size: 12; color: ink.off }
            box { from: 14, 367; size: 8, 8; corner: 4; color: skin.accent }
            text "CPU" { at: 28, 371; anchor: left center; family: "Iosevka"; size: 12; color: skin.ink.dim }
            box { from: 76, 367; size: 8, 8; corner: 4; color: amber }
            text "RAM" { at: 90, 371; anchor: left center; family: "Iosevka"; size: 12; color: skin.ink.dim }
            box { from: 138, 367; size: 8, 8; corner: 4; color: highlight; show: sysmon_gpu == 1 }
            text "GPU" { at: 152, 371; anchor: left center; family: "Iosevka"; size: 12; color: skin.ink.dim; show: sysmon_gpu == 1 }
            box { from: 200, 367; size: 8, 8; corner: 4; color: warn; show: sysmon_temp == 1 }
            text "TEMP" { at: 214, 371; anchor: left center; family: "Iosevka"; size: 12; color: skin.ink.dim; show: sysmon_temp == 1 }

            repeat g in 0..3 {
                box { from: hist.x, hist.y + hist.h - g * hist.h / 3; size: hist.w, 1; color: skin.ink; opacity: 12% }
            }
            text "100 %" { at: hist.x + hist.w - 2, hist.y - 8; anchor: right center; family: "Iosevka"; size: 10; color: ink.off }
            text "0 %" { at: hist.x + hist.w - 2, hist.y + hist.h - 8; anchor: right center; family: "Iosevka"; size: 10; color: ink.off }

            for h in sys_hist {
                box { from: hist.x + h.index * hist.pitch, hist.y + hist.h - h.cpu * hist.h
                    size: max(hist.pitch, 1), 1.5; color: skin.accent; opacity: 85% }
                box { from: hist.x + h.index * hist.pitch, hist.y + hist.h - h.ram * hist.h
                    size: max(hist.pitch, 1), 1.5; color: amber; opacity: 85% }
                box { from: hist.x + h.index * hist.pitch, hist.y + hist.h - h.gpu * hist.h
                    size: max(hist.pitch, 1), 1.5; color: highlight; opacity: 75%; show: sysmon_gpu == 1 }
                box { from: hist.x + h.index * hist.pitch, hist.y + hist.h - h.temp * hist.h
                    size: max(hist.pitch, 1), 1.5; color: warn; opacity: 75%; show: sysmon_temp == 1 }
            }
            text "waiting for samples…" { at: hist.x + hist.w / 2, hist.y + hist.h / 2; anchor: center
                family: "Iosevka"; size: 11; color: ink.off; show: sys_hist.total == 0 }
            text "1 sample / s · 60 s window" { at: 14, 584; anchor: left center; family: "Iosevka"; size: 10; color: ink.off }
        }
    }

    SystemDrawer() { show: drawer == system }
}
