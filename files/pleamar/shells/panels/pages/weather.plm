// pages/weather.plm — the weather drawer (`drawer == weather`).
//
// Current conditions and a short daily forecast from the pleamar-weather
// worker (Open-Meteo + wttr.in fallback; scripts/helpers/README.md): the
// worker reports numbers and WMO codes, panels.luau turns them into the
// formatted live texts this part draws (`weather.temp`, `weather.cond`,
// `weather.wind`, `weather.humidity`, `weather.pressure`, `weather.city`) and
// fills `forecast` with one record per day. Nothing here is invented: with no
// worker or a failed fetch the texts say "--" and `weather.err` explains.
//
// The card hangs centred above the bar, like the legacy weather popup
// (WeatherButton.qml anchors it to the bar's centre with panelModuleHeight + 4).

part Weather {
    component WeatherDrawer(scale: number = ui * clamp(min(screen.width / design.width, screen.height / design.height), fit.min, fit.max) * zoom) {
        size: 300 * scale, 196 * scale

        group {
            move: 4, 4 + (1 - lift) * (196 + 4) * scale

            // ----***----------------------------- the card
            // Widgets/SidePanel/Weather.qml: `Color.withAlpha(Theme.surface, 0.85)`,
            // `borderWidth: 0`, `radius: 0`, and one 1 px line of the accent at
            // 0.25 across the top edge.
            Capsule(300, 196, fill: coal, alpha: 85%, radius: 0, scale: scale)
            box { from: 0, 0; size: 300, 1; color: accent; opacity: 25% }

            // ----***--------------------- current conditions
            text weather.city { at: 14, 16; anchor: left center; width: 200; lines: 1; family: "Iosevka"; weight: 700; size: 12; color: ink }
            text weather.temp { at: 14, 50; anchor: left center; family: "Iosevka"; size: 32; weight: 700; color: ink }
            text weather.unit { at: 84, 54; anchor: left center; family: "Iosevka"; size: 14; color: ink.dim }
            text weather.cond { at: 124, 50; anchor: left center; width: 162; lines: 2; family: "Iosevka"; size: 12; color: ink.dim }

            // ----***-------------------------- metrics
            text weather.wind { at: 14, 82; anchor: left center; family: "Iosevka"; size: 10; color: ink.dim }
            text weather.humidity { at: 112, 82; anchor: left center; family: "Iosevka"; size: 10; color: ink.dim }
            text weather.pressure { at: 208, 82; anchor: left center; family: "Iosevka"; size: 10; color: ink.dim }

            box { from: 14, 96; size: 272, 1; color: ink; opacity: ink.subtle }

            // ----***--------------------------- forecast
            // One column per day, nothing stacked on anything: the day above,
            // the high and the low under it, 54 wide each.
            row days { at: 14, 108; gap: 0
                for f in forecast {
                    group {
                        size: 54, 62
                        text f.day { at: 27, 8; anchor: center; family: "Iosevka"; size: 10; color: ink.dim }
                        text f.hi { at: 27, 26; anchor: center; family: "Iosevka"; size: 12; weight: 700; color: ink }
                        text f.lo { at: 27, 44; anchor: center; family: "Iosevka"; size: 10; color: ink.off }
                    }
                }
            }

            text weather.err { at: 150, 186; anchor: center; family: "Iosevka"; size: 10; color: warn }
        }
    }

    WeatherDrawer() { show: drawer == weather }
}
