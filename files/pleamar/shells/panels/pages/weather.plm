// pages/weather.plm — the weather drawer (`drawer == weather`).
//
// Current conditions and a short daily forecast from the pleamar-weather
// worker (Open-Meteo + wttr.in fallback; scripts/helpers/README.md): the
// worker reports numbers and WMO codes, panels.luau turns them into the
// formatted live texts this part draws (`weather.temp`, `weather.cond`,
// `weather.wind`, `weather.humidity`, `weather.pressure`, `weather.city`) and
// fills `forecast` with one record per day. Nothing here is invented: with no
// worker or a failed fetch the texts say "--" and `weather.err` explains.
//
// The card hangs centred above the bar, like the legacy weather popup
// (WeatherButton.qml anchors it to the bar's centre with panelModuleHeight + 4).

part Weather {
    component WeatherDrawer(scale: number = ui * clamp(min(screen.width / design.width, screen.height / design.height), fit.min, fit.max) * zoom) {
        size: 300 * scale, 138 * scale

        group {
            move: (screen.width - 300 * scale) / 2, screen.height - (174 + bar.height + bar.gap) * scale + (1 - lift) * (174 + bar.height + bar.gap) * scale

            // ----***----------------------------- the card
            Capsule(300, 174, fill: coal, alpha: 75%, edge: 1, edge_tone: ink, edge_alpha: 10%, radius: 0, scale: scale)

            // ----***--------------------- current conditions
            text weather.city { at: 14 * scale, 16 * scale; anchor: left center; width: 150 * scale; lines: 1; family: "Iosevka"; size: 12; color: ink.dim }
            text weather.temp { at: 14 * scale, 50 * scale; anchor: left center; family: "Iosevka"; size: 32; weight: 700; color: ink }
            text pick(use_fahrenheit, "°F", "°C") { at: 84 * scale, 52 * scale; anchor: left center; family: "Iosevka"; size: 16; color: ink.dim }
            text weather.cond { at: 120 * scale, 40 * scale; anchor: left center; width: 166 * scale; lines: 2; family: "Iosevka"; size: 12; color: ink }

            text weather.wind { at: 14 * scale, 76 * scale; anchor: left center; family: "Iosevka"; size: 12; color: ink.dim }
            text weather.humidity { at: 112 * scale, 76 * scale; anchor: left center; family: "Iosevka"; size: 12; color: ink.dim }
            text weather.pressure { at: 208 * scale, 76 * scale; anchor: left center; family: "Iosevka"; size: 12; color: ink.dim }

            // ----***--------------------------- forecast
            row days { at: 14 * scale, 90 * scale; gap: 6 * scale
                for f in forecast {
                    group {
                        size: 48 * scale, 30 * scale
                        text f.day { at: 24 * scale, 10 * scale; anchor: center; family: "Iosevka"; size: 12; color: ink.dim }
                        text f.cond { at: 24 * scale, 28 * scale; anchor: center; width: 46 * scale; lines: 2; family: "Iosevka"; size: 9 * text_scale * scale; color: ink }
                        text f.hi { at: 24 * scale, 14 * scale; anchor: center; family: "Iosevka"; size: 12; color: ink }
                        text f.lo { at: 24 * scale, 26 * scale; anchor: center; family: "Iosevka"; size: 12; color: ink.off }
                    }
                }
            }

            text weather.err { at: 150 * scale, 165 * scale; anchor: center; family: "Iosevka"; size: 12; color: warn }
        }
    }

    WeatherDrawer() { show: drawer == weather }
}
