language 0.4

import "../../lib/palette.plm"
import "../../lib/palette-live.plm"
// The live.accent the album art gives (rewritten by the bar on every track change). The media card
// tints its analyser and scrub line with it, the way Music.qml takes
// `MusicManager.accentColor` over the wallpaper palette.
import "../../art.plm" as artacc
import "../../lib/capsule.plm"
import "../../lib/controls.plm"
import "../../lib/plugins/cover/cover.plm" as Cover
import "../../lib/plugins/meta/meta.plm" as Meta
import "../../lib/plugins/spectrum/spectrum.plm" as spec
import "../../lib/plugins/build/build.plm" as build
import "../../lib/sun.plm" as sun
// The calendar drawer marks the days the pill was taken, was missed, is still pending or has no
// record of. The history comes from the `pleamar-calendar` worker, which reads the tracker's own
// state file: a scene's logic cannot read a plugin's boundary (that is the plugin's alone), so the
// calendar is fed the same way its events and holidays are.
// whenever it moves — a rule cannot hear a model change, and `today` is a text, not a fact.

// panels.plm — the drawer surface of the shell (scene `panels`, PH2-B slice 1).
//
// One overlay surface per monitor, no exclusive zone, opening the drawers that
// hang from the bottom-anchored bar: the bar keeps its reserve, this surface
// reserves nothing and draws the drawers upward from the bar's top edge.
// The drawers themselves are parts under pages/, which the scene imports for;
// a part has no name of its own and is not checked alone (INTERFACES.md §1.3).
// The drawers: volume, network, media (the now-playing card the bar's cover
// opens), calendar, weather, build, system, theme and shell — one part each under
// pages/. The `drawer` fact names exactly those and nothing else: a name with no
// page behind it is a press that opens an empty window. `theme` lists the theme
// files under ~/.config/pleamar/themes and applies one (`pleamar-themes`,
// packages/pleamar-theme), which rewrites theme.plm the way a wallpaper change
// does. `shell` is the settings page: the values of the JSON described below
// (scale, type scale, the closing rules, Fahrenheit, the weather city and the
// holiday country) and the light theme's paper warmth, changed live and written
// back with `files.write` — the file stays the one place the defaults live.
//
// Opening and closing
// -------------------
//   `pleamar --say panels "fact drawer calendar"`      interface, one at a time
//   `pleamar --say panels "fact drawer none"`          close
//   `pleamar --say panels "emit open_calendar"`        bind-friendly events, below
//   `pleamar --say panels "emit close_drawer"`
// Escape and an outside press close the open drawer; the outside catcher is the
// scene's full-monitor zone, declared before every part so each drawer's zones
// sit above it (a press inside a drawer never reaches the catcher).
//
// Settings (`~/.local/share/pleamar/panels/settings.json`, read and watched by panels.luau)
// -------------------------------------------------------------------------------
//   closeOnEscape     bool    true    Escape closes the open drawer
//   closeOnOutside    bool    true    a press outside the drawer closes it
//   scale             number  1.0     0.5 – 2.0, user multiplier on top of `ui` and the fit
//   fontScale         number  1.0     0.5 – 2.0, multiplies type.* sizes (the QS fontSizeMultiplier)
//   weatherCity       text    "Saint Petersburg"  empty: let the helper fall back to its env
//   useFahrenheit     bool    false   weather temperatures in °F instead of °C
//   calendarCountry   text    ""      ISO country for public holidays, empty: none
// The scene only reads and clamps these: nothing here writes the file, it is
// edited by hand (and by whatever a provisioning script wants). Reads keep the
// parsed table and mutate it, so keys another version put there survive a save.
//
// Helper workers (INTERFACES.md §7; installed into PATH as pleamar-<name>)
// ------***--------------------------------
//   pleamar-sysmon    while `system` is open    topic sysmon, one sample per second
//   pleamar-weather   while `weather` is open   topic weather, refreshed every five minutes
//   pleamar-calendar  while `calendar` is open  topic calendar, one month + navigation
// They are started, subscribed and killed by panels.luau; a missing worker leaves
// the drawer in its documented "not available" state (`sysmon.err`, `weather.err`,
// `cal.err`), never with made-up data. The handshake's `version` must be 1 (an
// unknown one is killed and reported), month navigation travels as
// `{"cmd":"sample","month":…}`, and the deprecated draft sample shape with no
// handshake is still accepted for one release of the workers.
//
// The scale model (INTERFACES.md §3.2)
// ------------------------------------
// scaleNow = ui * clamp(min(screen.width / design.width, screen.height / fit.height),
//                       fit.min, fit.max) * zoom
// It is never a loose `let`/`prop`/`fact`: every drawer component carries it as
// the default of its own `scale` parameter, so each monitor copy reads its own
// `screen.*` at the use site. Everything else is a design length times `scale`,
// and every text size additionally times the `text_scale` fact (fontScale).

scene panels {

    // The live palette (lib/palette-live.plm): the theme handed over as facts, so a
    // new theme repaints this scene without a reload. panels.luau reads them out of the
    // scene's own `palette.json` (`pleamar-themes push` writes it, and every apply
    // and wallpaper run calls that); the defaults are the repository's theme.plm,
    // so the first frame before that read looks as it always did.
    fact pal_coal_r = 0.0000
    fact pal_coal_g = 0.0000
    fact pal_coal_b = 0.0000
    fact pal_surface_r = 0.1412
    fact pal_surface_g = 0.1647
    fact pal_surface_b = 0.2078
    fact pal_ink_r = 0.7961
    fact pal_ink_g = 0.8392
    fact pal_ink_b = 0.8980
    fact pal_ink_dim_r = 0.6824
    fact pal_ink_dim_g = 0.7255
    fact pal_ink_dim_b = 0.7843
    fact pal_accent_r = 0.0000
    fact pal_accent_g = 0.4353
    fact pal_accent_b = 0.8000
    fact pal_on_accent_r = 1.0000
    fact pal_on_accent_g = 1.0000
    fact pal_on_accent_b = 1.0000
    fact pal_light = 0
    // The light theme's warmth, for the drawer's slider: 0 is 2700 K (warm), 1 is
    // 6500 K (neutral). `pleamar-themes warm` takes kelvin and rebuilds the paper.
    fact warm = 0.4211

    // The fit divisor is the work area, not the monitor. Inside a scene `screen.height` is
    // what the surfaces get (1080 minus the bar's 25 px reserve = 1055 here), while palette's
    // `design.height` is the monitor's 1080 — so the stock expression shaved the scale to
    // 1.15 * 1030/1080 = 1.0968 and every drawer came out 4.5 % smaller than the
    // reference's. Measured on 2026-10-23: the flow plate drew 515 x 371 where the popup is
    // 540 x 389, and the 26 transparent pixels left over on the right were the surface
    // showing through. `fit.height` is the work area the drawers are fitted to, named so it
    // does not shadow the palette token (the compiler says why: a `screens: each` scene may
    // take one or the other per copy).
    let fit.height = 1055

    // The drawer surface: full monitor, anchored top (geometry origin), overlay
    // level, reserve 0 so the bar's exclusive zone is the bar's alone. It is
    // there exactly while a drawer is open; the `lift` spring below is what the
    // drawers slide in with (a closed surface is not seen and cannot be pressed,
    // so the close is immediate and the slide-out is not drawn).
    // keyboard: exclusive while the surface exists (drawer != none): Escape must
    // reach the open drawer without a click first, and a modal drawer is the one
    // moment the shell may hold the keyboard. Compositor-level binds still fire.
    // An open surface that draws nothing is not free, and what it costs is frames: the catcher
    // below was mapped for the life of the session, so a 3840x2110 layer with an empty draw was
    // blitted at the screen's 240 Hz for a scene with nothing on screen (measured 2026-10-27,
    // same drawers opened and closed in both runs: 2423 frames in 10 s and 2 % of a core before,
    // 305 and 0 % after; the memory did not move — 79.8 MiB against 78.3 — because a closed
    // sheet keeps its buffers either way). So the catcher is up exactly while a drawer is, and
    // what keeps the scene alive with every surface closed is the one-pixel keeper under it: a
    // scene whose last surface closes exits a second or so later, and then
    // `pleamar --say panels "fact drawer media"` would have to land in the handful of
    // milliseconds between the end of the load and that exit.
    // A surface per drawer, sized exactly to the card it draws — the reference's
    // shape (one window per popup), and the only arrangement where the glass
    // edge falls on the card's own boundary: drawn inside one big layer,
    // Hyprland's blur leaves a visible seam around the plate.
    // The keeper: one pixel, no body, no input — the scene's reason to stay loaded while no
    // drawer is open. Behind everything, so it is never in the way. What it costs is the pace
    // declared on the catcher below, not a rate of its own: `rate:` is the scene's, and the
    // surface that drives the pace only decides which frames are asked for.
    surface keeper { size: 1, 1; anchor: top_left; level: background; reserve: 0; screens: each }

    // The unnamed full-monitor surface is the catcher — the press outside that
    // dismisses the drawer. It paints nothing, so it is up only while it has something to
    // catch; a closed surface takes no press (the engine empties its input region).
    // `rate:` is the scene's own pace, so the idle rate lives here: 15 frames a second while no
    // drawer is open (nothing of this scene is on screen) and the monitor's the moment one is.
    // Without it the scene kept asking for the screen's 240 Hz to draw nothing. The pace is also
    // how long a `fact drawer …` waits before it is drawn: 1 fps took 1.4 s (measured), 15 fps is
    // 67 ms, and since 2026-11-02 the 0.57 compositor pays ~3 ms of CPU per presented frame at 4K,
    // so the idle rounds are where a core went (`bar.plm`'s rate note has the A/B).
    surface { size: full, full; anchor: top; level: overlay; reserve: 0; screens: each
              keyboard: on_demand; open: drawer != none; rate: 240, 10 while drawer == none }

    // The panel rectangles are the reference's own numbers, read from its popups and
    // not eyeballed. The units matter and cost a round: a surface's `size:`/`margin:`
    // are LITERAL logical pixels (bar.plm says the same in its own header — its surface
    // height is spelled out as 25, the scaled value of QS' 22), while what a page draws
    // inside is design pixels times its `scale`. Since `palette.plm` sets `ui = 1` (not the
    // reference's 1.15), a page draws at exactly its design size and a surface has to say that
    // same number: the five plates that still carried `design * 1.15` left a 15 % band of empty
    // window on the right and bottom, and the weather card's own label sat below its plate.
    // (`media` and `build` were already equal; the rest now are.)
    //
    // What each popup anchors with — top, right, bottom, left:
    //   media    420 x 320   right 4 (sidePanelPopupOuterMargin), bottom 1
    //   network  470 x 338   left 4 (max with the capsule's x), bottom 36
    //   volume   340 x 320   no popup in the reference; aligned with media
    //   weather  300 x 196   centred across the monitor, bottom 40
    //                        ((panelModuleHeight 36 + 4) * scale)
    //   system  1040 x 610  the reference popup is min(1040, 0.92 W) x max(480, H - 60); the page's
    //                        own content sits on the 1040-wide grid (its divider runs 14…1026, the
    //                        third card starts at 698), so the plate is 1040 wide. The height is
    //                        the page's own: its last line is at 584, and the 887 it used to carry
    //                        (the reference's 1020 minus a little) left a third of the card empty
    //                        under the dashboard — 610 is that content plus a 26 px bottom margin
    //   calendar 380 x 500   left 2, bottom 2 (calendarPopupMargin); the QS popup is 480 and
    //                        grows to 520 with the pill overlay on — the streak row takes 20 here
    // Radius is 0 everywhere: panelOverlayRadius and cornerRadiusLarge are both
    // 0 in the reference theme, so a plate is a plain rectangle.

    // The cards are placed on the screen, not on the surface: a surface's `size:`
    // takes a literal and never follows `zoom`, so a card declared at its design
    // size clipped as soon as the shell was scaled (the calendar already had a
    // `surface.h` band-aid for the `ui` 1.15 case). A full-monitor surface with the
    // card put at its own corner costs nothing: the input region lets the click
    // through the empty part (reference, "A surface does not grow with what it
    // draws"). Each page places its card in `screen` coordinates.
    surface media_card { size: full, full
                         level: overlay; reserve: 0; screens: each; keyboard: on_demand
                         open: drawer == media
        include "pages/media.plm"
    }
    surface network_card { size: full, full
                           level: overlay; reserve: 0; screens: each; keyboard: on_demand
                           open: drawer == network
        include "pages/network.plm"
    }
    surface volume_card { size: full, full
                          level: overlay; reserve: 0; screens: each; keyboard: on_demand
                          open: drawer == volume
        include "pages/volume.plm"
    }
    surface theme_card { size: full, full
                         level: overlay; reserve: 0; screens: each; keyboard: on_demand
                         open: drawer == theme
        include "pages/theme.plm"
    }
    surface shell_card { size: full, full
                         level: overlay; reserve: 0; screens: each; keyboard: on_demand
                         open: drawer == shell
        include "pages/shell.plm"
    }
    surface weather_card { size: full, full
                           level: overlay; reserve: 0; screens: each; keyboard: on_demand
                           open: drawer == weather
        include "pages/weather.plm"
    }
    surface build_card { size: full, full
                         level: overlay; reserve: 0; screens: each; keyboard: on_demand
                         open: drawer == build
        include "pages/build.plm"
    }
    surface system_card { size: full, full
                          level: overlay; reserve: 0; screens: each; keyboard: on_demand
                          open: drawer == system
        include "pages/system.plm"
    }
    surface calendar_card { size: full, full
                            level: overlay; reserve: 0; screens: each; keyboard: on_demand
                            open: drawer == calendar
        include "pages/calendar.plm"
    }

    // The session menu is a modal opened by a key bind, so it asks for the keyboard
    // itself: Escape must close it without a click first (a surface with no field of
    // its own gets the keys, and its rules see Escape).
    surface power_card { size: full, full
                         level: overlay; reserve: 0; screens: each
                         keyboard: exclusive while drawer == power
                         open: drawer == power
        include "pages/power.plm"
    }

    surface bluetooth_card { size: full, full
                             level: overlay; reserve: 0; screens: each; keyboard: on_demand
                             open: drawer == bluetooth
        include "pages/bluetooth.plm"
    }

    surface toggles_card { size: full, full
                           level: overlay; reserve: 0; screens: each; keyboard: on_demand
                           open: drawer == toggles
        include "pages/toggles.plm"
    }
    surface keys_card { size: full, full
                        level: overlay; reserve: 0; screens: each
                        keyboard: exclusive while drawer == keys
                        open: drawer == keys
        include "pages/keys.plm"
    }
    surface notes_card { size: full, full
                         level: overlay; reserve: 0; screens: each
                         keyboard: exclusive while drawer == notes
                         open: drawer == notes
        include "pages/notes.plm"
    }
    surface timer_card { size: full, full
                         level: overlay; reserve: 0; screens: each; keyboard: on_demand
                         open: drawer == timer
        include "pages/timer.plm"
    }

    // Commands the logic runs (workers), services it listens to (audio, own
    // settings file) and commands it sends (audio.*). `ip` and `ping` are the connection's
    // own two probes while the network drawer is open — the same commands QS's
    // Connectivity.qml runs.
    // `wl-copy` is the reference's clipboard copy of the journal's problems (SystemMonitorPopup.qml:17-40
    // runs it every time the dashboard opens, so a paste into a chat carries the lines).
    permissions { run: "pleamar-sysmon", "pleamar-weather", "pleamar-calendar", "pleamar-journal", "pleamar-themes", "flow", "ip", "ping", "pleamar", "wl-copy", "systemctl", "hyprctl", "notify-send"
                  services: "audio", "audio.*", "files", "files.write", "media", "media.*", "session.*", "bluetooth", "bluetooth.*", "network.*", "say:notifications", "clock" }

    // ----***--------------- bluetooth (the `bluetooth` drawer)
    // The adapter's state, the devices and what bluetoothd is asking, straight from the
    // service: `devices` lands in the model by field name (reference, "Lists, into a
    // model, with no logic"), so the page needs neither a worker nor a poll. The
    // commands are panels.luau's: they take the ADDRESS, and a row press carries only
    // its index, so the logic keeps its own table from the same watch.
    model bt_devices max 8 {
        name: text
        address: text
        paired: bool = false
        connected: bool = false
        battery: number = 0
        icon: image 16, 16
    }
    service bluetooth as bt {
        present: bool
        powered: bool
        discovering: bool
        pairing: none | pin | passkey | confirm | display | authorize
        pairing_id: text
        pairing_code: text
        pairing_name: text
        devices: bt_devices
    }

    // ----***--------------- the quick toggles (`toggles`)
    // The radio states come from the services the rest of the shell already trusts; the Wi-Fi
    // switch commands `network.wifi`, the Bluetooth one `bluetooth.power`, and do-not-disturb is
    // the notifications scene's own fact, read back through `--say` and set through it.
    service network as net { wifi: bool; online: bool; name: text }
    fact dnd = false

    // ----***--------------- the key binds (`keys`)
    // Filled by panels.luau from `hyprctl binds -j` when the drawer opens and re-filtered as the
    // field changes; the scene draws what the compositor reported, not a table that can drift.
    model key_rows max 12 { combo: text; action: text; submap: text; has_submap: bool }
    text key_query = ""

    // ----***--------------- the notes (`notes`)
    model notes max 9 { body: text; at: text }
    text note_input = ""

    // ----***--------------- the timer (`timer`)
    fact timer_running = false
    fact timer_seconds = 0
    text timer_text = "0:00"

    // ----***--------------- drawer state and settings
    fact drawer: none | volume | network | media | calendar | weather | build | system | theme | shell | power | bluetooth | toggles | keys | notes | timer = none
    // The socket takes the enum's value names (`--say panels "fact drawer weather"`), which is how
    // the bar opens a drawer; a separate numeric mirror was declared here and never written, and
    // its only reader opened the media card without the catcher, so the card could not be closed.
    fact close_on_escape = true
    fact close_on_outside = true
    fact zoom = 1
    fact text_scale = 1
    fact use_fahrenheit = false

    // Calendar UI state (the grid and title are panels.luau's, the selection is a rule's).
    fact sel_day = 0
    fact cal_year = 0
    fact cal_month = 0
    // The pill tracker's streak, as a number the page can test; the words it draws
    // ("5 days" — a text, because words are not facts) are in `cal.streak` below.
    fact cal_streak = 0

    // The media card's position, kept by the logic (`media_apply` + `every(1000)` in panels.luau):
    // the service reports `media.position` only when the player says something, so the progress
    // line reads this and moves under a playing track.
    fact media.pos = 0

    // Worker state, read by the drawers.
    fact sysmon_online = 0
    // Whether the sample has a real temperature reading; the history hides that series rather than
    // drawing a flat line at zero. There is no GPU flag: the worker's `gpu_busy_percent` reads
    // 99-100 % while the card is idle, so the metric is out of the dashboard.
    fact sysmon_temp = 0
    // The flow dashboard: whether there is traffic right now. The curve itself needs no fact — the
    // model carries the values already normalised by the window's peak (panels.luau keeps the ring).
    fact net_live = false
    fact weather_ok = 0
    // The card is not left blank while the worker answers (Weather.qml shows a spinner and "--°C"):
    // `loading` is on from the drawer's open until the first sample or its failure, `have` says a
    // sample has ever landed (so a placeholder is not painted over real values), and `code` is the
    // WMO number the watermark and the icon pick from.
    fact weather.loading = false
    fact weather.have = false
    fact weather.code = 2
    // The wind's angle in degrees, like the reference's `windRotation`: the card turns its arrow.
    fact weather.dir = 0
    // The moon, as the reference's details row shows it (`moonName` + `moonIllumination`).
    fact weather.moonpct = 0
    // The phase itself, 0 = new, 0.5 = full, 1 = new again: the terminator the moon's own shader
    // draws. The same number the bar's capsule carries, computed once by the logic.
    fact weather.moonphase = 0

    // QS draws the moon with a Canvas (`Components/MoonPhaseIcon.qml`: the terminator plus a 4x4
    // Bayer stipple along it); this is that, in one fragment. The bar's capsule draws the same
    // file, and the copy here is deliberate: the deployed tree links `shells/<scene>/` as a whole
    // and `lib/` file by file (`modules/user/nix-maid/gui/pleamar.nix`), so a shader shared
    // through `lib/` would only reach the live tree at the next switch.
    shader moon_face = file "shaders/moon.wgsl"
    // The theme drawer's page, for the light theme (shaders/paper.wgsl).
    shader paper_sheet = file "shaders/paper.wgsl"

    // The shared slide: every drawer leaves and arrives with the same motion.
    // A loose prop in a `screens: each` scene is shared by the copies on purpose:
    // the drawer is one thing on every monitor, not one per monitor.
    // The reference's own number: `panelAnimStdMs` is 280 ms with `InExpo` on the way in and
    // `OutExpo` on the way out (`Settings/Theme.qml:717,917,918`), and `NumberStdIn/StdOutBehavior`
    // are nothing but those two presets. It used to run at 120 ms (`ui.quick`), which read as the
    // click being instant; a spring said in time (`~280ms`) is that 280 ms without bouncing, and
    // it keeps its speed if something interrupts it.
    prop lift = 0 ~280ms
    follow lift = if(drawer == none, 0, 1)

    // ----***--------------------- entry points
    event open_volume
    event open_calendar
    event open_weather
    event open_build
    event open_system
    event open_media
    event open_network
    event open_theme
    // A row of the theme card was pressed: its index in `model.themes` (an event
    // payload is a number, so the logic keeps the paths).
    event theme_apply ->
    // The warmth slider: 0 warm (2700 K) to 1 neutral (6500 K).
    event theme_warm ->
    // The shell page's controls: 0..1 for the two scales, bare events for the
    // switches (the logic flips the fact and writes settings.json).
    event open_shell
    event shell_zoom ->
    event shell_type ->
    event shell_toggle_escape ->
    event shell_toggle_outside ->
    event shell_toggle_fahrenheit ->

    // A press or a drag on the media card's progress band: how far along the track, 0..1.
    event seek ->
    event close_drawer
    // The session menu's five actions (pages/power.plm). panels.luau runs them; the
    // two destructive ones are hold-only in the page and `agent: no`.
    event power_lock ->
    event power_suspend ->
    event power_logout ->
    event power_reboot ->
    event power_poweroff ->
    // The Bluetooth drawer: the adapter, a scan, a device by its row index, a paired
    // device to forget, and the answer to a pairing prompt.
    event bt_power ->
    event bt_scan ->
    event bt_device ->
    event bt_forget ->
    event bt_confirm ->
    // The toggles', the notes' and the timer's own actions.
    event toggle_wifi ->
    event toggle_bt ->
    event toggle_dnd ->
    event note_add ->
    event note_delete ->
    event timer_add ->
    event timer_toggle ->
    event timer_reset ->
    event bt_cancel ->

    // Calendar navigation (panels.luau re-asks the worker for the month).
    event cal_prev ->
    event cal_next ->
    // The arrow keys in the grid, in days: -1 and 1 walk a day, -7 and 7 a week. The logic moves
    // the month when the walk leaves it.
    event cal_step ->
    // The pill tracker published (a toggle, a rollover, the state file written by another
    // instance): the grid's markers and the streak header are rebuilt from it. Nothing in this
    // scene can see the tracker — it is another scene's plugin — so the bar's logic sends this over
    // `sys.call("say", "panels", "emit pill_sync")` when its `pill.*` mirror moves, and
    // `pleamar --say panels "emit pill_sync"` does the same by hand. `->` makes it reach
    // panels.luau; the handler rebuilds the grid from the last worker sample.
    event pill_sync ->

    // Mixer (the logic carries them to sys.call("audio.…")).
    event set_out ->
    event set_in ->
    event toggle_out ->
    event toggle_in ->
    event set_default_out ->
    event set_default_in ->
    event app_set ->
    event app_mute ->

    // ----***----------------------- live texts
    text sysmon.err = ""
    text theme.err = ""
    text theme.warm = "4300 K"
    text city = ""
    text country = ""
    text weather.city = ""
    text weather.temp = ""
    // Published together with the value, not read from the flag at draw time:
    // the label and the number could then disagree (the number is converted
    // when the sample arrives, the label was picked per frame).
    text weather.unit = "°C"

    // The system dashboard's figures (SystemMonitorPopup.qml: Log Lines,
    // Errors, Services) and its last few journal entries.
    fact journal_ok = false
    // Whether a snapshot has landed at all: the page says "reading the journal…" until it has,
    // so an opened dashboard does not announce that there are no entries while the worker is
    // still answering (the first one takes a second or two).
    fact sys.have = false
    text sys.logs = "--"
    text sys.errors = "--"
    text sys.services = "--"
    model journal max 8 { time: text; service: text; msg: text }
    text weather.cond = ""
    // The Material glyph of the current condition and of each forecast day
    // (`WeatherIcons.materialSymbolForCode` in the reference): a ligature the fonts draw.
    text weather.glyph = "cloud"
    text weather.moon = ""
    text weather.wind = ""
    text weather.humidity = ""
    text weather.pressure = ""
    text weather.err = ""
    text cal.title = ""
    text cal.err = ""
    text cal.today = ""
    // The pill streak header: "1 day" / "5 days", written by panels.luau from the `streak` the
    // calendar worker reports beside the history.
    text cal.streak = ""

    // The flow dashboard (pages/network.plm): human rates as the reference's own
    // `flow` prints them, plus the peaks of the running window.
    text net.rx = "--"
    text net.tx = "--"
    text net.iface = "—"
    text net.peak_rx = "--"
    text net.peak_tx = "--"
    // Why the dashboard has no numbers, when it has none for a reason.
    text net.err = ""
    // Axis labels for the chart: the reference prints the top of the scale and
    // its thirds on the right of the plot, compact (`1.2K`, `3.4M`).
    text net.ax1 = ""
    text net.ax2 = ""
    text net.ax3 = ""
    // The connection's own two questions, as QS asks them (Services/Connectivity.qml): is there
    // a link (an interface up) and is there internet (a ping, every 30 s). The reference's
    // drawer has neither — it draws the stream — but the words it uses for the state are its
    // own (NetClusterCapsule.qml:231-235), and `state` is that sentence with the tunnel's name
    // on the end when one is up. panels.luau probes them while this drawer is open.
    fact net.link = false
    fact net.internet = false
    text net.state = ""

    // ----***---- models filled by panels.luau (columns the drawers draw)
    model forecast max 5 { day: text; cond: text; glyph: text; hi: text; lo: text }
    // One record per segment of the curve, oldest first: `t0`/`t1` run 0..1 across the window and
    // `rx`/`tx` are shares of that window's own peak, so the card draws a line and touches no
    // arithmetic but the plot's rectangle. `panels.luau` publishes one record per sample the stream
    // gives (4 Hz), so 240 of them are the reference's 60 s window.
    model flow max 240 { t0: number; t1: number; rx0: number; rx1: number; tx0: number; tx1: number }
    model tiles max 8 { label: text; value: text; level: number; tone: number }
    // The system drawer's history: one record per pair of neighbour samples, oldest first, each
    // carrying the segment's two ends (the flow card's shape: a scene can loop over a model but
    // cannot build a path or remember the previous point). `t` runs over the whole 60-slot window,
    // so the curve grows in from the left. `temp_ok`: both ends had a real reading, so a missing
    // one breaks the line instead of drawing a dip. There is no GPU series — see the note above the
    // `sysmon_temp` fact: the reading cannot be trusted on this card.
    model sys_hist max 60 { t0: number; t1: number; cpu0: number; cpu1: number; ram0: number; ram1: number; temp0: number; temp1: number; temp_ok: bool }
    // `mark`: 1 a day with an event, 2 a public holiday. `pill`: 0 nothing known, 1 taken,
    // 2 missed, 3 still pending (today), 4 a past day with no record — the QS statuses.
    // `dayoff` is a day off as the production calendar has it (isdayoff.ru: a weekend, a holiday or a
    // moved day), which knows more than the weekday arithmetic does — a working Saturday is a
    // Saturday that is *not* off, and that is the whole point of the calendar. `weekend` stays as
    // the weekday's own answer for when the work calendar could not be read.
    model cells max 42 { day: number; this: bool; today: bool; weekend: bool; dayoff: number; mark: number; pill: number; label: text }
    model events max 60 { day: number; time: text; title: text; cal: text }
    model holidays max 10 { day: number; name: text }
    model streams max 8 { id: text; name: text; binary: text; title: text; volume: number; muted: bool; playing: bool }
    model sinks max 8 { id: text; name: text; default: bool }
    model sources max 8 { id: text; name: text; default: bool }
    model media_rows max 8 { glyph: text; value: text }
    model themes max 6 { idx: number; name: text; detail: text; selected: bool; accent_r: number; accent_g: number; accent_b: number }

    // ----***------------------- audio (no worker)
    // Volume, microphone and the per-stream mixers come from the service; the
    // mixer drawer stays live while it is on screen, there is nothing to start.
    service audio { volume: number; muted: bool; input: number; input_muted: bool
                    outputs: sinks; inputs: sources; apps: streams }

    // The now-playing card reads the media service directly: MPRIS already
    // carries every field the card shows. The service's `art` is the player's
    // URL (often a temp file the player exported), so the picture itself comes
    // from the cover plugin, which resolves the real album-directory file.
    // `can_seek` is the player's own answer (`CanSeek` over MPRIS): MPD says no, so the progress
    // band is a readout there and a control only where the player takes a seek.
    service media { playing: bool; title: text; artist: text; album: text
                    player: text; position: number; length: number; can_seek: bool }

    // The media card's analyser is one-sided, as in QS (`mirror = false`).
    // A plugin fact is set from a rule, never loose (spectrum.check.plm), so
    // this rides on the drawer's own opening rule.





    // ----***---------------------- close behaviour
    // The catcher lives on the scene's own surface while every drawer is a surface of its own, and
    // surfaces stack in declaration order — that, not this zone's position inside the scene, is
    // what keeps a press inside a drawer from dismissing it.
    // A drawer scene with nothing drawn stops itself after a second or two, and
    // the fact that opens a drawer would then have to land in a window of
    // milliseconds. One design pixel at 2 % keeps the scene resident without
    // being visible; the cards are the only thing the eye sees.
    box { from: 0, 0; size: 1, 1; color: live.coal; opacity: 2% }

    zone box catcher { from: 0, 0; size: screen.width, screen.height
        label: "Dismiss drawer"; role: region; show: drawer != none }
    on press catcher while close_on_outside and drawer != none { drawer = none; Spectrum.active = false }
    on key Escape while close_on_escape and drawer != none { drawer = none; Spectrum.active = false }

    on open_volume { drawer = volume }
    on open_calendar { drawer = calendar }
    on open_weather { drawer = weather }
    on open_system { drawer = system }
    on open_build { drawer = build }
    // The analyser runs only while the card that draws it is up (see spectrum.plm:
    // a plugin deciding for itself kept cava and its decay timer alive in a
    // scene with nothing on screen). `mirror = true`: the reference's band is
    // symmetric.
    // A rule cannot set a plugin fact (it compiled and did nothing); the logic
    // says it over IPC instead, the way the bar opens a drawer.
    on open_media { drawer = media }
    // One effect per rule for a plugin fact: a rule that also moves the drawer
    // dropped these silently, which is why the analyser never woke up.
    on open_network { drawer = network; Spectrum.active = false }
    on close_drawer { drawer = none; Spectrum.active = false }


}
