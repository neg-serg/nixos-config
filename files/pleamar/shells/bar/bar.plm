language 0.4

// bar.plm — the pleamar bar, first slice (PH2-A / superplan).
//
// Legacy: files/quickshell/Bar/Bar.qml asks for three layer-shell surfaces per
// monitor, all anchored to the BOTTOM edge (anchors.bottom: true), one of them
// the reserve panel whose exclusiveZone is the bar height; the port asks for
// ONE surface, anchored by the `edge` setting (bottom on trantor), reserving
// its strip while `shown` holds.
//
// Reading order, left to right, is the legacy one:
//   left row:  clock · workspaces · pill · keyboard · network · sysmon · weather
//   right row: media · MPD · sysmon · tray · mic · volume · Genelec
// This slice draws clock/date, the workspace tabs, the network capsule (left)
// and the volume capsule (right). The other modules come later; each has a
// marked extension point below.
//
// Interfaces this file follows: files/pleamar/docs/INTERFACES.md — §2 (surface,
// facts `shown`/`startup`), §3.2 (the scale), §4 (the Capsule API),
// §6 (the settings keys, merged by bar.luau), §8 (labels and roles).
//
// Two compiler facts shape the file:
//   · A surface `size:`/`reserve:` and a text `size:`/`weight:` take a LITERAL
//     number (`c.num()` in compiler.rs): `bar.height * 2` is refused by a
//     surface, and `12 * scale` inside a text would silently draw at 12. So the
//     surface height is spelled out (25), and every widget draws in DESIGN
//     PIXELS inside a `group { scale: scale }`, the group scaling once; a lib
//     Capsule is asked for `scale: 1` inside it so the group is the only
//     multiplier.
//   · A component parameter default is read at the use site (INTERFACES §4), so
//     a `scale:` default is per monitor. Call sites pass no scale; the default
//     is `ui * user_scale` — the QS `Theme.scale()` for a bar, which is where
//     the design numbers in this file come from.
//
// Parity notes (measured, not guessed). The gate is `just parity-bar DIR
// approve hide`: it shoots the live QS strip, hides quickshell, shoots the port
// over the same strip and prints mean / visible-share. It has to run OUTSIDE
// the agent's file sandbox — grim needs /dev/shm and the GPU is needed for the
// scene's dmabuf frames — which the `hub` tool does (a plain bash call fails
// with `failed to create buffer`).
//
// What the reference is, measured off its own strip (DP-2, 3840x2160 @2x; the
// bar occupies the last 50 physical rows, the gate's crop starts 20 above it):
//   · one surface 25 logical px tall, reserving 25 — QS draws panelHeight 22 at
//     Theme.scale() 1.15, and 22 * 1.15 rounds to 25;
//   · a full-width face of coal at ~84 % (rgb(12,14,16) over bright wallpaper,
//     rgb(6,7,8) over dark), no rim, no shadow;
//   · each widget on its own WidgetCapsule face: 53 % coal, radius 6, ~14
//     design px tall;
//   · left cluster order and ink spans: clock · workspace · keyboard · network ·
//     sysmon · weather.
//
// Two pleamar rules this file learned the hard way:
//   · a `box` at a NEGATIVE `from:` draws nothing at all, silently (--check is
//     happy) — a face starts at 0 and the content is inset instead;
//   · a component's `size:` is read in the CALLER's scope, so a `let` written
//     inside the component is not visible there (inline the expression); inside
//     a `group` it is.
//
// Open, in order: the tray PAINTS NOTHING. Its list arrives (four items, the
// right titles), its zones land where they should — `--say bar describe` shows
// `trayhit#Right34#r0..r3 «Vicinae» «Steam» «TelegramDesktop» «neru» at 1766,-2
// 25×29` — and a press emits `tray_press`, but neither the frame nor the picture
// inside a `for`-built component reaches the screen: first a `for` inside a
// `group`, then a record-taking component in a nested row (the idiom
// shells/notifications uses), and an opaque warning-red box the size of the slot
// painted nothing in both. What is left to try is a `for` straight in the row,
// and asking upstream. Then the left capsules' widths and the gaps between them (the
// port's keyboard capsule is visibly narrower than the reference's), the tray
// (`service tray { list }`), the weather capsule (its fetch, JSON parse, the
// km/h -> m/s conversion and the on-disk cache are written and were reverted
// only because its columns did not land where the design numbers say), and a
// `paused` field for the media capsule.
//
// Settings, merged by bar.luau from the scene's own settings.json:
//   edge          top | bottom, default bottom   — applied: the `bar_edge` fact
//                 drives `anchor:` (the fact cannot be called `edge`: that name
//                 collides with the Capsule component's own `edge` parameter)
//   scale         0.5..2.0, default 1.0          — applied: `user_scale`
//   widgets       array of text, max 24          — applied as visibility for
//                 this slice's four: clock, workspaces, network, volume
//   height        16..64, default 22             — frozen, not applied: a
//                 surface size cannot name a fact in 0.4.11 (checked:
//                 `size: full, h` is `expected a number here`)
//   fontScale, animations, startupClean,         — the features they tune are
//   monitorScale                                   later slices; not applied

import "../../lib/palette.plm"
import "../../theme.plm"
import "../../lib/capsule.plm"
import "../../lib/plugins/pill/pill.plm" as pill
import "../../lib/plugins/mpd/mpd.plm" as mpd
import "../../lib/plugins/genelec/genelec.plm" as gen
import "../../lib/plugins/spectrum/spectrum.plm" as spec
import "../../lib/plugins/cover/cover.plm" as art

scene bar {

    // ------------------------------------------------- facts the interface fixes
    // `bar_edge` is the surface anchor; `shown` gates surface and reserve (tests
    // and other tools read both). `startup` is the login gate's fact: this slice
    // leaves it false, the gate itself is a later slice.
    fact bar_edge: top | bottom = bottom
    fact shown = true
    fact startup = false
    // The gap between two capsules, QS panel.widgetSpacing 4 at the 1.35
    // interWidgetRatio: round(4 * 1.15) = 5 logical, times 1.35 rounds to 7 —
    // 6.1 design px, six here.
    // 7, not 6: the reference's plates sit at 5, 72, 158, 223 with gaps of 9 then 7,
    // and a uniform 6 left every capsule after the clock 3 logical px short.
    let row.gap = 7
    // How many of the six monitor pairs are there at all: the reference's own
    // rule (SystemMonitorCapsule._vis*), the GPU only on a machine that has
    // one, swap only above systemMonitorSwapShowThreshold. A `let` INSIDE the
    // component would not do: a component's `size:` is read in the caller's
    // scope, and there the name `shown` is the scene's own fact.
    // The tray's slot, in design px: 22 = max(CapsuleMetrics.inner 16,
    // panelHeight 22) * 1.15 rounded, which is QS's trayIconSlot. A scene-level
    // let because a component's `size:` is read in the caller's scope.
    // The seam between the halves is 8 logical px wide and slanted
    // (`BarLayout.wedgeWidthNorm` caps the wedge at the same 8): tried as a gap
    // of 7 design px between two leaning paths, and the centre of the strip got
    // WORSE (mean over 1860..1980 went 3.88 -> 6.73), so the gap as drawn does
    // not match the reference's window: on this wallpaper neither shows, and
    // what looks like a diagonal in the reference is the WEATHER capsule's own
    // right triangle (`capsule.rightTriangleVisible`, width factor 0.75,
    // highlight `max(2, 3 * s)` in a darkened accent), not a seam.
    // Every capsule face, from WidgetCapsule.qml + this theme:
    //   height `uniformCapsuleHeight` = max(CapsuleMetrics.height = inner 16 +
    //   2 * pad 5, round(panelHeight 22 * 0.55 * 1.15)) = 26 logical px = 23
    //   design, centred in the 25 design strip (y = 1);
    //   fill `WidgetBg.color(settings, key, fallback)` -> widgetBackgrounds.default
    //   `#000000b0` = 69 %, which is what this bar runs (colors.surface's 53 %
    //   would only apply with no widgetBackgrounds entry);
    //   corner `shape.cornerRadiusSmall` = 6.
    let seam = 7
    let tray.slot = 22
    let sysmon.pairs = 1 + 1 + if(has.gpu, 1, 0) + 1 + if(io >= 0.03, 1, 0) + if(has.swap and swap >= 0.4, 1, 0)
    // The user's settings, merged by bar.luau: `scale` multiplies ui and the
    // per-monitor fit; `widget.*` decide which widgets of this slice are there.
    fact user_scale = 1.0
    fact widget.clock = true
    fact widget.workspaces = true
    fact widget.pill = true
    fact widget.network = true
    fact widget.keyboard = true
    fact widget.sysmon = true
    fact widget.weather = true
    fact widget.systray = true
    fact widget.mpd = true
    fact widget.volume = true
    fact widget.mic = true
    fact widget.genelec = true
    fact widget.media = true
    // Set by bar.luau from the `media` service: a player is there (the QS
    // `MusicManager.hasPlayer`). The language compares numbers only, so the
    // scene cannot ask `media.player != ""` itself.
    fact media.present = false
    // The cursor is over the media capsule: the transport strip rides in.
    fact media.hot = false
    // The audio capsules (QS AudioLevelCapsule): `shown` is the reference's own
    // visibility rule — not at 100 %, not muted — carried by bar.luau because
    // it needs the timers and the two fields; `hot` is the cursor over them,
    // which brings the pill up.
    fact vol.shown = false
    fact vol.hot = false
    fact mic.shown = false
    fact mic.hot = false
    // The cursor is anywhere on the strip: QS's `panelHovering`, which is what
    // brings the Genelec tile (idle-hidden) back. (Not `bar.hot`: the palette
    // already has a `bar.hot` — panel.hotzone.width.)
    fact strip.hot = false
    // The tooltip: QS gives every capsule one on its own layer surface
    // (PanelTooltip + TooltipText.compose), and this bar's own surface is 25 px
    // tall, so it cannot hold one. `tip.shown` is the cursor being on a capsule.
    // Named without a dot on purpose: `pleamar --say bar fact tip.shown true`
    // is refused ("I don't understand 'tip.shown'"), so a fact an outside tool
    // may want to poke carries no dot.
    fact tip_open = false
    // What QS's WsIndicator shows for the ACTIVE workspace: its icon (a Nerd
    // Font glyph, the same codepoint the tree's SVGs are cut from) and the name
    // with Hyprland's `:name` prefix stripped. bar.luau fills them; the scene
    // cannot compare workspace names itself (text, not numbers).
    text ws_icon = ""
    // The Old Italic letter the owner puts in front of the name, kept apart: only
    // Code2001 has U+10330 among the faces here, and the label's Iosevka does not.
    text ws_lead = ""
    text ws_label = ""
    // The two halves of the network readout, as QS prints them.
    // The two readouts, without their unit letter — the capsule draws the number
    // beside a link glyph and the tooltip appends the letter (measured against the
    // reference: it reads "022.6", the port used to read "015.7K").
    text net_rx = "--"
    text net_tx = "--"
    text net_rx_unit = ""
    text net_tx_unit = ""
    // How many leading zeros the readout starts with (QS dims them in textDisabled);
    // the letter of the unit is drawn in the accent, and "K" is not drawn at all.
    fact net_rx_zeros = 0
    fact net_tx_zeros = 0
    fact net_rx_show_unit = false
    fact net_tx_show_unit = false
    // The active keyboard layout, as `hyprctl devices` prints it (`ru`, `en`).
    text kb_layout = ""
    // The weather capsule, filled by bar.luau from open-meteo through its own
    // on-disk cache: the glyph of the WMO code, the readouts, and the wind
    // arrow's angle (meteorological degrees + 180, where the wind blows TO).
    // `have` stays false until an answer — cached or fresh — has landed.
    fact weather.have = false
    fact weather.dir = 0
    // The moon's phase, 0 = new, 0.5 = full: the disc's shadow is placed by it.
    fact weather.moon = 0
    text weather.icon = "partly_cloudy_day"
    text weather.temp = "--°C"
    text weather.hum = ""
    text weather.wind = ""
    // What the tooltip says. The scene cannot compose text, so it says which
    // capsule the cursor is on (`emit tip(n)`) and bar.luau writes the line.
    text tip_body = ""
    // QS Services/SystemMonitor: six 0..1 metrics and whether two of them are
    // there at all (the machine's GPU exposes a busy file, its swap is on).
    fact cpu = 0
    fact ram = 0
    fact gpu = 0
    fact temp = 0
    fact io = 0
    fact swap = 0
    fact has.gpu = false
    fact has.swap = false

    // The transport's three commands, handled by bar.luau through the `media`
    // service (QS calls MusicManager.toggle/next/previous).
    event media_prev ->
    event media_toggle ->
    event media_next ->
    // The capsule's cover opens the now-playing card in the `panels` scene.
    // That scene exits while no drawer is open (its only surface is the drawer),
    // so the logic has to start the unit and then say where to go.
    event open_media_panel ->
    // QS opens NetFlowPopup from the network capsule; same drawer family here.
    event open_network_panel ->

    // --------------------------------------------------------------- surface
    // 25, not QS's `panelHeight` of 22: the reference draws that 22 at
    // `Theme.scale(screen)` = panel.scale 1.15 (drawn on a 2x monitor it lands
    // at 2.3 physical px per design px, a 25-logical-px surface). pleamar's
    // `screen.width`/`height` are the SURFACE's, not the monitor's, so the
    // per-monitor fit of palette rule 2 reads 22/1080 here and clamps to
    // fit.min — the port drew everything at 0.92 instead of 1.15, 20% small.
    // A bar surface has one scale, so it is `ui` and the surface is 22 * 1.15
    // rounded: 25. The reserve is the same 25, so windows stop at the bar
    // exactly where they do under Quickshell (measured: hyprctl reports the QS
    // panel at 0,1055 1920x25).
    surface {
        size: full, 25
        anchor: bar_edge
        level: top
        reserve: 25 while shown
        screens: each
    }

    // A named surface carries what it draws and shares every fact with the bar,
    // so a tooltip needs no round trip. `level: overlay` so it reads over the
    // bar; `open:` so it costs nothing while nobody is on a capsule.
    //
    // IT DOES NOT SHOW YET, and the reason is the bar's own surface: pleamar
    // sizes surfaces in LOGICAL px while their content is drawn at `ui` 1.15, so
    // this 25-logical surface holds only 21.7 design px. The reference gets away
    // with a 26-logical capsule because its content surface is panelHeight 25
    // plus the hotzone 9 * 1.15 = 10, ~34 logical tall, and only the reserve is
    // 25. The renderer says so itself, once: "a drawing is cut: it needs 2 px
    // above more than this 1920 x 25 surface has". So the next step is not this
    // surface but the bar's: size it ~34 logical, reserve 25, and shift the whole
    // design strip down by the hotzone (10 logical = 8.7 design).
    surface tip {
        size: 240, 30
        anchor: bottom
        // Measured: with `margin: 0, 0, 29, 0` the card's bottom edge sat 38
        // logical px above the bar's top (the anchor is the work area, not the
        // surface), so it hugs it instead.
        margin: 0, 0, 0, 0
        level: overlay
        open: tip_open
        body {
            color: skin.surface
            opacity: 96%
            box { from: 0, 0; size: 240, 30; corner: 6 }
            box { from: 0, 0; size: 2, 30; corner: 1; color: skin.accent }
        }
        text "{tip_body}" { at: 10, 15; anchor: left center; size: 13; color: skin.ink; family: "Iosevka" }
    }

    // What is drawn inside the surface, in the same design pixels.
    let strip = 25

    // ----------------------------------------------------------- permissions
    // Listening: clock, workspaces, audio, network. Commanding: workspaces.focus,
    // audio.* (step/mute) and the scene's own settings file.
    permissions { run: "cat", "hyprctl", "dash", "curl", "date", "pleamar", "systemctl"; services: "clock", "workspaces", "workspaces.focus", "audio", "audio.*", "network", "tray", "media", "media.*", "files", "files.write" }

    // ------------------------------------------------------------------ data
    // One record per workspace; `active` says whether that one is the active
    // workspace of the monitor it lives on — per-monitor, so each copy of the
    // bar lights its own without a line of logic.
    //
    // Limitation, checked against the compiler: the record's `monitor` is text
    // and the language compares numbers only, so the tabs cannot be filtered to
    // this monitor's workspaces (`ws.monitor == screen.name` is refused). On one
    // monitor the list is exactly right; on several, each copy shows them all
    // and the active tab of every monitor is lit. Closing it needs a text
    // comparison in the language or a helper worker that distributes per monitor.
    model spaces max 9 { id: number; name: text; monitor: text; active: bool }

    service clock as now { time: text; date: text }
    // The track the capsule shows (QS: MusicManager.trackTitle/trackArtist).
    service media { playing: bool; title: text; artist: text; player: text; position: number; length: number }
    service workspaces { list: spaces }
    service audio { volume: number; muted: bool; input: number; input_muted: bool }
    service network { online: bool; kind: none | wired | wifi; name: text; strength: number }
    // The tray, straight from the StatusNotifier host: `key` is what a click is
    // sent back with, `icon` comes as a name or a path, ready to paint.
    model icons max 12 { key: text; title: text; icon: image 18, 18 }
    service tray { list: icons }

    // --------------------------------------------------------- facts & events
    // `side` is the side margin in design px (palette bar.side): a later
    // settings round may expose it, the frozen schema does not.
    fact side = 4
    // The volume fill is a spring carried by rules, never touched per frame.
    prop level = 0 ~calm
    follow level = if(audio.muted, 0, audio.volume)
    // The microphone's level only tints its glyph (same rule).
    prop mic.level = 0 ~calm
    follow mic.level = if(audio.input_muted, 0, audio.input)

    event focus_workspace ->
    // A click on a tray icon: the record's index, because an event carries a
    // number and the keys live in the logic, which is what the tray is told with.
    event tray_press ->
    // The cursor came onto a left capsule; the number is its place in the row.
    event tip ->
    event wheel_volume ->
    event toggle_mute ->
    event toggle_mic ->

    // -------------------------------------------------------- left: the clock
    // The service writes time and date itself; no slot here pads numbers, so
    // neither is composed from hour/minute.
    component Clock(scale: number = ui * user_scale) {
        // QS's ClockWidget prints the time at round(fontSizeSmall 14 * timeFontScale
        // 0.7 * capsuleScale 1.15) = 11 logical px. 14 design px here is 16.1 over
        // the group's scale and measured 34 px of ink against the reference's 28;
        // 11.5 is 13.2 and lines up. (An earlier note claimed 14 "agrees" — it was
        // measuring width against a different face.)
        size: 50 * scale, strip * scale
        group zoom {
            scale: scale
            body {
                color: skin.coal
                opacity: 69%
                border: 1, mix(skin.coal, skin.ink, 8%)
                box { from: 0, 1; size: 50, 23; corner: 6 }
            }
            text "{now.time}" { at: 6, strip / 2; anchor: left center; size: 9.6; weight: 500; color: time.tone; family: "Iosevka" }
            zone box clock { from: 0, 0; size: 50, strip; corner: corner; label: "Clock {now.time}"; role: region }
            on enter clock { tip_open = true; emit tip(0) }
        }
    }

    // ------------------------------------------------- left: the workspace
    // QS's WsIndicator is ONE capsule for the workspace that is focused — the
    // icon in the accent, the name beside it in the text colour — and not a row
    // of tabs per workspace. The port drew a tab per record (four of them here),
    // each a filled capsule with a triangle, which is what made the left end
    // read far brighter than the reference.
    component WsCapsule(focus: event,
                       scale: number = ui * user_scale) {
        // The glyph, the Old Italic letter and the label are laid out side by side;
        // a width is only known once the text is shaped, so both are measured.
        measure glyph
        measure lead
        // 69, not 38: that is the reference's plate (measured off its strip — the plates sit
        // at 8, 72, 158, 223, 287 and are 54, 79, 58, 57, 95 LOGICAL px wide, which is 47, 69,
        // 50, 50, 83 in this scene's design px), and at 38 the label was cut to "λ:te": a
        // capsule sized for the glyph and nothing else.
        size: 69 * scale, strip * scale
        group zoom {
            scale: scale
            body {
                color: skin.coal
                opacity: 69%
                border: 1, mix(skin.coal, skin.ink, 8%)
                box { from: 0, 1; size: 69, 23; corner: 6 }
            }
            text "{ws_icon}" { measure: glyph; at: 6, strip / 2; anchor: left center; size: 14; color: skin.accent.hover; family: "FiraCode Nerd Font Mono" }
            text "{ws_lead}" { measure: lead; at: 6 + glyph.width + 5, strip / 2; anchor: left center; size: 14; weight: 500; color: skin.ink; family: "Code2001" }
            text "{ws_label}" { at: 6 + glyph.width + 5 + lead.width, strip / 2; anchor: left center; size: 14; weight: 500; color: skin.ink; family: "Iosevka" }
            zone box ws { from: 0, 0; size: 69, strip; corner: corner; cursor: pointer; label: "Workspace {ws_label}"; role: tab }
            on enter ws { tip_open = true; emit tip(1) }
            on press ws { emit focus }
        }
    }

    // ---------------------------------------------------- left: system monitor
    // QS SystemMonitorCapsule: six `icon + vertical bar` pairs in one capsule,
    // in the fixed order CPU · RAM · GPU · temperature · I/O · swap. Each pair
    // is `panel.icons.iconSizeSmall`-ish glyph and a `systemMonitorBarWidth`
    // bar as tall as `panelHeight * 0.55` (palette bar.height / 2), filled from
    // the bottom and coloured by the metric's own thresholds
    // (SystemMonitorUi.thresholdColor). A metric under the idle threshold
    // (systemMonitorHideIdle, 3 %) keeps its place but dims to textDisabled,
    // and I/O disappears outright — that is the reference's own rule, and it is
    // why the cluster is often narrower than six pairs.
    component SysmonPair(glyph: text, value: number, shown: bool, idle: bool,
                         warn: number, crit: number,
                         scale: number = ui * user_scale) {
        let bh = 12
        size: 16 * scale, strip * scale
        group zoom {
            scale: scale
            text glyph { at: 0, strip / 2; anchor: left center; size: 11; color: if(idle, ink.off, if(value >= crit, warn, if(value >= warn, amber, skin.ink.dim))); family: "Material Symbols Outlined"; show: shown }
            // MonitorBar draws the fill and nothing else: no track behind it, so
            // a 5 % metric is a short dash, not a dot on a rail.
            box { from: 12, strip / 2 + bh / 2 - value * bh; size: 3, value * bh; corner: 1.5; color: if(value >= crit, warn, if(value >= warn, amber, skin.ink.dim)); show: shown }
        }
    }

    component SysmonCluster(scale: number = ui * user_scale) {
        // The box is as wide as the pairs that show: QS's capsule is
        // `horizontalPadding * 2 + metricsRow.implicitWidth`, and a metric the
        // idle rule took away takes its width with it.
        let inner = sysmon.pairs * 16 + (sysmon.pairs - 1) * 2.5
        size: (sysmon.pairs * 16 + (sysmon.pairs - 1) * 2.5 + 12) * scale, strip * scale
        group zoom {
            scale: scale
            // A `box` placed at a NEGATIVE `from:` draws nothing at all (five
            // faces written that way never appeared); the face starts at 0 and
            // the content is inset by the capsule's padding instead.
            body {
                color: skin.coal
                opacity: 69%
                border: 1, mix(skin.coal, skin.ink, 8%)
                box { from: 0, 1; size: inner + 12, 23; corner: 6 }
            }
            row metrics {
                gap: 2.5
                align: center
                at: 6, strip / 2 - 12
                SysmonPair("memory_alt", cpu, true, cpu < 0.03, 0.5, 0.8)
                SysmonPair("memory", ram, true, ram < 0.03, 0.5, 0.8)
                SysmonPair("developer_board", gpu, has.gpu, gpu < 0.03, 0.5, 0.8)
                SysmonPair("thermostat", temp, true, temp < 0.03, 0.43, 0.71)
                // I/O is the one metric the reference takes away outright when
                // it is idle (`_visIo = showIoMonitor && !_idleIo`), where the
                // others stay and only dim: it is worth 44 physical px of the
                // row, and a cluster that keeps it pushes everything after it
                // (the weather) to the right.
                SysmonPair("storage", io, io >= 0.03, io < 0.03, 0.5, 0.8)
                SysmonPair("swap_horiz", swap, has.swap and swap >= 0.4, swap < 0.03, 0.5, 0.8)
            }
        }
    }

    // ------------------------------------------------------- left: the weather
    // QS WeatherButton: one row of pieces — the code's glyph in the accent, the
    // temperature, water_drop and the humidity, the navigation arrow turned by
    // the wind with its speed beside it, and the moon — inside one
    // WidgetCapsule whose width is `horizontalPadding * 2 + content`.
    //
    // The offsets are the reference's ink, measured again against its bar with
    // both strips in one screenshot (the earlier set came from a single strip and
    // had drifted: by the wind the port was 6 design px right of the reference and
    // by the moon 19). Relative to the glyph, QS places temp +19.6, water_drop
    // +32.2, humidity +38.3, arrow +51.3, wind +57.8, moon +70.4 design px, with
    // its Row's `spacing: 4 * capsuleScale` between them.
    component WeatherCapsule(scale: number = ui * user_scale) {
        measure w.icon
        measure w.temp
        measure w.drop
        measure w.hum
        measure w.arrow
        measure w.wind
        size: 140 * scale, strip * scale
        group zoom {
            scale: scale
            // The reference cuts this capsule's right end on a SLANT and runs a
            // hairline along the cut (`rightTriangleVisible` zeroes the right
            // radii and lays a triangle of `_triangleWidth` = round(1.15 * 1 * 1
            // * 16) = 18 logical px at `rightTriangleWidthFactor` 0.75 past the
            // right edge, so the face gains the point while the cut takes it
            // back). Measured off the strip: the cut leans "/" over ~13 design
            // px, the hairline is `triangleHighlightWidth` = 3 logical px.
            path {
                at: 0, 1
                move 0, 0
                line 154, 0
                line 140, 22
                line 0, 22
                close
                color: skin.coal
                opacity: 69%
            }
            // QS's triangleHighlightColor is the accent put through black twice
            // (towardsBlack(saturate(...), 0.3) x2), so a dark saturated blue.
            line { from: 154, 1; to: 140, 23; width: 2.6; color: mix(skin.accent, skin.coal, 55%) }
            // Laid out after their own widths, not at fixed offsets: the offsets were read
            // off the reference once and then the port's glyphs turned out wider, so the
            // temperature ran into the water drop ("11°C◯67%") and the capsule measured 114
            // logical px of ink where the reference's is 155. `measure` is what fixes that —
            // the same mechanism the workspace capsule uses for its glyph.
            let gap.g = 4
            let x.temp = 6 + w.icon.width + gap.g
            let x.drop = x.temp + w.temp.width + gap.g
            let x.hum = x.drop + w.drop.width + gap.g
            let x.arrow = x.hum + w.hum.width + gap.g
            let x.wind = x.arrow + w.arrow.width + gap.g
            let x.moon = x.wind + w.wind.width + gap.g
            text "{weather.icon}" { measure: w.icon; at: 6, strip / 2; anchor: left center; size: 12; color: skin.accent; family: "Material Symbols Outlined" }
            text "{weather.temp}" { measure: w.temp; at: x.temp, strip / 2; anchor: left center; size: 13; color: skin.ink; family: "Iosevka" }
            text "water_drop" { measure: w.drop; at: x.drop, strip / 2; anchor: left center; size: 10; color: skin.ink.dim; family: "Material Symbols Outlined" }
            text "{weather.hum}" { measure: w.hum; at: x.hum, strip / 2; anchor: left center; size: 11; color: skin.ink.dim; family: "Iosevka" }
            // `text` has no `rotate`: the arrow turns inside a group whose pivot
            // is the glyph's own centre.
            group arrow { pivot: x.arrow + w.arrow.width / 2, strip / 2; rotate: weather.dir
                text "navigation" { measure: w.arrow; at: x.arrow, strip / 2; anchor: left center; size: 10; color: skin.ink.dim; family: "Material Symbols Outlined" }
            }
            text "{weather.wind}" { measure: w.wind; at: x.wind, strip / 2; anchor: left center; size: 11; color: skin.ink.dim; family: "Iosevka" }
            // MoonPhaseIcon: a disc, and the shadow that bites into it moved by
            // the phase — at new moon it sits on the disc, at full moon clear of
            // it. The shadow is the face's own colour, as in the reference.
            box { from: x.moon, 6; size: 12, 12; corner: 6; color: skin.ink.dim }
            box { from: x.moon + (weather.moon - 0.5) * 24, 6; size: 12, 12; corner: 6; color: skin.coal; opacity: 84% }
            zone box weather { from: 0, 0; size: 140, strip; corner: corner; cursor: pointer; label: "Weather {weather.temp}"; role: button }
            on enter weather { tip_open = true; emit tip(5) }
        }
    }

    // ------------------------------------------------------ left: the keyboard
    component KeyboardCluster(scale: number = ui * user_scale) {
        size: 50 * scale, strip * scale
        group zoom {
            scale: scale
            body {
                color: skin.coal
                opacity: 69%
                border: 1, mix(skin.coal, skin.ink, 8%)
                box { from: 0, 1; size: 50, 23; corner: 6 }
            }
            // 10 and 32, not 6 and 28: the reference insets this capsule's ink 12 logical px
            // from its own edge (its glyph measures at 170 inside a plate at 158), while the
            // other capsules inset 6 — measured, not guessed.
            text "keyboard" { at: 10, strip / 2; anchor: left center; size: 14; color: skin.ink.dim; family: "Material Symbols Outlined" }
            text "{kb_layout}" { at: 32, strip / 2; anchor: left center; size: 14; color: skin.ink; family: "Iosevka" }
            zone box kb { from: 0, 0; size: 50, strip; corner: corner; label: "Keyboard {kb_layout}"; role: button }
            on enter kb { tip_open = true; emit tip(2) }
        }
    }

    // -------------------------------------------------------- left: network
    // QS NetFlowCapsule -> NetClusterCapsule: the link glyph in the accent and,
    // beside it, the two-row throughput readout — receive over transmit, small
    // type, three digits and a decimal (ConnUi.formatRxText/formatTxText).
    // The port drew `wired net1 1 %` in a capsule instead: a different widget
    // with a different width, and the biggest single difference in the left
    // cluster after the tabs.
    component NetCluster(scale: number = ui * user_scale) {
        measure w.rx
        measure w.tx
        let icon = 14
        let text.x = 22
        size: 50 * scale, strip * scale
        group zoom {
            scale: scale
            body {
                color: skin.coal
                opacity: 69%
                border: 1, mix(skin.coal, skin.ink, 8%)
                box { from: 0, 1; size: 50, 23; corner: 6 }
            }
            // QS does not paint the accent here: NetClusterCapsule's linkIconColor is
            // Color.desaturate(accentPrimary, vpn.desaturateAmount 0.45), the accent
            // mixed 45 % toward its own luminance grey. The scene language has no
            // luminance, and the group's own `saturation` is exactly that mix on the
            // GPU — 0.55 of the accent's saturation is what 45 % of grey leaves.
            group lan_tone { saturation: 0.55
                text "lan" { at: 6, strip / 2; anchor: left center; size: 13; color: if(network.online, skin.accent, ink.off); family: "Material Symbols Outlined" }
            }
            // 700, not the 900 QS asks for: the installed Iosevka has Regular, Medium and
            // Bold only (fc-match Iosevka:weight=black -> Iosevka Bold), so 700 names the
            // face Qt would actually pick and cosmic-text cannot fall back on a lighter one.
            // 9.6 design px is the reference's 11 logical px (round(round(14 * 1.0) * 0.7))
            // divided by this scene's 1.15 scale; at 10 the rows drew 11.5 px, half a pixel
            // too tall.
            text "{net_rx}" { measure: w.rx; at: text.x, strip / 2 - 5; anchor: left center; size: 9.6; weight: 700; color: skin.ink; family: "Iosevka"; letter_opacity: if(letter < net_rx_zeros, 45%, 100%) }
            text "{net_rx_unit}" { at: text.x + w.rx.width, strip / 2 - 5; anchor: left center; size: 9.6; weight: 700; color: skin.accent; family: "Iosevka"; show: net_rx_show_unit }
            text "{net_tx}" { measure: w.tx; at: text.x, strip / 2 + 5; anchor: left center; size: 9.6; weight: 700; color: skin.ink; family: "Iosevka"; letter_opacity: if(letter < net_tx_zeros, 45%, 100%) }
            text "{net_tx_unit}" { at: text.x + w.tx.width, strip / 2 + 5; anchor: left center; size: 9.6; weight: 700; color: skin.accent; family: "Iosevka"; show: net_tx_show_unit }
            zone box net { from: 0, 0; size: 50, strip; corner: corner; label: pick(network.online, "Network: offline", "Network {network.name}"); role: button }
            on enter net { tip_open = true; emit tip(3) }
            on press net { emit open_network_panel }
        }
    }

    // ---------------------------------------------------- right: the tray
    // QS SystemTray, in the settings this bar runs (`hideSystemTrayCapsule`,
    // `collapseSystemTray`, `systemTrayTightSpacing`): at rest the capsule is not
    // there at all and the icons appear only while the tray is expanded — which
    // is why the reference strip shows no tray even with applets running. What
    // "expanded" is here: the whole strip being under the cursor (`strip.hot`),
    // the same fact that brings the pill back.
    //
    // Geometry from SystemTray.qml: a slot of `trayIconSlot` = max(inner 16,
    // panelHeight 22) * 1.15 = 25 logical px, the icon `trayIconSize` = 20 inside
    // a 21 px frame, slots 2 logical px apart. At 2.3 physical px per design that
    // is a 22 design slot and an 18 design icon, with no capsule padding
    // (`horizontalPadding` is 0 while the spacing is tight).
    // One icon: its frame, the picture and the hit zone. A component taking the
    // record, because that is how a list is walked here (notifications does the
    // same) — a `for` inside a `group` painted nothing at all.
    component TrayIcon(r: record, scale: number) {
        size: tray.slot * scale, strip * scale
        // The frame each icon sits in: QS's surfaceHover is textPrimary at 6 %.
        box { from: 1 * scale, 2 * scale; size: (tray.slot - 2) * scale, 21 * scale; corner: 6 * scale; color: skin.ink; opacity: 6% }
        image r.icon { at: 2 * scale, 3 * scale; size: 18 * scale, 18 * scale }
        zone box trayhit { from: 0, 0; size: tray.slot * scale, strip * scale; corner: corner; cursor: pointer; label: "{r.title}"; role: button }
        on press trayhit { emit tray_press(r.index) }
    }

    // ---------------------------------------------- right: microphone, volume
    // QS AudioEndpointCapsule -> AudioLevelCapsule -> PillIndicator, as far as
    // the bar shows it at rest and under the cursor:
    //   · at rest the capsule is the Material glyph of the level, tinted with
    //     the level's own colour (panel.volume.lowColor -> highColor). The port
    //     used to paint the level as a filled bar inside a capsule — not the
    //     reference, and what made the right end read much lighter;
    //   · the pill (rounded fill, glyph, "NN %") rides out to the LEFT of the
    //     glyph while the cursor is over the capsule, over its neighbours, so
    //     the row never moves (PillIndicator does the same);
    //   · the capsule is not there at all when the endpoint is silent: QS hides
    //     the volume capsule at 100 % once panel.volume.fullHideMs has passed
    //     and the microphone when it is muted. `vol.shown`/`mic.shown` carry
    //     that (bar.luau), so the layout closes up like the reference's.
    component AudioTile(glyph: text, on: bool, readout: text, hot: bool, fill: color,
                        scale: number = ui * user_scale) {
        let icon = pill.icon
        size: (2 * capsule.pad + pill.icon) * scale, strip * scale
        group zoom {
            scale: scale
            box {
                from: icon / 2 - 44, (strip - pill.height) / 2
                size: 44, pill.height
                corner: corner.small
                color: skin.coal
                opacity: 53%
                show: hot
            }
            text "{readout}" {
                at: icon / 2 - pill.pad, strip / 2
                anchor: right center
                size: 14
                weight: 600
                color: skin.ink
                family: "Iosevka"
                show: hot
            }
            text "{glyph}" {
                at: icon / 2, strip / 2
                anchor: center
                size: 13
                color: fill
                family: "Material Symbols Outlined"
            }
        }
    }

    component VolCapsule(step: event, mute: event,
                         scale: number = ui * user_scale) {
        size: (2 * capsule.pad + pill.icon) * scale, strip * scale
        group zoom {
            scale: scale
            AudioTile("volume_up", vol.shown, "{audio.volume * 100, 0} %", vol.hot, mix(volume.low, volume.high, level))
            zone box vol { from: 0, 0; size: 2 * capsule.pad + pill.icon, strip; corner: corner; cursor: pointer; label: "Volume {audio.volume * 100, 0} %"; role: slider; value: "{audio.volume * 100, 0} %" }
            on enter vol { vol.hot = true }
            on leave vol { vol.hot = false }
            on scroll vol { emit step(wheel) }
            on press vol { emit mute }
        }
    }

    component MicCapsule(mute: event,
                         scale: number = ui * user_scale) {
        size: (2 * capsule.pad + pill.icon) * scale, strip * scale
        group zoom {
            scale: scale
            AudioTile("mic", mic.shown, "{audio.input * 100, 0} %", mic.hot, mix(volume.low, volume.high, mic.level))
            zone box mic { from: 0, 0; size: 2 * capsule.pad + pill.icon, strip; corner: corner; cursor: pointer; label: "Microphone {audio.input * 100, 0} %"; role: slider; value: "{audio.input * 100, 0} %" }
            on enter mic { mic.hot = true }
            on leave mic { mic.hot = false }
            on press mic { emit mute }
        }
    }

    // ------------------------------------------------------------------ rows
    component Left(scale: number = ui * user_scale) {
        row { at: side * scale, strip / 2; anchor: left middle; gap: row.gap * scale
            Clock() { show: widget.clock }
            WsCapsule(focus_workspace) { show: widget.workspaces }

            // QS KeyboardLayoutHypr: the keyboard glyph and the active layout,
            // nothing else (the icon is not in a square, `iconSquare: false`).
            KeyboardCluster() { show: widget.keyboard }
            // The pill capsule (legacy order: clock · workspaces · pill ·
            // keyboard · network) rides in only when it is wanted: QS wraps it
            // in a SlideReveal revealed by `PillTracker.reminderActive ||
            // (PillTracker.taken && hovering the left row)`, so at rest the bar
            // has no pill at all and the neighbours close up. A `show:` on a
            // copy of a strict-library component is read inside the library,
            // where the scene's `widget.pill` does not exist; the slot row
            // carries the condition instead.
            row pill_slot { show: widget.pill and Pill.taken and strip.hot; pill.Mark() }
            NetCluster() { show: widget.network }
            SysmonCluster() { show: widget.sysmon }
            WeatherCapsule() { show: widget.weather and weather.have }
            // Extension point: sysmon, then weather, go here.
        }
    }

    // ------------------------------------------------------- media capsule
    // The QS `Media` capsule, as far as this slice reaches: square album art on
    // the left (the Cover plugin), "artist — title" beside it, the analyser
    // (the Spectrum plugin) when there is one, and the transport as three
    // Material glyphs that fade in while the cursor is over the capsule (QS
    // slides a whole strip out; the slide needs the panel-level hover tracker
    // the bar does not have yet). Clicking the cover opens the now-playing
    // panel in QS — no panel exists here, so a cover click does nothing.
    component MediaCapsule(prev: event, toggle: event, next: event,
                           scale: number = ui * user_scale) {
        // QS `baseHeight = max(capsule.capsuleHeight, panelHeight * scale)` = 25,
        // the art is that square, the text is `musicTextPx = 16` and the
        // analyser is `iconPreferredWidth` wide (~ the art).
        let h = bar.height
        let art.w = bar.height
        let text.w = 240
        let spec.w = bar.height
        let btn.w = 16
        // At rest: art, the track and the time. The analyser and the transport are the
        // hover row and take no room here (the reference reserves none either).
        let w = 288
        size: 288 * scale, bar.height * scale
        group zoom {
            scale: scale
            // The plate is QS's WidgetCapsule: `WidgetBg.color(..., "media", …)` fills
            // with widgetBackgrounds.default `#000000b0` (69 %) and `borderVisible` adds
            // `textPrimary` at panel.capsule.borderOpacity 0.08, one `uiBorderWidth` wide —
            // two layers, the dark one under the faint light one. The port drew no plate
            // at all here, which read as the track floating on the strip.
            body {
                color: skin.coal
                opacity: 69%
                border: 1, mix(skin.coal, skin.ink, 8%)
                box { from: 0, 0; size: w, h; corner: corner }
            }

            // The analyser and the transport are revealed on hover in the reference
            // (`transportRevealed`, an analyser at `opacity: 0` until then), so they live in
            // a row that only exists while the capsule is hot: at rest the bar must reserve
            // no room for them, which is what the 48 px of button boxes used to do.
            row media_row {
                gap: bar.gap
                align: center
                art.Art(w: 22, h: 22)
                // The reference leaves 8 logical px between the art and the track; the row's
                // own gap is 6, and measured they were flush (the art and the first word came
                // out as one run of ink).
                space 2
                text "{media.artist} — {media.title}" { width: 168; lines: 1; size: 14; color: skin.ink; family: "Iosevka" }
                // QS paints the time in textPrimary while playing and textSecondary
                // while paused, at media.time.alpha.playing 1.0 / .paused 0.8 —
                // amber was the port's own invention and the one warm thing on a
                // cold bar.
                text "({media.position, time}/{media.length, time})" { size: 14; color: pick(media.playing, skin.ink, skin.ink.dim); opacity: pick(media.playing, 100%, 80%); family: "Iosevka" }
                row extras { show: media.hot
                    gap: bar.gap
                    align: center
                    spec.Bars(width: 22, height: 20, gap: 1)
                    // Fixed 16 px boxes so the hit zones below can name the same
                    // cells the layout hands out.
                    row btn_prev { size: 16, h; align: center
                        text "skip_previous" { family: "Material Symbols Outlined"; size: 14; color: skin.ink }
                    }
                    row btn_play { size: 16, h; align: center
                        text "play_arrow" { family: "Material Symbols Outlined"; size: 14; color: skin.ink; show: media.playing }
                        text "pause" { family: "Material Symbols Outlined"; size: 14; color: skin.ink; show: not media.playing }
                    }
                    row btn_next { size: 16, h; align: center
                        text "skip_next" { family: "Material Symbols Outlined"; size: 14; color: skin.ink }
                    }
                }
            }
            // Where the hover transport starts: after art, track and time (~75 design).
            let bx = art.w + bar.gap + text.w + bar.gap + 75 + bar.gap
            zone box media_zone { from: 0, 0; size: w, h; corner: corner; cursor: pointer; label: "Media"; role: region; value: "{media.title}" }
            zone box z_prev { from: bx, 0; size: 16, h; corner: corner; cursor: pointer; label: "Previous track"; role: button; show: media.hot }
            zone box z_play { from: bx + 16 + bar.gap, 0; size: 16, h; corner: corner; cursor: pointer; label: "Play or pause"; role: button; show: media.hot }
            zone box z_next { from: bx + 2 * (16 + bar.gap), 0; size: 16, h; corner: corner; cursor: pointer; label: "Next track"; role: button; show: media.hot }
            on enter media_zone { media.hot = true }
            on press media_zone { emit open_media_panel }
            on leave media_zone { media.hot = false }
            on press z_prev { emit prev }
            on press z_play { emit toggle }
            on press z_next { emit next }
        }
    }

    component Right(scale: number = ui * user_scale) {
        // `side` keeps the left row off the edge; the right row needs 8 design px less of it.
        // Measured: the mic's ink ended 9 logical px short of the reference's (1894 against
        // 1903 on a 1920 bar).
        row { at: screen.width - (side - 8) * scale, strip / 2; anchor: right middle; gap: row.gap * scale
            // The legacy order from the left: media · MPD · systray · mic ·
            // volume · Genelec. The tray is still an extension point.
            row media_slot { show: widget.media and media.present; MediaCapsule(media_prev, media_toggle, media_next) }
            // QS shows the flag badges only while media is up AND there is a
            // flag to show; with none it still drew an empty capsule here.
            // No `media.present` here: measured on the two bars, the reference draws the
            // shuffle badge while the port drew nothing, because the port had tied the badges
            // to "something is playing" and nothing was. A flag the owner set is not a media
            // state — it is shown while any flag is on.
            row mpd_slot { show: widget.mpd and (Mpd.repeat or Mpd.random or Mpd.single or Mpd.consume or Mpd.xfade); mpd.Flags() }
            row tray_slot { show: widget.systray and icons.count > 0 and strip.hot; gap: 0; align: center
                for r in icons { TrayIcon(r, scale) }
            }
            MicCapsule(toggle_mic) { show: widget.mic and mic.shown }
            VolCapsule(wheel_volume, toggle_mute) { show: widget.volume and vol.shown }
            // Genelec, the rightmost module, as in the legacy bar — and, as in
            // the legacy bar, only while the cursor is on it: QS's tile sets
            // `hideIconWhenIdle`, which collapses the whole capsule (width and
            // opacity) until `panelHovering` or a level change brings it back.
            row genelec_slot { show: widget.genelec and Genelec.hot; gen.Tile() }
        }
    }

    // -------------------------------------------------------------- the strip
    // One face across the whole width, translucent: measured off the reference
    // (grim, DP-2 @2x) the bar strip is a uniform near-black that still follows
    // the wallpaper behind it — rgb(12,14,16) over bright rock, rgb(6,7,8) over
    // the dark part. The backdrop is `panel.backdrop.color` #000000 at
    // `panel.seam.opacity` 0.88 (Bar.qml:360-380; `nonTerminalOpacity` is 1.0
    // there), so 88 %, not the opaque 100% the port used
    // (which read as a flat slab) and not nothing at all (which let the
    // wallpaper through unbroken). No rim and no shadow: QS paints neither
    // (`panel.capsule.borderWidth` is 0 and WidgetCapsule has no drop shadow).
    body {
        color: skin.coal
        opacity: 88%
        // The shape, not a second coat of paint: a body fills its own extent, and a box
        // inside it with no colour of its own inherits the body's and fills it again. The
        // two coats are what a measurement of the strip shows — QS' #1D1E21 for a plate at
        // 88 % over that wallpaper, the port's #040404, and 1 - (1 - 0.88)^2 = 0.9856 with
        // 0.0144 * rgb(242,250,255) is exactly #040404. `opacity: 0%` keeps the shape the
        // body needs and drops the second coat.
        box { from: 0, 0; size: screen.width, strip; opacity: 0% }
    }
    // The whole strip is a hover target for the widgets that hide at idle
    // (QS's `panelHovering`): declared before the rows, so every widget's own
    // zone is above it and keeps its clicks.
    zone box strip_hover { from: 0, 0; size: screen.width, strip; label: "Bar"; role: region }
    on enter strip_hover { strip.hot = true }
    on leave strip_hover { strip.hot = false; tip_open = false }

    Left()
    Right()

    // ------------------------------------------------------------ what waits
    // Later slices (rest of PH2-A): the pill capsule, the keyboard layout, the
    // system monitor and the weather on the left; media + its transport, the MPD
    // flags, the system monitor, the tray, the microphone and Genelec on the
    // right; the seam/wedge between the two bar halves; the startup gate (it
    // reads `startupClean` and drives `startup`); and the settings keys that
    // cannot act yet (see the header).
    //
    // Widget ORDER is not a runtime thing: the scene paints in the order it is
    // written, so `widgets` is applied as visibility here, and an order would be
    // applied when the scene is generated.
}
