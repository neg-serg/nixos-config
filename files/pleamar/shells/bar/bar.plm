language 0.4

// bar.plm — the pleamar bar, first slice (PH2-A / superplan).
//
// Legacy: files/quickshell/Bar/Bar.qml asks for three layer-shell surfaces per
// monitor, all anchored to the BOTTOM edge (anchors.bottom: true), one of them
// the reserve panel whose exclusiveZone is the bar height; the port asks for
// ONE surface, anchored by the `edge` setting (bottom on trantor), reserving
// its strip while `shown` holds.
//
// Reading order, left to right, is the legacy one:
//   left row:  clock · workspaces · pill · keyboard · network · sysmon · weather
//   right row: media · MPD · sysmon · tray · mic · volume · Genelec
// This slice draws clock/date, the workspace tabs, the network capsule (left)
// and the volume capsule (right). The other modules come later; each has a
// marked extension point below.
//
// Interfaces this file follows: files/pleamar/docs/INTERFACES.md — §2 (surface,
// facts `shown`/`startup`), §3.2 (the per-monitor scale), §4 (the Capsule API),
// §6 (the settings keys, merged by bar.luau), §8 (labels and roles).
//
// Two compiler facts shape the file:
//   · A surface `size:`/`reserve:` and a text `size:`/`weight:` take a LITERAL
//     number (`c.num()` in compiler.rs): `bar.height * 2` is refused by a
//     surface, and `12 * scale` inside a text would silently draw at 12. So the
//     surface height is spelled out (44: the pleamar bar strip, the examples'
//     own bar), and every widget draws in DESIGN PIXELS inside a
//     `group { scale: scale }`, the group scaling once for the monitor; a lib
//     Capsule is asked for `scale: 1` inside it so the group is the only
//     multiplier.
//   · A component parameter default is read at the use site (INTERFACES §4), so
//     a `scale:` default is per monitor. Call sites pass no scale; the default
//     is the palette rule-2 expression with the user's `scale` setting on top.
//
// Settings, merged by bar.luau from the scene's own settings.json:
//   edge          top | bottom, default bottom   — applied: the `bar_edge` fact
//                 drives `anchor:` (the fact cannot be called `edge`: that name
//                 collides with the Capsule component's own `edge` parameter)
//   scale         0.5..2.0, default 1.0          — applied: `user_scale`
//   widgets       array of text, max 24          — applied as visibility for
//                 this slice's four: clock, workspaces, network, volume
//   height        16..64, default 22             — frozen, not applied: a
//                 surface size cannot name a fact in 0.4.11 (checked:
//                 `size: full, h` is `expected a number here`)
//   fontScale, animations, startupClean,         — the features they tune are
//   monitorScale                                   later slices; not applied

import "../../lib/palette.plm"
import "../../lib/capsule.plm"
import "../../lib/plugins/pill/pill.plm" as pill
import "../../lib/plugins/mpd/mpd.plm" as mpd
import "../../lib/plugins/genelec/genelec.plm" as gen
import "../../lib/plugins/spectrum/spectrum.plm" as spec
import "../../lib/plugins/cover/cover.plm" as art

scene bar {

    // ------------------------------------------------- facts the interface fixes
    // `bar_edge` is the surface anchor; `shown` gates surface and reserve (tests
    // and other tools read both). `startup` is the login gate's fact: this slice
    // leaves it false, the gate itself is a later slice.
    fact bar_edge: top | bottom = bottom
    fact shown = true
    fact startup = false
    // The user's settings, merged by bar.luau: `scale` multiplies ui and the
    // per-monitor fit; `widget.*` decide which widgets of this slice are there.
    fact user_scale = 1.0
    fact widget.clock = true
    fact widget.workspaces = true
    fact widget.pill = true
    fact widget.network = true
    fact widget.mpd = true
    fact widget.volume = true
    fact widget.genelec = true
    fact widget.media = true
    // Set by bar.luau from the `media` service: a player is there (the QS
    // `MusicManager.hasPlayer`). The language compares numbers only, so the
    // scene cannot ask `media.player != ""` itself.
    fact media.present = false
    // The cursor is over the media capsule: the transport strip rides in.
    fact media.hot = false

    // The transport's three commands, handled by bar.luau through the `media`
    // service (QS calls MusicManager.toggle/next/previous).
    event media_prev ->
    event media_toggle ->
    event media_next ->

    // --------------------------------------------------------------- surface
    // 44 px is the pleamar bar strip; the surface is exactly that tall and
    // reserves the same, so windows stop at the bar. (`bar.height * scale` — the
    // QS strip height in INTERFACES §2.3 — cannot go in a surface size: literal
    // only. The slice that can act on `height` takes that up.)
    surface {
        size: full, 44
        anchor: bar_edge
        level: top
        reserve: 44 while shown
        screens: each
    }

    // What is drawn inside the surface, in the same design pixels.
    let strip = 44

    // ----------------------------------------------------------- permissions
    // Listening: clock, workspaces, audio, network. Commanding: workspaces.focus,
    // audio.* (step/mute) and the scene's own settings file.
    permissions { services: "clock", "workspaces", "workspaces.focus", "audio", "audio.*", "network", "media", "media.*", "files", "files.write" }

    // ------------------------------------------------------------------ data
    // One record per workspace; `active` says whether that one is the active
    // workspace of the monitor it lives on — per-monitor, so each copy of the
    // bar lights its own without a line of logic.
    //
    // Limitation, checked against the compiler: the record's `monitor` is text
    // and the language compares numbers only, so the tabs cannot be filtered to
    // this monitor's workspaces (`ws.monitor == screen.name` is refused). On one
    // monitor the list is exactly right; on several, each copy shows them all
    // and the active tab of every monitor is lit. Closing it needs a text
    // comparison in the language or a helper worker that distributes per monitor.
    model spaces max 9 { id: number; name: text; monitor: text; active: bool }

    service clock as now { time: text; date: text }
    // The track the capsule shows (QS: MusicManager.trackTitle/trackArtist).
    service media { playing: bool; title: text; artist: text; player: text }
    service workspaces { list: spaces }
    service audio { volume: number; muted: bool }
    service network { online: bool; kind: none | wired | wifi; name: text; strength: number }

    // --------------------------------------------------------- facts & events
    // `side` is the side margin in design px (palette bar.side): a later
    // settings round may expose it, the frozen schema does not.
    fact side = 4
    // The volume fill is a spring carried by rules, never touched per frame.
    prop level = 0 ~calm
    follow level = if(audio.muted, 0, audio.volume)

    event focus_workspace ->
    event wheel_volume ->
    event toggle_mute ->

    // -------------------------------------------------------- left: the clock
    // The service writes time and date itself; no slot here pads numbers, so
    // neither is composed from hour/minute.
    component Clock(scale: number = ui * user_scale * clamp(min(screen.width / design.width, screen.height / design.height), fit.min, fit.max)) {
        size: 64 * scale, 34 * scale
        group zoom {
            scale: scale
            column { at: 0, 3; gap: 1
                text "{now.time}" { size: 13; weight: 500; color: time.tone; family: "Iosevka" }
                text "{now.date}" { size: 10; color: ink.dim; family: "Iosevka" }
            }
            zone box clock { from: 0, 0; size: 64, 34; corner: corner; label: "Clock {now.time}"; role: region }
        }
    }

    // -------------------------------------------------- left: workspace tabs
    // One round tab per record the service reports; the active one on its monitor
    // is lit through a spring. A press hands the id to the logic, which commands
    // `workspaces.focus`.
    component Tab(ws: record, focus: event,
                  scale: number = ui * user_scale * clamp(min(screen.width / design.width, screen.height / design.height), fit.min, fit.max)) {
        size: pill.height * scale, pill.height * scale
        group zoom {
            scale: scale
            prop lit = 0 ~ui.quick
            follow lit = if(ws.active, 1, 0)

            box { from: 0, 0; size: pill.height, pill.height; corner: pill.height / 2; color: mix(slate, highlight, lit) }
            text "{ws.name}" { at: pill.height / 2, pill.height / 2; anchor: center; size: 11.5; weight: 600; color: mix(ink, coal, lit); width: pill.height - 8; lines: 1; align: center; family: "Iosevka" }

            zone box tab { from: 0, 0; size: pill.height, pill.height; corner: pill.height / 2; cursor: pointer; label: "Workspace {ws.name}"; role: tab; selected: ws.active }
            on press tab { emit focus(ws.id) }
        }
    }

    // ------------------------------------------------------ left: the network
    // What the service reports: online (the dot), kind, name, strength. The
    // label is the standard one — `Network {name}`, or `Network: offline` — and
    // clicking it will open the network drawer in a later slice.
    component NetCapsule(scale: number = ui * user_scale * clamp(min(screen.width / design.width, screen.height / design.height), fit.min, fit.max)) {
        let w = 118
        let h = capsule.height
        let ih = h - 2 * capsule.pad.y
        size: 118 * scale, capsule.height * scale
        group zoom {
            scale: scale
            Capsule(w, h, scale: 1, shadow: 25%, rim: 0.06) {
                group net {
                    size: w - 2 * capsule.pad, ih
                    ellipse { at: 3, ih / 2; radius: 2.5; color: if(network.online, highlight, warn) }
                    text "{network.kind} {network.name}" { at: 9, ih / 2; anchor: left center; size: 11; width: 72; lines: 1; color: if(network.online, ink, ink.off); family: "Iosevka" }
                    text "{network.strength, 0} %" { at: w - 2 * capsule.pad - 2, ih / 2; anchor: right center; size: 11; color: ink.dim; family: "Iosevka" }
                }
            }
            zone box net { from: 0, 0; size: w, h; corner: corner; label: pick(network.online, "Network: offline", "Network {network.name}"); role: button }
        }
    }

    // ------------------------------------------------------ right: the volume
    // The fill follows the level spring; the wheel steps the volume and a press
    // toggles silence, both through events the logic carries to `audio.step`
    // and `audio.mute`.
    component VolCapsule(step: event, mute: event,
                         scale: number = ui * user_scale * clamp(min(screen.width / design.width, screen.height / design.height), fit.min, fit.max)) {
        let w = 78
        let h = capsule.height
        let iw = w - 2 * capsule.pad
        let ih = h - 2 * capsule.pad.y
        size: 78 * scale, capsule.height * scale
        group zoom {
            scale: scale
            Capsule(w, h, scale: 1, shadow: 25%, rim: 0.06) {
                group track {
                    size: iw, ih
                    box { from: 0, 0; size: iw * level, ih; corner: corner.small; color: mix(volume.low, volume.high, level) }
                    text "{audio.volume * 100, 0} %" { at: iw / 2, ih / 2; anchor: center; size: 11; weight: 600; color: ink; family: "Iosevka" }
                }
            }
            zone box vol { from: 0, 0; size: w, h; corner: corner; cursor: pointer; label: "Volume {audio.volume * 100, 0} %"; role: slider; value: "{audio.volume * 100, 0} %" }
            on scroll vol { emit step(wheel) }
            on press vol { emit mute }
        }
    }

    // ------------------------------------------------------------------ rows
    component Left(scale: number = ui * user_scale * clamp(min(screen.width / design.width, screen.height / design.height), fit.min, fit.max)) {
        row { at: side * scale, strip / 2; anchor: left middle; gap: bar.gap * scale
            Clock() { show: widget.clock }
            row tabs { show: widget.workspaces; gap: ws.gap * scale
                for ws in spaces { Tab(ws, focus_workspace) }
            }
            // The pill capsule (legacy order: clock · workspaces · pill ·
            // keyboard · network). The keyboard layout is still an extension
            // point; `Pill.Mark()` draws the QS pill, its click handled by the
            // plugin's own logic.
            // A `show:` on a copy of a strict-library component is read inside
            // the library, where the scene's `widget.pill` does not exist; the
            // slot row carries the condition instead.
            row pill_slot { show: widget.pill; pill.Mark() }
            NetCapsule() { show: widget.network }
            // Extension point: sysmon, then weather, go here.
        }
    }

    // ------------------------------------------------------- media capsule
    // The QS `Media` capsule, as far as this slice reaches: square album art on
    // the left (the Cover plugin), "artist — title" beside it, the analyser
    // (the Spectrum plugin) when there is one, and the transport as three
    // Material glyphs that fade in while the cursor is over the capsule (QS
    // slides a whole strip out; the slide needs the panel-level hover tracker
    // the bar does not have yet). Clicking the cover opens the now-playing
    // panel in QS — no panel exists here, so a cover click does nothing.
    component MediaCapsule(prev: event, toggle: event, next: event,
                           scale: number = ui * user_scale * clamp(min(screen.width / design.width, screen.height / design.height), fit.min, fit.max)) {
        // QS `baseHeight = max(capsule.capsuleHeight, panelHeight * scale)` = 25,
        // the art is that square, the text is `musicTextPx = 16` and the
        // analyser is `iconPreferredWidth` wide (~ the art).
        let h = 25
        let art.w = 25
        let text.w = 168
        let spec.w = 25
        let btn.w = 16
        let w = art.w + bar.gap + text.w + bar.gap + spec.w + 2 * bar.gap + 3 * btn.w
        size: (25 + bar.gap + 168 + bar.gap + 25 + 2 * bar.gap + 3 * 16) * scale, 25 * scale
        group zoom {
            scale: scale
            // pad_y 0: the art is square, as in QS ("Disable vertical padding to
            // allow square cover art in all modes").
            Capsule(w, h, scale: 1, pad_y: 0, pad: 2, shadow: 25%, rim: 0.06) {
                row media_row {
                    gap: bar.gap
                    align: center
                    art.Art(w: 25, h: 25)
                    text "{media.artist} — {media.title}" { width: 168; lines: 1; size: 16; color: ink; family: "Iosevka" }
                    spec.Bars(width: 25, height: 23, gap: 1)
                    // Fixed 16 px boxes so the hit zones below can name the same
                    // cells the layout hands out.
                    row btn_prev { size: 16, h; align: center
                        text "skip_previous" { family: "Material Symbols Outlined"; size: 16; color: ink; opacity: if(media.hot, 1, 0) }
                    }
                    row btn_play { size: 16, h; align: center
                        text "play_arrow" { family: "Material Symbols Outlined"; size: 16; color: ink; opacity: if(media.hot and media.playing, 1, 0) }
                        text "pause" { family: "Material Symbols Outlined"; size: 16; color: ink; opacity: if(media.hot and not media.playing, 1, 0) }
                    }
                    row btn_next { size: 16, h; align: center
                        text "skip_next" { family: "Material Symbols Outlined"; size: 16; color: ink; opacity: if(media.hot, 1, 0) }
                    }
                }
            }
            let bx = art.w + bar.gap + text.w + bar.gap + spec.w + 2 * bar.gap
            zone box media_zone { from: 0, 0; size: w, h; corner: corner; cursor: pointer; label: "Media"; role: region; value: "{media.title}" }
            zone box z_prev { from: bx, 0; size: 16, h; corner: corner; cursor: pointer; label: "Previous track"; role: button }
            zone box z_play { from: bx + 16 + bar.gap, 0; size: 16, h; corner: corner; cursor: pointer; label: "Play or pause"; role: button }
            zone box z_next { from: bx + 2 * (16 + bar.gap), 0; size: 16, h; corner: corner; cursor: pointer; label: "Next track"; role: button }
            on enter media_zone { media.hot = true }
            on leave media_zone { media.hot = false }
            on press z_prev { emit prev }
            on press z_play { emit toggle }
            on press z_next { emit next }
        }
    }

    component Right(scale: number = ui * user_scale * clamp(min(screen.width / design.width, screen.height / design.height), fit.min, fit.max)) {
        row { at: screen.width - side * scale, strip / 2; anchor: right middle; gap: bar.gap * scale
            // The legacy order from the left: media · MPD · systray · mic ·
            // volume · Genelec. The tray and the microphone are still extension
            // points.
            row media_slot { show: widget.media and media.present; MediaCapsule(media_prev, media_toggle, media_next) }
            row mpd_slot { show: widget.mpd; mpd.Flags() }
            VolCapsule(wheel_volume, toggle_mute) { show: widget.volume }
            // Genelec, the rightmost module, as in the legacy bar.
            row genelec_slot { show: widget.genelec; gen.Tile() }
        }
    }

    // -------------------------------------------------------------- the strip
    // One bottom strip: translucent coal with a light rim. The widget rows are
    // placed inside it by the surface copies. No drop shadow: the surface is
    // exactly the strip, and a shadow below it would be cut (INTERFACES §2.3
    // asks for shadow room; impossible while a surface size is a literal).
    body {
        color: coal
        opacity: veil
        rim: 8%
        box { from: 0, 0; size: screen.width, strip; corner: corner }
    }

    Left()
    Right()

    // ------------------------------------------------------------ what waits
    // Later slices (rest of PH2-A): the pill capsule, the keyboard layout, the
    // system monitor and the weather on the left; media + its transport, the MPD
    // flags, the system monitor, the tray, the microphone and Genelec on the
    // right; the seam/wedge between the two bar halves; the startup gate (it
    // reads `startupClean` and drives `startup`); and the settings keys that
    // cannot act yet (see the header).
    //
    // Widget ORDER is not a runtime thing: the scene paints in the order it is
    // written, so `widgets` is applied as visibility here, and an order would be
    // applied when the scene is generated.
}
