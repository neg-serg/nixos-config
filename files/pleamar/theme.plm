// theme.plm — the wallpaper palette a scene opts into.
//
// The live file is generated: `packages/pleamar-theme` writes
// ~/.config/pleamar/theme.plm from the current wallpaper and rewrites it when the
// wallpaper changes. A scene is loaded from that directory, so its
// `import "../../theme.plm"` there reads the generated palette — the roles are
// the ones QS derives at runtime in Settings/Theme.qml (accentPrimary is
// `Color.matchHue(_wpAccent, "#006FCC")`, the rest are the colours.jsonc roles).
//
// This copy is the repository's default. It carries the same names with the
// theme's own values, so `pleamar --check` runs from the tree — without it the
// import fails with "cannot find '../../theme.plm'" — and a checkout that was
// never themed looks like the plain QS theme instead of not compiling.
//
// Roles:
//   skin.coal     colors.background       the wallpaper's darkest cluster
//   skin.surface  colors.surfaceVariant   its second-darkest
//   skin.ink      colors.text.primary     the lightest cluster, stepped toward the
//                                         extreme until it clears 4.5:1 on surface
//                                         (9.8:1 with these defaults)
//   skin.ink.dim  colors.text.secondary   the static token colors.jsonc carries, not a
//                                         mix of the other two (the comment below the
//                                         value says the same; these defaults are ~17 %
//                                         of the way from ink to surface)
//   skin.accent   colors.accent.primary   the wallpaper's mean saturated colour,
//                                         hue-matched onto #006FCC
//   skin.accent.hover / skin.accent.deep / skin.on.accent — the derived tokens
//   (Theme.accentHover, Theme.accentDarkStrong, colors.onAccent).

library Skin strict {

    // colors.background role: the wallpaper's darkest cluster.
    let skin.coal = #000000

    // colors.surfaceVariant role: the wallpaper's second-darkest cluster.
    let skin.surface = #242A35

    // colors.text.primary role: the lightest cluster.
    let skin.ink = #CBD6E5

    // colors.text.secondary (Settings/colors.jsonc) — the static token the reference
    // draws its secondary text with, not a mix of the two other tones.
    let skin.ink.dim = #AEB9C8

    // colors.accent.primary role: the wallpaper's accent, hue-matched onto the
    // theme's own #006FCC.
    let skin.accent = #006FCC

    // Theme.accentHover: towardsWhite(accentPrimary, 0.2).
    let skin.accent.hover = mix(skin.accent, #ffffff, 20%)

    // Theme.accentDarkStrong: towardsBlack(accentPrimary, 0.8).
    let skin.accent.deep = mix(skin.accent, skin.coal, 80%)

    // colors.onAccent, unchanged.
    let skin.on.accent = #ffffff

    // Is the wallpaper light? Its mean WCAG luminance over the reference's own
    // `ui.textShadow.lightThreshold` (0.5), which is what decides whether the ink on a
    // plate of `coal` at 69..96 % still reads. The generator computes it
    // (the crate's extractor, `light=`); this default says "dark wallpaper".
    let skin.light = false
}
