// meta.plm — extended track metadata as a plugin: what is playing, and what the
// file behind it is.
//
// Legacy: files/quickshell/Services/MusicMeta.qml, whose order is kept — the
// player's own metadata first (genre, album artist, composer, date, track
// number), the file only for what a player cannot say (codec, depth, sample
// rate, bitrate). The source is MPRIS, read through `playerctl -a`: every player
// is asked at once and the playing one answers, so nothing here is wired to a
// particular player. pleamar's `media` service still reports no url (upstream
// ask, INTERFACES §10.5), which is why the url comes from MPRIS `xesam:url`.
//
// A player that publishes no url — mpd's own bridge is one — still has genre and
// the year, so the card keeps its tags and only the quality line stays empty; a
// stream reports a url that is not a file, and is treated the same way. Nothing
// is guessed at, and no path is invented from a music directory.
//
// The tag fallbacks (`tags.GENRE` capitalised, then lowercase, then
// `format.tags`) and the mediainfo retry are the QS order; `sox --i` is left out
// (its text output is a third parser for the tail of a tail).
//
//     import "../../lib/plugins/meta/meta.plm" as meta
//     meta.Line()
//
// Compile proof: meta.check.plm.

import "../../palette.plm"
import "../../capsule.plm"

library Meta strict {

    // Its logic's own: playerctl asks every MPRIS player (the universal read —
    // no player is hard-wired), ffprobe is the introspection tool and mediainfo
    // its fallback; media says when the track changed.
    permissions {
        run: "playerctl", "ffprobe", "mediainfo"
        services: "media"
    }

    // ------------------------------------------------------------- boundary
    // Numbers are facts, strings are live texts (a fact is a number, a yes/no
    // or an enum).
    fact bitDepth: number = 0
    fact sampleRate: number = 0
    fact bitrateKbps: number = 0
    fact channels: number = 0
    fact sizeBytes: number = 0
    fact trackNo: number = 0
    fact discNo: number = 0
    fact year: number = 0
    text codec = ""
    text container = ""
    text genre = ""
    text label = ""
    text albumArtist = ""
    text composer = ""
    text file = ""
    // The QS "quality summary" line, composed here so a scene does not have to:
    // "FLAC 24/96 · 1024 kbps".
    text summary = ""
    // The tag rows a card draws under the title, in the QS order and with the
    // QS glyphs (MusicDetailRow: person/album/category/calendar_month/sell/
    // piano/high_quality). Filled here for the same reason the summary is: only
    // the logic can tell whether a text is empty, and a scene cannot — so a row
    // that has no value is never handed over, and no icon is drawn over nothing.
    model rows max 6 { glyph: text; value: text }

    // ----------------------------------------------------------------- line
    // `type_scale` is the scene's `fontScale` (the bar's `text_scale` fact): a strict library
    // cannot read the scene's facts, so the multiplier comes in as a parameter.
    component Line(scale: number = ui, type_scale: number = 1) {
        let w = 118
        let h = bar.plate
        size: 118 * scale, bar.plate * scale
        group zoom {
            scale: scale
            Capsule(w, h, scale: 1) {
                row line {
                    gap: 4
                    align: center
                    text "{summary}" { size: 9 * type_scale; weight: 600; family: "Iosevka"; color: ink.dim }
                }
            }
            zone box line { from: 0, 0; size: 118, h; corner: corner; label: "Track quality"; role: region; value: "{summary}" }
        }
    }
}
