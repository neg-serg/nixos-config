language 0.4

// build.check.plm — the compile proof of the build badge (INTERFACES §10.2).

import "../../palette.plm"
import "./build.plm" as build

scene build_check {
    surface { size: 260, 80; anchor: top; level: overlay; agent: hidden }

    // The tile asks for the event a press means; the proof only has to name one.
    event tapped ->

    build.Tile(tapped)
    build.Tile(tapped, scale: 1.5)
    build.Rows(width: 300)

    on demo {
        Build.stage = "building"
        Build.tone = 1
        Build.glyph = "build"
        Build.summary = "probe-build-status +1"
        Build.count = 2
        Build.busy = true
    }
}
