language 0.4

// build.plm — the Nix build badge: what a `nix build`, `nixos-rebuild` or a
// flake check is doing right now, from the `nixbuild-status` tool this repo
// ships (packages/nixbuild-status).
//
// Legacy: files/quickshell/Bar/Modules/BuildStatus.qml (the capsule: state icon,
// summary, only while something runs) and BuildStatusPopup.qml (one row per
// build). QS streamed the tool with `--watch 1 --json`; this plugin spawns the
// same tool in its waybar format, which is one JSON object per line:
// `{ text, alt, class, tooltip, count, builds, drvs }`.
//
// Detection lives in the tool (/proc and the derivation log directory), never
// here — the plugin reads one line per state change and nothing else.
//
// The badge takes no bar space while the state is `idle`: that is QS's
// `capsuleVisible: statusText.length > 0`, and it is why the row can be
// unconditional in the scene (`show: Build.busy`, or a row of its own).
//
//     import "../../lib/plugins/build/build.plm" as build
//     event open_build_panel ->          // the scene's: the tile cannot open a drawer itself
//     build.Tile(open_build_panel)
//
// Compile proof: build.check.plm.

import "../../palette.plm"

library Build strict {

    // The stream is the plugin's own program, not the scene's.
    permissions { run: "nixbuild-status" }

    // ----------------------------------------------------------------- facts
    // A fact is a number or a yes-or-no and nothing else (the language's rule), so
    // the words are `text`: the phase (`idle | evaluating | building | activating`,
    // as the tool names it), the glyph the tile draws for it, the line beside it and
    // the tooltip the tool prints.
    fact count: number = 0
    fact busy = false
    // Which tone the tile paints: a fact, because a component of a `strict` library
    // cannot compare the library's own `text` (the resolver reads it as the scene's).
    // 0 plain, 1 the work's own accent, 2 the one that wants attention.
    fact tone: number = 0
    text stage = "idle"
    text glyph = "check_circle"
    text summary = ""
    text detail = ""

    fact hot = false

    // ------------------------------------------------------------------- tile
    // One capsule, as in QS: the phase's glyph in its tone, what the tool is building above it
    // and the phase word below. The two-row readout is the centre row's own (the bar's
    // `LlmCapsule`), so the build badge and the resident model beside it read as one family
    // rather than a caption next to a card.
    //
    // The plate is that capsule's, not `Capsule`'s: `box { from: 0, 1; size: w, bar.plate }`, the
    // same 69 % plate fill and the 1 px hairline at 8 % — bar geometry §3.6, "one plate line"
    // (a 23-tall slot painted its plate from the strip's top edge and sat a pixel above its
    // neighbour). The tones come from the caller for the reason genelec's do: a strict library
    // cannot see the scene's live palette, and the child shell has two palettes; the defaults are
    // palette.plm's dark ones, so a bench that does not care keeps working.
    //
    // `label.w` is fixed because a plugin cannot measure text, and a width composed from the
    // summary would change with every derivation and make the badge jitter (the same reason the
    // logic drops the tool's clock); the engine elides inside it and the tooltip carries the line.
    //
    // The tile is a button, and what a press means is the scene's to say: QS's BuildStatus is
    // `autoToggleOnTap` and opens its popup, which here is the `build` drawer, and a plugin
    // may not run `pleamar --say`. So the event comes in as a parameter, as `chosen` does in
    // the language's own example.
    // `type_scale` is the scene's `fontScale` (the bar's `text_scale` fact): a strict library
    // cannot read the scene's facts, so the multiplier comes in as a parameter. `row` is the
    // strip's band (25): the plate is 23 of it, 1 px down, and the press area is the whole band.
    // `hover` is the scene's own hook for its tooltip: QS shows `PanelTooltip { text:
    // statusTooltip }` while the capsule is hovered (BuildStatus.qml:84-87), and a library emits
    // nothing on its own.
    component Tile(tap: event, hover: event, scale: number = ui, type_scale: number = 1,
                   row: number = 25, plate: color = coal, ink_tone: color = ink,
                   lit: color = accent.hover) {
        // The centre capsules' box: 6 px of air, the 14 px glyph, 6, the words.
        let pad = 6
        let icon = 14
        let icon.gap = 6
        let label.w = 104
        let w = pad + icon + icon.gap + label.w + pad
        size: w * scale, row * scale
        group zoom {
            scale: scale
            body {
                color: plate
                opacity: 69%
                border: 1, mix(plate, ink_tone, 8%)
                box { from: 0, 1; size: w, bar.plate; corner: corner }
            }
            // The idle tone never paints (the scene shows the tile only while a build runs) and
            // stays on the palette's dim, which is not a theme's role to change.
            text "{glyph}" { at: pad, row / 2; anchor: left center; family: "Material Symbols Outlined"; size: icon; color: if(tone == 2, amber, if(tone == 1, lit, ink.dim)); opacity: if(hot, 1, 0.85) }
            // The tool's own line (the derivation it names, "+N" for the ones behind it) on top,
            // the phase word below in the accent — `accent.hover`, which is the text-safe shade
            // (§3.6: accent itself is 4.1:1 on a plate).
            text "{summary}" { at: pad + icon + icon.gap, row / 2 - 4; anchor: left center; size: 9.6 * type_scale; weight: 700; family: "Iosevka"; width: label.w; lines: 1; color: ink_tone }
            text "{stage}" { at: pad + icon + icon.gap, row / 2 + 4; anchor: left center; size: 9.6 * type_scale; weight: 700; family: "Iosevka"; lines: 1; color: if(tone == 2, amber, lit) }
            zone box tile { from: 0, 0; size: w, row; corner: corner; cursor: pointer; label: "Nix build"; role: button }
            on enter tile { hot = true; emit hover(1) }
            on leave tile { hot = false; emit hover(0) }
            on press tile { emit tap }
        }
    }

    // ------------------------------------------------------------- the popup
    // One row per build the tool reports — the QS `BuildStatusPopup` list. A model,
    // because a fact carries no words and no table: the logic fills it from the
    // stream's own `builds` array, and the drawer iterates it.
    model builds max 8 { name: text; stage: text; elapsed: text }

    // The list itself: the phase word dim on the left, the derivation in body ink, the
    // clock on the right. `width` is the plate's inner width, so a row cannot outgrow the
    // drawer it stands in.
    // `type_scale` is the scene's `fontScale` (the bar's `text_scale` fact): a strict library
    // cannot read the scene's facts, so the multiplier comes in as a parameter.
    component Rows(scale: number = ui, type_scale: number = 1, width: number = 300) {
        let w = width
        let clock.w = 46
        let stage.w = 62
        let name.w = w - clock.w - stage.w - 12
        size: w * scale, builds.total * 20 * scale
        group zoom {
            scale: scale
            column rows {
                gap: 2
                for b in builds {
                    row line {
                        gap: 6
                        align: center
                        text b.stage { family: "Iosevka"; size: 11 * type_scale; width: stage.w; lines: 1; color: ink.dim }
                        text b.name { family: "Iosevka"; size: 12 * type_scale; width: name.w; lines: 1; color: ink }
                        text b.elapsed { family: "Iosevka"; size: 11 * type_scale; width: clock.w; lines: 1; color: ink.off }
                    }
                }
            }
        }
    }
}
