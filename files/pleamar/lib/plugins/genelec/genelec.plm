language 0.4

// genelec.plm — the Genelec SAM volume widget as a plugin: the tile, the facts
// and the logic (`genelec.luau`) that talks to the monitors.
//
// Legacy: files/quickshell/Services/Genelec.qml (the state machine, the commit
// coalescing) and Bar/Modules/GenelecWidget.qml (the tile: whole dB, wheel ±1,
// muted label). The dB range is the QS one: -95 at the bottom,
// `genelecMaxVolume` (Settings.json -20) at the top, whole dB only, because
// GLM's CC20 is an integer.
//
// One transport: `genlc volume <dB>` writes $XDG_RUNTIME_DIR/genlc-volume and
// routes the write itself — through the daemon's socket when the daemon holds
// the adapter, straight to the HID adapter otherwise. The logic reads the same
// state file back with `genlc volume --show` and `genlc volume --watch` (a
// spawned watch, because the files service is sandboxed to the plugin's own
// folder), the port of the QS FileView watch on that file.
//
//     import "../../lib/plugins/genelec/genelec.plm" as gen
//     gen.Tile()
//
// The scene sets the cap if it differs from the frozen default:
//     Genelec.maxVolume = -30                       // from a rule
//
// Compile proof: genelec.check.plm.

import "../../palette.plm"
import "../../capsule.plm"

library Genelec strict {

    // Its logic's, not the scene's: the one binary every write and read goes
    // through.
    // `files`/`files.write` are the plugin's own folder: the pre-mute volume lives there so a
    // restart does not lose it (the QS service kept the same pair in its StateCache).
    permissions { run: "genlc"; services: "files", "files.write" }

    // ------------------------------------------------------------- boundary
    // The target volume, whole dB (the QS displayDb/volume). The logic owns the
    // writes; a scene may read it.
    fact volume: number = -40
    fact muted = false
    // `available` is the last write answering; `genlc volume` itself decides whether it went
    // through the daemon's socket or straight to the adapter.
    fact available = true
    // The clamp, per host: Settings.json genelecMaxVolume (-20) and the QS floor.
    fact minVolume: number = -95
    fact maxVolume: number = -20

    // The tile's two gestures; the logic does the work (a rule cannot run a
    // program).
    event turn ->
    event toggle ->

    // The monitor's silhouette, the same file the QS tree draws
    // (files/quickshell/art/genelec/genelec-ones.svg, copied here so the plugin
    // travels with its piece).
    image ones = file "genelec-ones.svg", 20, 20

    // ------------------------------------------------------------------ tile
    // The QS GenelecWidget: the monitor's own silhouette (the SVG the QS tree
    // draws, travelling with this plugin) that stays hidden until the capsule is
    // hovered (`hideIconWhenIdle`), and the whole dB label beside it — `-40dB`,
    // no space, as the QS pill prints it. Wheel is ±1 dB, a press toggles mute.
    fact hot = false

    // The tile's tones come from the caller: a library cannot see the scene's `skin.*`, and the
    // shell now has two palettes (light and dark), so the frozen `coal`/`ink` this used to paint
    // with left a black pill standing at the end of a light bar. The defaults are those frozen
    // tones, so a bench that does not care keeps working.
    // `type_scale` is the scene's `fontScale` (the bar's `text_scale` fact): a strict library
    // cannot read the scene's facts, so the multiplier comes in as a parameter.
    component Tile(scale: number = ui, type_scale: number = 1, row: number = 25,
                   plate: color = coal, tone: color = ink, tone.dim: color = ink.off,
                   loud: color = accent) {
        // The silhouette reads smaller than a glyph of the same size — it is a thin monitor
        // outline, not a solid shape — so it is drawn at the row's own height, not the
        // capsule's inner 14: the tile keeps its 18 px pill and the icon stands a pixel proud of
        // it, which is what makes it legible next to the volume capsule's icon.
        // The silhouette sits inside the plate, not above it: at 20 against a 13 px plate its
        // bottom edge hung out of the pill.
        let size.icon = 17
        // The label is `-95dB` — minus, two digits, the unit, no space, the way the QS pill
        // prints it — so five glyphs is the widest the format gets: 5 * 7 = 35 at 14 px Iosevka.
        // 48 was sized for the old `-51 dB` spelling and left 13 px of empty plate at the right
        // of a string that never fills it, which read as the tile hanging off the row's edge.
        let label.w = 35
        let w = 2 * capsule.pad + size.icon + capsule.gap + label.w
        // 23 design: the height every other capsule's plate is drawn at. A taller one pokes out of
        // the strip at its rounded corner, which is the black notch at the right end.
        let h = 23
        // The slot is as tall as the row's: every other capsule in the bar answers a press over
        // the full `row`, and this one answered over 18 design px sitting at the top of it —
        // a tile that looked a few pixels high and clicked even less.
        size: w * scale, row * scale
        group zoom {
            scale: scale
            // The plate is the capsule's, and a capsule only wears one while the pointer is on it:
            // the microphone and the volume tile beside it do exactly that. Drawn always, this one
            // was the single dark pill standing at the end of an otherwise bare right side.
            group plate {
                // Centred in the slot: the plate is 18 tall, the row is 29, and a `row` with
                // `align: center` is how the transport's buttons sit in theirs too.
                row cap { size: w, row; align: center
                    Capsule(w, h, fill: plate, alpha: 69%, scale: 1) {
                        // `row content`, not `row tile`: a named layout is a region of its own, and a
                        // row called `tile` next to the `zone box tile` below made two zones of one
                        // name — `describe`/`press` then saw the button as "covered by" its own
                        // decoration, while a mouse found it (the later zone wins).
                        row content {
                            gap: capsule.gap
                            align: center
                            // The reference paints this icon `available ? accentPrimary : textDisabled`
                            // (Services/Genelec.qml:168) and keeps its own tone on the dB label, so the
                            // dim is the icon's alone. The port's silhouette reads better in `ink` than in
                            // the accent, which the dB row already carries, so only the `available` half of
                            // the reference's colour is ported here.
                            image ones { size: size.icon, size.icon; tint: if(available and not muted, tone, tone.dim) }
                            row db { gap: 0; align: center
                                text "-" { family: "Iosevka"; size: 14 * type_scale; weight: 700; color: if(muted, tone.dim, loud); show: volume < 0 }
                                text "{max(volume, 0 - volume), 0}" { family: "Iosevka"; size: 14 * type_scale; weight: 700; color: if(muted, tone.dim, tone) }
                                text "dB" { family: "Iosevka"; size: 14 * type_scale; weight: 700; color: if(muted, tone.dim, loud) }
                            }
                        }
                    }
                }
            }
            zone box tile { from: 0, 0; size: w, row; corner: corner; cursor: pointer; label: "Genelec SAM"; role: slider; value: "{volume, 0} dB" }
            on enter tile { hot = true }
            on leave tile { hot = false }
            on scroll tile { emit turn(wheel) }
            on press tile { emit toggle }
        }
    }
}
