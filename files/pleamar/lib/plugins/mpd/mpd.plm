language 0.4

// mpd.plm — the MPD flags capsule as a plugin: the state MPD reports and the
// badge row that shows it.
//
// Legacy: files/quickshell/Bar/Modules/MpdFlags.qml (the `mpc status` parser,
// the idle watch, the 2500 ms fallback poll) and the QS token
// `media.mpd.flags.fallbackMs` -> palette `mpd.flags`.
//
// The badges are text, not icons: `lib/icons.plm` is not written yet
// (INTERFACES §5.3), and a plugin that reached into the scene's icon names
// would break the moment one moved. The short keys are the QS tooltip's names.
//
//     import "../../lib/plugins/mpd/mpd.plm" as mpd
//     mpd.Flags()
//
// Compile proof: mpd.check.plm.

import "../../palette.plm"
import "../../capsule.plm"

library Mpd strict {

    // mpc only: the QS fallback `rmpc status` is a second binary for a second
    // client library, and this shell talks to MPD, not to a wrapper.
    permissions { run: "mpc" }

    // ------------------------------------------------------------- boundary
    fact state: playing | paused | stopped | unknown = unknown
    fact repeat = false
    fact random = false
    fact single = false
    fact consume = false
    fact xfade = false
    // mpc could not reach MPD (no socket, no server): the scene hides the tile.
    fact available = true

    // ----------------------------------------------------------------- flags
    // The QS capsule is as wide as its content (`horizontalPadding * 2 +
    // content.implicitWidth`), so the width follows the number of flags that are
    // on: bools add, and an empty capsule is not drawn at all (the scene hides
    // it). The glyphs are the Material Symbols names QS passed to MaterialIcon
    // (`repeat`, `shuffle`, `repeat_one`, `auto_delete`, `blur_linear`), drawn
    // from the same font with its ligatures, at the QS size
    // (fontSizeSmall * capsuleScale = 14) and its emphasis opacity.
    component Flags(scale: number = ui) {
        let glyph.gap = 2
        let glyph.size = 16
        let shown = repeat + random + single + consume + xfade
        let w = 2 * capsule.pad + shown * glyph.size + max(0, shown - 1) * glyph.gap
        let h = capsule.height
        size: (2 * capsule.pad + (repeat + random + single + consume + xfade) * 16 + max(0, repeat + random + single + consume + xfade - 1) * 2) * scale, capsule.height * scale
        group zoom {
            scale: scale
            Capsule(w, h, scale: 1, shadow: 25%, rim: 0.06) {
                row flags {
                    gap: 2
                    align: center
                    text "repeat" { family: "Material Symbols Outlined"; size: 16; color: if(state == playing, highlight, ink.dim); opacity: 75%; show: repeat }
                    text "shuffle" { family: "Material Symbols Outlined"; size: 16; color: if(state == playing, highlight, ink.dim); opacity: 75%; show: random }
                    text "repeat_one" { family: "Material Symbols Outlined"; size: 16; color: if(state == playing, highlight, ink.dim); opacity: 75%; show: single }
                    text "auto_delete" { family: "Material Symbols Outlined"; size: 16; color: if(state == playing, highlight, ink.dim); opacity: 75%; show: consume }
                    text "blur_linear" { family: "Material Symbols Outlined"; size: 16; color: if(state == playing, highlight, ink.dim); opacity: 75%; show: xfade }
                }
            }
            zone box flags { from: 0, 0; size: w, h; corner: corner; label: "MPD"; role: region; value: "{state}" }
        }
    }
}
