language 0.4

// mpd.check.plm — the compile proof of the MPD flags plugin (INTERFACES §10.2).

import "../../palette.plm"
import "./mpd.plm" as mpd

scene mpd_check {
    surface { size: 200, 60; anchor: top; level: overlay; agent: hidden }

    mpd.Flags()
    mpd.Flags(scale: 1.25)

    on demo {
        Mpd.repeat = true
        Mpd.random = true
        Mpd.single = false
        Mpd.consume = true
        Mpd.xfade = true
        Mpd.state = stopped
    }
}
