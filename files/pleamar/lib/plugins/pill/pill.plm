language 0.4

// pill.plm — the pill tracker as a plugin: today's state, the streak, and the
// mark that shows whether it happened.
//
// Legacy: files/quickshell/Services/PillTracker.qml (the state JSON, the
// midnight rollover, the deadline reminder, the ICS write into the synced
// calendar) and Helpers/PillHistory.js (the streak arithmetic).
//
// Where the files live is the one thing that changed: the QS service kept a
// mirror of the tracked marks in $XDG_STATE_HOME/quickshell/pill-tracker.json
// (the file the Telegram bridge reads and rewrites), while a plugin owns a
// folder of its own (`$XDG_DATA_HOME/pleamar/<scene>/` through the files
// service) — so the state is `state.json` in that folder, and only the
// calendar event stays outside, in the directory vdirsyncer syncs (written
// with `tee`, removed with `rm`, both through `run`). The bridge's copy now
// lives in $XDG_STATE_HOME/pleamar/pill-tracker.json; it falls back to the
// quickshell one until the new file exists (telegram-units.nix).
//
//     import "../../lib/plugins/pill/pill.plm" as pill
//     pill.Mark()
//
// The deadline is the scene's (the QS `pillReminderDeadline`, 12:00), split into
// two numbers because a text is not assignable from a rule:
//     on settings_ready { Pill.deadlineHour = 9; Pill.deadlineMinute = 30 }
//
// Compile proof: pill.check.plm.

import "../../palette.plm"
import "../../capsule.plm"

library Pill strict {

    // The plugin's own: its folder (state), the calendar directory (create,
    // write, remove, list — the listing is the history the port inherited),
    // HOME to find it, and the minute clock it runs on.
    permissions {
        run: "mkdir", "tee", "rm", "ls"
        services: "files", "files.write", "env", "clock"
    }

    // ------------------------------------------------------------- boundary
    // Live texts, not facts: a fact is a number, a yes/no or an enum, and a
    // fact of text is `text name = "…"` in this language.
    text takenAt = ""
    text today = ""
    fact taken = false
    fact streak: number = 0
    // True after the deadline while nothing is taken (the QS reminderActive).
    fact reminder = false
    // The scene's, from its settings: the QS default is 12:00, split because a
    // text is not assignable from a rule.
    fact deadlineHour: number = 12
    fact deadlineMinute: number = 0

    // The cursor is on the mark. The tooltip is the bar's to draw (a plugin has no surface): the
    // scene watches this and asks the logic for the line.
    fact hot = false
    // How many times the mark was right-pressed. A plugin cannot open a drawer — the `panels` scene
    // owns those — so the press counts here and the scene turns the change into its own event; a
    // counter and not a yes/no, or the second press would change nothing and do nothing.
    fact asks: number = 0

    event toggle ->

    // ----------------------------------------------------------------- mark
    // The QS PillCapsule: one `pill` Material glyph in a capsule the size of the
    // icon plus its padding, accent-coloured once taken and pulsing (opacity
    // 0.3 → 1 over a second, `SequentialAnimation` in QS) while the deadline has
    // passed. `wave` is the language's own sine: 0.35 · sin(2π t) around 0.65.
    // The plate and the glyph's tones come from the caller: a library cannot see the scene's
    // `skin.*`, and with two palettes in the shell the frozen `coal` plate left a black pill in
    // the light bar. The defaults are the frozen tones a bench expects.
    // `plate.h` and `plate.top` are the bar's own numbers, and they are not `capsule.height`:
    // every other capsule in the strip draws `box { from: 0, 1; size: w, 23 }` inside a 25 px
    // strip, so its plate spans y 1..24 and its centre is 12.5. This one drew 18 px from y 0 —
    // centre 9, three and a half design px above every neighbour, which is what read as a pill
    // hanging off the strip. A bench that wants the bare capsule keeps the defaults.
    component Mark(scale: number = ui, plate: color = coal, tone.on: color = highlight,
                   tone.off: color = ink.dim, plate.h: number = capsule.height,
                   plate.top: number = 0) {
        // The glyph fills the capsule it sits in: 10 inside an 18 px plate read as a speck on
        // a square, which is what "too small" was looking at.
        let size.icon = capsule.height - 4
        // Tighter than a capsule's padding: the mark is one glyph, and the capsule's 4 px on each
        // side left it floating in a pill wider than the thing it holds.
        let pad.mark = capsule.pad - 2
        let w = 2 * pad.mark + size.icon
        let h = plate.h
        prop pulse = 0
        wave pulse = 0.35 at 6.28
        // The slot is the plate's size, not the plate the glyph had before it grew: 22 drawn
        // inside an 18 slot ran into the keyboard capsule beside it, hit zone and all.
        size: (2 * capsule.pad + size.icon) * scale, (plate.top + plate.h) * scale
        group zoom {
            scale: scale
            // The plate the neighbours wear: the bar's capsules are `coal` at 69 %, and the
            // library's defaults (`slate` at `veil`) read as a lighter, greyer pill sitting off
            // the strip's tone.
            group { move: 0, plate.top
            Capsule(w, h, fill: plate, alpha: 69%, scale: 1) {
                // `row content`, not `row mark`: a named layout is a region of its own, and a row
                // called `mark` next to the `zone box mark` below made two zones of one name — the
                // right press went to the region, so the calendar never opened.
                row content {
                    align: center
                    text "pill" { family: "Material Symbols Outlined"; size: size.icon; color: if(taken, tone.on, tone.off); opacity: if(reminder, 0.65 + pulse, 1) }
                }
            }
            }
            zone box mark { from: 0, 0; size: w, plate.top + h; corner: corner; cursor: pointer; label: "Pill taken"; role: toggle; checked: taken; value: "{streak}" }
            on enter mark { hot = true }
            on leave mark { hot = false }
            on press mark { emit toggle }
            // QS PillCapsule's second TapHandler: the right button opens the shared calendar.
            on press right mark { asks = asks + 1 }
        }
    }
}
