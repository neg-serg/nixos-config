language 0.4

// pill.plm — the pill tracker as a plugin: today's state, the streak, and the
// mark that shows whether it happened.
//
// Legacy: files/quickshell/Services/PillTracker.qml (the state JSON, the
// midnight rollover, the deadline reminder, the ICS write into the synced
// calendar) and Helpers/PillHistory.js (the streak arithmetic).
//
// Where the files live is the one thing that changed: the QS service kept its
// state under $XDG_STATE_HOME/quickshell/, while a plugin owns a folder of its
// own (`$XDG_DATA_HOME/pleamar/<scene>/` through the files service) — so the
// state is `state.json` in that folder, and only the calendar event stays
// outside, in the directory vdirsyncer syncs (written with `tee`, removed with
// `rm`, both through `run`).
//
//     import "../../lib/plugins/pill/pill.plm" as pill
//     pill.Mark()
//
// The deadline is the scene's (the QS `pillReminderDeadline`, 12:00), split into
// two numbers because a text is not assignable from a rule:
//     on settings_ready { Pill.deadlineHour = 9; Pill.deadlineMinute = 30 }
//
// Compile proof: pill.check.plm.

import "../../palette.plm"
import "../../capsule.plm"

library Pill strict {

    // The plugin's own: its folder (state), the calendar directory (create,
    // write, remove), HOME to find it, and the minute clock it runs on.
    permissions {
        run: "mkdir", "tee", "rm"
        services: "files", "files.write", "env", "clock"
    }

    // ------------------------------------------------------------- boundary
    // Live texts, not facts: a fact is a number, a yes/no or an enum, and a
    // fact of text is `text name = "…"` in this language.
    text takenAt = ""
    text today = ""
    fact taken = false
    fact streak: number = 0
    // True after the deadline while nothing is taken (the QS reminderActive).
    fact reminder = false
    // The scene's, from its settings: the QS default is 12:00, split because a
    // text is not assignable from a rule.
    fact deadlineHour: number = 12
    fact deadlineMinute: number = 0

    event toggle ->

    // ----------------------------------------------------------------- mark
    // The QS PillCapsule: one `pill` Material glyph in a capsule the size of the
    // icon plus its padding, accent-coloured once taken and pulsing (opacity
    // 0.3 → 1 over a second, `SequentialAnimation` in QS) while the deadline has
    // passed. `wave` is the language's own sine: 0.35 · sin(2π t) around 0.65.
    component Mark(scale: number = ui) {
        // The glyph fills the capsule it sits in: 10 inside an 18 px plate read as a speck on
        // a square, which is what "too small" was looking at.
        let size.icon = capsule.height - 4
        let w = 2 * capsule.pad + size.icon
        let h = capsule.height
        prop pulse = 0
        wave pulse = 0.35 at 6.28
        // The slot is the plate's size, not the plate the glyph had before it grew: 22 drawn
        // inside an 18 slot ran into the keyboard capsule beside it, hit zone and all.
        size: (2 * capsule.pad + size.icon) * scale, capsule.height * scale
        group zoom {
            scale: scale
            // The plate the neighbours wear: the bar's capsules are `coal` at 69 %, and the
            // library's defaults (`slate` at `veil`) read as a lighter, greyer pill sitting off
            // the strip's tone.
            Capsule(w, h, fill: coal, alpha: 69%, scale: 1) {
                row mark {
                    align: center
                    text "pill" { family: "Material Symbols Outlined"; size: size.icon; color: if(taken, highlight, ink.dim); opacity: if(reminder, 0.65 + pulse, 1) }
                }
            }
            zone box mark { from: 0, 0; size: w, h; corner: corner; cursor: pointer; label: "Pill taken"; role: toggle; checked: taken; value: "{streak}" }
            on press mark { emit toggle }
        }
    }
}
