language 0.4

// cover.check.plm — the compile proof of the album-art resolver (INTERFACES §10.2).

import "../../palette.plm"
import "./cover.plm" as cover

scene cover_check {
    surface { size: 240, 240; anchor: top; level: overlay; agent: hidden }

    cover.Art()
    cover.Art(w: 120, h: 120)

    on demo {
        Cover.found = true
    }
}
