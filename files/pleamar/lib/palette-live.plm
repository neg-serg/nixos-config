// palette-live.plm — the colours a theme changes while the scene runs, as
// facts: a new palette repaints the scene without rewriting a file and
// reloading it.
//
// The engine's `rgb(r, g, b)` takes three numbers that may be facts
// (`pleamar --docs reference`, "a palette taken from the wallpaper, by setting
// three facts, without a file to rewrite and a scene to reload"). A scene
// declares the facts and its logic keeps them current; this library only reads
// them.
//
//   import "../../lib/palette.plm"        // sizes and the static roles below
//   import "../../lib/palette-live.plm"
//
//   fact pal_ink_r = 0.7961               // the defaults are theme.plm's
//   fact pal_ink_g = 0.8392
//   fact pal_ink_b = 0.8980               // ... one triple per role
//
//   text "Muted" { color: live.ink.dim }
//   Capsule(140, 34, fill: live.slate, scale: 1) { ... }
//
// Who sets the facts: the scene's own logic, from its `palette.json` — a file
// `pleamar-themes push` writes into `~/.local/share/pleamar/<scene>/` after every
// theme apply and every wallpaper run (a scene reads only its own folder, so the
// tools leave the numbers there; the file is JSON, one key per channel):
//
//   {"coal_r":0.0627,"coal_g":0.0784,…,"light":0}
//
// What a theme drives is exactly theme.plm's five roles and `light`: coal,
// surface (as `live.slate`, palette.plm's name for the surface tone), ink,
// ink.dim, accent and on.accent, plus the two shades worked out from the accent.
// The rest of palette.plm's colour names are not a theme's to change — an alert
// is red whatever the wallpaper — so they are kept here with palette.plm's
// values, under the `live.` prefix the scenes already use.
//
// The names are `live.*` on purpose: `palette.plm` already defines `ink`,
// `slate`, `accent`, and `capsule.plm`/`menu.plm` import it and use those names
// themselves, so a library that redefined them could not be imported beside
// them.
//
// A program that is not this scene (the lock screen, a separate process) cannot
// see facts: it keeps importing the generated `theme.plm`, as before.

library PaletteLive strict {

    // ── what a theme drives (facts: pal_<role>_r/g/b, pal_light 0|1) ──
    let live.coal = rgb(pal_coal_r, pal_coal_g, pal_coal_b)
    let live.slate = rgb(pal_surface_r, pal_surface_g, pal_surface_b)
    let live.ink = rgb(pal_ink_r, pal_ink_g, pal_ink_b)
    let live.ink.dim = rgb(pal_ink_dim_r, pal_ink_dim_g, pal_ink_dim_b)
    let live.accent = rgb(pal_accent_r, pal_accent_g, pal_accent_b)
    let live.on.accent = rgb(pal_on_accent_r, pal_on_accent_g, pal_on_accent_b)
    let live.light = pal_light > 0.5

    // The shades the static palette works out from the accent.
    let live.accent_hover = mix(live.accent, #ffffff, 20%)
    let live.accent_deep = mix(live.accent, live.coal, 80%)

    // ── what a theme does not drive: palette.plm's values, unchanged ──
    let live.outline = #3B4C5C
    let live.ink.off = #6B718A
    let live.warn = #FF6B81
    let live.amber = #FFB347
    let live.highlight = #94E1F9
}
