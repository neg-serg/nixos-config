            opacity: (0.15 + abs(sin(28.2000 + t * 0.8) * 0.35 + sin(79.8000 - t * 0.5) * 0.2 + sin(126.6000 + t * 1.1) * 0.12) * 0.7) * 0.3
        }
        line ray.7 {
            from: c + 0.819152 * size * 0.105, c + 0.573576 * size * 0.105
            to: c + 0.819152 * (size * 0.3 * (1.55 + sin(32.9000 + t * 0.8) * 0.35 + sin(93.1000 - t * 0.5) * 0.2 + sin(147.7000 + t * 1.1) * 0.12)), c + 0.573576 * (size * 0.3 * (1.55 + sin(32.9000 + t * 0.8) * 0.35 + sin(93.1000 - t * 0.5) * 0.2 + sin(147.7000 + t * 1.1) * 0.12))
