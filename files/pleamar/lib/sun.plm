// sun.plm — the animated sun of the weather card.
//
// The pleamar form of Widgets/SidePanel/SunIcon.qml: a glow, a bright core and 72 rays whose lengths
// and opacity shimmer. The reference paints it on a Canvas — a radial gradient plus, per ray, three
// sines — because Qt had nothing else; here it is what the renderer draws: three ellipses for the
// glow and the core, and 72 `line`s.
//
// **The 72 lines are written out, not unfolded by a `repeat`.** They were a repeat first and it
// renders one ray: in this version `$i` reaches a name (`ray.$i` does make 72 draws) but the turn's
// number does not reach an *expression*, and every ray's angle and length is arithmetic on it
// (measured 2026-10-31 in a headless sway session — 72 rays on one angle, unchanged after inlining
// the arithmetic). So the per-ray constants are literals, generated once:
//
//   python3 - <<'PY'
//   import math
//   for i in range(72):
//       a = 2 * math.pi * i / 72
//       ...
//   PY
//
// What still varies at run time is `t` (`time`, the scene's seconds) — the shimmer itself — so the
// drawing animates exactly as the reference's does.
//
//   import "../../lib/palette.plm"
//   import "../../lib/sun.plm" as sun
//
//   sun.Sun(72) { }
//
// What it costs: 72 lines and their expressions, on every frame the scene paints. The reference's
// `animate: _overlayVisible` gate has no counterpart — a drawing has no clock of its own — so the
// caller decides when it is on screen (`show:`), and reading `time` keeps the scene from resting.
//
// The geometry is the reference's: the core's radius is `size * 0.30`, rays run from `r * 0.35` out
// to `r * (0.55 + wig)`, `wig` is the three-sine sum over the per-ray phases, and a ray's opacity is
// `(0.15 + |wig| * 0.7) * 0.3`. Its per-ray width wobble is dropped: at a card's size it is under a
// device pixel, and the lengths carry the shimmer.

library Sun {

    // `size` is the footprint in design pixels; everything inside is a fraction of it, as in the
    // reference, so one number sizes the whole thing.
    component Sun(size: number = 72, tone: color = #FFD98A, core: color = #FFFFFF) {
        let c = size / 2
        let t = time
        // The glow, as three rings rather than the reference's one radial gradient: at the sizes a
        // card uses the stepped falloff is indistinguishable from a smooth one.
        group glow {
            ellipse halo { at: c, c; radius: size * 0.45; color: tone; opacity: 10% }
            ellipse bloom { at: c, c; radius: size * 0.315; color: tone; opacity: 26% }
            ellipse disc { at: c, c; radius: size * 0.216; color: core; opacity: 92% }
        }
        group rays {
        line ray.0 {
            from: c + 1.000000 * size * 0.105, c + 0.000000 * size * 0.105
            to: c + 1.000000 * (size * 0.3 * (1.55 + sin(0.0000 + t * 0.8) * 0.35 + sin(0.0000 - t * 0.5) * 0.2 + sin(0.0000 + t * 1.1) * 0.12)), c + 0.000000 * (size * 0.3 * (1.55 + sin(0.0000 + t * 0.8) * 0.35 + sin(0.0000 - t * 0.5) * 0.2 + sin(0.0000 + t * 1.1) * 0.12))
            width: size * 0.012
            color: tone
            opacity: (0.15 + abs(sin(0.0000 + t * 0.8) * 0.35 + sin(0.0000 - t * 0.5) * 0.2 + sin(0.0000 + t * 1.1) * 0.12) * 0.7) * 0.3
        }
        line ray.1 {
            from: c + 0.996195 * size * 0.105, c + 0.087156 * size * 0.105
            to: c + 0.996195 * (size * 0.3 * (1.55 + sin(4.7000 + t * 0.8) * 0.35 + sin(13.3000 - t * 0.5) * 0.2 + sin(21.1000 + t * 1.1) * 0.12)), c + 0.087156 * (size * 0.3 * (1.55 + sin(4.7000 + t * 0.8) * 0.35 + sin(13.3000 - t * 0.5) * 0.2 + sin(21.1000 + t * 1.1) * 0.12))
            width: size * 0.012
            color: tone
            opacity: (0.15 + abs(sin(4.7000 + t * 0.8) * 0.35 + sin(13.3000 - t * 0.5) * 0.2 + sin(21.1000 + t * 1.1) * 0.12) * 0.7) * 0.3
        }
        line ray.2 {
            from: c + 0.984808 * size * 0.105, c + 0.173648 * size * 0.105
            to: c + 0.984808 * (size * 0.3 * (1.55 + sin(9.4000 + t * 0.8) * 0.35 + sin(26.6000 - t * 0.5) * 0.2 + sin(42.2000 + t * 1.1) * 0.12)), c + 0.173648 * (size * 0.3 * (1.55 + sin(9.4000 + t * 0.8) * 0.35 + sin(26.6000 - t * 0.5) * 0.2 + sin(42.2000 + t * 1.1) * 0.12))
            width: size * 0.012
            color: tone
            opacity: (0.15 + abs(sin(9.4000 + t * 0.8) * 0.35 + sin(26.6000 - t * 0.5) * 0.2 + sin(42.2000 + t * 1.1) * 0.12) * 0.7) * 0.3
        }
        line ray.3 {
            from: c + 0.965926 * size * 0.105, c + 0.258819 * size * 0.105
            to: c + 0.965926 * (size * 0.3 * (1.55 + sin(14.1000 + t * 0.8) * 0.35 + sin(39.9000 - t * 0.5) * 0.2 + sin(63.3000 + t * 1.1) * 0.12)), c + 0.258819 * (size * 0.3 * (1.55 + sin(14.1000 + t * 0.8) * 0.35 + sin(39.9000 - t * 0.5) * 0.2 + sin(63.3000 + t * 1.1) * 0.12))
            width: size * 0.012
            color: tone
            opacity: (0.15 + abs(sin(14.1000 + t * 0.8) * 0.35 + sin(39.9000 - t * 0.5) * 0.2 + sin(63.3000 + t * 1.1) * 0.12) * 0.7) * 0.3
        }
        line ray.4 {
            from: c + 0.939693 * size * 0.105, c + 0.342020 * size * 0.105
            to: c + 0.939693 * (size * 0.3 * (1.55 + sin(18.8000 + t * 0.8) * 0.35 + sin(53.2000 - t * 0.5) * 0.2 + sin(84.4000 + t * 1.1) * 0.12)), c + 0.342020 * (size * 0.3 * (1.55 + sin(18.8000 + t * 0.8) * 0.35 + sin(53.2000 - t * 0.5) * 0.2 + sin(84.4000 + t * 1.1) * 0.12))
            width: size * 0.012
            color: tone
            opacity: (0.15 + abs(sin(18.8000 + t * 0.8) * 0.35 + sin(53.2000 - t * 0.5) * 0.2 + sin(84.4000 + t * 1.1) * 0.12) * 0.7) * 0.3
        }
        line ray.5 {
            from: c + 0.906308 * size * 0.105, c + 0.422618 * size * 0.105
            to: c + 0.906308 * (size * 0.3 * (1.55 + sin(23.5000 + t * 0.8) * 0.35 + sin(66.5000 - t * 0.5) * 0.2 + sin(105.5000 + t * 1.1) * 0.12)), c + 0.422618 * (size * 0.3 * (1.55 + sin(23.5000 + t * 0.8) * 0.35 + sin(66.5000 - t * 0.5) * 0.2 + sin(105.5000 + t * 1.1) * 0.12))
