        }
        line ray.6 {
            from: c + 0.866025 * size * 0.105, c + 0.500000 * size * 0.105
            to: c + 0.866025 * (size * 0.3 * (1.55 + sin(28.2000 + t * 0.8) * 0.35 + sin(79.8000 - t * 0.5) * 0.2 + sin(126.6000 + t * 1.1) * 0.12)), c + 0.500000 * (size * 0.3 * (1.55 + sin(28.2000 + t * 0.8) * 0.35 + sin(79.8000 - t * 0.5) * 0.2 + sin(126.6000 + t * 1.1) * 0.12))
            width: size * 0.012
