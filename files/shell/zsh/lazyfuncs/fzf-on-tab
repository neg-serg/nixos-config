# fzf-on-tab: empty line -> interactive fzf file picker (Ctrl-T also works);
#   otherwise Tab inserts a completion. A path word whose parent dir does not
#   exist (~/m/new, d/) is resolved by fuzzy insertion of the best dir match
#   (fzf-path-insert) instead of opening a picker; everything else keeps the
#   normal expand-or-complete (which already inserts on Tab).
local line=$BUFFER
if [[ $line == "" ]]; then
    zle fzf-file-widget
    return
fi
local stripped=${LBUFFER%%[[:space:]]##}
local cur=${stripped[(w)-1]}
if [[ $cur != */* ]]; then
    zle expand-or-complete
    return
fi
local expanded
if ! eval "expanded=$cur" 2>/dev/null; then
    zle expand-or-complete
    return
fi
local parent
if [[ $cur == */ ]]; then
    parent=$expanded          # word ends with '/': complete inside it
else
    parent=${expanded%/*}    # complete the last component under this dir
fi
if [[ -z $parent || -d $parent ]]; then
    zle expand-or-complete
else
    autoload -Uz fzf-path-insert
    fzf-path-insert "$cur" || zle expand-or-complete
fi
