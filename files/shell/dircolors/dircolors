# neg — LS_COLORS in the neg.nvim palette.
#
# Colours are 24-bit SGR (38;2;R;G;B), not 256-colour indexes: an index is
# whatever the terminal says it is, so `ls`, zsh completion and the syntax theme
# drifted apart as soon as the palette changed. The same hex roles drive
# files/shell/zsh-native-syntax/neg.ini, whose [file-extensions] table mirrors
# this one — scripts/dev/check-shell-palette.sh compares the two.
#
# Palette source: https://github.com/neg-serg/neg.nvim (lua/neg/palette.lua).
#   dirs ops3 · links dlim · plain text norm · dim files dbng · temp/backup dbng
#   archives violet · packages dlim · graphics incl · vector ops3 · video ops1
#   audio lit2/dadd · documents high/dlim · source iden · configs dbng
#   roms dwarn · errors err · block devices ops4
# `violet` #746b9e (L* 48, C* 30, h 300) and `lilac` #a47ead (L* 58, C* 30,
# h 320) are the two CIELAB-derived stops: the family had no readable member on
# #000000. `err` #cf4f88 is kitty color9 — neg's reds are background tints.
#
# Originally inspired by https://github.com/trapd00r/LS_COLORS
COLOR all
OPTIONS -F -b -T 0
EIGHTBIT 1

NORMAL                00                     # No color code at all
FILE                  00                     # Regular file: use no color at all
RESET                 00                     # Reset to "normal" color
DIR                   01;38;2;0;95;175       # Directory (bold blue; zsh completion can't parse reverse-video 07)
SOCK                  01;38;2;54;124;176     # Socket
BLK                   38;2;57;85;115         # Block device driver
CHR                   38;2;57;85;115;1       # Character device driver
CAPABILITY            38;2;57;85;115         # File with capability
NORM                  00                     # Normal files
EXEC                  04;03                  # This is for files with execute permission
FIFO                  38;2;20;135;135        # Named pipe
DOOR                  38;2;164;126;173       # Solaris door
LINK                  03;38;2;71;121;179     # Symbolic link
ORPHAN  01;03;38;2;207;79;136;48;2;95;0;0    # Symbolic link to nonexistent file
MULTIHARDLINK  48;2;21;24;31;38;2;165;193;230;1;3 # Regular file with more than one link
OTHER_WRITABLE  48;2;21;24;31;38;2;165;193;230;1;3 # Dir that is other-writable o+w and not sticky
SETGID                38;2;20;135;135;1      # File that is setgid: g+s
SETUID                38;2;20;135;135        # File that is setgid: u+s
STICKY  38;2;20;135;135;48;2;21;24;31        # Dir with the sticky bit set +t and not other-writable
STICKY_OTHER_WRITABLE  38;2;20;135;135;48;2;21;24;31;1 # Dir that is sticky and other-writable

