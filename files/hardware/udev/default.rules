# NVMe SSD
ACTION=="add|change", KERNEL=="nvme[0-9]*", ATTR{queue/rotational}=="0", \
    ATTR{queue/scheduler}="none"

# SSD
ACTION=="add|change", KERNEL=="sd[a-z]*|mmcblk[0-9]*", ATTR{queue/rotational}=="0", \
    ATTR{queue/scheduler}="mq-deadline"

# HDD
ACTION=="add|change", KERNEL=="sd[a-z]*", ATTR{queue/rotational}=="1", \
    ATTR{queue/scheduler}="bfq"
DEVPATH=="/devices/virtual/misc/cpu_dma_latency", OWNER="root", GROUP="audio", MODE="0660"
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="3434", ATTRS{idProduct}=="0b10", MODE="0660", GROUP="users", TAG+="uaccess", TAG+="udev-acl"
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="3554", ATTRS{idProduct}=="f54b", MODE="0660", GROUP="users", TAG+="uaccess", TAG+="udev-acl"

# 8BitDo controllers (hidraw access, vendor-wide rule)
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="2dc8", MODE="0666", GROUP="users", TAG+="uaccess", TAG+="udev-acl"
SUBSYSTEMS=="usb", ATTRS{idVendor}=="3554", ATTRS{idProduct}=="f54b", GROUP="users", MODE="0666"
SUBSYSTEMS=="usb", ATTRS{idVendor}=="35ef", ATTRS{idProduct}=="2201", GROUP="users", MODE="0666"
SUBSYSTEMS=="usb", ATTRS{idVendor}=="35ef", ATTRS{idProduct}=="2200", GROUP="users", MODE="0666"
SUBSYSTEMS=="usb", ATTRS{idVendor}=="31e3", ATTRS{idProduct}=="1322", GROUP="users", MODE="0666"
SUBSYSTEMS=="usb", ATTRS{idVendor}=="31e3", ATTRS{idProduct}=="132f", GROUP="users", MODE="0666"


# Questyle QCC Dongle Pro2 - USB-C Bluetooth audio transmitter (0a12:4007).
# 0a12 is the CSR/Qualcomm vendor id, so udev's usb.ids database labels this
# device "Mpow HC5 Headset in charging mode - HID / Mass Storage"; that string
# is what PipeWire shows as the card/port name. The kernel and the USB strings
# say "Questyle QCC Dongle Pro2" - put the database back in line.
# (Runs from 99-local.rules, i.e. after the usb_id builtin has filled the
# ID_*_FROM_DATABASE properties, so the assignment wins.)
SUBSYSTEM=="sound", ATTRS{idVendor}=="0a12", ATTRS{idProduct}=="4007", \
    ENV{ID_VENDOR_FROM_DATABASE}="Questyle", ENV{ID_MODEL_FROM_DATABASE}="QCC Dongle Pro2"

# The vendor control channel (hidraw, usage page 0xFF00) must be readable for
# questyle-ctl: uaccess for the local session + plugdev for everything else.
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0a12", ATTRS{idProduct}=="4007", \
    MODE="0660", GROUP="plugdev", TAG+="uaccess", TAG+="udev-acl"
