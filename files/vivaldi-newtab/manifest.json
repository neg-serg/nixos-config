{
  "manifest_version": 3,
  "name": "neg newtab",
  "version": "1.0.0",
  "description": "Dark new tab page: clock, date, weather, search and quick links.",
  "key": "",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "storage",
    "favicon"
  ],
  "host_permissions": [
    "https://api.open-meteo.com/*"
  ],
  "icons": {
    "128": "img/icon.svg"
  }
}
