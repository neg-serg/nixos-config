;; Kanata keyboard remapper
;; Docs: https://github.com/jtroo/kanata/blob/main/docs/config.adoc
;;
;; Home row mods: tap = letter, hold = modifier (timeout 200ms, quick-tap 200ms).
;; Physical positions in defsrc → layout-independent (works for RU/EN).
;; All unmapped keys pass through unchanged (process-unmapped-keys yes).

(defcfg
  process-unmapped-keys yes
  concurrent-tap-hold yes          ;; allow rolling home-row chords
)
(defalias
  ;; home row: tap = letter, hold = mod
  a (tap-hold 150 150 a lctl)
  s (tap-hold 150 150 s lalt)
  d (tap-hold 150 150 d lmet)
  f (tap-hold 150 150 f lsft)
  j (tap-hold 150 150 j lsft)
  k (tap-hold 150 150 k lmet)
  l (tap-hold 150 150 l lalt)
  ; (tap-hold 150 150 ; rctl)
  ;; caps: esc on tap, ctrl on hold (upgrade of former caps→lctl)
  caps (tap-hold 150 150 esc lctl)
)

(defsrc
  caps
  a s d f
  j k l ;
  spc
)

(deflayer base
  @caps
  @a @s @d @f
  @j @k @l @;
  spc
)

;; Keep HRM alive across layer switches (kanata 1.11 deflayermap):
;; (deflayermap (nav sym) a (tap-hold 150 150 a lctl) s (tap-hold 150 150 s lalt) d (tap-hold 150 150 d lmet) f (tap-hold 150 150 f lsft) j (tap-hold 150 150 j lsft) k (tap-hold 150 150 k lmet) l (tap-hold 150 150 l lalt) ; (tap-hold 150 150 ; rctl))
