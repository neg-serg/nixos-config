;; Kanata keyboard remapper
;; Docs: https://github.com/jtroo/kanata/blob/main/docs/config.adoc
;;
;; Achordion-like home row mods:
;;   tap-hold-tap-keys — when another letter key is pressed while a home-row
;;   key is held, the tap action activates immediately and the modifier does
;;   NOT fire (fast typing never triggers mods). This is kanata's equivalent
;;   of QMK's Achordion "don't misfire while typing" heuristic.
;;   Mods still work when held with non-letter keys (space, enter, arrows…).
;;
;; Number layer: hold '\' → home row becomes digits (a=1 s=2 d=3 f=4 j=7 k=8
;;   l=9 ;=0); Shift+digit on that layer gives symbols as usual.
;;
;; Physical positions in defsrc → layout-independent (works for RU/EN).
;; Unmapped keys pass through (process-unmapped-keys yes).

(defcfg
  process-unmapped-keys yes
  concurrent-tap-hold yes          ;; rolling home-row chords
)

;; Number layer: digits on home row (must be declared before the alias that
;; references it). Positions match defsrc order: caps, a s d f, j k l ;, bksl.
(deflayer num
  esc
  1 2 3 4
  7 8 9 0
  bksl
)

(defalias
  ;; home row: tap = letter, hold = mod (Achordion-like)
  a (tap-hold-tap-keys 150 200 a lctl (a b c d e f g h i j k l m n o p q r s t u v w x y z spc))
  s (tap-hold-tap-keys 150 200 s lalt (a b c d e f g h i j k l m n o p q r s t u v w x y z spc))
  d (tap-hold-tap-keys 150 200 d lmet (a b c d e f g h i j k l m n o p q r s t u v w x y z spc))
  f (tap-hold-tap-keys 150 200 f lsft (a b c d e f g h i j k l m n o p q r s t u v w x y z spc))
  j (tap-hold-tap-keys 150 200 j lsft (a b c d e f g h i j k l m n o p q r s t u v w x y z spc))
  k (tap-hold-tap-keys 150 200 k lmet (a b c d e f g h i j k l m n o p q r s t u v w x y z spc))
  l (tap-hold-tap-keys 150 200 l lalt (a b c d e f g h i j k l m n o p q r s t u v w x y z spc))
  ; (tap-hold-tap-keys 150 200 ; rctl (a b c d e f g h i j k l m n o p q r s t u v w x y z spc))
  ;; caps: esc on tap, ctrl on hold
  caps (tap-hold 150 150 esc lctl)
  ;; '\' — tap = backslash, hold = number layer
  bsl (tap-hold 150 150 bksl (layer-toggle num))
)

(defsrc
  caps
  a s d f
  j k l ;
  bksl
)

(deflayer base
  @caps
  @a @s @d @f
  @j @k @l @;
  @bsl
)
