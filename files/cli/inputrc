set bell-style                 none
set bind-tty-special-chars     on
set completion-ignore-case     on
set completion-map-case        on
set completion-query-items     200
set echo-control-characters    off
set enable-keypad              on
set enable-meta-key            on
set history-preserve-point     off
set history-size               1000
set horizontal-scroll-mode     off
set input-meta                 on
set output-meta                on
set convert-meta               off
set mark-directories           on
set mark-modified-lines        off
set mark-symlinked-directories on
set match-hidden-files         off
set meta-flag                  on
set page-completions           off
set show-all-if-ambiguous      on
set show-all-if-unmodified     on
set skip-completed-text        on
set visible-stats              on
set colored-stats              on
set completion-prefix-display-length 3

# vi editing mode for bash only: INPUTRC is exported system-wide, and other
# readline consumers (psql, python, …) keep their defaults. Insert mode keeps
# the emacs chords, command mode keeps the native vi keys — the same mix as zsh
# (files/shell/zsh/04-bindings.zsh).
$if Bash
  set editing-mode vi

  set keymap vi-insert
  "\C-a": beginning-of-line
  "\C-b": backward-char
  "\C-e": end-of-line
  "\C-f": forward-char
  "\C-k": kill-line
  "\C-u": kill-whole-line
  "\C-w": backward-kill-word
  "\C-l": clear-screen
  "\C-p": history-search-backward
  "\C-n": history-search-forward
  "\e[A": history-search-backward
  "\e[B": history-search-forward
  "\ew": copy-backward-word
  "\C-\M-w": unix-word-rubout
  "\C-x\C-i": menu-complete
  "\C-x\C-o": menu-complete-backward
  "\C-x\C-r": re-read-init-file
  "\ei": tab-insert
  # leave insert mode without reaching for Esc
  "kj": vi-movement-mode

  set keymap vi-command
  "gg": beginning-of-history
  "G": end-of-history
$endif
