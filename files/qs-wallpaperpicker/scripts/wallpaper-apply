#!/usr/bin/env bash
# Everything a new wallpaper sets besides the picture on screen:
#
#     wallpaper-apply FILE
#
#   ~/.cache/current_wallpaper_source -> FILE (what Quickshell draws)
#   ~/.cache/current_wallpaper        -> a still of it (scripts/wallpaper-still:
#                                        FILE itself, or a video's frame), which
#                                        the lock screens and Themes panel read
#   and the colour scheme, from matugen on that still (when it's installed).
#
# services/WallpaperEngine.qml runs it; scripts/setwall too without the shell.

file=$1
[[ -f $file ]] || { echo "wallpaper-apply: '$file' not found" >&2; exit 1; }
still=$("$(dirname "$0")/wallpaper-still" "$file") || { echo "wallpaper-apply: no still image for '$file'" >&2; exit 1; }

ln -sfn "$file" "$HOME/.cache/current_wallpaper_source"
ln -sfn "$still" "$HOME/.cache/current_wallpaper"

# NixOS (trantor): the deck and wl-daemon share the desktop — wl paints images, this
# picker paints the clips wl cannot. So applying a wallpaper also feeds what used to
# hang off wl-daemon alone: ~/.cache/quickshell-wallpaper-path (read by the bar accent
# and by wl-greeter-sync, which copies the file into the login screen's cache) and
# wl's last-good fallback. The *still*, never the source: the login screen runs
# k-means over it and the bar extracts colours, and neither can read a video.
mkdir -p "$HOME/.local/state/wl"
printf '%s\n' "$still" > "$HOME/.cache/quickshell-wallpaper-path"
printf '%s\n' "$still" > "$HOME/.local/state/wl/last-good"

# What wl was last handed (`wl img {}` runs for images only, see
# services/WallpaperEngine.qml). qs-wallpaper-adopt compares wl's state against this
# record to tell wl's own restore at login — which re-applies exactly this file —
# from a wallpaper the user picked on wl's side, which has to be adopted.
case ${file,,} in
    *.mp4 | *.webm | *.mkv | *.mov | *.m4v | *.gif | *.webp) ;;
    *) printf '%s\n' "$file" > "$HOME/.cache/qs-picker-wl-last" ;;
esac
# The colour scheme, for those who use matugen. Niced: reading a big image
# takes it most of a second on every core, which would cost the shell's
# animations (the picker's) their frames.
command -v matugen >/dev/null || exit 0
nice -n 19 matugen image "$still" --source-color-index 0
