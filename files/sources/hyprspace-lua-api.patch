+// Lua API: hl.plugin.hyprspace.toggle_overview() - returns a dispatcher
+// closure usable with hl.bind(). Needed because Hyprland 0.55+ Lua configs
+// cannot invoke string dispatchers registered via addDispatcherV2
+// (hyprctl dispatch overview:toggle fails at the Lua eval layer).
+static int luaToggleOverview(lua_State* L) {
+    static constexpr const char* FN = "hl.plugin.hyprspace.toggle_overview";
+    const int count = lua_gettop(L);
+    if (count > 1)
+        return luaL_error(L, "%s: expected at most 1 argument, got %d", FN, count);
+    std::string arg;
+    if (count == 1) {
+        if (!lua_isstring(L, 1))
+            return luaL_error(L, "%s: argument must be a string", FN);
+        arg = lua_tostring(L, 1);
+    }
+    lua_pushstring(L, arg.c_str());
+    auto dspToggle = [](lua_State* L) -> int {
+        std::string a = lua_tostring(L, lua_upvalueindex(1));
+        dispatchToggleOverview(a);
+        return 0;
+    };
+    lua_pushcclosure(L, dspToggle, 1);
+    return 1;
+}
