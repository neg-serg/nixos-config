# broot verb set for xdg-desktop-portal-termfilechooser (Choose Folder).
#
# Same contract as picker.hjson, but the pick key applies to directories: the
# wrapper starts broot with --only-folders, so the tree shows no files at all.
{
    quit_on_last_cancel: true

    verbs: [
        # Enter picks the highlighted directory and closes broot. Stock
        # `:open_stay` (which descends on Enter) is remapped to the right arrow.
        {
            invocation: "pick"
            key: "enter"
            internal: ":print_path"
            apply_to: "directory"
        }
        {
            key: "right"
            internal: ":open_stay"
        }
        # Multi-selection of directories, as in the multi-file picker.
        {
            invocation: "mark"
            key: "ctrl-s"
            internal: ":toggle_stage"
        }
        {
            key: "alt-enter"
            internal: ":no_action"
        }
        {
            key: "alt-h"
            internal: ":toggle_hidden"
        }
    ]
}
