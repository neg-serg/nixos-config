# broot verb set for xdg-desktop-portal-termfilechooser (Open File, multiple).
#
# Same as picker.hjson plus the staging key: mark files with ctrl-s, then move
# to the staging panel (ctrl-→ / alt-→) and press Enter there. `:print_path`
# prints every staged path when the staging panel is focused, which is exactly
# the multi-file answer the portal expects.
{
    quit_on_last_cancel: true

    verbs: [
        {
            invocation: "pick"
            key: "enter"
            internal: ":print_path"
            apply_to: "file"
        }
        {
            invocation: "mark"
            key: "ctrl-s"
            internal: ":toggle_stage"
        }
        {
            key: "alt-enter"
            internal: ":no_action"
        }
        {
            key: "alt-h"
            internal: ":toggle_hidden"
        }
    ]
}
