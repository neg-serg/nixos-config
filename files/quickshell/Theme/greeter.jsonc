{
  "greeter": {
    // Lock screen / greeter timing tokens
    "lockAnimationMs": 500,
    "slideshowDurationMs": 3000,
    "contextTimerMs": 300,
    // Animation tiers for greeter UI elements
    "animFastMs": 150,
    "animMediumMs": 250,
    "animSlowMs": 500,
    // Greeter color tokens (synced with main Theme or independent)
    "barColor": "#30c0ffff",
    "barOutline": "#50ffffff",
    "widgetColor": "#25ceffff",
    "widgetActiveColor": "#80ceffff",
    "widgetOutline": "#40ffffff",
    "widgetOutlineSeparate": "#20ffffff",
    "separatorColor": "#60ffffff",

    // Login card (files/quickshell/greeter/lock/LockContent.qml)
    // Login card: one scale for every font size and the geometry around it
    "uiScale": 1.2,
    "uiFont": "Iosevka",
    "displayFont": "Iosevka",
    "cardColor": "#a60f141c",
    "avatarPath": "assets/avatar.jpg",

    // Frosted glass card (greeter/shaders/glass_card.frag)
    "glassBlur": 9,
    "glassTint": "#33101820",
    "glassHighlight": 0.045,
    "glassRefract": 10,
    "glassShadow": 26,
    "glassGrain": 0.02,
    // Liquid glass: edge lensing (with a chromatic split), rim specular and a
    // highlight that follows the pointer
    "glassLens": 16,
    "glassChroma": 0.5,
    "glassSpecular": 0.1,
    "glassPointer": 0.12,
    // The password field is the same material, denser and with a brighter rim
    "fieldBlur": 6,
    "fieldTint": "#2effffff",

    // Avatar disc (greeter/shaders/avatar_round.frag)
    "avatarRingWidth": 0.05,
    "avatarGlow": 0.5,

    // No rounding by default: the login screen is meant to read as a terminal.
    // Raise these if a softer look is wanted; 0 is entirely square.
    "cardRadius": 0,
    "fieldRadius": 0,
    "chipRadius": 0,
    "buttonRadius": 0,
    "avatarRadius": 0,

    // Text halo: an accent glow plus a dark, slightly offset shadow behind the
    // glyphs — the glow carries them over a busy picture, the shadow keeps the
    // edges readable.
    "textGlow": 0.18,
    "textGlowColour": "#7fd6ff",
    "textGlowRadius": 4,
    "textShadow": 0.8,
    "textShadowColour": "#e6000000",
    "textShadowRadius": 2.5,
    "textShadowOffset": 2,

    // Wallpaper posterisation (greeter/shaders/posterize_dither.frag): four
    // colours, Bayer dithering, tinted with the image's own dominant colour.
    "posterizeEnabled": true,
    // "bayer" | "blueNoise" | "yliluoma" (see shaders/posterize_dither.frag)
    "posterizeMode": "yliluoma",
    "posterizeMaskScale": 1.0,
    // Palette chroma boost in Oklab (1.0 = the image's own colours, verbatim)
    "posterizeChroma": 1.35,
    "posterizeDither": 0.85,
    "posterizeCell": 2,
    "posterizeGamma": 1.0,
    "posterizeMix": 0.15,
    "posterizeTint": "",

    // CRT pass over the whole screen (greeter/shaders/crt_screen.frag);
    "crtEnabled": true,
    "crtLineSpacing": 3,
    "crtScanStrength": 0.13,
    "crtUiLines": 0,
    // Scanlines over the card as well (0 turns the UI overlay off)
    "crtMaskStrength": 0.05,
    "crtAberration": 0.6,
    "crtBarrel": 0.008,
    "crtBloom": 0.35,
    "crtVignette": 0.35,
    // Off: the sweep repaints the whole screen every frame, which reads as
    // shivering on a screen that has nothing else to animate.
    "crtRollStrength": 0,
    "crtRollMs": 9000,

    "cardOutline": "#3dffffff",
    "accentColor": "#7fd6ff",
    "dangerColor": "#ff9b9b",
    "textColor": "#f2f6fa",
    "textMutedColor": "#c3d2e0",
    "avatarColor": "#3d7fd6ff",
    "appearMs": 420
  }
}
