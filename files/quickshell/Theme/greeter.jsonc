{
  "greeter": {
    // Lock screen / greeter timing tokens
    "lockAnimationMs": 500,
    "slideshowDurationMs": 3000,
    "contextTimerMs": 300,
    // Animation tiers for greeter UI elements
    "animFastMs": 150,
    "animMediumMs": 250,
    "animSlowMs": 500,
    // Greeter color tokens (synced with main Theme or independent)
    "barColor": "#30c0ffff",
    "barOutline": "#50ffffff",
    "widgetColor": "#25ceffff",
    "widgetActiveColor": "#80ceffff",
    "widgetOutline": "#40ffffff",
    "widgetOutlineSeparate": "#20ffffff",
    "separatorColor": "#60ffffff",

    // Login card (files/quickshell/greeter/lock/LockContent.qml)
    // Login card: one scale for every font size and the geometry around it
    "uiScale": 1.2,
    "uiFont": "Iosevka",
    "displayFont": "Iosevka",
    "cardColor": "#a60f141c",
    "avatarPath": "assets/avatar.jpg",

    // Frosted glass card (greeter/shaders/glass_card.frag)
    "glassBlur": 9,
    // The pane is dark on purpose: the sampled backdrop is the wallpaper *before*
    // the scrim, the vignette and the CRT pass darken it, so a light tint would
    // make the card brighter than the picture around it — a pale slab, and no
    // surface for white type. Plain uniform darkening, nothing local.
    "glassTint": "#c20a0e14",
    "glassHighlight": 0.045,
    "glassRefract": 10,
    "glassShadow": 26,
    "glassGrain": 0.02,
    // Liquid glass: edge lensing (with a chromatic split) and a highlight that
    // follows the pointer
    "glassLens": 16,
    "glassChroma": 0.5,
    // No rim specular. The shader adds it as pure white on top of the blurred
    // backdrop, so on a dark patch of the picture it draws a bright 1px line
    // along the pane's edge that reads as a scratch on the screen. The pane is
    // held by the tint and the drop shadow instead.
    "glassSpecular": 0,
    "glassPointer": 0.12,
    // The password field: the same material, darker and denser than the card, so
    // light type reads on it over any wallpaper
    "fieldBlur": 6,
    "fieldTint": "#e60a0e14",

    // Avatar disc (greeter/shaders/avatar_round.frag)
    "avatarRingWidth": 0.05,
    "avatarGlow": 0.5,

    // Clock (greeter/lock/NixieClock.qml, shaders/nixie.frag): four gas-discharge
    // tubes. The colour of a real tube is not one colour — the lit cathode is
    // almost white while the gas around it is pure orange, and the glass it
    // burns in is a very dark, warm tint. "nixieDigitSize" is the numeral in px
    // before uiScale; the tubes, the gaps and the colon are built from it.
    // "nixieTubeMargin" is the room each tube's item keeps around its glass for
    // the discharge's bloom: the clock's row is spaced negative by two of them,
    // so the glass edges can sit as close as the clock's own two gaps say.
    "nixieDigitSize": 92,
    "nixieTubeMargin": 16,
    "nixieGlow": 1.0,
    // The lit cathode's temperature in kelvin: a metal that hot is its own
    // light, and the shader draws it with a colour and a power measured off the
    // Planck spectrum itself (see nixie.frag and scripts/dev/nixie-calibrate.py).
    // A nixie's cathode is not a tungsten filament: the discharge heats it to a
    // dull orange, and the white in photographs of one is the camera, not the
    // metal. 2100 K is the vintage lamp — a deep orange, close to the glow of a
    // cathode in an old photograph; 2400 K is the same physics, one knob apart,
    // and reads as a modern amber wire.
    "nixieTempK": 2100,
    // How many times brighter than white the wire is exposed at. This is what
    // makes a core white through the tone curve instead of painting it white:
    // 1.5 is the calibrated pair for 2400 K, 2.5 keeps the vintage 2100 K wire
    // glowing. Higher is a hotter lamp, lower is a dimmer one.
    "nixieExposure": 2.5,
    "nixieGlowColor": "#ff5a10",
    "nixieGlassColor": "#4d120b06",
    "nixieCathodeColor": "#aab6c4",
    // Coloured glass. The tube's own light — the hot metal and the gas around it
    // — takes this hue at the brightness it already had: the colour is written
    // the way Qt writes colours, #aarrggbb, so the alpha is how much of it.
    // "#00000000" is off (the metal's own Planck colour, the default) and
    // "#cc66e0ff" makes the lamp read as a cyan tube. It is a look, not a filter:
    // an orange light through cyan glass would simply be dark, and this is the
    // knob for a tube that was blown in coloured glass.
    "nixieTint": "#00000000",
    // Or let the room colour the lamp: above zero, the tube's light takes the
    // wallpaper's own accent — the most saturated colour found on a ring around
    // it — instead of nixieTint's, and this is how much of it. A grey wallpaper
    // has no accent to take and the metal keeps its own colour.
    "nixieTintWallpaper": 0.0,
    // The camera. It stands a little off the clock's axis and a finite distance
    // away, which together are what makes the clock read as photographed and
    // not drawn: the numerals inside each glass shift towards the viewer's side
    // and narrow by the cosine (the envelope keeps its silhouette — a cylinder
    // is as wide at an angle as it is head-on), and the two ends of the row are
    // not the same size. 16 degrees costs the numerals cos(16) = 4% of their
    // width and leaves them clear of the glass; 0 puts the camera dead ahead.
    "nixieViewAngle": 16.0,
    // How far the camera stands from the clock, in tube widths (21 mm): the
    // nearer half of the row is drawn a little larger and the farther half a
    // little smaller — about a tenth between the nearest and the farthest
    // glass at 8, and that is what reads as a row seen from the side. Larger
    // is a flatter picture, the perspective goes as 1/distance, and 0 leaves
    // it to the shader's own default.
    "nixieViewDistance": 8.0,
    // The cathode wire's radius as a fraction of the numeral's height: 0.044 of
    // 25 mm is 1.10 mm, so the wire measures 2.20 mm across — a heavy-duty
    // cathode, and what the discharge around it is drawn on. The real IN-12
    // cathode is 0.24 mm; this one is thickened on purpose, because what the eye
    // reads on the login screen is the glowing filament, and a hairline
    // vanishes there. The digit's bends are the same radius (the shader takes
    // it from this token), so turning the knob keeps elbows as thick as the wire.
    "nixieWire": 0.0440,
    "nixieStack": 0.5,
    "nixieHighlight": 0.8,
    "nixieWarmth": 0.45,
    // Restrike time on a digit change — long enough to be seen, short enough
    // that a minute never waits for it. 0 leaves the tubes steady.
    "nixieFlickerMs": 320,

    // Rounded corners, held back on purpose: the glass and the light are what
    // shape these surfaces, and a wide radius reads as a capsule fighting them.
    // 0 gives the old hard-edged terminal look back.
    "cardRadius": 6,
    "fieldRadius": 8,
    // Clamped to half the height, so 999 is a pill / a disc.
    "chipRadius": 999,
    "buttonRadius": 999,
    "avatarRadius": 16,

    // Wallpaper posterisation (greeter/shaders/posterize_dither.frag): four
    // colours, Bayer dithering, tinted with the image's own dominant colour.
    "posterizeEnabled": true,
    // "bayer" | "blueNoise" | "yliluoma" (see shaders/posterize_dither.frag)
    "posterizeMode": "yliluoma",
    "posterizeMaskScale": 1.0,
    // Palette chroma boost in Oklab (1.0 = the image's own colours, verbatim)
    "posterizeChroma": 1.35,
    "posterizeDither": 0.85,
    "posterizeCell": 2,
    "posterizeGamma": 1.0,
    "posterizeMix": 0.15,
    "posterizeTint": "",

    // CRT pass over the whole screen (greeter/shaders/crt_screen.frag);
    "crtEnabled": true,
    "crtLineSpacing": 3,
    "crtScanStrength": 0.13,
    "crtUiLines": 0,
    // Scanlines over the card as well (0 turns the UI overlay off)
    "crtMaskStrength": 0.05,
    "crtAberration": 0.6,
    "crtBarrel": 0.008,
    "crtBloom": 0.35,
    "crtVignette": 0.35,
    // Off: the sweep repaints the whole screen every frame, which reads as
    // shivering on a screen that has nothing else to animate.
    "crtRollStrength": 0,
    "crtRollMs": 9000,

    "cardOutline": "#3dffffff",
    "accentColor": "#7fd6ff",
    "dangerColor": "#ff9b9b",
    "textColor": "#f2f6fa",
    "textMutedColor": "#c3d2e0",
    "avatarColor": "#3d7fd6ff",
    "appearMs": 420
  }
}
