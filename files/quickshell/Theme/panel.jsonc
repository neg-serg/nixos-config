{
  "panel": {
    // Layout primitives for the top bar; keep values even to avoid pixel jitter.
    "height": 22,
    "scale": 1.15,
    "sideMargin": 4,
    "widgetSpacing": 4,
    "separatorWidthFactor": 1,
    "separatorOpacity": 0.88,
    // Inter-widget spacing and seam geometry for the top bar capsules.
    "interWidgetRatio": 1.35,
    "seamWidthRatio": 0.85,
    "seamMinPx": 8,
    "hotzone": {
      "width": 16,
      "height": 9,
      "rightShift": 1.15
    },
    "moduleHeight": 22,
    "menuYOffset": 20,
    "icons": {
      // Icon sizes for bar capsules/tray, before per-screen scaling.
      "iconSize": 24,
      "iconSizeSmall": 16
    },
    "pill": {
      // Hover pill controls consolidated menu/tooltip popups triggered from the bar.
      "height": 28,
      "iconSize": 22,
      "paddingH": 8,
      "showDelayMs": 500,
      "autoHidePauseMs": 2500,
      "color": "#000000"
    },
    "animations": {
      "stdMs": 200,
      "fastMs": 150,
      "overlayMs": 180,
      "slideMs": 380
    },
    "tray": {
      "longHoldMs": 2500,
      "shortHoldMs": 1500,
      "guardMs": 120,
      "overlayDismissDelayMs": 5000,
      "inlinePadding": 4
    },
    "rowSpacing": 4,
    "rowSpacingSmall": 2,
    "volume": {
      "fullHideMs": 800,
      "mutedHideMs": 180000,
      "offReminderCooldownMs": 86400000,
      "lowColor": "#D62E6E",
      "highColor": "#0E6B4D"
    },
    "hover": {
      "fadeMs": 120
    },
    "menu": {
      "width": 180,
      "submenuWidth": 180,
      "padding": 4,
      "itemSpacing": 2,
      "itemHeight": 26,
      "itemRadius": 0,
      "radius": 0,
      "heightExtra": 12,
      "anchorYOffset": 4,
      "submenuGap": 12,
      "chevronSize": 15,
      "iconSize": 16,
      "itemFontScale": 0.9
    },
    "overlayRadius": 5,
    "netCluster": {
      "spacing": 2
    },
    "capsule": {
      "borderInset": -1,
      "borderWidth": 0,
      "borderOpacity": 0.08,
      "borderColor": "#000000"
    },
    "computedFontScale": 0.6,
    "seam": {
      "opacity": 0.88
    },
    "backdrop": {
      "color": "#000000"
    },
    "tint": {
      // Bar recolor pass (Docs/PANELS.md); panelTintEnabled toggles it at runtime.
      "color": "#ff2a36",
      "alpha": 0.75,
      "strength": 1.0,
      "featherTop": 0,
      "featherBottom": 0
    },
    "slideTimerTickMs": 16
  }
}